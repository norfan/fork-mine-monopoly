ePlayerAllOperationListener(currentPlayer.id, OperateType.UseChanceCard);\n\n\t\tif (operation.type === OperateType.RollDice) {\n\t\t\tbreak;\n\t\t}\n\n\t\tif (operation.res) {\n\t\t\tconst { chanceCardId, targetIdList } = operation.res;\n\t\t\tawait gameProcess.handleUseChanceCard(currentPlayer, chanceCardId, targetIdList);\n\t\t}\n\t}\n\n\t// å°†éª°å­ç»“æœå†™å…¥ä¸Šä¸‹æ–‡ï¼Œå¹¶å­˜å‚¨åˆ°ç©å®¶å¯¹è±¡ä¸­ä¾›å…¶ä»–æœºåˆ¶ä½¿ç”¨\n\tconst diceResult = await currentPlayer.rollDices();\n\tcontext.diceResult = diceResult;\n}) as GameEventFunction<RollDiceContext>;\n"},{"id":"sys-phase-player-move","name":"ç©å®¶ç§»åŠ¨","description":"ç©å®¶ç§»åŠ¨é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":"PlayerMove","initEventCode":"(async (context, gameProcess) => {\n\t//ç©å®¶ç§»åŠ¨\n\tconst player = context.currentRoundPlayer;\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\n\tcontext.targetIndex = player.positionIndex;\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"sys-phase-arrived-event","name":"åˆ°è¾¾äº‹ä»¶","description":"åˆ°è¾¾äº‹ä»¶é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":"ArrivedEvent","initEventCode":"(async (context, gameProcess) => {\n\tconst player = context.currentRoundPlayer;\n\tawait gameProcess.handleArriveEvent(player);\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"sys-phase-player-round-end","name":"ç©å®¶å›åˆç»“æŸ","description":"ç©å®¶å›åˆç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":"PlayerRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\t\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"sys-phase-game-round-end","name":"è½®æ¬¡ç»“æŸ","description":"è½®æ¬¡ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":"GameRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\tgameProcess.currentRound += 1;\n}) as GameEventFunction<GameRoundEndContext>;"}],"postRestore":[{"id":"sys-phase-post-restore","name":"å­˜æ¡£æ¢å¤å","description":"å­˜æ¡£æ¢å¤åé˜¶æ®µ","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}]},"buildingModelIdList":["house-cbd-0","house-cbd-1","house-cbd-2","house-cbd-3","house-cbd-4"],"uiTemplates":[],"modifierTemplates":[],"customUIs":[],"gameSettingForm":[{"id":"gs-init-money","key":"initMoney","type":"number-input","label":"åˆå§‹å…ƒ","defaultValue":15000,"min":0,"max":1000000,"builtIn":true},{"id":"gs-turn-timeout","key":"turnTimeout","type":"number-input","label":"å›åˆå€’è®¡æ—¶(ç§’)","defaultValue":15,"min":5,"max":120,"builtIn":true},{"id":"gs-chance-timeout","key":"chanceTimeout","type":"number-input","label":"æœºä¼šå¡é˜…è¯»æ—¶é™(ç§’)","defaultValue":20,"min":5,"max":120}],"extraLibs":"// ç»å…¸å¤åˆ»åœ°å›¾æ•ˆæœå‡½æ•°åº“ï¼ˆç¥å·å¤§åœ°/ä¸‰å›½é£äº‘/æ±Ÿå—æ°´ä¹¡ å…±ç”¨ï¼‰\n// ä¸ tang-extra-libs åŒæ„ï¼šåœ°äº§åˆ°è¾¾ï¼ˆè´­ç½®/å»ºé€ /æ”¶ç§Ÿï¼‰ã€æœºä¼šå¡æŠ½å–ã€é€šç”¨æ”¶ä»˜æ¬¾\nfunction clsNumber(gp: IGameProcess, key: string, fallback: number): number {\n  const value = Number(gp.gameSetting[key]?.value);\n  return Number.isFinite(value) ? value : fallback;\n}\nasync function clsCash(gp: IGameProcess, player: IPlayer, base: number, title: string): Promise<void> {\n  if (player.isBankrupted) return;\n  const money = Math.max(0, Math.round(Math.abs(base)));\n  if (base >= 0) await player.gain(money, \"cls_card\");\n  else if (money > 0) await player.cost(money, \"cls_tax\");\n  gp.messageNotify([player.id], { type: base >= 0 ? \"success\" : \"warning\", content: `${title}ï¼š${base >= 0 ? \"æ”¶å…¥\" : \"æ”¯å‡º\"} ${money}ï¼Œç»“ä½™ ${player.money}` });\n  gp.gameDataBroadcast();\n}\nasync function clsArrive(gp: IGameProcess, property: IProperty, player: IPlayer): Promise<void> {\n  if (player.isBankrupted) return;\n  const owner = property.owner;\n  const displayName = property.name.replace(/\\n/g, \"Â·\");\n  if (!owner) {\n    const price = property.sellCost;\n    if (player.money <= price) {\n      gp.messageNotify([player.id], { type: \"warning\", content: `${displayName} å”®ä»· ${price}ï¼Œç°é‡‘ä¸è¶³ï¼Œæ— åŠ›è´­ç½®ã€‚` });\n      return;\n    }\n    const result = await gp.showConfirmDialog(player.id, { title: `è´­ç½® ${displayName}`, content: `å”®ä»· ${price}ï¼Œå½“å‰ç»“ä½™ ${player.money}ã€‚`, confirmText: \"ä¹°ä¸‹\", cancelText: \"æ”¾å¼ƒ\" }, { timeout: clsNumber(gp, \"turnTimeout\", 15) * 1000 });\n    if (result.confirm && !player.isBankrupted && player.money > price) await gp.handlePlayerBuyProperty(player, property);\n    return;\n  }\n  if (owner.id === player.id) {\n    if (property.level < property.maxLevel && player.money > property.buildCost) {\n      const result = await gp.showConfirmDialog(player.id, { title: `æ‰©å»º ${displayName}`, content: `å»ºé€ è´¹ ${property.buildCost}ï¼Œå‡è‡³ ${property.level + 1} çº§ã€‚`, confirmText: \"å¼€å·¥\", cancelText: \"æš‚ä¸\" }, { timeout: clsNumber(gp, \"turnTimeout\", 15) * 1000 });\n      if (result.confirm && !player.isBankrupted) await gp.handlePlayerBuildUp(player, property);\n    }\n    return;\n  }\n  const rent = property.costList[property.level] || 0;\n  const paid = await player.cost(rent, \"cls_rent\", owner);\n  if (paid.actualCost > 0) await owner.gain(paid.actualCost, \"cls_rent\", player);\n  gp.msgNotifyBroadcast(\"info\", `${player.name} åœ¨ ${displayName} ç¼´çº³ç§Ÿé“¶ ${paid.actualCost} äºˆ ${owner.name}`);\n  gp.gameDataBroadcast();\n}\nasync function clsDraw(gp: IGameProcess, player: IPlayer): Promise<void> {\n  const cards = Array.from(gp.chanceCardInfos.values());\n  if (!cards.length) return;\n  const info = cards[Math.floor(Math.random() * cards.length)];\n  await gp.showConfirmDialog(player.id, { title: `æœºä¼šå¡ Â· ${info.name}`, content: `${info.description}\\n\\nç‚¹å‡»ç¡®è®¤åæ‰§è¡Œæ•ˆæœï¼›ç­‰å¾…è¶…æ—¶å°†è‡ªåŠ¨æ‰§è¡Œã€‚`, confirmText: \"çŸ¥æ™“å¹¶æ‰§è¡Œ\", cancelText: \"å·²è¯»ç»§ç»­\" }, { timeout: clsNumber(gp, \"chanceTimeout\", 20) * 1000, defaultValue: { id: player.id, confirm: true } });\n  if (player.isBankrupted) return;\n  gp.msgNotifyBroadcast(\"info\", `${player.name} æŠ½åˆ°ã€Œ${info.name}ã€`);\n  await gp.createNewChanceCard(info.id).use(player, player, gp);\n  gp.gameDataBroadcast();\n}\n"}à*
