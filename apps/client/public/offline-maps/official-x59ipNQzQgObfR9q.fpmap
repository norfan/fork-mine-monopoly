details-'+q.id,type:'div',style:{padding:'12px',background:'#111c32',color:'#e5f3ff','border-radius':'12px'},children:[\n  {id:'stock-title',type:'div',content:`${q.name} Â· ${nsPrice(gp,q)}/è‚¡ Â· æœ¬è½® ${q.change>=0?'+':''}${q.change}%`,style:{'font-size':'18px','font-weight':'bold',color}},\n  {id:'stock-chart',type:'svg',props:{viewBox:'0 0 480 160',width:'100%',height:'160'},children:[{id:'stock-axis',type:'line',props:{x1:16,y1:130,x2:464,y2:130,stroke:'#405575'}},{id:'stock-curve',type:'path',props:{d:path,fill:'none',stroke:color,'stroke-width':3}},...points.map((p,i)=>({id:'stock-dot-'+i,type:'circle' as const,props:{cx:p.x,cy:p.y,r:2.5,fill:color}}))]},\n  {id:'stock-period',type:'div',content:`æœ€è¿‘${history.length}ä¸ªæ”¶ç›˜ç‚¹ Â· ç¬¬${history[0]?.round??0}â€“${history[history.length-1]?.round??0}è½® Â· ä»·æ ¼èŒƒå›´ ${low}â€“${high}`},\n  {id:'stock-position',type:'div',content:`æŒæœ‰${lot.shares}è‚¡ Â· å¸‚å€¼${lot.shares*nsPrice(gp,q)} Â· æˆæœ¬${Math.round(lot.cost)} Â· å·²å®ç°ç›ˆäº${Math.round(lot.realized)} Â· ç´¯è®¡åˆ†çº¢${lot.dividends}`},\n  {id:'stock-risk',type:'div',content:`${q.group}å‘å±•å½±å“é•¿æœŸä»·æ ¼ï¼›åŸºç¡€æ³¢åŠ¨ä¸Šé™${ncNumber(gp,'stockVolatility',12)}%ï¼Œå¦å åŠ åŸå¸‚é€šèƒ€ã€‚è‚¡ç¥¨å¯èƒ½äºæŸã€‚`,style:{'margin-top':'8px',color:'#aebfd8'}}]};\n}\nasync function nsMenu(gp:IGameProcess,player:IPlayer):Promise<void> {\n if(!nsEnabled(gp)||player.isBankrupted||gp.currentRoundPlayer?.id!==player.id)return;\n const s=nsState(gp),selected=await gp.showItemSelectDialog(player.id,{title:'ä¸å¤œåŸè‚¡ç¥¨äº¤æ˜“æ‰€',content:nsReport(gp,player),itemList:s.quotes.map(q=>({id:q.id,display:`${q.name} Â· ${nsPrice(gp,q)}/è‚¡ Â· æŒæœ‰${nsLot(gp,player,q.id).shares}è‚¡`})),cancelText:'è¿”å›æ·éª°å­',multiple:false});\n const q=s.quotes.find(q=>q.id===selected.selected?.[0]);if(!q||player.isBankrupted||gp.currentRoundPlayer?.id!==player.id)return;\n const max=nsMaxBuy(gp,player,q),held=nsLot(gp,player,q.id).shares;\n const options=[];if(max>0)options.push({id:'buy',display:`ä¹°å…¥ï¼ˆæœ€å¤š${max}è‚¡ï¼‰`});if(held>0)options.push({id:'sell',display:`å–å‡ºï¼ˆæŒä»“${held}è‚¡ï¼‰`});\n if(nsTurn(gp,player).actions>=3)options.splice(0,options.length);\n options.push({id:'back',display:'ä»…æŸ¥çœ‹è¡Œæƒ… / è¿”å›'});\n const action=await gp.showItemSelectDialog(player.id,{title:q.name,content:nsChart(gp,player,q),itemList:options,cancelText:'è¿”å›',multiple:false});const side=action.selected?.[0];if(!['buy','sell'].includes(side))return;\n const limit=side==='buy'?max:held;\n const form=await gp.showFormDialog(player.id,{title:`${side==='buy'?'ä¹°å…¥':'å–å‡º'} ${q.name}`,content:`ç°ä»· ${nsPrice(gp,q)}/è‚¡ï¼Œäº¤æ˜“æ‰‹ç»­è´¹ ${ncNumber(gp,'stockFee',1)}%ã€‚`,fields:[{key:'shares',label:'è‚¡æ•°ï¼ˆæ­£æ•´æ•°ï¼‰',defaultValue:Math.min(10,limit),min:1,max:limit}],confirmText:'æŸ¥çœ‹æŠ¥ä»·',cancelText:'å–æ¶ˆ'});\n const n=Number(form.shares);if(!form.submitted||!Number.isSafeInteger(n)||n<=0||n>limit)return;\n const value=n*nsPrice(gp,q),fee=nsFee(gp,value);\n const confirm=await gp.showConfirmDialog(player.id,{title:'ç¡®è®¤è‚¡ç¥¨äº¤æ˜“',content:`${side==='buy'?'ä¹°å…¥':'å–å‡º'} ${q.name} ${n}è‚¡ï¼Œ${side==='buy'?'æ€»æ”¯å‡º':'å‡€æ”¶å…¥'} ${side==='buy'?value+fee:value-fee}ï¼Œå…¶ä¸­æ‰‹ç»­è´¹${fee}ã€‚`,confirmText:'æˆäº¤',cancelText:'å–æ¶ˆ'});\n if(confirm.confirm&&!await nsTrade(gp,player,q.id,side,n))gp.messageNotify([player.id],{type:'warning',content:'äº¤æ˜“æœªå®Œæˆï¼šèµ„é‡‘ã€æŒä»“æˆ–å›åˆçŠ¶æ€å·²å˜åŒ–ã€‚'});\n}\nasync function nsAITurn(gp:IGameProcess,player:IPlayer):Promise<void> {\n if(!nsIsAI(player)||!nsEnabled(gp)||player.isBankrupted)return;\n nsSync(gp);const s=nsState(gp),reserve=nsReserve(gp);\n const actions:{id:string;label:string;actionType:string;summary:string;payload:Record<string,unknown>}[]=[{id:'hold',label:'ä¿ç•™ç°é‡‘ï¼Œç»§ç»­ç»è¥åœ°äº§',actionType:'skip',summary:'ä¸äº¤æ˜“ï¼Œä¿ç•™ç°é‡‘æ”¯ä»˜è¿‡è·¯è´¹å’Œç›–æˆ¿',payload:{}}];\n const candidates:Record<string,{stockId:string;s