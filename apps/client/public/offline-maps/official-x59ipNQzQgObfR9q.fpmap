=>{gameProcess.messageNotify([player.id],{type:\"info\",content:\"è¡—è§’ä¼‘æ¯ï¼šæ¬£èµå¤œæ™¯ï¼Œä¸‹ä¸€å›åˆç…§å¸¸è¡ŒåŠ¨ã€‚\"});});"},{"id":"event-rxwikm","name":"åŸå¸‚æœåŠ¡è´¹","type":"ArrivedEvent","description":"ç¼´çº³åŸºå‡†300","iconId":"image-rf5dw8","effectCode":"(async (player:IPlayer,gameProcess:IGameProcess)=>{await ncCash(gameProcess,player,-300,\"åŸå¸‚æœåŠ¡è´¹\");});"},{"id":"event-t0y7as","name":"èµ·ç‚¹è¥ä¸šæ”¶å…¥","type":"PassedEvent","description":"ç»è¿‡èµ·ç‚¹é¢†å–åŸºå‡†3000","iconId":"image-vii6wq","effectCode":"(async (player:IPlayer,gameProcess:IGameProcess)=>{await ncCash(gameProcess,player,3000,\"èµ·ç‚¹è¥ä¸šæ”¶å…¥\");});"}],"phases":{"gameOverRule":[{"id":"sys-phase-game-over-rule","name":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™","description":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™, è¿”å› false è¡¨ç¤ºæ¸¸æˆç»§ç»­; è¿”å›ç©å®¶IDæ•°ç»„è¡¨ç¤ºæ¸¸æˆç»“æŸ, æ•°ç»„é¡ºåºå³ä¸ºæ’åï¼ˆç´¢å¼•0ä¸ºç¬¬ä¸€åï¼‰","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => { ncEliminations(gameProcess); const alive=Array.from(gameProcess.players.values()).filter(p=>!p.isBankrupted); if(alive.length>1)return false; const eliminated=[...ncState(gameProcess).eliminated].reverse(); return [...alive.map(p=>p.id),...eliminated]; });"}],"gameInited":[{"id":"sys-phase-game-inited","name":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸ","description":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => { ncInitialize(gameProcess); gameProcess.msgNotifyBroadcast('info','æ¬¢è¿æ¥åˆ°éœ“è™¹ä¸å¤œåŸï¼šä¹°åœ°åå³å¯ç›–æˆ¿ï¼Œé›†é½è¡—åŒºä»…åŠ ç§Ÿé‡‘ï¼Œç°é‡‘è€—å°½å³ç ´äº§ã€‚'); });"}],"playerPreInit":[{"id":"sys-phase-player-pre-init","name":"ç©å®¶é¢„åˆå§‹åŒ–","description":"ç©å®¶é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨ç©å®¶åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n  \r\n}) as GameEventFunction<GameContext>;\r\n"}],"propertyPreInit":[{"id":"sys-phase-property-pre-init","name":"åœ°çš®é¢„åˆå§‹åŒ–","description":"åœ°çš®é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨åœ°çš®åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n  \r\n}) as GameEventFunction<GameContext>;\r\n"}],"gameRoundStart":[{"id":"sys-phase-game-round-start","name":"è½®æ¬¡å¼€å§‹","description":"è½®æ¬¡å¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context, gameProcess) => {\r\n  \r\n}) as GameEventFunction<GameRoundStartContext>;"}],"playerRound":[{"id":"sys-phase-player-round-start","name":"ç©å®¶å›åˆå¼€å§‹","description":"ç©å®¶å›åˆå¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":1,"initEventCode":"(async (context:PlayerRoundStartContext,gameProcess:IGameProcess)=>{ncBeginTurn(gameProcess,context.currentRoundPlayer);ncSync(gameProcess);nsSync(gameProcess);});\n"},{"id":"sys-phase-roll-dice","name":"ç©å®¶æ“ä½œ","description":"ç©å®¶æ“ä½œé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":2,"initEventCode":"(async (context:RollDiceContext,gameProcess:IGameProcess)=>{\n const player=context.currentRoundPlayer;\n await nsAITurn(gameProcess,player);\n let active=true;let interaction:Promise<void>|undefined;let wakeInteraction:(()=>void)|undefined;\n const buttons:ButtonController[]=[];\n const run=async(fn:()=>Promise<void>)=>{\n  if(!active||interaction||player.isBankrupted)return;\n  for(const b of buttons)b.setEnabled(false);\n  interaction=Promise.resolve().then(fn);wakeInteraction?.();\n  try{await interaction;}finally{interaction=undefined;if(active)for(const [i,b] of buttons.entries())b.setEnabled(i!==0||ncCanBuild(gameProcess,player));}\n };\n buttons.push(gameProcess.registerPlayerButton(player.id,'ç›–æˆ¿ / å‡çº§ï¼ˆæ¯å›åˆä¸€æ¬¡ï¼‰',()=>run(()=>ncBuild(gameProcess,player))));\n buttons[0].setEnabled(ncCanBuild(gameProcess,player));\n if(nsEnabled(gameProcess)&&!nsIsAI(player))buttons.push(gameProcess.registerPlayerButton(player.id,'è‚¡ç¥¨ Â· è¡Œæƒ… / ä¹°å–',()=>run(()=>nsMenu(gameProcess,player))));\n try{\n  while(!player.isBankrupted){\n   gameProcess.setCurrentEventName(`ç­‰å¾…${player.name}ï¼š${ncCanBuild(gameProcess,player)?'å¯ç›–æˆ¿ã€':''}äº¤æ˜“è‚¡ç¥¨æˆ–æ·éª°å­`);\n   const operation=await Promise.race([\n    gameProcess.oncePlayerOperationAsync(player.id,OperateType.RollDice).then(res=>({kind:'dice' as const,res})),\n    gameProcess.oncePlayerOperationAsync(player.id,OperateType.UseChanceCard).then(res=>({kind:'card' as const,res})),\n    new Promise<{kind:'interaction'}>(resolve=>{wakeInteraction=()=>resolve({kind:'interaction'});})\n   ]);\n   gameProcess.removePlayerAllOperationListener(player.id,OperateType.RollDice);\n   gameProcess.removePlayerAllOperationListener(player.id,OperateType.UseChanceCard);\n   wakeInteraction=undefined;\n   if(operation.kind==='interaction'){if(interaction)await interaction;continue;}\n   if(operation.kind==='dice'){active=false;for(const b of buttons)b.setEnabled(false);if(interaction)await interaction;break;}\n   if(interaction)await interaction;\n   if(operation.res)await gameProcess.handleUseChanceCard(player,operation.res.chanceCardId,operation.res.targetIdList);\n  }\n }finally{active=false;for(const b of buttons)b.remove();}\n if(!player.isBankrupted)context.diceResult=await player.rollDices();\n});\n"},{"id":"sys-phase-player-move","name":"ç©å®¶ç§»åŠ¨","description":"ç©å®¶ç§»åŠ¨é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":3,"initEventCode":"(async (context, gameProcess) => {\r\n\t//ç©å®¶ç§»åŠ¨\r\n\tconst player = context.currentRoundPlayer;\r\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\r\n\tcontext.targetIndex = player.positionIndex;\r\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"sys-phase-arrived-event","name":"åˆ°è¾¾äº‹ä»¶","description":"åˆ°è¾¾äº‹ä»¶é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":4,"initEventCode":"(async (context, gameProcess) => {\r\n\tconst player = context.currentRoundPlayer;\r\n\tawait gameProcess.handleArriveEvent(player);\r\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"sys-phase-player-round-end","name":"ç©å®¶å›åˆç»“æŸ","description":"ç©å®¶å›åˆç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":5,"initEventCode":"(async (context, gameProcess) => {\r\n\t\r\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"sys-phase-game-round-end","name":"è½®æ¬¡ç»“æŸ","description":"è½®æ¬¡ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":6,"initEventCode":"(async (context:GameContext,gameProcess:IGameProcess)=>{ncRoundEnd(gameProcess);await nsRoundEnd(gameProcess);});"}],"postRestore":[{"id":"sys-phase-post-restore","name":"å­˜æ¡£æ¢å¤å","description":"å­˜æ¡£æ¢å¤åé˜¶æ®µï¼ˆåœ¨ restoreFromSnapshot ä¹‹åã€GameInit å¹¿æ’­ä¹‹å‰è¿è¡Œï¼Œä»…åœ¨æœ‰å­˜æ¡£æ•°æ®æ—¶æ‰§è¡Œä¸€æ¬¡ï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => { ncInitialize(gameProcess); });"}]},"buildingModelIdList":["model-2n9bjf","model-3wnnjy","model-ehe7pw","model-znitr4","model-4koimf"],"uiTemplates":[],"modifierTemplates":[{"id":"mod-98zups","name":"åœ°äº§å½’å±å¤–è§‚","slug":"ncownershipvisual","descriptor":{"timing":"after","commandType":"property.owner.change","remainingTriggers":-1,"priority":100,"autoConsume":false,"meta":{"name":"åœ°äº§å½’å±å¤–è§‚","description":"äº§æƒå˜æ›´åï¼Œåœ¨å¹¿æ’­å‰åˆ‡æ¢å¾…å”®ç‰Œå’Œè§’è‰²ä»£è¡¨ç‰©ã€‚","tags":["nc-ownership-visual"]}},"effectCode":"((property: any, gameProcess: any, cmd: any, ctx: any) => {\n const original=property.getOriginalData();\n const visual=original.exportData && original.exportData.ncVisuals;\n if(!visual || !original.buildingModelIdList)return;\n if(!property.owner){property.buildingModelIdList=original.buildingModelIdList.map(()=>visual.sale);return;}\n const token=visual.roles[property.owner.roleId] || visual.fallback;\n property.buildingModelIdList=[token,...original.buildingModelIdList.slice(1)];\n})\n"}],"customUIs":[],"gameSettingForm":[{"id":"gs-2z12y1","key":"inflationPeriod","type":"number-input","label":"é€šèƒ€å‘¨æœŸï¼ˆå®Œæ•´è½®æ¬¡ï¼‰","defaultValue":5,"min":1,"max":50},{"id":"gs-5w7ibw","key":"groupRentBonus","type":"number-input","label":"è¡—åŒºé˜¶æ¢¯ç§Ÿé‡‘æœ€é«˜åŠ æˆï¼ˆ%ï¼Œå„æ¡£åŒæ¯”ç¼©æ”¾ï¼‰","defaultValue":25,"min":0,"max":100},{"id":"gs-65yp1t","key":"stockDividendPeriod","type":"number-input","label":"è‚¡ç¥¨åˆ†çº¢å‘¨æœŸï¼ˆå®Œæ•´è½®æ¬¡ï¼‰","defaultValue":5,"min":1,"max":50},{"id":"gs-9aplrg","key":"stockVolatility","type":"number-input","label":"è‚¡ç¥¨å•è½®åŸºç¡€æ³¢åŠ¨ä¸Šé™ï¼ˆ%ï¼‰","defaultValue":12,"min":0,"max":30},{"id":"gs-9b4nst","key":"inflationEnabled","type":"select","label":"é€šè´§è†¨èƒ€","defaultValue":"on","options":[{"label":"å¼€å¯","value":"on"},{"label":"å…³é—­","value":"off"}]},{"id":"gs-9mfgej","key":"noticeLevel","type":"select","label":"æ¶ˆæ¯æ•°é‡","defaultValue":"important","options":[{"label":"ç²¾ç®€ï¼ˆä¿ç•™å…³é”®é€šçŸ¥ï¼‰","value":"important"},{"label":"è¯¦ç»†ï¼ˆæ˜¾ç¤ºæ‰€æœ‰ç»è¥é€šçŸ¥ï¼‰","value":"detailed"}]},{"id":"gs-amg3l4","key":"rentRounding","type":"number-input","label":"è¿‡è·¯è´¹å–æ•´å•ä½ï¼ˆ1=æ•´æ•°ï¼Œ10=æ•´åï¼Œ100=æ•´ç™¾ï¼‰","defaultValue":10,"min":1,"max":1000},{"id":"gs-ap642w","key":"turnTimeout","type":"number-input","label":"æ“ä½œç­‰å¾…æ—¶é—´ï¼ˆç§’ï¼Œå«æ·éª°ä¸äº¤æ˜“ï¼‰","defaultValue":120,"min":15,"max":600,"builtIn":true},{"id":"gs-b79v3e","key":"initMoney","type":"number-input","label":"åˆå§‹ç°é‡‘ï¼ˆç»æµåŸºå‡†ï¼‰","defaultValue":20000,"builtIn":true,"min":1000,"max":1000000},{"id":"gs-cktyq2","key":"stockEnabled","type":"select","label":"è‚¡ç¥¨å¸‚åœº","defaultValue":"on","options":[{"label":"å¼€å¯","value":"on"},{"label":"å…³é—­","value":"off"}]},{"id":"gs-iw19vj","key":"chanceTimeout","type":"number-input","label":"æœºä¼šå¡é˜…è¯»ç¡®è®¤æ—¶é—´ï¼ˆç§’ï¼Œè¶…æ—¶è‡ªåŠ¨æ‰§è¡Œï¼‰","defaultValue":120,"min":15,"max":600},{"id":"gs-ld0w3n","key":"stockDividend","type":"number-input","label":"è‚¡ç¥¨åˆ†çº¢ç‡ï¼ˆå¸‚å€¼%ï¼‰","defaultValue":2,"min":0,"max":10},{"id":"gs-o4mhmk","key":"propertyTimeout","type":"number-input","label":"ä¹°åœ°ï¼å‡çº§ç¡®è®¤æ—¶é—´ï¼ˆç§’ï¼‰","defaultValue":120,"min":15,"max":600},{"id":"gs-ol7ur1","key":"stockExposure","type":"number-input","label":"è‚¡ç¥¨æŒä»“å¸‚å€¼ä¸Šé™ï¼ˆåˆå§‹ç°é‡‘%ï¼‰","defaultValue":50,"min":0,"max":100},{"id":"gs-plg3ot","key":"stockFee","type":"number-input","label":"è‚¡ç¥¨äº¤æ˜“æ‰‹ç»­è´¹ï¼ˆ%ï¼‰","defaultValue":1,"min":0,"max":5},{"id":"gs-xngcle","key":"inflationPercent","type":"number-input","label":"æ¯æ¬¡é€šèƒ€æ¶¨å¹…ï¼ˆ%ï¼‰","defaultValue":10,"min":0,"max":50}],"extraLibs":"const ncOwnershipTemplate: ModifierTemplate = {\"id\": \"mod-98zups\", \"name\": \"åœ°äº§å½’å±å¤–è§‚\", \"slug\": \"ncownershipvisual\", \"descriptor\": {\"timing\": \"after\", \"commandType\": \"property.owner.change\", \"remainingTriggers\": -1, \"priority\": 100, \"autoConsume\": false, \"meta\": {\"name\": \"åœ°äº§å½’å±å¤–è§‚\", \"description\": \"äº§æƒå˜æ›´åï¼Œåœ¨å¹¿æ’­å‰åˆ‡æ¢å¾…å”®ç‰Œå’Œè§’è‰²ä»£è¡¨ç‰©ã€‚\", \"tags\": [\"nc-ownership-visual\"]}}, \"effectCode\": \"((property, gameProcess, cmd, ctx) => {\\n const original=property.getOriginalData();\\n const visual=original.exportData && original.exportData.ncVisuals;\\n if(!visual || !original.buildingModelIdList)return;\\n if(!property.owner){property.buildingModelIdList=original.buildingModelIdList.map(()=>visual.sale);return;}\\n const token=visual.roles[property.owner.roleId] || visual.fallback;\\n property.buildingModelIdList=[token,...original.buildingModelIdList.slice(1)];\\n})\\n\"};\n// Shared helpers for the neon city. Included in every script by the game compiler.\ninterface NcBuildTurn { playerId: string; round: number; built: boolean; building?: boolean; }\ninterface NcState { completedRounds: number; multiplier: number; eliminated: string[]; buildTurn?: NcBuildTurn; }\ninterface NcPropertyData { ncGroup?: string; ncGroupSize?: number; ncVisuals?: {sale:string;roles:Record<string,string>;fallback:string}; }\nfunction ncNumber(gp: IGameProcess, key: string, fallback: number): number {\n  const value = Number(gp.gameSetting[key]?.value);\n  return Number.isFinite(value) ? value : fallback;\n}\nfunction ncState(gp: IGameProcess): NcState {\n  if (!gp.customData.neonCity) gp.customData.neonCity = {completedRounds: 0, multiplier: 1, eliminated: []};\n  return gp.customData.neonCity as NcState;\n}\nfunction ncScale(gp: IGameProcess): number { return Math.max(1000, ncNumber(gp, 'initMoney', 20000)) / 20000; }\nfunction ncMoney(gp: IGameProcess, base: number): number {\n  return Math.max(0, Math.round(base * ncScale(gp) * ncState(gp).multiplier));\n}\nfunction ncTimeout(gp: IGameProcess, key: string): number { return Math.max(15,Math.min(600,ncNumber(gp,key,120)))*1000; }\nfunction ncDetailed(gp: IGameProcess): boolean {return String(gp.gameSetting.noticeLevel?.value??'important')==='detailed';}\nfunction ncRent(gp: IGameProcess, base: number, bonus: number): number {\n  const unit=Math.max(1,Math.round(ncNumber(gp,'rentRounding',10)));\n  return base<=0?0:Math.max(unit,Math.round(base*ncScale(gp)*ncState(gp).multiplier*bonus/unit)*unit);\n}\nfunction ncGroup(property: IProperty): string {\n  return ((property.getOriginalData() as unknown as {exportData?: NcPropertyData}).exportData?.ncGroup) || '';\n}\nfunction ncVisual(property: IProperty): void {\n  const original=property.getOriginalData();\n  const visual=(original as unknown as {exportData?:NcPropertyData}).exportData?.ncVisuals;\n  if(!visual || !original.buildingModelIdList?.length)return;\n  const next=property.owner?[visual.roles[property.owner.roleId]||visual.fallback,...original.buildingModelIdList.slice(1)]:original.buildingModelIdList.map(()=>visual.sale);\n  if(!property.buildingModelIdList || next.some((id,i)=>property.buildingModelIdList?.[i]!==id))property.buildingModelIdList=next;\n}\nfunction ncOwn(gp: IGameProcess, player: IPlayer): IProperty[] {\n  return Array.from(gp.properties.values()).filter(p => p.owner?.id === player.id);\n}\nfunction ncGroups(gp: IGameProcess, player: IPlayer): number {\n  const groups = new Map<string, IProperty[]>();\n  for (const p of gp.properties.values()) { const g = ncGroup(p); if(g) groups.set(g, [...(groups.get(g) || []),p]); }\n  return Array.from(groups.values()).filter(ps => ps.every(p => p.owner?.id === player.id)).length;\n}\nfunction ncGroupBonus(gp: IGameProcess, total: number, owned: number): number {\n  if(owned<1 || total<1) return 0;\n  const cap=Math.max(0,ncNumber(gp,'groupRentBonus',25));\n  if(owned>=total) return cap/100;\n  if(owned<2) return 0;\n  const steps:Record<number,number[]>={3:[0,0,15,25],4:[0,0,10,15,25],5:[0,0,5,10,15,25]};\n  const percent=steps[total]?.[owned] ?? 25*(owned-1)/(total-1);\n  return percent/25*cap/100;\n}\nfunction ncBeginTurn(gp: IGameProcess, player: IPlayer): void {\n  ncState(gp).buildTurn={playerId:player.id,round:gp.currentRound,built:false};\n}\nfunction ncBuildTurn(gp: IGameProcess, player: IPlayer): NcBuildTurn {\n  const state=ncState(gp);\n  if(!state.buildTurn || state.buildTurn.playerId!==player.id || state.buildTurn.round!==gp.currentRound)ncBeginTurn(gp,player);\n  return state.buildTurn!;\n}\nfunction ncCanBuild(gp: IGameProcess, player: IPlayer): boolean {\n  if(player.isBankrupted || gp.currentRoundPlayer?.id!==player.id)return false;\n  const turn=ncBuildTurn(gp,player);return !turn.built && !turn.building;\n}\nfunction ncSync(gp: IGameProcess): void {\n  const groups = new Map<string, IProperty[]>();\n  for(const p of gp.properties.values()) { const group=ncGroup(p); if(group) groups.set(group,[...(groups.get(group)||[]),p]); }\n  for(const p of gp.properties.values()) {\n    ncVisual(p);\n    const original=p.getOriginalData();\n    const set=groups.get(ncGroup(p));\n    const owned=p.owner && set ? set.filter(q=>q.owner?.id===p.owner?.id).length : 0;\n    const bonus=p.owner && set ? ncGroupBonus(gp,set.length,owned) : 0;\n    p.sellCost=ncMoney(gp,original.sellCost);\n    p.buildCost=ncMoney(gp,original.buildCost);\n    p.costList=original.costList.map(n=>ncRent(gp,n,1+bonus));\n  }\n}\nasync function ncCash(gp: IGameProcess, player: IPlayer, base: number, title: string): Promise<void> {\n  if(player.isBankrupted) return;\n  const money=ncMoney(gp,Math.abs(base));\n  if(base>=0) await player.gain(money,'neon_card'); else if(money>0) {await nsLiquidate(gp,player,money);await player.cost(money,'neon_tax');}\n  if(ncDetailed(gp))gp.messageNotify([player.id],{type:base>=0?'success':'warning',content:`${title}ï¼š${base>=0?'æ”¶å…¥':'æ”¯å‡º'} ${money}ï¼Œä½™é¢ ${player.money}`});\n  ncSync(gp); nsSync(gp); gp.gameDataBroadcast();\n}\nasync function ncConfirm(gp: IGameProcess, player: IPlayer, property: IProperty, buy: boolean): Promise<void> {\n  if(player.isBankrupted) return;\n  if(!buy && (!ncCanBuild(gp,player) || property.owner?.id!==player.id || property.level>=property.maxLevel))return;\n  ncSync(gp);\n  const price=buy?property.sellCost:property.buildCost;\n  if(player.money<=price) {gp.messageNotify([player.id],{type:'warning',content:`${property.name}éœ€è¦ ${price}ï¼Œè¯·ä¿ç•™ç°é‡‘é¿å…ç ´äº§ã€‚`});return;}\n  const turn=buy?undefined:ncBuildTurn(gp,player);const oldLevel=property.level;let attemptedBuild=false;\n  if(turn)turn.building=true;\n  try {\n  const result=await gp.showConfirmDialog(player.id,{title:`${buy?'è´­ä¹°':'å‡çº§'} ${property.name}`,content:`${buy?'è´­ä¹°ä»·':'æœ¬æ¬¡å»ºé€ è´¹'} ${price}ã€‚å½“å‰ä½™é¢ ${player.money}ã€‚\\n${buy?'ä¹°ä¸‹å³å¯ç‹¬ç«‹ç›–æˆ¿ï¼›æ¯å›åˆæœ€å¤šä»˜è´¹å»ºé€ ä¸€æ¬¡ã€‚':`å‡çº§è‡³ ${property.level+1} çº§ï¼Œå°†ä½¿ç”¨æœ¬å›åˆå”¯ä¸€å»ºé€ æœºä¼šã€‚`}\\nè¿‡è·¯è´¹ï¼ˆ0â€“4çº§ï¼‰ï¼š${property.costList.join(' / ')}ã€‚\\nåŒç»„æŒåœ°è¶Šå¤šï¼Œç§Ÿé‡‘åŠ æˆè¶Šé«˜ï¼›é›†é½åŠ æˆæœ€é«˜ï¼Œä¸å‘ç°é‡‘ã€‚`,confirmText:buy?'è´­ä¹°':'ç›–æˆ¿',cancelText:'ä¿ç•™ç°é‡‘'},{timeout:ncTimeout(gp,'propertyTimeout')});\n  if(!result.confirm || player.isBankrupted || player.money<=price) return;\n  if(buy) {\n    if(property.owner) return;\n    await gp.handlePlayerBuyProperty(player,property);\n  } else {\n    if(gp.currentRoundPlayer?.id!==player.id || ncState(gp).buildTurn!==turn || turn?.built || property.owner?.id!==player.id || property.level!==oldLevel || property.level>=property.maxLevel) return;\n    attemptedBuild=true;\n    await gp.handlePlayerBuildUp(player,property);\n  }\n  } finally {\n    if(turn){if(attemptedBuild && property.level>oldLevel)turn.built=true;turn.building=false;}\n  }\n  ncSync(gp);nsSync(gp);gp.gameDataBroadcast();\n}\nasync function ncArrive(gp: IGameProcess, property: IProperty, player: IPlayer): Promise<void> {\n  if(player.isBankrupted) return;\n  ncSync(gp);\n  const owner=property.owner;\n  if(!owner) {await ncConfirm(gp,player,property,true);return;}\n  if(owner.id===player.id) {\n    if(property.level<property.maxLevel && ncCanBuild(gp,player)) await ncConfirm(gp,player,property,false);\n    return;\n  }\n  const rent=property.costList[property.level] || 0;\n  await nsLiquidate(gp,player,rent);\n  const paid=await player.cost(rent,'neon_rent',owner);\n  if(paid.actualCost>0) await owner.gain(paid.actualCost,'neon_rent',player);\n  if(ncDetailed(gp))gp.msgNotifyBroadcast('info',`${player.name}åœ¨ ${property.name} æ”¯ä»˜ ${paid.actualCost} ç»™ ${owner.name}`);\n  ncSync(gp);nsSync(gp);gp.gameDataBroadcast();\n}\nfunction ncAttach(gp: IGameProcess): void {\n  for(const property of gp.properties.values()) {\n    if(!ncGroup(property)) continue;\n    const visual=(property.getOriginalData() as unknown as {exportData?:NcPropertyData}).exportData?.ncVisuals;\n    if(visual && !property.modifierManager.getModifiersList().some(m=>m.descriptor.meta?.tags?.includes('nc-ownership-visual')))property.modifierManager.add(ncOwnershipTemplate);\n    property.commandBus.setHandler('property.arrived',async payload=>{await ncArrive(gp,property,payload.arrivedPlayer);return payload;});\n  }\n}\nasync function ncBuild(gp: IGameProcess, player: IPlayer): Promise<void> {\n  if(player.isBankrupted || gp.currentRoundPlayer?.id!==player.id) return;\n  if(!ncCanBuild(gp,player)){gp.messageNotify([player.id],{type:'info',content:'æœ¬å›åˆæœ€å¤šä»˜è´¹å»ºé€ ä¸€æ¬¡ï¼Œè¯·ä¸‹å›åˆå†ç›–æˆ¿ã€‚'});return;}\n  ncSync(gp);\n  const own=ncOwn(gp,player).filter(p=>p.level<p.maxLevel && player.money>p.buildCost);\n  if(!own.length) {gp.messageNotify([player.id],{type:'info',content:'æ²¡æœ‰å¯å»ºé€ çš„åœ°äº§ï¼Œæˆ–èµ„é‡‘ä¸è¶³ã€‚'});return;}\n  const result=await gp.showItemSelectDialog(player.id,{title:'é€‰æ‹©è¦ç›–æˆ¿çš„åœ°äº§',itemList:own.map(p=>({id:p.id,display:`${p.name} Â· ${p.level}â†’${p.level+1}çº§ Â· ${p.buildCost}`})),cancelText:'è¿”å›',multiple:false});\n  const property=own.find(p=>p.id===result.selected?.[0]);\n  if(property && gp.currentRoundPlayer?.id===player.id) await ncConfirm(gp,player,property,false);\n}\nasync function ncFreeUpgrade(gp: IGameProcess,player: IPlayer,count: number,choose: boolean): Promise<void> {\n  const available=ncOwn(gp,player).filter(p=>p.level<p.maxLevel);\n  if(!available.length) {await ncCash(gp,player,500,'æ— å¯å‡çº§åœ°äº§ï¼Œé¢†å–è£…ä¿®è¡¥è´´');return;}\n  let chosen:IProperty[]=[];\n  if(choose) {\n    const result=await gp.showItemSelectDialog(player.id,{title:'é€‰æ‹©å…è´¹è£…ä¿®åœ°äº§',itemList:available.map(p=>({id:p.id,display:`${p.name}ï¼š${p.level}â†’${p.level+1}çº§`})),multiple:false});\n    const p=available.find(p=>p.id===result.selected?.[0]);\n    chosen=p?[p]:[available[0]];\n  } else {\n    const pool=[...available];\n    while(chosen.length<count && pool.length)chosen.push(pool.splice(Math.floor(Math.random()*pool.length),1)[0]);\n  }\n  for(const p of chosen)if(p.owner?.id===player.id && p.level<p.maxLevel)await p.levelUp();\n  if(ncDetailed(gp))gp.messageNotify([player.id],{type:'success',content:`å…è´¹å‡çº§ï¼š${chosen.map(p=>p.name).join('ã€')}`});\n  ncSync(gp);nsSync(gp);gp.gameDataBroadcast();\n}\nasync function ncDowngrade(gp: IGameProcess,player: IPlayer): Promise<void> {\n  const pool=ncOwn(gp,player).filter(p=>p.level>0);\n  if(!pool.length){gp.messageNotify([player.id],{type:'info',content:'æ²¡æœ‰å·²å»ºæˆ¿å±‹ï¼Œæœ¬æ¬¡æ— éœ€å¤„ç†ã€‚'});return;}\n  const p=pool[Math.floor(Math.random()*pool.length)];await p.levelDown();\n  gp.messageNotify([player.id],{type:'warning',content:`${p.name}è®¾æ–½è€åŒ–ï¼Œé™ä¸º ${p.level} çº§ã€‚`});gp.gameDataBroadcast();\n}\nasync function ncDraw(gp: IGameProcess,player: IPlayer): Promise<void> {\n  const cards=Array.from(gp.chanceCardInfos.values());\n  if(!cards.length) return;\n  const info=cards[Math.floor(Math.random()*cards.length)];\n  await gp.showConfirmDialog(player.id,{title:`æœºä¼šå¡ Â· ${info.name}`,content:`${info.description}\\n\\né‡‘é¢ä¼šæŒ‰åˆå§‹ç°é‡‘å’Œé€šèƒ€è°ƒæ•´ã€‚ç‚¹å‡»åæ‰§è¡Œæœ¬æ¬¡æ•ˆæœã€‚å…³é—­çª—å£ä¹Ÿè§†ä¸ºå·²è¯»ï¼›ç­‰å¾…è¶…æ—¶åè‡ªåŠ¨æ‰§è¡Œï¼Œä¸èƒ½è·³è¿‡ä¸åˆ©æ•ˆæœã€‚`,confirmText:'ç¡®å®šå¹¶æ‰§è¡Œ',cancelText:'å·²è¯»å¹¶ç»§ç»­'},{timeout:ncTimeout(gp,'chanceTimeout'),defaultValue:{id:player.id,confirm:true}});\n  if(player.isBankrupted)return;\n  if(ncDetailed(gp))gp.msgNotifyBroadcast('info',`${player.name}æŠ½åˆ°ã€Œ${info.name}ã€`);\n  await gp.createNewChanceCard(info.id).use(player,player,gp);\n  ncSync(gp);nsSync(gp);gp.gameDataBroadcast();\n}\nfunction ncEliminations(gp: IGameProcess): void {\n  const state=ncState(gp);\n  for(const p of gp.players.values())if(p.isBankrupted&&!state.eliminated.includes(p.id))state.eliminated.push(p.id);\n}\nfunction ncInitialize(gp: IGameProcess): void {\n  const turn=ncState(gp).buildTurn;if(turn)turn.building=false;\n  ncState(gp);ncAttach(gp);ncSync(gp);nsInitialize(gp);gp.gameDataBroadcast();\n}\nfunction ncRoundEnd(gp: IGameProcess): void {\n  const state=ncState(gp);state.completedRounds+=1;\n  const period=Math.max(1,Math.floor(ncNumber(gp,'inflationPeriod',5)));\n  const enabled=String(gp.gameSetting.inflationEnabled?.value ?? 'on')==='on';\n  const percent=Math.max(0,ncNumber(gp,'inflationPercent',10))/100;\n  const old=state.multiplier;\n  if(enabled && state.completedRounds%period===0) state.multiplier*=1+percent;\n  ncEliminations(gp);ncSync(gp);gp.currentRound+=1;\n  if(state.multiplier!==old)gp.msgNotifyBroadcast('info',`ç¬¬ ${state.completedRounds} è½®ç»“æŸï¼Œé€šèƒ€ç´¯è®¡å€ç‡ ${state.multiplier.toFixed(2)}ã€‚å”®ä»·ã€å»ºé€ è´¹ã€ç§Ÿé‡‘åŠç°é‡‘å¥–åŠ±åŒæ­¥è°ƒæ•´ã€‚`);\n  gp.gameDataBroadcast();\n}\n\n// Stock gameplay inspired by the repository's cash-reserve and speculative AI hints.\ninterface NsLot {shares:number;cost:number;realized:number;dividends:number;}\ninterface NsQuote {id:string;name:string;group:string;base:number;risk:number;index:number;change:number;history:{round:number;price:number}[];}\ninterface NsState {version:number;round:number;news:string;quotes:NsQuote[];holdings:Record<string,Record<string,NsLot>>;turns:Record<string,{round:number;actions:number}>;}\nfunction nsIsAI(player:IPlayer):boolean {return !!(player as unknown as {isAI?:boolean}).isAI;}\nfunction nsEnabled(gp:IGameProcess):boolean {return String(gp.gameSetting.stockEnabled?.value??'on')==='on';}\nfunction nsState(gp:IGameProcess):NsState {\n const groups=['å¤œå¸‚è€è¡—','ç¾é£Ÿè¡—','æ½®æµæ­¥è¡Œè¡—','å¨±ä¹è¡—','æ–‡åˆ›è¡—','æ»¨æ°´å•†åœˆ','ç²¾å“è´­ç‰©åŒº','CBDæ ¸å¿ƒåŒº','æ•°ç å•†è¡—','ç©ºæ¸¯å•†åŠ¡åŒº'];\n const bases=[100,120,160,180,200,240,300,400,220,320],risks=[.7,.75,1,1.2,.8,.85,.9,1.1,1.15,.9];\n const quote=(group:string,i:number):NsQuote=>({id:'NC'+(i+1),name:group,group,base:bases[i],risk:risks[i],index:1,change:0,history:[{round:ncState(gp).completedRounds,price:ncMoney(gp,bases[i])}]});\n if(!gp.customData.neonStocks) {\n  gp.customData.neonStocks={version:2,round:ncState(gp).completedRounds,news:'åŸå¸‚äº¤æ˜“æ‰€å¼€å¸‚',quotes:groups.map(quote),holdings:{},turns:{}};\n }\n const state=gp.customData.neonStocks as NsState;\n if(state.version<2) {\n  // Keep existing IDs, prices, histories and portfolios when loading an eight-stock save.\n  groups.forEach((group,i)=>{const current=state.quotes.find(q=>q.id==='NC'+(i+1));if(current){current.name=group;current.group=group;}else state.quotes.push(quote(group,i));});\n  state.version=2;\n }\n return state;\n}\nfunction nsPrice(gp:IGameProcess,q:NsQuote):number {return Math.max(1,Math.round(ncMoney(gp,q.base)*q.index));}\nfunction nsLot(gp:IGameProcess,player:IPlayer,id:string):NsLot {\n const state=nsState(gp);if(!state.holdings[player.id])state.holdings[player.id]={};\n return state.holdings[player.id][id]||(state.holdings[player.id][id]={shares:0,cost:0,realized:0,dividends:0});\n}\nfunction nsValue(gp:IGameProcess,player:IPlayer):number {return nsState(gp).quotes.reduce((sum,q)=>sum+nsLot(gp,player,q.id).shares*nsPrice(gp,q),0);}\nfunction nsFee(gp:IGameProcess,amount:number):number {return Math.ceil(amount*Math.max(0,Math.min(5,ncNumber(gp,'stockFee',1)))/100);}\nfunction nsReserve(gp:IGameProcess):number {return Math.max(1,Math.round(Math.max(1000,ncNumber(gp,'initMoney',20000))*.2));}\nfunction nsTurn(gp:IGameProcess,player:IPlayer):{round:number;actions:number} {\n const s=nsState(gp),r=ncState(gp).completedRounds;\n if(!s.turns[player.id]||s.turns[player.id].round!==r)s.turns[player.id]={round:r,actions:0};return s.turns[player.id];\n}\nfunction nsMaxBuy(gp:IGameProcess,player:IPlayer,q:NsQuote):number {\n const price=nsPrice(gp,q),initial=Math.max(1000,ncNumber(gp,'initMoney',20000));\n const cap=initial*Math.max(0,Math.min(100,ncNumber(gp,'stockExposure',50)))/100;\n const funds=Math.max(0,Math.min(player.money-nsReserve(gp),cap-nsValue(gp,player)));\n let n=Math.floor(funds/(price*(1+Math.max(0,Math.min(5,ncNumber(gp,'stockFee',1)))/100)));\n while(n>0&&n*price+nsFee(gp,n*price)>funds)n--;return Math.max(0,Math.min(100000,n));\n}\nfunction nsSync(gp:IGameProcess):void {\n const exports=gp.exportData as unknown as Record<string,unknown>;\n if(!nsEnabled(gp)){delete exports.stockMarket;return;}\n const s=nsState(gp);\n exports.stockMarket={round:s.round,news:s.news,feePercent:ncNumber(gp,'stockFee',1),cashReserve:nsReserve(gp),maxExposurePercent:ncNumber(gp,'stockExposure',50),quotes:s.quotes.map(q=>({id:q.id,name:q.name,group:q.group,price:nsPrice(gp,q),changePercent:q.change,risk:q.risk,history:q.history.map(h=>({...h}))})),portfolios:Array.from(gp.players.values()).map(p=>({playerId:p.id,value:nsValue(gp,p),positions:s.quotes.map(q=>({stockId:q.id,...nsLot(gp,p,q.id)}))}))};\n for(const p of gp.players.values()){const info=p as unknown as {exportData?:Record<string,unknown>};if(!info.exportData)info.exportData={};info.exportData.neonStocks={value:nsValue(gp,p),positions:s.quotes.filter(q=>nsLot(gp,p,q.id).shares>0).map(q=>({id:q.id,name:q.name,price:nsPrice(gp,q),...nsLot(gp,p,q.id)}))};}\n}\nasync function nsTrade(gp:IGameProcess,player:IPlayer,id:string,side:string,shares:number,automatic=false):Promise<boolean> {\n if(!nsEnabled(gp)||player.isBankrupted||(!automatic&&gp.currentRoundPlayer?.id!==player.id))return false;\n if(!Number.isSafeInteger(shares)||shares<=0||shares>100000||!['buy','sell'].includes(side))return false;\n const q=nsState(gp).quotes.find(q=>q.id===id);if(!q)return false;\n const turn=nsTurn(gp,player);if(!automatic&&turn.actions>=3)return false;\n const lot=nsLot(gp,player,id),value=shares*nsPrice(gp,q),fee=nsFee(gp,value);\n if(side==='buy') {\n  if(automatic||shares>nsMaxBuy(gp,player,q)||player.money<=value+fee)return false;\n  const paid=await player.cost(value+fee,'neon_stock_buy');\n  if(!paid.success||paid.actualCost!==value+fee)return false;\n  lot.shares+=shares;lot.cost+=value+fee;\n } else {\n  if(shares>lot.shares)return false;\n  const cost=lot.cost*shares/lot.shares;lot.shares-=shares;lot.cost=lot.shares===0?0:lot.cost-cost;\n  lot.realized+=value-fee-cost;await player.gain(value-fee,'neon_stock_sell');\n }\n if(!automatic)turn.actions++;\n gp.messageNotify([player.id],{type:'info',content:`${automatic?'åº”æ€¥å˜ç° Â· ':''}${side==='buy'?'ä¹°å…¥':'å–å‡º'} ${q.name} ${shares}è‚¡ï¼Œ${side==='buy'?'æ”¯å‡º':'æ”¶å…¥'} ${side==='buy'?value+fee:value-fee}ï¼ˆæ‰‹ç»­è´¹ ${fee}ï¼‰`});\n nsSync(gp);gp.gameDataBroadcast();return true;\n}\nasync function nsLiquidate(gp:IGameProcess,player:IPlayer,expense:number):Promise<void> {\n if(!nsEnabled(gp)||player.isBankrupted||player.money>expense)return;\n for(const q of [...nsState(gp).quotes].sort((a,b)=>b.risk-a.risk)) {\n  const lot=nsLot(gp,player,q.id);if(!lot.shares)continue;\n  // Raise enough to preserve at least one unit of cash after compulsory payment.\n  const need=expense+1-player.money,price=nsPrice(gp,q);\n  let n=Math.min(lot.shares,Math.max(1,Math.ceil(need/(price*(1-Math.max(0,Math.min(5,ncNumber(gp,'stockFee',1)))/100)))));\n  while(n<lot.shares&&n*price-nsFee(gp,n*price)<need)n++;\n  await nsTrade(gp,player,q.id,'sell',n,true);if(player.money>expense)break;\n }\n}\nasync function nsRoundEnd(gp:IGameProcess):Promise<void> {\n if(!nsEnabled(gp))return;const s=nsState(gp),round=ncState(gp).completedRounds;if(s.round>=round)return;\n const vol=Math.max(0,Math.min(30,ncNumber(gp,'stockVolatility',12)))/100;\n const newsQuote=Math.random()<.35?s.quotes[Math.floor(Math.random()*s.quotes.length)]:undefined;\n const newsSign=Math.random()<.5?-1:1;\n s.news=newsQuote?`${newsQuote.group}${newsSign>0?'å®¢æµå‡æ¸©ï¼Œè¡Œä¸šåˆ©å¥½':'çŸ­æœŸå®¢æµé™æ¸©ï¼Œè¡Œä¸šæ‰¿å‹'}`:'åŸå¸‚å¸‚åœºå¹³ç¨³è¿è¡Œï¼Œå„è¡Œä¸šç‹¬ç«‹æ³¢åŠ¨';\n for(const q of s.quotes) {\n  const ps=Array.from(gp.properties.values()).filter(p=>ncGroup(p)===q.group),levels=ps.reduce((sum,p)=>sum+p.level,0);\n  const fair=1+(ps.length?levels/(ps.length*4)*.3:0);\n  const drift=(fair/q.index-1)*.06;\n  const shock=q===newsQuote?newsSign*.04:0;\n  const delta=Math.max(-vol,Math.min(vol,(Math.random()*2-1)*vol*q.risk+drift+shock));\n  const oldPrice=q.history[q.history.length-1]?.price||nsPrice(gp,q);\n  q.index=Math.max(.25,Math.min(4,q.index*(1+delta)));\n  const price=nsPrice(gp,q);q.change=Math.round((price/oldPrice-1)*10000)/100;\n  q.history.push({round,price});if(q.history.length>20)q.history.shift();\n }\n s.round=round;\n const period=Math.max(1,Ma