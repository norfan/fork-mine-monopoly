,"x":0,"y":1,"rotation":0,"type":{"id":"map-item-type-v6ypsf","name":"Е°╟Г ╝-Ф╥╠Х⌠²","modelId":"model-6hp4wf","color":"#EDE6D6","size":1},"linkto":"mi-942ih4"},{"id":"mi-tlsanm","x":3,"y":0,"rotation":0,"type":{"id":"map-item-type-3v6pml","name":"Е°╟Г ╝-Фё∙","modelId":"model-yzt0iu","color":"#EDE6D6","size":1},"linkto":"mi-3uzpfz"},{"id":"mi-umnviw","x":9,"y":-1,"rotation":0,"type":{"id":"map-item-type-wuks4c","name":"Е°╟Е²≈-Г╖▒Е╜╕И≥╒","modelId":"model-ze47qm","color":"#263238","size":1},"beLinked":"mi-rr441o","property":{"id":"prop-d8cvme","name":"Г═■Г╘╤Ф┴─","sellCost":250,"buildCost":150,"level":0,"maxLevel":1,"costList":[30,90],"buildingModelIdList":["model-5pt3qy","model-o913z0"],"exportData":{},"custom":{"effectCode":"((property: IProperty, gameProcess: IGameProcess) => {\n  // Е°╟Г ╝Е█║Г┴┤Д╦┼Ф≤╬Г╓╨Г └Х┐╫Е┼⌡Х╞╢Ф≤▌О╪┬Г╪√Х╬▒Е≥╗Е▐╙Х┐╫Е├≥Е⌡╨Е╝ Ф▐▐Х©╟О╪▄Х©≥И┤▄Е°╗Е╪─Е╠─Ф≈╤Х╕├Г⌡√О╪┴\n  property.custom = { effectCode: \"\", description: \"Ц─░Г═■Г╘╤Ф┬░Ф·°Ц─▒Е°╟Д╦╩Ф╞▐Ф╛║Г╩▐Х©┤Ф┬√Е│°Е°╗Г═■Г╘╤Ф┴─О╪▄И┐╫Х┐╫Е┘█Х╢╧Ф┼╫Д╦─Е╪═Ф°╨Д╪ Е█║О╪┬Ф▄┴Г╗─Ф°┴Е╨╕Ф┼╫О╪▄Ф┴▀Г┴▄Ф╩║Д╨├Е▐╞Д╩╔Д╦╒Д╦─Е╪═Ф█╒Ф√╟Е█║О╪┴Ц─┌Е┬╚Д╨╨Г╩▐Х©┤Ф╡║Ф°┴Ф∙┬Ф·°Ц─┌\" };\n});","description":"Г═■Г╘╤Ф┴─ Х┤╙Е╝ Д╧┴Ф∙┬Ф·°"}}},{"id":"mi-urj3h0","x":5,"y":10,"rotation":0,"type":{"id":"map-item-type-w385rh","name":"Х╫╕Г╚≥","modelId":"model-zt43x3","color":"#EDE6D6","size":1},"linkto":"mi-en74gy"},{"id":"mi-v38xfa","x":5,"y":-1,"rotation":0,"type":{"id":"map-item-type-hpisg6","name":"Е°╟Е²≈-Х╫╕Г╚≥","modelId":"model-qo2iv4","color":"#455A64","size":1},"beLinked":"mi-b3w82c","property":{"id":"prop-6564lj","name":"Е▄≈Г╚≥","sellCost":200,"buildCost":150,"level":0,"maxLevel":1,"costList":[25,75],"buildingModelIdList":["model-5pt3qy","model-o913z0"],"exportData":{},"custom":{"effectCode":"((property: IProperty, gameProcess: IGameProcess) => {\n  // Е°╟Г ╝Е█║Г┴┤Д╦┼Ф≤╬Г╓╨Г └Х┐╫Е┼⌡Х╞╢Ф≤▌О╪┬Г╪√Х╬▒Е≥╗Е▐╙Х┐╫Е├≥Е⌡╨Е╝ Ф▐▐Х©╟О╪▄Х©≥И┤▄Е°╗Е╪─Е╠─Ф≈╤Х╕├Г⌡√О╪┴\n  property.custom = { effectCode: \"\", description: \"Ц─░И⌠│Х╥╞Г╫▒Ц─▒Х©┤Х╥╞Х╢╧И ▐Е°╟Д╦╩Ф▀╔Ф°┴Г └Х╫╕Г╚≥Ф∙╟И┤▐Г©╩Е─█О╪ 1/2/3/4 Е╨╖ = 1/2/4/8 Е─█Ц─┌Ф╞▐Ф■╤Д╦─Ф╛║Х©┤Х╥╞Х╢╧О╪▄Г▌╞Е÷▌И⌠│Х╥╞Г └Е┘╛Е▐╦Д╩╥Е─╪И┐╫Д╪ Д╦┼Ф╤╗Ц─┌\" };\n});","description":"Е▄≈Г╚≥ Х┤╙Е╝ Д╧┴Ф∙┬Ф·°"}}},{"id":"mi-vi91rw","x":4,"y":0,"rotation":0,"type":{"id":"map-item-type-koy1ig","name":"Г╗▌Е┼║","modelId":"model-h0kyxe","color":"#EDE6D6","size":1},"mapEventId":"event-e0kvz2"},{"id":"mi-vk69ff","x":11,"y":4,"rotation":0,"type":{"id":"map-item-type-6bf493","name":"Е°╟Е²≈-Г╡┴","modelId":"model-rz3nlb","color":"#F06292","size":1},"beLinked":"mi-xukyh9","property":{"id":"prop-s6rq9v","name":"Ф╒┘Ф·≈И│⌠","sellCost":160,"buildCost":100,"level":0,"maxLevel":3,"costList":[12,60,180,500],"buildingModelIdList":["model-5pt3qy","model-o913z0","model-63oh9n","model-rpkrk2"],"exportData":{}}},{"id":"mi-wr3aac","x":10,"y":2,"rotation":0,"type":{"id":"map-item-type-u66zoq","name":"OЕё╚Е╨╥","modelId":"model-mnlt7f","color":"#90A4AE","size":1},"mapEventId":"event-pxc01g"},{"id":"mi-wze2vb","x":4,"y":11,"rotation":0,"type":{"id":"map-item-type-whc87k","name":"Е°╟Е²≈-И╩└","modelId":"model-vcbgc7","color":"#FDD835","size":1},"beLinked":"mi-ljvco8","property":{"id":"prop-2dkqmk","name":"И╩└И┤▒Ф╣╥Е╡╦","sellCost":260,"buildCost":150,"level":0,"maxLevel":3,"costList":[22,110,330,800],"buildingModelIdList":["model-5pt3qy","model-o913z0","model-63oh9n","model-rpkrk2"],"exportData":{}}},{"id":"mi-xglgoi","x":5,"y":8,"rotation":0,"type":{"id":"map-item-type-1tyxxs","name":"Ф°╨Д╪ ","modelId":"model-h0kyxe","color":"#EDE6D6","size":1},"mapEventId":"event-1j2bas"},{"id":"mi-xukyh9","x":10,"y":4,"rotation":0,"type":{"id":"map-item-type-6vgl24","name":"Е°╟Г ╝-Г╡┴","modelId":"model-1sst8u","color":"#EDE6D6","size":1},"linkto":"mi-vk69ff"},{"id":"mi-z4a3kf","x":0,"y":7,"rotation":0,"type":{"id":"map-item-type-xh9vn6","name":"Е▒╫Х©░","modelId":"model-h0kyxe","color":"#EDE6D6","size":1},"mapEventId":"event-ixblh2"}],"chanceCards":[{"id":"card-0380a9","name":"Х╠╧Е╜░И╙╟","type":"ToSelf","description":"Д╦▀Д╦─Ф╛║Ф▌╥И╙╟Ф≈╤О╪▄Ф╞▐И╒≈И╙╟Е╜░И┐╫Ф▌╥Е┤╨ 6","color":"#1E88E5","iconId":"image-xs9jss","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    for (const dice of sourcePlayer.dices) dice.setProphecy(6);\n    gameProcess.msgNotifyBroadcast(\"info\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Х╠╧Е╜░И╙╟Ц─█О╪▄Д╦▀Д╦─Ф╛║Ф▌╥И╙╟Ф╞▐И╒≈И╙╟Е╜░И┐╫Ф≤╞ 6`);\n    gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)} Д╫©Г■╗Ц─▄Х╠╧Е╜░И╙╟Ц─█О╪▄Д╦▀Д╦─Ф╛║Ф▌╥И╙╟Ф╞▐И╒≈И╙╟Е╜░И┐╫Ф≤╞ 6`);\n}));"},{"id":"card-0k480k","name":"Х┌║Г│╬","type":"ToSelf","description":"Ф┴─Ф°┴Х┌║Г╔╗Д╦▀Х╥▄ 25%","color":"#8E24AA","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    for (const id of MM_STOCK_IDS) mmStockMove(gameProcess, id, -0.25);\n    const s = mmStocks(gameProcess);\n    const board = MM_STOCK_IDS.map(id => `${MM_STOCKS[id].name} ${s.prices[id]}О©╔`).join(\"О╪▄\");\n    mmAnnounce(gameProcess, \"error\", `Х┌║Г│╬О╪│Ф┴─Ф°┴Х┌║Г╔╗Д╦▀Х╥▄ 25%О╪ ${board}`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Е╪∙Е▐▒Д╨├Х┌║Г│╬О╪▄Ф┴─Ф°┴Х┌║Г╔╗Д╦▀Х╥▄ 25%О╪ ${board}`);\n}));"},{"id":"card-0rv3c6","name":"Д╩╩Ф└▐И≈╗","type":"ToSelf","description":"Д╩▌Е┬≈Х║╗И┤▄И─┴Д╩╩Ф└▐Д╦─Д╦╙Ф═╪Е╜░Д╪═И─│Х©┤Е▌╩О╪▄Е╧╤Г╩⌠Г╝≈И┌ёИ┤▄Г └Ф∙┬Ф·°О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#8E24AA","iconId":"image-gl8hed","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const here = sourcePlayer.positionMapItemId;\n    const options = mmOrderedPathItems(gameProcess).filter(id => id !== here).map(id => {\n      const { prop } = mmPropertyAt(gameProcess, id);\n      if (!prop) return mmOption(id, gameProcess.getMapItemById(id)?.type.name ?? id, \"Е┼÷Х┐╫Ф═╪\", \"#1E88E5\");\n      if (!prop.owner) return mmOption(id, prop.name, `Ф≈═Д╦╩О╪▄Е°╟Д╩╥ ${prop.sellCost}О©╔`, \"#43A047\");\n      if (prop.owner.id === sourcePlayer.id) return mmOption(id, prop.name, `Д╫═Г └Е°╟Г ╝О╪┬${prop.level} Г╨╖О╪┴`, \"#FB8C00\");\n      return mmOption(id, prop.name, `${prop.owner.name} Г └Е°╟Г ╝О╪▄Х©┤Х╥╞Х╢╧ ${prop.costList[prop.level] ?? 0}О©╔`, \"#E53935\");\n    });\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Д╩╩Ф└▐И≈╗О╪ И─┴Ф▀╘Г⌡╝Г └Е°╟\", \"Ф▄┴Е╓√Е°┬И║╨Е╨▐Ф▌▓Е┬≈О╪▄Ф°─Е░▌Ф≤╞Е╦┌Д╦╜Е©┐Ц─┌Д╪═И─│Е░▌Д╪ Г╩⌠Г╝≈Х░╫Х└ Ф═╪Е╜░Г └Ф∙┬Ф·°Ц─┌\", options, \"Е┘┬Д╦█Г■╗Д╨├\", 4);\n    if (!pick) { await mmRefundCard(gameProcess, sourcePlayer, \"Д╩╩Ф└▐И≈╗\", \"Е▐√Ф╤┬Д╨├Д╪═И─│\"); return; }\n    await sourcePlayer.tpToMapItem(pick);\n    const dest = mmPropertyAt(gameProcess, pick).prop?.name ?? gameProcess.getMapItemById(pick)?.type.name ?? \"Ф÷░Е╓└\";\n    mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Ф▌╗Е╪─Ц─▄Д╩╩Ф└▐И≈╗Ц─█О╪▄Е┤╨Г▌╟Е°╗Д╨├Ц─▄${dest}Ц─█`, `${mmPlayerLink(gameProcess, sourcePlayer)} Ф▌╗Е╪─Д╩╩Ф└▐И≈╗О╪▄Е┤╨Г▌╟Е°╗Д╨├Ц─▄${dest}Ц─█`);\n    await mmHandleArrival(gameProcess, sourcePlayer);\n}));"},{"id":"card-1f2b0c","name":"Е├┘Е╧∙Ф╤┬Ф│╞","type":"ToSelf","description":"Е╬≈Г÷╔Д╦▀Д╦─Х╫╝Е⌠╙Е▐╙Х┌║Г╔╗Д╪ Е╓╖Ф╤╗Г╨╕ 25%О╪▄Е╧╤Е▐╞Д╩╔Е╫⌠Е°╨Ф▄┴Г▌╟Д╩╥Д╧╟Е┘╔","color":"#8E24AA","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const id = MM_STOCK_IDS[Math.floor(Math.random() * MM_STOCK_IDS.length)];\n    const s = mmStocks(gameProcess);\n    s.insider[id] = (s.insider[id] ?? 0) + 0.25;\n    mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Г╔·Г╔·Г╖≤Г╖≤Е°╟Ф┴⌠Д╨├Д╦╙Г■╣Х╞²О╪▄Е╔╫Е┐▐Ф▀©Е┬╟Д╨├Д╩─Д╧┬Е├┘Е╧∙Ф╤┬Ф│╞Б─╕Б─╕`, `${mmPlayerLink(gameProcess, sourcePlayer)} Ф▀©Е┬╟Д╨├Д╦─Ф²║Е├┘Е╧∙Ф╤┬Ф│╞`);\n    await mmTradeStock(gameProcess, sourcePlayer, id, \"Е┘┬Д╦█Д╧╟\",\n      `<b>Е├┘Е╧∙Ф╤┬Ф│╞О╪ Д╦▀Д╦─Х╫╝Е╪─Г⌡≤Ц─▄${MM_STOCKS[id].name}Ц─█Д╪ Е╓╖Ф╤╗Г╨╕ 25%Ц─┌</b>Г▌╟Е°╗Е▐╞Д╩╔Ф▄┴Г▌╟Д╩╥Д╧╟Е┘╔Ц─┌<br>`, true);\n}));"},{"id":"card-1hp3sm","name":"Г┴⌡Е╦┌","type":"ToSelf","description":"Ф┴─Ф°┴Х┌║Г╔╗Д╦┼Ф╤╗ 15%","color":"#8E24AA","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    for (const id of MM_STOCK_IDS) mmStockMove(gameProcess, id, 0.15);\n    const s = mmStocks(gameProcess);\n    const board = MM_STOCK_IDS.map(id => `${MM_STOCKS[id].name} ${s.prices[id]}О©╔`).join(\"О╪▄\");\n    mmAnnounce(gameProcess, \"success\", `Г┴⌡Е╦┌О╪│Ф┴─Ф°┴Х┌║Г╔╗Д╦┼Ф╤╗ 15%О╪ ${board}`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Е╪∙Е▐▒Д╨├Г┴⌡Е╦┌О╪▄Ф┴─Ф°┴Х┌║Г╔╗Д╦┼Ф╤╗ 15%О╪ ${board}`);\n}));"},{"id":"card-22k15o","name":"И─│Х┌║","type":"ToSelf","description":"И─┴Д╦─Е▐╙Х┌║Г╔╗О╪▄Е┘█Х╢╧Х▌╥Е╬≈Г╨╕ 400О©╔ Е╦┌Е─╪Г └Х┌║Д╩╫О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#1E88E5","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const id = await mmChooseStock(gameProcess, sourcePlayer, \"И─│Х┌║О╪ И─┴Д╦─Е▐╙Х┌║Г╔╗\", `Е┘█Х╢╧Х▌╥Е╬≈Г╨╕ ${mmInflate(gameProcess, 400)}О©╔ Е╦┌Е─╪Г └Х┌║Д╩╫Ц─┌`);\n    if (!id) { await mmRefundCard(gameProcess, sourcePlayer, \"И─│Х┌║\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    const price = mmStocks(gameProcess).prices[id];\n    const qty = Math.max(1, Math.round(mmInflate(gameProcess, 400) / price));\n    mmSetHolding(gameProcess, sourcePlayer, id, mmHolding(gameProcess, sourcePlayer, id) + qty);\n    gameProcess.gameDataBroadcast();\n    mmAnnounce(gameProcess, \"success\", `${sourcePlayer.name} Х▌╥Х╣═ ${qty} Х┌║Ц─▄${MM_STOCKS[id].name}Ц─█О╪┬Е╦┌Е─╪Г╨╕ ${qty * price}О©╔О╪┴`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Х▌╥Х╣═ ${qty} Х┌║ ${MM_STOCKS[id].name}О╪┬Е╦┌Е─╪Г╨╕ ${qty * price}О©╔О╪┴`);\n}));"},{"id":"card-6m1bxn","name":"Е╫╘Г╔╗","type":"ToSelf","description":"Е┬╝Е╪─Г°▀Г°▀О╪ Е▐╞Х┐╫Х╟╒Х╟╒Ф┐═И║╬О╪▄Д╧÷Е▐╞Х┐╫Д╦╜ 50~500","color":"#78909C","iconId":"image-g6v0om","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const prize = mmInflate(gameProcess, [0, 50, 100, 200, 300, 500][Math.floor(Math.random() * 6)]);\n    if (prize === 0) {\n      mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Е┬╝Е╪─Ц─▄Е╫╘Г╔╗Ц─█Б─╕Б─╕Х╟╒Х╟╒Ф┐═И║╬`, `${mmPlayerLink(gameProcess, sourcePlayer)} Е┬╝Е╪─Е╫╘Г╔╗Б─╕Б─╕Х╟╒Х╟╒Ф┐═И║╬`);\n      return;\n    }\n    await sourcePlayer.gain(prize, \"card\");\n    mmAnnounce(gameProcess, \"success\", `${sourcePlayer.name} Е┬╝Е╪─Ц─▄Е╫╘Г╔╗Ц─█О╪▄Д╦╜Д╨├ ${prize}О╪│`, `${mmPlayerLink(gameProcess, sourcePlayer)} Е┬╝Е╪─Е╫╘Г╔╗О╪▄Д╦╜Д╨├ ${prize}О©╔`);\n}));"},{"id":"card-73x198","name":"Е²┤Е╞▄Е█║","type":"ToPlayer","description":"Е▓▄Д╦─Е░█Г▌╘Е╝╤Е╧ЁЕ┬├Д╦╓Д╨╨Г └Г▌╟И┤▒","color":"#8E24AA","iconId":"image-g6v0om","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    if (target.id === sourcePlayer.id) {\n      gameProcess.messageNotify([sourcePlayer.id], { type: \"info\", content: \"Ц─▄Е²┤Е╞▄Е█║Ц─█Е╞╧Х┤╙Е╥╠Г■╗Ф╡║Ф°┴Ф∙┬Ф·°\" });\n      return;\n    }\n    const diff = Math.floor(Math.abs(sourcePlayer.money - target.money) / 2);\n    if (diff <= 0) return;\n    const [rich, poor] = sourcePlayer.money > target.money ? [sourcePlayer, target] : [target, sourcePlayer];\n    const res = await rich.cost(diff, \"card\");\n    await poor.gain(res.actualCost, \"card\");\n    gameProcess.msgNotifyBroadcast(\"info\", `${sourcePlayer.name} Е╞╧ ${target.name} Д╫©Г■╗Ц─▄Е²┤Е╞▄Е█║Ц─█О╪▄${rich.name} Е┬├Г╩≥ ${poor.name} ${res.actualCost}`);\n    gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)} Е╞╧ ${gameProcess.createGameLinkItem(GameLinkItem.Player, target.id)} Д╫©Г■╗Ц─▄Е²┤Е╞▄Е█║Ц─█О╪▄${gameProcess.createGameLinkItem(GameLinkItem.Player, rich.id)} Е┬├Г╩≥ ${gameProcess.createGameLinkItem(GameLinkItem.Player, poor.id)} ${res.actualCost}`);\n}));"},{"id":"card-7q16i7","name":"Х╥▄Е│°Е█║","type":"ToSelf","description":"И─┴Д╦─Е▐╙Х┌║Г╔╗О╪▄Г╚▀Е┬╩Д╦▀Х╥▄ 20%О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#1E88E5","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const id = await mmChooseStock(gameProcess, sourcePlayer, \"Х╥▄Е│°Е█║О╪ И─┴Д╦─Е▐╙Х┌║Г╔╗\", \"Х©≥Е▐╙Х┌║Г╔╗Г╚▀Е┬╩Д╦▀Х╥▄ 20%Ц─┌\");\n    if (!id) { await mmRefundCard(gameProcess, sourcePlayer, \"Х╥▄Е│°Е█║\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    mmStockMove(gameProcess, id, -0.2);\n    const price = mmStocks(gameProcess).prices[id];\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Х╝╘Ц─▄${MM_STOCKS[id].name}Ц─█Х╥▄Е│°Д╨├О╪│Г▌╟Д╩╥ ${price}О©╔`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Х╝╘ ${MM_STOCKS[id].name} Х╥▄Е│°О╪┬-20%О╪┴О╪▄Г▌╟Д╩╥ ${price}О©╔`);\n}));"},{"id":"card-abckvx","name":"Е©╚И╘╛Е┼═И·╜","type":"ToSelf","description":"Г╚▀Е█ЁЕ┴█Х©⌡ 3 Ф╜╔О╪▄Е╧╤Х╖╕Е▐▒Х░╫Х└ Ф═╪Е╜░Г └Ф∙┬Ф·°","color":"#78909C","iconId":"image-xs9jss","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    await mmWalk(gameProcess, sourcePlayer, 3);\n    mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Е©╚И╘╛Е┼═И·╜Ц─█Е┴█Х©⌡Д╨├ 3 Ф╜╔`, `${mmPlayerLink(gameProcess, sourcePlayer)} Е©╚И╘╛Е┼═И·╜О╪▄Е┴█Х©⌡Д╨├ 3 Ф╜╔`);\n    await mmHandleArrival(gameProcess, sourcePlayer);\n}));"},{"id":"card-b3jz22","name":"Е°╟Д╨╖Д╦╜Д╩▀","type":"ToSelf","description":"Д╩▌Е┬≈Х║╗И┤▄И─┴Д╦─Е²≈Х┤╙Е╥╠Г └Е°╟Г ╝О╪▄Х©·Е░▄Е╩╨Г╜▒Ф▄┴Е▌÷Д╩╥Е█√Е⌡·Г╩≥И⌠╤Х║▄О╪▄Ф─╔Г■╗И▓╠Ф≈╤Ф∙▒Е▒╫О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#78909C","iconId":"image-58x9x2","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    // Г■╗Е┬≈Х║╗И─┴Г⌡╝Ф═┤О╪ Е▐╙Е┬≈Е┤╨Х┤╙Е╥╠Г └Е°╟Г ╝О╪▄Е╧╤Ф═┤Е┤╨Х┐╫Е█√Е╓ Е╟▒И▓╠\n    const valueOf = (p: IProperty) => p.sellCost + p.level * p.buildCost;\n    const mine = [...gameProcess.properties.values()].filter(p => p.owner?.id === sourcePlayer.id).sort((a, b) => valueOf(b) - valueOf(a));\n    if (mine.length === 0) { await mmRefundCard(gameProcess, sourcePlayer, \"Е°╟Д╨╖Д╦╜Д╩▀\", \"Д╫═Х©≤Ф╡║Ф°┴Е°╟Г ╝Е▐╞Е█√\"); return; }\n    const options = mine.map(p => mmOption(p.id, `${p.name}О╪┬${p.level} Г╨╖О╪┴`, `Е█√Е⌡·И⌠╤Х║▄Е╬≈ ${valueOf(p)}О©╔`, \"#78909C\"));\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Е°╟Д╨╖Д╦╜Д╩▀О╪ И─┴Ф▀╘Х╕│Е█√Ф▌┴Г └Е°╟Г ╝\",\n      `Е°╟Г ╝Х©·Е░▄Е╩╨Г╜▒Ф▄┴Е▌÷Д╩╥Е█√Е⌡·Г╩≥И⌠╤Х║▄О╪┬Е°╟Д╩╥ + Е╥╡Г⌡√Е╩╨Г╜▒Х╢╧О╪┴Ц─┌Д╫═Г └Г▌╟И┤▒ <b>${sourcePlayer.money}О©╔</b>Ц─┌`, options, \"Е┘┬Д╦█Е█√Д╨├\", 2);\n    const prop = mine.find(p => p.id === pick);\n    if (!prop) { await mmRefundCard(gameProcess, sourcePlayer, \"Е°╟Д╨╖Д╦╜Д╩▀\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    const value = valueOf(prop);\n    await prop.setLevel(0);\n    await prop.setOwner(undefined); // Е╪∙Ф⌠▌Д╪ Е░▄Ф≈╤Ф┼┼Е╝┐Д╩▌Е▌÷Е°╟Д╦╩Г └Е°╟Д╨╖Е┬≈Х║╗И┤▄Г╖╩И≥╓\n    await sourcePlayer.gain(value, \"card\");\n    gameProcess.gameDataBroadcast();\n    mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} И─ Х©┤Ц─▄Е°╟Д╨╖Д╦╜Д╩▀Ц─█Ф┼┼Ц─▄${prop.name}Ц─█Ф▄┴Е▌÷Д╩╥ ${value}О©╔ Е█√Е⌡·Г╩≥Д╨├И⌠╤Х║▄`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} И─ Х©┤Е°╟Д╨╖Д╦╜Д╩▀Ф┼┼ ${mmPropLink(gameProcess, prop)} Ф▄┴Е▌÷Д╩╥ ${value}О©╔ Е█√Е⌡·Г╩≥Д╨├И⌠╤Х║▄`);\n}));"},{"id":"card-ceu5wy","name":"Е°╟И⌡╥","type":"ToSelf","description":"Д╩▌Е┬≈Х║╗И┤▄И─┴Д╦─Д╦╙Ф═╪Е╜░Е÷▀Д╦▀Е°╟И⌡╥О╪▄Д╦▀Д╦─Д╦╙Е│°Е°╗И┌ёИ┤▄Г └Г▌╘Е╝╤Д╪ Х╒╚Г┌╦Х©⌡Е▄╩И≥╒О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#1E88E5","iconId":"image-gl8hed","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    // Е╝╒Ф┬╥Г╚╞Г └\"И─┴Ф▀╘Ф═╪Е╜░\"Г∙▄И²╒Ф≤╞Г╘╨Г └О╪┬ToMapItem И─┴Д╦█Д╨├Г⌡╝Ф═┤О╪┴О╪▄Ф┴─Д╩╔Г■╗Е┬≈Х║╗И─┴Ф═╪Е╜░\n    const mines: Record<string, string> = gameProcess.customData.mines ?? (gameProcess.customData.mines = {});\n    const options = mmOrderedPathItems(gameProcess).filter(id => !mines[id]).map(id => {\n      const { prop } = mmPropertyAt(gameProcess, id);\n      const here = id === sourcePlayer.positionMapItemId ? \"О╪┬Д╫═Х└ Д╦▀О╪┴\" : \"\";\n      if (!prop) return mmOption(id, `${gameProcess.getMapItemById(id)?.type.name ?? id}${here}`, \"Е┼÷Х┐╫Ф═╪\", \"#1E88E5\");\n      if (!prop.owner) return mmOption(id, `${prop.name}${here}`, \"Ф≈═Д╦╩Е°╟Г ╝\", \"#43A047\");\n      if (prop.owner.id === sourcePlayer.id) return mmOption(id, `${prop.name}${here}`, `Д╫═Г └Е°╟Г ╝О╪┬${prop.level} Г╨╖О╪┴`, \"#FB8C00\");\n      return mmOption(id, `${prop.name}${here}`, `${prop.owner.name} Г └Е°╟Г ╝`, \"#E53935\");\n    });\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Е°╟И⌡╥О╪ И─┴Ф▀╘Е÷▀И⌡╥Г └Ф═╪Е╜░\", \"Ф▄┴Е╓√Е°┬И║╨Е╨▐Ф▌▓Е┬≈О╪▄Ф°─Е░▌Ф≤╞Е╦┌Д╦╜Е©┐Ц─┌Д╦▀Д╦─Д╦╙Е│°Е°╗И┌ёИ┤▄Г └Г▌╘Е╝╤О╪┬Е▄┘Ф▀╛Д╫═Х┤╙Е╥╠О╪┴Д╪ Х╒╚Г┌╦Х©⌡Е▄╩И≥╒Ц─┌\", options, \"Е┘┬Д╦█Г■╗Д╨├\", 4);\n    if (!pick) { await mmRefundCard(gameProcess, sourcePlayer, \"Е°╟И⌡╥\", \"Е▐√Ф╤┬Д╨├Е÷▀И⌡╥\"); return; }\n    mines[pick] = sourcePlayer.id;\n    const where = mmPropertyAt(gameProcess, pick).prop?.name ?? gameProcess.getMapItemById(pick)?.type.name ?? \"Ф÷░Е╓└\";\n    gameProcess.messageNotify([sourcePlayer.id], { type: \"success\", content: `Е°╟И⌡╥Е÷▀Е°╗Д╨├Ц─▄${where}Ц─█О╪▄Д╦▀Д╦─Д╦╙Е│°Е°╗И┌ёИ┤▄Г └Г▌╘Е╝╤Д╪ Х╒╚Г┌╦Х©⌡Е▄╩И≥╒` });\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Ф┌└Ф┌└Е°╗Е°╟Е⌡╬Д╦┼Е÷▀Д╨├Д╦─И╒≈Ц─▄Е°╟И⌡╥Ц─█Б─╕Б─╕`, `${mmPlayerLink(gameProcess, sourcePlayer)} Ф┌└Ф┌└Е°╗Е°╟Е⌡╬Д╦┼Е÷▀Д╨├Д╦─И╒≈Ц─▄Е°╟И⌡╥Ц─█Б─╕Б─╕`);\n}));"},{"id":"card-eug7x2","name":"Г╨╒Е▄┘И⌡╗","type":"ToSelf","description":"Е┘╤Д╩√Ф╞▐Д╫█Г▌╘Е╝╤Г╩≥Д╫═Е▐▒ 100 Г╨╒Е▄┘","color":"#1E88E5","iconId":"image-g6v0om","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const others = [...gameProcess.players.values()].filter(p => p.id !== sourcePlayer.id && !p.isBankrupted);\n    let total = 0;\n    for (const p of others) total += (await p.cost(mmInflate(gameProcess, 100), \"card\")).actualCost;\n    if (total > 0) await sourcePlayer.gain(total, \"card\");\n    mmAnnounce(gameProcess, \"success\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Г╨╒Е▄┘И⌡╗Ц─█О╪▄Ф╞▐Д╫█Г▌╘Е╝╤Е▐▒Ф²╔ ${mmInflate(gameProcess, 100)} Г╨╒Е▄┘О╪▄Е┘╠Ф■╤Е┬╟ ${total}`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Д╫©Г■╗Г╨╒Е▄┘И⌡╗О╪▄Ф╞▐Д╫█Г▌╘Е╝╤Е▐▒Ф²╔ ${mmInflate(gameProcess, 100)} Г╨╒Е▄┘О╪▄Е┘╠Ф■╤Е┬╟ ${total}О©╔`);\n}));"},{"id":"card-ga5e0t","name":"Е┬├Г╨╒Ф≈╔","type":"ToSelf","description":"Ф▄┴Д╫═Г └Ф▄│Х┌║Е╦┌Е─╪И╒├Е▐√ 25% Е┬├Г╨╒О╪▄Х┤ЁЕ╟▒ 150О©╔О╪┬Ф╡║Ф°┴Х┌║Г╔╗Д╧÷Х┐╫И╒├Д©²Е╨∙О╪┴","color":"#78909C","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const value = mmPortfolioValue(gameProcess, sourcePlayer);\n    const bonus = Math.max(mmInflate(gameProcess, 150), Math.round(value * 0.25));\n    await sourcePlayer.gain(bonus, \"dividend\");\n    const detail = value > 0 ? `Ф▄│Х┌║Е╦┌Е─╪ ${value}О©╔ Г └ 25%` : \"Ф╡║Ф°┴Ф▄│Х┌║О╪▄И╒├Е▐√Д©²Е╨∙\";\n    mmAnnounce(gameProcess, \"success\", `Е┬├Г╨╒Ф≈╔О╪│${sourcePlayer.name} И╒├Е┬╟Г╨╒Е┬╘ ${bonus}О©╔О╪┬${detail}О╪┴`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} И╒├Е┬╟Е┬├Г╨╒ ${bonus}О©╔О╪┬${detail}О╪┴`);\n}));"},{"id":"card-gvixyx","name":"Д╦╬Ф┼╔","type":"ToOtherPlayer","description":"Ф┼┼Д╦─Е░█Г▌╘Е╝╤И─│Х©⌡Г⌡▒Г▀╠ 2 Е⌡·Е░┬О╪┬Е╞╧Ф√╧Ф°┴Е┘█Ф╜╩И┤▒Г┴▄Е┬≥Ф┼╣Ф╤┬О╪┴","color":"#8E24AA","iconId":"image-w3teaq","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const JAIL_ID = \"mi-qpl9m8\";\n    const pardon = target.chanceCards.find(c => c.getName() === \"Е┘█Ф╜╩И┤▒Г┴▄\");\n    if (pardon) {\n      await target.loseCard(pardon.getId());\n      gameProcess.msgNotifyBroadcast(\"info\", `${sourcePlayer.name}Ц─▄Д╦╬Ф┼╔Ц─█Д╨├ ${target.name}О╪▄Д╫├Е╞╧Ф√╧Д╨╝Е┤╨Д╨├Ц─▄Е┘█Ф╜╩И┤▒Г┴▄Ц─█`);\n      gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)}Ц─▄Д╦╬Ф┼╔Ц─█Д╨├ ${gameProcess.createGameLinkItem(GameLinkItem.Player, target.id)}О╪▄Д╫├Е╞╧Ф√╧Д╨╝Е┤╨Д╨├Ц─▄Е┘█Ф╜╩И┤▒Г┴▄Ц─█`);\n      return;\n    }\n    await target.tpToMapItem(JAIL_ID);\n    target.setStop(2);\n    target.isStop = 2;\n    target.buffManager.removeByTag(\"jail\");\n    target.buffManager.addBuff({ id: `jail-${target.id}`, name: \"Е²░Г┴╒\", description: \"Е°╗Г⌡▒Г▀╠И┤▄Х╧╡ 2 Е⌡·Е░┬\", source: \"Д╦╬Ф┼╔\", tags: [\"jail\"], triggerTimes: 2 });\n    gameProcess.msgNotifyBroadcast(\"warning\", `${sourcePlayer.name}Ц─▄Д╦╬Ф┼╔Ц─█Д╨├ ${target.name}О╪▄Е╞╧Ф√╧Х╒╚Е┘ЁХ©⌡Г⌡▒Г▀╠ 2 Е⌡·Е░┬`);\n    gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)}Ц─▄Д╦╬Ф┼╔Ц─█Д╨├ ${gameProcess.createGameLinkItem(GameLinkItem.Player, target.id)}О╪▄Е╞╧Ф√╧Х╒╚Е┘ЁХ©⌡Г⌡▒Г▀╠ 2 Е⌡·Е░┬`);\n}));"},{"id":"card-gydxqr","name":"Х╥╞И °","type":"ToSelf","description":"Е°╗Е┴█Е░▌ 8 Ф═╪Е├┘О╪┬Е▄┘Ф▀╛Х└ Д╦▀О╪┴Ф■╬Д╦─Д╦╙Х╥╞И °О╪▄Д╦▀Д╦─Д╦╙Г╩▐Х©┤Г └Г▌╘Е╝╤О╪┬Е▄┘Ф▀╛Д╫═Х┤╙Е╥╠О╪┴Д╪ Х╒╚Ф▀╕Д╦▀О╪▄Е│°Е°╗И┌ёФ═╪Г╩⌠Г╝≈О╪⌡Ф■╬Е°╗Х└ Д╦▀Г └Х╞²О╪▄Д╫═Д╦▀Ф╛║Е┤╨Е▐▒Ф≈╤Д╪ Е▌÷Е°╟Е│°Д╦▀О╪▄Е├█Г╩⌠Г╝≈Д╦─Ф╛║Х©≥Д╦─Ф═╪О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#1E88E5","iconId":"image-gl8hed","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const RANGE = 8;\n    const blocks: Record<string, string> = gameProcess.customData.roadblocks ?? (gameProcess.customData.roadblocks = {});\n    const here = sourcePlayer.positionMapItemId;\n    // Е┴█Е░▌Е░└ RANGE Ф═╪Д╩╔Е├┘О╪┬Ф╡©Ф┴─Ф°┴Е╡■Х╥╞О╪┴Х┐╫Е┬╟Х╬╬Г └Ф═╪Е╜░О╪▄Х╝╟Д╦▀Ф°─Х©▒Х╥²Г╕╩О╪ Е┴█Ф√╧Д╦╨Ф╜ёО╪▄Е░▌Ф√╧Д╦╨Х╢÷О╪▄Х└ Д╦▀Д╦╨ 0\n    const dist = new Map<string, number>([[here, 0]]);\n    const spread = (forward: boolean) => {\n      let frontier = [here];\n      for (let d = 1; d <= RANGE && frontier.length > 0; d++) {\n        const next: string[] = [];\n        for (const id of frontier) {\n          for (const p of gameProcess.mapData.mapPaths) {\n            if (!gameProcess.isMapPathEnabled(p.id)) continue;\n            const [from, to] = forward ? [p.fromMapItemId, p.toMapItemId] : [p.toMapItemId, p.fromMapItemId];\n            if (from !== id || dist.has(to)) continue;\n            dist.set(to, forward ? d : -d);\n            next.push(to);\n          }\n        }\n        frontier = next;\n      }\n    };\n    spread(true);\n    spread(false);\n    const tiles = [...dist.entries()].filter(([id]) => !blocks[id])\n      .sort((a, b) => Math.abs(a[1]) - Math.abs(b[1]) || b[1] - a[1]); // Х©▒Г └Е°╗Е┴█О╪▄Е░▄Х╥²Г╕╩Е┴█Ф√╧Е°╗Е┴█\n    if (tiles.length === 0) { await mmRefundCard(gameProcess, sourcePlayer, \"Х╥╞И °\", \"И≥└Х©▒Ф╡║Ф°┴Е▐╞Д╩╔Ф■╬Х╥╞И °Г └Ф═╪Е╜░\"); return; }\n    const options = tiles.map(([id, d]) => {\n      const { prop } = mmPropertyAt(gameProcess, id);\n      const name = prop?.name ?? gameProcess.getMapItemById(id)?.type.name ?? id;\n      const what = !prop ? \"Е┼÷Х┐╫Ф═╪\" : !prop.owner ? \"Ф≈═Д╦╩Е°╟Г ╝\" : prop.owner.id === sourcePlayer.id ? `Д╫═Г └Е°╟Г ╝О╪┬${prop.level} Г╨╖О╪▄Х©┤Х╥╞Х╢╧ ${prop.costList[prop.level] ?? 0}О©╔О╪┴` : `${prop.owner.name} Г └Е°╟Г ╝`;\n      const color = d === 0 ? \"#8E24AA\" : !prop ? \"#1E88E5\" : !prop.owner ? \"#43A047\" : prop.owner.id === sourcePlayer.id ? \"#FB8C00\" : \"#E53935\";\n      const pos = d === 0 ? `Х└ Д╦▀О╪ ${name}` : d > 0 ? `Е┴█Ф√╧ ${d} Ф═╪О╪ ${name}` : `Е░▌Ф√╧ ${-d} Ф═╪О╪ ${name}`;\n      return mmOption(id, pos, d === 0 ? `${what}Ц─┌Д╫═Д╦▀Ф╛║Е┤╨Е▐▒Ф≈╤Д╪ Х╒╚Ф▀╕Е°╗Е▌÷Е°╟О╪▄Х©≥Д╦─Ф═╪Е├█Г╩⌠Г╝≈Д╦─Ф╛║` : what, color);\n    });\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Х╥╞И °О╪ И─┴Ф▀╘Ф■╬Г╫╝Г └Ф═╪Е╜░\",\n      `Е┴█Е░▌ ${RANGE} Ф═╪Д╩╔Е├┘О╪▄Д╧÷Е▐╞Д╩╔Ф■╬Е°╗Х└ Д╦▀Ц─┌Д╦▀Д╦─Д╦╙Г╩▐Х©┤Х©≥Ф═╪Г └Г▌╘Е╝╤О╪┬Е▄┘Ф▀╛Д╫═Х┤╙Е╥╠О╪┴Д╪ Х╒╚Ф▀╕Д╦▀О╪▄Е│°Е°╗Х©≥И┤▄Г╩⌠Г╝≈О╪⌡Ф■╬Е°╗Х└ Д╦▀Г └Х╞²О╪▄Д╫═Д╦▀Ф╛║Е┤╨Е▐▒Ф≈╤Д╪ Е▌÷Е°╟Е│°Д╦▀О╪▄Е├█Г╩⌠Г╝≈Д╦─Ф╛║Х©≥Д╦─Ф═╪Ц─┌`, options, \"Е┘┬Д╦█Г■╗Д╨├\", 3);\n    if (!pick) { await mmRefundCard(gameProcess, sourcePlayer, \"Х╥╞И °\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    blocks[pick] = sourcePlayer.id;\n    const { prop } = mmPropertyAt(gameProcess, pick);\n    const where = prop?.name ?? gameProcess.getMapItemById(pick)?.type.name ?? \"Ф÷░Е╓└\";\n    const atFeet = pick === here ? \"О╪┬Е╟╠Е°╗Х┤╙Е╥╠Х└ Д╦▀О╪┴\" : \"\";\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Е°╗Ц─▄${where}Ц─█${atFeet}Ф■╬Д╨├Д╦─Д╦╙Х╥╞И °О╪▄Д╦▀Д╦─Д╦╙Г╩▐Х©┤Г └Д╨╨Д╪ Х╒╚Ф▀╕Д╦▀`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Е°╗Ц─▄${where}Ц─█${atFeet}Ф■╬Д╨├Д╦─Д╦╙П÷ ╖Х╥╞И °О╪▄Д╦▀Д╦─Д╦╙Г╩▐Х©┤Г └Д╨╨Д╪ Х╒╚Ф▀╕Д╦▀`);\n}));\n"},{"id":"card-kzydkj","name":"Ф÷╔Г╗▌","type":"ToOtherPlayer","description":"Х╝╘Д╦─Е░█Г▌╘Е╝╤Х║╔Г╪╢Г▌╟И┤▒Г └ 15%О╪┬Ф°─Е╟▒ 80О╪┴О╪▄Е╜≤Е┘╔Е│°Х╫╕Е°╨Е╔√Ф╠═","color":"#78909C","iconId":"image-fxi0bt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const tax = Math.max(mmInflate(gameProcess, 80), Math.floor(target.money * 0.15));\n    const res = await target.cost(tax, \"card\");\n    gameProcess.customData.jackpot = (gameProcess.customData.jackpot ?? 0) + res.actualCost;\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Е╞╧ ${target.name} Е▐▒Х╣╥Ц─▄Ф÷╔Г╗▌Ц─█О╪▄Е╞╧Ф√╧Х║╔Г╪╢ ${res.actualCost}О╪▄Е╜≤Е┘╔Е│°Х╫╕Е°╨Е╔√Ф╠═`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Е╞╧ ${mmPlayerLink(gameProcess, target)} Е▐▒Х╣╥Ф÷╔Г╗▌О╪▄Е╞╧Ф√╧Х║╔Г╪╢ ${res.actualCost}О©╔О╪▄Е╜≤Е┘╔Е│°Х╫╕Е°╨Е╔√Ф╠═`);\n}));"},{"id":"card-mq7r7t","name":"Х║ёИ■╕Х©≤Д╧║","type":"ToSelf","description":"Д╪═И─│Е⌡·Х╣╥Г┌╧Е╧╤И╒├Е▐√Д╦─Ф╛║Е╥╔Х╣└О╪┬Д╨║Г│╣И╒├Д╦█Е┬╟О╪┴","color":"#78909C","iconId":"image-xs9jss","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const START_ID = \"mi-pkctf6\";\n    await sourcePlayer.tpToMapItem(START_ID);\n    const salary = mmInflate(gameProcess, Number(gameProcess.gameSetting.salary?.value ?? 200));\n    if (sourcePlayer.buffManager.hasBuffWithTag(\"undead\")) {\n      gameProcess.msgNotifyBroadcast(\"info\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Х║ёИ■╕Х©≤Д╧║Ц─█Е⌡·Е┬╟Х╣╥Г┌╧О╪▄Д╫├Д╨║Г│╣И╒├Д╦█Д╨├Е╥╔Х╣└`);\n      gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)} Д╫©Г■╗Ц─▄Х║ёИ■╕Х©≤Д╧║Ц─█Е⌡·Е┬╟Х╣╥Г┌╧О╪▄Д╫├Д╨║Г│╣И╒├Д╦█Д╨├Е╥╔Х╣└`);\n      return;\n    }\n    await sourcePlayer.gain(salary, \"card\");\n    gameProcess.msgNotifyBroadcast(\"success\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Х║ёИ■╕Х©≤Д╧║Ц─█Е⌡·Е┬╟Х╣╥Г┌╧О╪▄И╒├Е▐√Е╥╔Х╣└ ${salary}`);\n    gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)} Д╫©Г■╗Ц─▄Х║ёИ■╕Х©≤Д╧║Ц─█Е⌡·Е┬╟Х╣╥Г┌╧О╪▄И╒├Е▐√Е╥╔Х╣└ ${salary}`);\n}));"},{"id":"card-n0sbbf","name":"Е┘█Ф╜╩И┤▒Г┴▄","type":"ToSelf","description":"Х╒╚Е┼╗Е█║О╪ Ф▄│Ф°┴Ф≈╤О╪▄Д╦▀Д╦─Ф╛║Е┘╔Г▀╠Д╪ Х┤╙Е┼╗Ф╤┬Х─≈Х©≥Е╪═Е█║Е╧╤Е┘█И≥╓Е²░Г┴╒","color":"#8E24AA","iconId":"image-xs9jss","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    // Х╒╚Е┼╗Е█║О╪ Е┘╔Г▀╠Ф≈╤Х┤╙Е┼╗Ф╤┬Х─≈Ц─┌Д╦╩Е┼╗Ф┴⌠Е┤╨Ф≈╤Е▌÷Ф═╥Х©≤Г╩≥Г▌╘Е╝╤Ц─┌\n    const info = [...gameProcess.chanceCardInfos.values()].find(i => i.name === \"Е┘█Ф╜╩И┤▒Г┴▄\");\n    if (info) await sourcePlayer.gainCard(gameProcess.createNewChanceCard(info.id));\n    gameProcess.messageNotify([sourcePlayer.id], { type: \"info\", content: \"Ц─▄Е┘█Ф╜╩И┤▒Г┴▄Ц─█Д╪ Е°╗Д╫═Е┘╔Г▀╠Ф≈╤Х┤╙Е┼╗Г■÷Ф∙┬О╪▄Д╦█И°─Х╕│Д╦╩Е┼╗Д╫©Г■╗О╪▄Е╥╡Ф■╬Е⌡·Ф┴▀Г┴▄\" });\n}));"},{"id":"card-olsrgh","name":"Ф▀├Х©│И≤÷","type":"ToSelf","description":"Д╩▌Е┬≈Х║╗И┤▄И─┴Д╦─Е²≈Е┬╚Д╨╨Г⌡√Д╨├Ф╔╪Г └Е°╟Г ╝О╪▄Ф▀├Ф▌┴Д╦─Г╨╖Е╩╨Г╜▒О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#78909C","iconId":"image-58x9x2","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    // Г■╗Е┬≈Х║╗И─┴Г⌡╝Ф═┤О╪ Е▐╙Е┬≈Е┤╨Е┬╚Д╨╨Г └Ц─│Г⌡√Д╨├Ф╔╪Г └Е°╟Г ╝О╪┬0 Г╨╖Г╘╨Е°╟И─┴Д╦█Д╨├О╪┴\n    const targets = [...gameProcess.properties.values()]\n      .filter(p => p.owner && p.owner.id !== sourcePlayer.id && !p.owner.isBankrupted && p.level > 0)\n      .sort((a, b) => b.level * b.buildCost - a.level * a.buildCost);\n    if (targets.length === 0) {\n      await mmRefundCard(gameProcess, sourcePlayer, \"Ф▀├Х©│И≤÷\", \"Е°╨Д╦┼Х©≤Ф╡║Ф°┴Е┬╚Д╨╨Г⌡√Д╨├Ф╔╪Г └Е°╟Г ╝\");\n      return;\n    }\n    const options = targets.map(p => mmOption(p.id, `${p.name}О╪┬${p.owner!.name}О╪▄${p.level} Г╨╖О╪┴`,\n      `Ф▀├Ф▌┴Д╦─Г╨╖О╪▄Е╞╧Ф√╧Ф█÷Е╓╠Е╩╨Ф┬©Х╢╧ ${p.buildCost}О©╔`, \"#78909C\"));\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Ф▀├Х©│И≤÷О╪ И─┴Ф▀╘Х╕│Ф▀├Г └Е°╟Г ╝\", \"Ф▀├Ф▌┴Г⌡╝Ф═┤Е°╟Г ╝Д╦┼Г └Д╦─Г╨╖Е╩╨Г╜▒Ц─┌\", options, \"Е┘┬Д╦█Г■╗Д╨├\", 2);\n    const prop = targets.find(p => p.id === pick);\n    if (!prop) { await mmRefundCard(gameProcess, sourcePlayer, \"Ф▀├Х©│И≤÷\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    await prop.levelDown();\n    gameProcess.gameDataBroadcast();\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Ф╢╬Ц─▄Ф▀├Х©│И≤÷Ц─█Ф▀├Ф▌┴Д╨├ ${prop.owner!.name} Г └Ц─▄${prop.name}Ц─█Д╦─Г╨╖Е╩╨Г╜▒`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Ф╢╬Ф▀├Х©│И≤÷Ф▀├Ф▌┴Д╨├ ${mmPlayerLink(gameProcess, prop.owner!)} Г └ ${mmPropLink(gameProcess, prop)} Д╦─Г╨╖Е╩╨Г╜▒`);\n}));\n"},{"id":"card-pchvo5","name":"Ф┼⌠Е▌╩Ф┴⌠Е╥╔","type":"ToPlayer","description":"Ф┼┼Д╦─Е░█Г▌╘Е╝╤И─│Х©⌡ OЕё╚Е╨╥ Ф┴⌠Е╥╔ 1 Е⌡·Е░┬О╪ Е╥╔И▓╠ 300О╪▄Д╫═Д╩▌Д╦╜Ф┼╫ 150 Д╦╜Д╩▀Х╢╧О╪▄Е╞╧Ф√╧Ф▀©Е┬╟ 150Ц─┌Д╧÷Е▐╞Д╩╔Е╞╧Х┤╙Е╥╠Г■╗О╪ Х┤╙Е╥╠Е▌╩Ф┴⌠Е╥╔О╪▄Ф▀©Е┘╗И╒²Е╥╔И▓╠О╪▄Ф°╛Е⌡·Е░┬Г⌡╢Ф▌╔Г╩⌠Ф²÷","color":"#1E88E5","iconId":"image-b4njdw","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const FACTORY_ID = \"mi-wr3aac\";\n    const SELF = target.id === sourcePlayer.id; // Е╞╧Х┤╙Е╥╠Г■╗О╪ Х┤╙Е╥╠Е▌╩Ф┴⌠Е╥╔О╪▄Ф▀©Е┘╗И╒²Е╥╔И▓╠О╪┬Ф°╛Е⌡·Е░┬Г⌡╢Ф▌╔Г╩⌠Ф²÷О╪▄Х╖│Ц─▄Г▌╘Е╝╤Ф⌠█Д╫°Ц─█И≤╤Ф╝╣О╪┴\n    const STORE = mmHasRole(target, \"kotone\"); // Х√╞И╦║Е▌╩Д╬©Е┬╘Е╨≈О╪▄Е╥╔И▓╠Г©╩Е─█\n    const PLACE = STORE ? \"Д╬©Е┬╘Е╨≈\" : \"OЕё╚Е╨╥\";\n    const WAGE = mmInflate(gameProcess, 300) * (STORE ? 2 : 1), FEE = SELF ? 0 : mmInflate(gameProcess, 150); // Е▓▄Х┤╙Ф└©Х©⌡Е▌┌Е░▄Ф═╥Г └Е╥╔И▓╠О╪▄Ф┼⌠Е┬╚Д╨╨Ф≈╤Д╦╜Д╩▀Д╩▌Д╦╜Ф┼╫Ф┬░\n    await target.tpToMapItem(FACTORY_ID);\n    target.setStop(1);\n    target.isStop = 1;\n    await target.gain(WAGE - FEE, \"work\");\n    if (FEE > 0) await sourcePlayer.gain(FEE, \"card\");\n    mmValueMove(gameProcess, \"factory\", 0.04);\n    target.buffManager.removeByTag(\"work\");\n    target.buffManager.addBuff({ id: `work-${target.id}`, name: \"Ф┴⌠Е╥╔Д╦╜\", description: STORE ? \"Е°╗Д╬©Е┬╘Е╨≈Ф┴⌠Е╥╔ 1 Е⌡·Е░┬\" : \"Е°╗ OЕё╚Е╨╥ Ф╣│Ф╟╢Г╨©Д╦┼Е╧╡ 1 Е⌡·Е░┬\", source: \"Ф┼⌠Е▌╩Ф┴⌠Е╥╔\", tags: [\"work\"], triggerTimes: 1 });\n    if (SELF) {\n      mmAnnounce(gameProcess, \"info\", `${target.name} Д╦╩Е┼╗Е▌╩${PLACE}Ф┴⌠Е╥╔ 1 Е⌡·Е░┬О╪▄И╒├Е┬╟Е╥╔И▓╠ ${WAGE}`,\n        `${mmPlayerLink(gameProcess, target)} Д╦╩Е┼╗Е▌╩${PLACE}Ф┴⌠Е╥╔ 1 Е⌡·Е░┬О╪▄И╒├Е┬╟Е╥╔И▓╠ ${WAGE}О©╔`);\n      return;\n    }\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Ф┼┼ ${target.name}Ц─▄Ф┼⌠Е▌╩Ф┴⌠Е╥╔Ц─█1 Е⌡·Е░┬О╪ Е╥╔И▓╠ ${WAGE}О╪▄Х╒╚Ф┼╫Х╣╟ ${FEE} Д╦╜Д╩▀Х╢╧О╪▄Е┬╟Ф┴▀ ${WAGE - FEE}`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Ф┼┼ ${mmPlayerLink(gameProcess, target)} Ф┼⌠Е▌╩${PLACE}Ф┴⌠Е╥╔ 1 Е⌡·Е░┬О╪ Е╥╔И▓╠ ${WAGE}О©╔О╪▄${mmPlayerLink(gameProcess, sourcePlayer)} Ф┼╫Х╣╟Д╦╜Д╩▀Х╢╧ ${FEE}О©╔О╪▄${mmPlayerLink(gameProcess, target)} Е┬╟Ф┴▀ ${WAGE - FEE}О©╔`);\n}));\n"},{"id":"card-qim9p8","name":"Д╧╬Е²╓Е╓╖Ф▄╙Г╖╩","type":"ToOtherPlayer","description":"Е▓▄Д╦─Е░█Г▌╘Е╝╤Д╨╓Ф█╒Д╫█Г╫╝","color":"#78909C","iconId":"image-w3teaq","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const mine = sourcePlayer.positionMapItemId;\n    const theirs = target.positionMapItemId;\n    await sourcePlayer.tpToMapItem(theirs);\n    await target.tpToMapItem(mine);\n    gameProcess.msgNotifyBroadcast(\"info\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Д╧╬Е²╓Е╓╖Ф▄╙Г╖╩Ц─█О╪▄Е▓▄ ${target.name} Д╨╓Ф█╒Д╨├Д╫█Г╫╝`);\n    gameProcess.gameLogBroadcast(`${gameProcess.createGameLinkItem(GameLinkItem.Player, sourcePlayer.id)} Д╫©Г■╗Ц─▄Д╧╬Е²╓Е╓╖Ф▄╙Г╖╩Ц─█О╪▄Е▓▄ ${gameProcess.createGameLinkItem(GameLinkItem.Player, target.id)} Д╨╓Ф█╒Д╨├Д╫█Г╫╝`);\n}));"},{"id":"card-qmahgu","name":"И│╔Ф▌╖И╙╟Е╜░","type":"ToSelf","description":"Ф▄┤Е╝ Д╦▀Д╦─Ф╛║Ф▌╥И╙╟Г └Г┌╧Ф∙╟Е░┬Х╝║О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#8E24AA","iconId":"image-2zu794","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const dices = sourcePlayer.dices;\n    const n = dices.length;\n    if (n === 0) { await mmRefundCard(gameProcess, sourcePlayer, \"И│╔Ф▌╖И╙╟Е╜░\", \"Д╫═Ф╡║Ф°┴И╙╟Е╜░\"); return; }\n    const options = [];\n    for (let total = n; total <= 6 * n; total++) options.push(mmOption(String(total), `${total} Г┌╧`, \"\", \"#8E24AA\"));\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"И│╔Ф▌╖И╙╟Е╜░О╪ Д╦▀Ф╛║Ф▌╥Е┤╨Е┤═Г┌╧О╪÷\", `Д╫═Ф°┴ ${n} И╒≈И╙╟Е╜░О╪▄И─┴Е╔╫Г┌╧Ф∙╟Е░┬Х╝║Ц─┌`, options, \"Е┘┬Д╦█Г■╗Д╨├\", 6);\n    if (!pick) { await mmRefundCard(gameProcess, sourcePlayer, \"И│╔Ф▌╖И╙╟Е╜░\", \"Е▐√Ф╤┬Д╨├И│╔Ф▌╖\"); return; }\n    const total = Number(pick);\n    dices.forEach((d, i) => d.setProphecy(Math.floor(total / n) + (i < total % n ? 1 : 0)));\n    gameProcess.messageNotify([sourcePlayer.id], { type: \"success\", content: `И│╔Ф▌╖И╙╟Е╜░Е╥╡Х╝╬Е╝ О╪ Д╦▀Ф╛║Ф▌╥И╙╟Е░┬Х╝║ ${total} Г┌╧` });\n    mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Ф┌└Ф┌└Х╟┐Е╔╫Д╨├И│╔Ф▌╖И╙╟Е╜░Б─╕Б─╕`, `${mmPlayerLink(gameProcess, sourcePlayer)} Х╟┐Е╔╫Д╨├И│╔Ф▌╖И╙╟Е╜░`);\n}));"},{"id":"card-ruq530","name":"Ф╤╗Е│°Е█║","type":"ToSelf","description":"И─┴Д╦─Е▐╙Х┌║Г╔╗О╪▄Г╚▀Е┬╩Д╦┼Ф╤╗ 20%О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#1E88E5","iconId":"image-llvzmt","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const id = await mmChooseStock(gameProcess, sourcePlayer, \"Ф╤╗Е│°Е█║О╪ И─┴Д╦─Е▐╙Х┌║Г╔╗\", \"Х©≥Е▐╙Х┌║Г╔╗Г╚▀Е┬╩Д╦┼Ф╤╗ 20%Ц─┌\");\n    if (!id) { await mmRefundCard(gameProcess, sourcePlayer, \"Ф╤╗Е│°Е█║\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    mmStockMove(gameProcess, id, 0.2);\n    const price = mmStocks(gameProcess).prices[id];\n    mmAnnounce(gameProcess, \"success\", `${sourcePlayer.name} Х╝╘Ц─▄${MM_STOCKS[id].name}Ц─█Ф╤╗Е│°Д╨├О╪│Г▌╟Д╩╥ ${price}О©╔`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Х╝╘ ${MM_STOCKS[id].name} Ф╤╗Е│°О╪┬+20%О╪┴О╪▄Г▌╟Д╩╥ ${price}О©╔`);\n}));"},{"id":"card-xklfrx","name":"Е┘█Х╢╧Хё┘Д©╝","type":"ToSelf","description":"Д╩▌Д╫═Е░█Д╦▀Х©≤Х┐╫Е█┤Г╨╖Г └Е°╟Г ╝И┤▄И─┴Д╦─Е²≈О╪▄Е┘█Х╢╧Е█┤Д╦─Г╨╖О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#78909C","iconId":"image-58x9x2","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const upgradable = sourcePlayer.properties.filter(p => p.level < p.maxLevel);\n    if (upgradable.length === 0) { await mmRefundCard(gameProcess, sourcePlayer, \"Е┘█Х╢╧Хё┘Д©╝\", \"Д╫═Ф╡║Ф°┴Х©≤Х┐╫Е█┤Г╨╖Г └Е°╟Г ╝\"); return; }\n    const options = upgradable.map(p => mmOption(p.id, `${p.name}Ц──${p.level} Б├▓ ${p.level + 1} Г╨╖`,\n      `Х©┤Х╥╞Х╢╧ ${p.costList[p.level] ?? 0} Б├▓ ${p.costList[p.level + 1] ?? 0}О©╔О╪▄Г°│Д╦▀Е█┤Г╨╖Х╢╧ ${p.buildCost}О©╔`, \"#43A047\"));\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Е┘█Х╢╧Хё┘Д©╝О╪ И─┴Ф▀╘Х╕│Е█┤Г╨╖Г └Е°╟Г ╝\", \"Е▐╙Е┬≈Е┤╨Д╫═Е░█Д╦▀Х©≤Х┐╫Е█┤Г╨╖Г └Е°╟Г ╝Ц─┌\", options, \"Е┘┬Д╦█Г■╗Д╨├\", 2);\n    const prop = upgradable.find(p => p.id === pick);\n    if (!prop) { await mmRefundCard(gameProcess, sourcePlayer, \"Е┘█Х╢╧Хё┘Д©╝\", \"Е▐√Ф╤┬Д╨├Хё┘Д©╝\"); return; }\n    await prop.levelUp();\n    mmAnnounce(gameProcess, \"success\", `${sourcePlayer.name} Д╫©Г■╗Ц─▄Е┘█Х╢╧Хё┘Д©╝Ц─█О╪▄Ц─▄${prop.name}Ц─█Е█┤Е┬╟Д╨├ ${prop.level} Г╨╖`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Е┘█Х╢╧Хё┘Д©╝О╪▄${mmPropLink(gameProcess, prop)} Е█┤Е┬╟Д╨├ ${prop.level} Г╨╖`);\n}));"},{"id":"card-yen151","name":"Ф┴⌠Е┼╚","type":"ToOtherPlayer","description":"Ф┼╒Х╣╟Д╦─Е░█Г▌╘Е╝╤Г▌╟И┤▒Г └ 20%О╪┬Ф°─Е╟▒ 150О╪▄Ф°─Е╓ Ф┼╒Е┬╟Е╞╧Ф√╧Е▐╙Е┴╘ 1О╪┴","color":"#1E88E5","iconId":"image-w3teaq","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    const amount = Math.min(Math.max(mmInflate(gameProcess, 150), Math.floor(target.money * 0.2)), target.money - 1);\n    if (amount <= 0) {\n      mmAnnounce(gameProcess, \"info\", `${sourcePlayer.name} Ф┐ЁЦ─▄Ф┴⌠Е┼╚Ц─█${target.name}О╪▄Г╩⌠Ф·°Е╞╧Ф√╧Х╨╚Ф≈═Е┬├Ф√┤`, `${mmPlayerLink(gameProcess, sourcePlayer)} Ф┐ЁФ┴⌠Е┼╚ ${mmPlayerLink(gameProcess, target)}О╪▄Г╩⌠Ф·°Е╞╧Ф√╧Х╨╚Ф≈═Е┬├Ф√┤`);\n      return;\n    }\n    const res = await target.cost(amount, \"card\");\n    await sourcePlayer.gain(res.actualCost, \"card\");\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name}Ц─▄Ф┴⌠Е┼╚Ц─█Д╨├ ${target.name}О╪▄Ф┼╒Х╣╟ ${res.actualCost}`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Ф┴⌠Е┼╚Д╨├ ${mmPlayerLink(gameProcess, target)}О╪▄Ф┼╒Х╣╟ ${res.actualCost}О©╔`);\n}));"},{"id":"card-z35c59","name":"Е╪╨Е┬╤Ф■╤Х╢╜","type":"ToSelf","description":"Д╩▌Е┬≈Х║╗И┤▄И─┴Д╦─Е²≈Е┬╚Д╨╨Г └Е°╟Г ╝О╪▄Д╩≤Г╩≥Е°╟Д╦╩ 1.2 Е─█Е°╟Д╩╥Е┼═Е╩╨Г╜▒Х╢╧Е╪╨Х║▄Д╧╟Д╦▀О╪┬Е▐╞Е▐√Ф╤┬О╪▄Е█║Д╪ И──Е⌡·О╪┴","color":"#8E24AA","iconId":"image-58x9x2","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => mmCard(gameProcess, async () => {\n    // Г■╗Е┬≈Х║╗И─┴Г⌡╝Ф═┤О╪ Е╝╒Ф┬╥Г╚╞Г └Е╟▐Е°╟Е⌡╬И─┴Е°╟Г ╝Е°╗Ф┴▀Ф°╨Д╦┼Е╬┬И ╬Г┌╧Д╦╜О╪▄Х─▄Д╦■Г°▀Д╦█Е┬╟Ф■╤Х╢╜Д╩╥\n    if (sourcePlayer.buffManager.hasBuffWithTag(\"undead\")) {\n      await mmRefundCard(gameProcess, sourcePlayer, \"Е╪╨Е┬╤Ф■╤Х╢╜\", \"Д╨║Г│╣Д╦█Х┐╫Г╫╝Е┼·Е°╟Д╨╖\");\n      return;\n    }\n    const priceOf = (p: IProperty) => Math.floor(p.sellCost * 1.2 + p.level * p.buildCost);\n    const targets = [...gameProcess.properties.values()]\n      .filter(p => p.owner && p.owner.id !== sourcePlayer.id && !p.owner.isBankrupted)\n      .sort((a, b) => priceOf(a) - priceOf(b));\n    if (targets.length === 0) {\n      await mmRefundCard(gameProcess, sourcePlayer, \"Е╪╨Е┬╤Ф■╤Х╢╜\", \"Е°╨Д╦┼Х©≤Ф╡║Ф°┴Е┬╚Д╨╨Г └Е°╟Г ╝\");\n      return;\n    }\n    const options = targets.map(p => {\n      const price = priceOf(p);\n      const affordable = sourcePlayer.money > price;\n      return mmOption(p.id, `${p.name}О╪┬${p.owner!.name}О╪▄${p.level} Г╨╖О╪┴`,\n        affordable ? `Ф■╤Х╢╜Д╩╥ ${price}О©╔` : `Ф■╤Х╢╜Д╩╥ ${price}О©╔О╪┬И▓╠Д╦█Е╓÷О╪┴`, affordable ? \"#8E24AA\" : \"#9E9E9E\");\n    });\n    const pick = await mmChoose(gameProcess, sourcePlayer, \"Е╪╨Е┬╤Ф■╤Х╢╜О╪ И─┴Ф▀╘Г⌡╝Ф═┤Е°╟Г ╝\",\n      `Ф■╤Х╢╜Д╩╥ = Е°╟Д╩╥ ц≈ 1.2 + Е╥╡Г⌡√Е╩╨Г╜▒Х╢╧Ц─┌Д╫═Г └Г▌╟И┤▒ <b>${sourcePlayer.money}О©╔</b>О╪┬Д╧╟Е╝▄Е©┘И║╩Х©≤Ф°┴Е┴╘Д╫≥О╪┴Ц─┌`, options, \"Е┘┬Д╦█Г■╗Д╨├\", 2);\n    const prop = targets.find(p => p.id === pick);\n    if (!prop) { await mmRefundCard(gameProcess, sourcePlayer, \"Е╪╨Е┬╤Ф■╤Х╢╜\", \"Е▐√Ф╤┬Д╨├Д╫©Г■╗\"); return; }\n    const owner = prop.owner!;\n    const price = priceOf(prop);\n    if (sourcePlayer.money <= price) {\n      await mmRefundCard(gameProcess, sourcePlayer, \"Е╪╨Е┬╤Ф■╤Х╢╜\", `И°─Х╕│ ${price}О©╔О╪▄Д╫═Г └И▓╠Д╦█Е╓÷`);\n      return;\n    }\n    await sourcePlayer.cost(price, \"card\");\n    await owner.gain(price, \"card\");\n    await prop.setOwner(sourcePlayer); // Е╪∙Ф⌠▌Д╪ Е░▄Ф≈╤Ф⌡╢Ф√╟Ф√╟Ф≈╖Д╦╩Д╨╨Г └Е°╟Д╨╖Е┬≈Х║╗\n    gameProcess.gameDataBroadcast();\n    mmAnnounce(gameProcess, \"warning\", `${sourcePlayer.name} Д╩╔ ${price} Г └Д╩╥Ф═╪Ц─▄Е╪╨Е┬╤Ф■╤Х╢╜Ц─█Д╨├ ${owner.name} Г └Ц─▄${prop.name}Ц─█`,\n      `${mmPlayerLink(gameProcess, sourcePlayer)} Д╩╔ ${price}О©╔ Е╪╨Е┬╤Ф■╤Х╢╜Д╨├ ${mmPlayerLink(gameProcess, owner)} Г └ ${mmPropLink(gameProcess, prop)}`);\n}));\n"}],"mapItemTypes":[{"id":"map-item-type-079x9b","name":"Г╖▒Е╜╕И≥╒","modelId":"model-wgeyf6","color":"#EDE6D6","size":1},{"id":"map-item-type-0n8h70","name":"Е°╟Г ╝-И⌠╤(Д╦°Е▄╨)","modelId":"model-kqhz8z","color":"#EDE6D6",