ck-pct","type":"span","textBinding":"line.pct","styleBinding":{"color":"line.up ? '#EF5350' : '#66BB6A'"},"style":{"fontSize":"0.85em"}},{"id":"stock-held","type":"span","vShow":"currentPlayer && exportData.stocks.holdings[currentPlayer.id] && exportData.stocks.holdings[currentPlayer.id][line.id]","textBinding":"'Ф▄│' + exportData.stocks.holdings[currentPlayer.id][line.id]","style":{"fontSize":"0.8em","opacity":"0.75"}}]}]}]}}],"modifierTemplates":[],"customUIs":[{"id":"custom-ui-g91qjc","name":"Х┌║Е╦┌Х║▄Ф┐┘","uiSchema":"tmpl-tdlcq3","layout":{"x":0,"y":0,"width":8,"height":7}}],"gameSettingForm":[{"id":"gs-2pu63x","key":"winNetWorth","type":"select","label":"Х┐°Е┬╘Г╨©О╪ Ф─╩Х╣└Д╨╖О╪┬Г▌╟И┤▒О╪▀Е°╟Д╨╖О╪▄Д╦█Е░╚Х┌║Г╔╗О╪┴","defaultValue":4000,"min":0,"options":[{"label":"Е┘ЁИ≈╜","value":0},{"label":"3000О╪┬Е©╚Х┼┌Е╔▐О╪┴","value":3000},{"label":"4000О╪┬Ф▌╗Х█░О╪┴","value":4000},{"label":"5000","value":5000},{"label":"6000","value":6000},{"label":"8000О╪┬И∙©Е╠─О╪┴","value":8000}]},{"id":"gs-8dcjx0","key":"winMonopolies","type":"select","label":"Х┐°Е┬╘Г╨©О╪ Е·└Ф√╜Х┴╡Г╩└Ф∙╟","defaultValue":2,"min":0,"max":12,"options":[{"label":"Е┘ЁИ≈╜","value":0},{"label":"2 Д╦╙Х┴╡Г╩└О╪┬Ф▌╗Х█░О╪┴","value":2},{"label":"3 Д╦╙Х┴╡Г╩└","value":3},{"label":"4 Д╦╙Х┴╡Г╩└","value":4}]},{"id":"gs-gwuqkh","key":"inflation","type":"select","label":"И─ Х╢╖Х├╗Х┐─О╪┬Ф╞▐ 5 Х╫╝Г┴╘Д╩╥Д╦┼Ф╤╗О╪┴","defaultValue":0.05,"options":[{"label":"Е┘ЁИ≈╜О╪┬Г╨╕ 31~35 Х╫╝О╪┴","value":0},{"label":"Х╫╩Е╬╝ +5%О╪┬Ф▌╗Х█░О╪▄Г╨╕ 26~28 Х╫╝О╪┴","value":0.05},{"label":"Ф╦╘Е▓▄ +10%О╪┬Г╨╕ 22~24 Х╫╝О╪┴","value":0.1},{"label":"Е©╚Х┼┌Е╔▐ +15%О╪┬Г╨╕ 20~21 Х╫╝О╪┴","value":0.15},{"label":"Ф│╤Ф─╖ +25%","value":0.25}]},{"id":"gs-n9qmws","key":"salary","type":"number-input","label":"Х╣╥Г┌╧Е╥╔Х╣└","defaultValue":300,"min":0,"max":2000},{"id":"gs-oy88en","key":"initMoney","type":"number-input","label":"Е┬²Е╖▀И┤▒И▓╠","defaultValue":1500,"builtIn":true},{"id":"gs-yzlxes","key":"turnTimeout","type":"number-input","label":"Е⌡·Е░┬Е─▓Х╝║Ф≈╤(Г╖▓)","defaultValue":15,"min":5,"max":120,"builtIn":true}],"extraLibs":"// ===== Е╓╖Е╞▄Г©│Е°╟Е⌡╬Е┘╛Е┘╠Е╨⌠О╪ Ф┴─Ф°┴Д╨▀Д╩╤ / Ф°╨Д╪ Е█║ / И≤╤Ф╝╣Д╩ёГ═│И┐╫Х┐╫Г⌡╢Ф▌╔Х╟┐Г■╗ =====\n// ФЁ╗Ф└▐О╪ Е╪∙Ф⌠▌Г╪√Х╞▒Ф≈╤Д╪ Е┬═Ф▌┴Д╩ёГ═│И┤▄Ф┴─Ф°┴ \"d-e-c-l-a-r-e\" Х©≥Д╦╙Е█∙Х╞█О╪▄Ф°╛Ф√┤Д╩╤О╪┬Е▄┘Ф▀╛ФЁ╗И┤┼О╪┴Д╦█Х╕│Е┤╨Г▌╟Е╝┐Ц─┌\n\n// ---------- Е°╟Е⌡╬Д╦┼Г └Е┘ЁИ■╝ ID ----------\nconst MM_IDS = {\n  start: \"mi-pkctf6\",\n  jail: \"mi-qpl9m8\",\n  hospital: \"mi-8korl3\",\n  shop: \"mi-2ilevy\",\n  science: \"mi-qbn9hh\", // Г╖▒Е╜╕И≥╒Г └Х╥╞И²╒Ф═╪О╪┬Е°╟Г ╝Е°╗Е╝┐ linkto Г └Е°╟Е²≈Д╦┼О╪┴О╪⌡Г═■Г╘╤Ф┴─Х╖│ MM_SCIENCE_TILES\n  exchange: \"mi-lk2mdx\", // Х╞│Е┬╦Д╨╓Ф≤⌠Ф┴─\n  stationPlotType: \"map-item-type-hpisg6\",\n  downtownPlotType: \"map-item-type-wbdfvk\", // Е╦┌Д╦╜Е©┐О╪┬И┤▒О╪┴Е°╟Е²≈\n  sciencePlotType: \"map-item-type-wuks4c\",\n};\n/** Д╪ Г╩≥Е°╟Д╦╩Е▐▒Г═■Г╘╤Ф┬░Ф·°Г └Х╥╞И²╒Ф═╪О╪ Г╖▒Е╜╕И≥╒О╪┬Д╦▀Х╬╧О╪┴Ц─│Г═■Г╘╤Ф┴─О╪┬Д╦┼Х╬╧О╪▄Е▌÷Е█≈Ф╧√Х╥╞О╪┴ */\nconst MM_SCIENCE_TILES = [\"mi-qbn9hh\", \"mi-rr441o\"];\n\n// ---------- Е█║Г┴▄Е┬├Г╨╖О╪ Ф²┐И┤█ = Е┬╥Ф√╟Е┤═Г▌┤О╪┬Ф▄┴ tier Ф┼╫О╪▄Е├█Е°╗ tier Е├┘Е²┤Е▄─Ф┼╫О╪┴О╪▄price = Е∙├Е╨≈Е■╝Д╩╥ ----------\ntype MMTier = 1 | 2 | 3 | 4;\nconst MM_TIERS: Record<MMTier, { name: string; color: string; weight: number; price: number }> = {\n  1: { name: \"Ф≥╝И─ \", color: \"#78909C\", weight: 50, price: 150 },\n  2: { name: \"Г╗─Ф°┴\", color: \"#1E88E5\", weight: 30, price: 300 },\n  3: { name: \"Е▐╡Х╞≈\", color: \"#8E24AA\", weight: 15, price: 550 },\n  4: { name: \"Д╪═Х╞╢\", color: \"#FF8F00\", weight: 5, price: 900 },\n};\nconst MM_CARD_TIER: Record<string, MMTier> = {\n  Е╫╘Г╔╗: 1, Е©╚И╘╛Е┼═И·╜: 1, Х║ёИ■╕Х©≤Д╧║: 1, Ф÷╔Г╗▌: 1, Ф▀├Х©│И≤÷: 1, Д╧╬Е²╓Е╓╖Ф▄╙Г╖╩: 1,\n  Е┘█Х╢╧Хё┘Д©╝: 1, Е°╟Д╨╖Д╦╜Д╩▀: 1, Е┬├Г╨╒Ф≈╔: 1,\n  Г╨╒Е▄┘И⌡╗: 2, Ф┴⌠Е┼╚: 2, Х╠╧Е╜░И╙╟: 2, Ф┼⌠Е▌╩Ф┴⌠Е╥╔: 2, Е°╟И⌡╥: 2,\n  Ф╤╗Е│°Е█║: 2, Х╥▄Е│°Е█║: 2, И─│Х┌║: 2, Х╥╞И °: 2,\n  Д╦╬Ф┼╔: 3, Д╩╩Ф└▐И≈╗: 3, Е²┤Е╞▄Е█║: 3, Е┘█Ф╜╩И┤▒Г┴▄: 3, И│╔Ф▌╖И╙╟Е╜░: 3,\n  Е├┘Е╧∙Ф╤┬Ф│╞: 3, Г┴⌡Е╦┌: 3, Х┌║Г│╬: 3, Е╪╨Е┬╤Ф■╤Х╢╜: 3,\n};\n// Е©┘И║╩Д╦▌Е╪∙Ф⌠▌Д╦─Х┤╢О╪ Е╪∙Ф⌠▌ player.card.gain Е°╗Ф┴▀Г┴▄ >= 4 Ф≈╤Д╪ Г⌡╢Ф▌╔Д╦╒Е╪┐Ф√╟Е█║Д╦■Д╦█Ф▐░Г╓╨\nconst MM_MAX_HAND = 4;\nconst MM_SHOP_OFFERS = 3;\nconst MM_DIALOG_MS = 30000;\n\nconst mmTierOf = (cardName: string): MMTier => MM_CARD_TIER[cardName] ?? 1;\nconst mmPlayerLink = (gp: IGameProcess, p: IPlayer) => gp.createGameLinkItem(GameLinkItem.Player, p.id);\nconst mmCardLink = (gp: IGameProcess, cardInfoId: string) => gp.createGameLinkItem(GameLinkItem.ChanceCard, cardInfoId);\nconst mmPropLink = (gp: IGameProcess, prop: IProperty) => gp.createGameLinkItem(GameLinkItem.Property, prop.id);\n\n/** Е░▄Ф≈╤Е▐▒Е┘╗Е╠─И─ Г÷╔Е▓▄Ф╦╦Ф┬▐Х╝╟Е╫∙О╪┬Х╝╟Е╫∙И┤▄Г └Е░█Е╜≈Г■╗Е▐╞Г┌╧Е┤╩И⌠╬Ф▌╔О╪┴ */\nfunction mmAnnounce(gp: IGameProcess, type: \"success\" | \"warning\" | \"info\" | \"error\", notice: string, log: string) {\n  gp.msgNotifyBroadcast(type, notice);\n  gp.gameLogBroadcast(log);\n}\n\n/**\n * Ф°╨Д╪ Е█║Ф∙┬Ф·°Е▄┘Хё┘Ц─┌Е╪∙Ф⌠▌Г └И║╨Е╨▐Ф≤╞\"Ф┴╖Х║▄Е█║Г┴▄Ф∙┬Ф·° Б├▓ Е├≥Ц─▄Д╫©Г■╗Д╨├Ф°╨Д╪ Е█║Ц─█Х╝╟Е╫∙\"О╪▄\n * Ф┴─Д╩╔Ф∙┬Ф·°И┤▄Е├≥Г └Ф╦╦Ф┬▐Х╝╟Е╫∙Д╪ Ф▌▓Е°╗Ц─▄Д╫©Г■╗Д╨├Ф°╨Д╪ Е█║Ц─█Е┴█И²╒Ц─┌Х©≥И┤▄Е°╗Ф∙┬Ф·°Ф°÷И≈╢Е┘┬Ф┼┼Ф╦╦Ф┬▐Х╝╟Е╫∙Г╪⌠Е╜≤Х╣╥Ф²╔О╪▄\n * Г╜┴Е╪∙Ф⌠▌Е├≥Е╝▄И┌ёФ²║Д╧▀Е░▌Е├█Ф▄┴Е▌÷И║╨Е╨▐Х║╔Е▐▒Ц─┌Г■╗ФЁ∙О╪ (async (...) => mmCard(gameProcess, async () => { ... }));\n */\nasync function mmCard(gp: IGameProcess, body: () => Promise<void>) {\n  const host = gp as unknown as { gameLogBroadcast: (log: string) => void };\n  const hadOwn = Object.prototype.hasOwnProperty.call(host, \"gameLogBroadcast\");\n  const original = host.gameLogBroadcast;\n  const queue: string[] = [];\n  host.gameLogBroadcast = (log: string) => { queue.push(log); };\n  try {\n    await body();\n  } finally {\n    if (hadOwn) host.gameLogBroadcast = original;\n    else delete (host as Partial<typeof host>).gameLogBroadcast;\n    // Е╪∙Ф⌠▌Е°╗Ф∙┬Ф·°Г╩⌠Ф²÷Е░▌Е░▄Ф╜╔Е├≥Ц─▄Д╫©Г■╗Д╨├Ф°╨Д╪ Е█║Ц─█О╪▄Д╦▀Д╦─Д╦╙Е╝▐Д╩╩Е┼║Е├█Х║╔Е▐▒О╪▄Д©²Х╞│Ф▌▓Е°╗Е╝┐Е░▌И²╒\n    if (queue.length > 0) setTimeout(() => { for (const log of queue) gp.gameLogBroadcast(log); }, 0);\n  }\n}\n\n/** Ф▄┴ tier Ф²┐И┤█Ф┼╫ count Е╪═Д╨▓Д╦█И┤█Е╓█Г └Е█║Г┴▄Ф╗║Ф²© */\nfunction mmPickCards(gp: IGameProcess, count: number): ChanceCardInfo[] {\n  const pool = [...gp.chanceCardInfos.values()];\n  const picked: ChanceCardInfo[] = [];\n  while (picked.length < count && pool.length > 0) {\n    const tiers = [...new Set(pool.map(c => mmTierOf(c.name)))];\n    let roll = Math.random() * tiers.reduce((s, t) => s + MM_TIERS[t].weight, 0);\n    let tier = tiers[tiers.length - 1];\n    for (const t of tiers) { roll -= MM_TIERS[t].weight; if (roll < 0) { tier = t; break; } }\n    const inTier = pool.filter(c => mmTierOf(c.name) === tier);\n    const card = inTier[Math.floor(Math.random() * inTier.length)];\n    picked.push(card);\n    pool.splice(pool.indexOf(card), 1);\n  }\n  return picked;\n}\n\n/**\n * Ф┴▀Г┴▄Е╥╡Ф╩║Ф≈╤Х╝╘Г▌╘Е╝╤Д╦╒Е╪┐Д╦─Е╪═Ф²╔Х┘╬Д╫█Г╫╝Ц─┌\n * Х©■Е⌡· true Х║╗Г╓╨Е╥╡Ф°┴Г╘╨Д╫█О╪┬Ф┬√Е╥╡Д╦╒Е╪┐Д╦─Е╪═О╪┴О╪▄false Х║╗Г╓╨Г▌╘Е╝╤И─┴Ф▀╘Ф■╬Е╪┐Ф√╟Е█║Ц─┌\n */\nasync function mmMakeRoom(gp: IGameProcess, player: IPlayer, incoming: string): Promise<boolean> {\n  if (player.chanceCards.length < MM_MAX_HAND) return true;\n  const options = player.chanceCards.map(c => {\n    const t = MM_TIERS[mmTierOf(c.getName())];\n    return mmOption(c.getId(), `Д╦╒Е╪┐Ц─░${t.name}Ц─▒${c.getName()}`, c.getDescribe(), t.color);\n  });\n  const pick = await mmChoose(gp, player, `Ф┴▀Г┴▄Е╥╡Ф╩║О╪┬${MM_MAX_HAND} Е╪═О╪┴`,\n    `Ф┐ЁХ╕│Ц─▄${incoming}Ц─█Г └Х╞²О╪▄И°─Х╕│Е┘┬Д╦╒Е╪┐Д╦─Е╪═Ф┴▀Г┴▄Ц─┌`, options, `Д╦█Х╕│Ц─▄${incoming}Ц─█Д╨├`, 2);\n  const card = player.chanceCards.find(c => c.getId() === pick);\n  if (!card) return false;\n  await player.loseCard(card.getId());\n  mmAnnounce(gp, \"info\", `${player.name} Д╦╒Е╪┐Д╨├Ф°╨Д╪ Е█║Ц─▄${card.getName()}Ц─█`,\n    `${mmPlayerLink(gp, player)} Д╦╒Е╪┐Д╨├Ф°╨Д╪ Е█║ ${mmCardLink(gp, card.getSourceId())}`);\n  return true;\n}\n\n/** И ▐Ф°╨Е▐▒Д╦─Е╪═Е█║О╪┬Ф┴▀Г┴▄Ф╩║Ф≈╤Е▐╞Д╩╔Д╦╒Е╪┐Д╦─Е╪═Ф█╒Ф√╟Е█║О╪┴Ц─┌reason Д╬▀Е╕┌ \"Ф┼╫Е┬╟Д╨├Ф°╨Д╪ Е█║\" */\nasync function mmGiveRandomCard(gp: IGameProcess, player: IPlayer, reason: string, tag = \"\"): Promise<boolean> {\n  const [info] = mmPickCards(gp, 1);\n  if (!info) return false;\n  if (!(await mmMakeRoom(gp, player, info.name))) {\n    gp.messageNotify([player.id], { type: \"info\", content: `Ф■╬Е╪┐Д╨├Ц─▄${info.name}Ц─█` });\n    return false;\n  }\n  await player.gainCard(gp.createNewChanceCard(info.id));\n  const tier = MM_TIERS[mmTierOf(info.name)];\n  mmAnnounce(gp, \"info\", `${tag}${player.name} ${reason}О╪ Ц─░${tier.name}Ц─▒Ц─▄${info.name}Ц─█`,\n    `${mmPlayerLink(gp, player)} ${reason}О╪ Ц─░${tier.name}Ц─▒${mmCardLink(gp, info.id)}`);\n  return true;\n}\n\n/** Е█║Г┴▄Е▐√Ф╤┬Д╫©Г■╗Ф≈╤О╪▄Е▌÷Ф═╥И──Е⌡·Д╦─Е╪═О╪┬Д╫©Г■╗Ф≈╤Е╪∙Ф⌠▌Е╥╡Г╩▐Ф┴ёФ▌┴Д╨├Х©≥Е╪═Е█║О╪┴ */\nasync function mmRefundCard(gp: IGameProcess, player: IPlayer, cardName: string, why: string) {\n  const info = [...gp.chanceCardInfos.values()].find(i => i.name === cardName);\n  if (info) await player.gainCard(gp.createNewChanceCard(info.id));\n  gp.messageNotify([player.id], { type: \"info\", content: `${why}О╪▄Ц─▄${cardName}Ц─█Е╥╡И──Е⌡·Ф┴▀Г┴▄` });\n}\n\n/** И─┴Ф▀╘Ф║├И┤▄Г └Д╦─Х║▄О╪┬UISchemaО╪┴ */\nfunction mmOption(id: string, title: string, subtitle: string, color: string): { id: string; display: UISchema } {\n  return {\n    id,\n    display: {\n      id: `opt-${id}`, type: \"div\",\n      style: { display: \"flex\", flexDirection: \"column\", gap: \"0.2em\", padding: \"0.5em 0.7em\", border: `2px solid ${color}`, borderRadius: \"0.6em\" },\n      children: [\n        { id: `opt-${id}-t`, type: \"text\", content: title, style: { color, fontWeight: \"bold\" } },\n        { id: `opt-${id}-s`, type: \"text\", content: subtitle, style: { fontSize: \"0.85em\", opacity: \"0.8\" } },\n      ],\n    },\n  };\n}\nconst MM_CANCEL = \"__cancel__\";\n\n/** Х╝╘Г▌╘Е╝╤Д╩▌Е┬≈Х║╗И┤▄Е█∙И─┴Д╦─И║╧О╪⌡Х╤┘Ф≈╤Ц─│Е┘ЁИ≈╜Ф┬√И─┴\"Е▐√Ф╤┬\"И┐╫Х©■Е⌡· undefined */\nasync function mmChoose(gp: IGameProcess, player: IPlayer, title: string, content: string, options: { id: string; display: UISchema }[], cancelText: string, column = 2): Promise<string | undefined> {\n  const itemList = [...options, mmOption(MM_CANCEL, cancelText, \"\", \"#9E9E9E\")];\n  const res = await gp.showItemSelectDialog(player.id, { title, content, itemList, column }, { timeout: MM_DIALOG_MS, defaultValue: { selected: [] } });\n  const pick = res?.selected?.[0];\n  return pick && pick !== MM_CANCEL ? pick : undefined;\n}\n\nconst mmFindProp = (gp: IGameProcess, info: { id: string; name: string }) =>\n  gp.properties.get(info.id) ?? [...gp.properties.values()].find(p => p.name === info.name);\n\n/** Х╥╞И²╒Ф═╪Е╜░Д╦┼Ф▄┌Г └Е°╟Г ╝О╪┬Е°╟Г ╝Е°╗ linkto Ф▄┤Е░▒Г └Е°╟Е²≈Д╦┼О╪┴ */\nfunction mmPropertyAt(gp: IGameProcess, mapItemId: string): { plot?: MapItem; prop?: IProperty } {\n  const item = gp.getMapItemById(mapItemId);\n  const plot = item?.linkto ? gp.getMapItemById(item.linkto) : undefined;\n  return { plot, prop: plot?.property ? mmFindProp(gp, plot.property) : undefined };\n}\n\n/** Ф┴─Ф°┴Е▐╞Х╣╟Г └Ф═╪Е╜░О╪▄Ф▄┴\"Д╩▌Х╣╥Г┌╧Ф╡©Е╓√Е°┬Х╣╟Д╦─Е°┬О╪▄Е├█Е┬╟Е╦┌Д╦╜Е©┐\"Г └И║╨Е╨▐ */\nfunction mmOrderedPathItems(gp: IGameProcess): string[] {\n  const all = new Set(gp.getPathMapItemIds());\n  const order: string[] = [];\n  let cur: string | undefined = gp.mapData.startMapItemId;\n  while (cur && all.has(cur) && !order.includes(cur)) {\n    order.push(cur);\n    const next = gp.mapData.mapPaths.filter(p => p.fromMapItemId === cur).map(p => p.toMapItemId);\n    // Е╡■Х╥╞Е▐ёД╪≤Е┘┬Ф╡©Е╓√Е°┬Х╣╟О╪┬Е╓√Е°┬Г └Д╦▀Д╦─Ф═╪Г╕╩Е╫⌠Е┴█Ф═╪Ф⌡╢\"Х©°\"Д╨▌Е╦┌Д╦╜Е©┐О╪▄Х©≥И┤▄Е▐√Д╦█Е°╗Е╦┌Д╦╜Е©┐Е█│Е╜≈Д╦┼Г └И┌ёФ²║О╪┴\n    cur = next.find(id => { const m = gp.getMapItemById(id); return !!m && (m.x === 0 || m.y === 0 || m.x === 10 || m.y === 10); }) ?? next[0];\n  }\n  for (const id of all) if (!order.includes(id)) order.push(id);\n  return order;\n}\n\n/**\n * Х╣╟Х╥╞О╪▄Е╧╤Е╓└Г░├\"Е▐╙Е╞╧Г┴╧Е╝ Г▌╘Е╝╤Г■÷Ф∙┬\"Г └Г╩▐Х©┤Ф∙┬Ф·°Ц─┌\n * Х©≥Г╠╩Ф∙┬Ф·°Д╦█Г╩▒Е╝ Е°╟Е⌡╬Д╨▀Д╩╤О╪ Г╩▒Е╝ Г └Х╞²О╪▄Е╪∙Ф⌠▌Д╪ Г╩≥Ф╞▐Д╦╙Х╥╞Х©┤Г └Д╨╨И┐╫Е╧©Ф▓╜\"Г╩▐Х©┤Д╨├Б─╕Х╖╕Е▐▒Д╨▀Д╩╤\"Ц─┌\n */\n/**\n * Е╡■Х╥╞Х╖└Е┬≥О╪ Е│°Е°╗Е╡■Х╥╞Е▐ёД╦┼Е┤╨Е▐▒Ф≈╤Е▐╞Д╩╔Х┤╙Г■╠И─┴Х╥╞О╪⌡Е┘╤Д╩√Ф≈╤Е─≥Ф▄┴Х©≥Ф╛║Г └Ф╜╔Ф∙╟Х┤╙Е┼╗Е┬├Ф╣│О╪┬Д╦█Е╪╧И─┴Х╥╞Ф║├О╪┴Ц─┌\n * pick(steps, dx, dy)О╪ Д╩▌Е╡■Х╥╞Е▐ёХ╣╟Е░▒Г⌡╦И┌╩Ф═╪ (dx, dy) Г └Х©≥Ф²║Х╥╞Ф≤╞Е░╕Ф■╬Х║▄Ц─┌\n * Е▄≈Г╚≥О╪ Е╔┤Ф∙╟Х©⌡Е÷▌Ц─│Е│╤Ф∙╟Ф╡©Е╓√Е°┬О╪⌡Д╦╜Е╓╝Е╧©Е°╨О╪ Г┌╧Ф∙╟ ц╥3 Д╫≥ 0 Е╬─Е╥╕Ц─│Д╫≥ 1 Е╬─Д╦▀Ц─│Д╫≥ 2 Е╬─Е▐ЁО╪┬Е╔┤Ф∙╟Г┌╧Ф∙╟Д╦▀Д╦┴Д╦╙Ф√╧Е░▒Е░└ 1/3О╪┴Ц─┌\n */\nconst MM_BRANCHES: Record<string, { rule: string; pick: (steps: number, dx: number, dy: number) => boolean; label: (dx: number, dy: number) => string }> = {\n  \"mi-b3w82c\": {\n    rule: \"Е▄≈Г╚≥Е╡■Х╥╞О╪ Е╔┤Ф∙╟Х©⌡Е÷▌О╪▄Е│╤Ф∙╟Х╣╟Е╓√Е°┬\",\n    pick: (steps, dx, dy) => (steps % 2 === 1) === (dy > 0),\n    label: (dx, dy) => (dy > 0 ? \"Ф▀░Х©⌡Д╨├Е╦┌Д╦╜Е©┐\" : \"Ф╡©Е╓√Е°┬Г╩╖Г╩╜Е┴█Х©⌡\"),\n  },\n  \"mi-egk8e9\": {\n    rule: \"Д╦╜Е╓╝Е╧©Е°╨Е╡■Х╥╞О╪ Г┌╧Ф∙╟ ц╥3 Д╫≥ 0 Е╬─Х╔©Ц─│Д╫≥ 1 Е╬─Е█≈Ц─│Д╫≥ 2 Е╬─Д╦°\",\n    pick: (steps, dx, dy) => [dx < 0, dy > 0, dx > 0][steps % 3],\n    label: (dx, dy) => (dx < 0 ? \"Е╬─Х╔©Е▄╨Х╣╟О╪┬Е⌡·Х╣╥Г┌╧Г └Х©▒Х╥╞О╪┴\" : dy > 0 ? \"Е╬─Е█≈Е▄╨Х╣╟\" : \"Е╬─Д╦°Е▄╨Х╣╟\"),\n  },\n};\n\n/** Ф▄┴Ф╜╔Ф∙╟Е▐╙Ф■╬Х║▄Е╡■Х╥╞Е▐ёД╦┼Г └Д╦─Ф²║Х╥╞О╪┬overridesО╪ Е╡■Х╥╞Е▐ё Б├▓ Ф▄┤Е╝ Г └Д╦▀Д╦─Ф═╪О╪┴О╪⌡Х©■Е⌡·Х╒╚Д╦╢Ф≈╤Е┘ЁИ≈╜Г └Х╥╞Е╬└О╪▄Х╣╟Е╝▄Е░▌Х╕│Ф│╒Е╓█ */\nfunction mmRouteBranches(gp: IGameProcess, player: IPlayer, steps: number, overrides: Record<string, string> = {}): string[] {\n  const closed: string[] = [];\n  for (const [node, branch] of Object.entries(MM_BRANCHES)) {\n    if (node === player.positionMapItemId) continue; // Е│°Е°╗Е╡■Х╥╞Е▐ёД╦┼Е┤╨Е▐▒О╪ Х┤╙Г■╠И─┴\n    const from = gp.getMapItemById(node);\n    if (!from) continue;\n    const paths = gp.mapData.mapPaths.filter(p => p.fromMapItemId === node && gp.isMapPathEnabled(p.id));\n    const keep = overrides[node] ? paths.filter(p => p.toMapItemId === overrides[node]) : paths.filter(p => {\n      const to = gp.getMapItemById(p.toMapItemId);\n      return !!to && branch.pick(steps, to.x - from.x, to.y - from.y);\n    });\n    if (keep.length !== 1) continue; // Х╖└Е┬≥Е╞╧Д╦█Д╦┼Е°╟Е⌡╬Ф≈╤Д╦█Е╧╡И╒└О╪▄И──Е⌡·Е╪∙Ф⌠▌Г └Х┤╙Г■╠И─┴Х╥╞\n    for (const p of paths) if (p !== keep[0]) { gp.setMapPathEnabled(p.id, false); closed.push(p.id); }\n  }\n  return closed;\n}\n\n/**\n * Ф▄┴Е╡■Х╥╞Х╖└Е┬≥Ф▌╗Г╝≈Х©≥Ф╛║Д╪ Х╣╟Х©┤Г └Ф═╪Е╜░О╪┬Д╦█Е░╚Х╣╥Г┌╧О╪┴Ц─┌\n * Х╣╥Г┌╧Ф≤╞Е╡■Х╥╞Е▐ёФ≈╤И°─Х╕│ firstPickО╪┬Х┤╙Г■╠И─┴Г └Д╦▀Д╦─Ф═╪О╪┴О╪▄Е░╕Е┬≥Ф▌╗Г╝≈Д╦█Д╨├О╪▄Х©■Е⌡·Г╘╨Ц─┌\n * overridesО╪ Е╡■Х╥╞Е▐ё Б├▓ Ф▄┤Е╝ Г └Д╦▀Д╦─Ф═╪О╪┬Ф°╗Е╜░Ф²▌О╪┴О╪⌡ruleStepsО╪ Е╡■Х╥╞Х╖└Е┬≥Г■╗Г └Г┌╧Ф∙╟О╪┬Ф▌╗Г╝≈Е░▌Е█┼Ф╝╣Х╥╞Г╨©Ф≈╤Е▓▄ steps Д╦█Е░▄О╪┴Ц─┌\n */\nfunction mmPlanRoute(gp: IGameProcess, startAt: string, steps: number, firstPick?: string, overrides: Record<string, string> = {}, ruleSteps = steps): string[] {\n  const route: string[] = [];\n  let cur = startAt;\n  for (let i = 0; i < steps; i++) {\n    const outs = gp.mapData.mapPaths.filter(p => p.fromMapItemId === cur && gp.isMapPathEnabled(p.id));\n    let next: string | undefined;\n    if (outs.length === 1) next = outs[0].toMapItemId;\n    else if (i === 0 && firstPick) next = firstPick;\n    else if (i > 0) {\n      const branch = MM_BRANCHES[cur], from = gp.getMapItemById(cur);\n      const keep = overrides[cur] ? outs.filter(p => p.toMapItemId === overrides[cur]) : branch && from ? outs.filter(p => {\n        const to = gp.getMapItemById(p.toMapItemId);\n        return !!to && branch.pick(ruleSteps, to.x - from.x, to.y - from.y);\n      }) : [];\n      if (keep.length === 1) next = keep[0].toMapItemId;\n    }\n    if (!next) break;\n    route.push(next);\n    cur = next;\n  }\n  return route;\n}\n\n/** Е°╗Е╡■Х╥╞Е▐ёД╦┼Е┤╨Е▐▒Ф≈╤Г■╠Ф┬▒Д╩╛Е╪╧И─┴Х╥╞Ф║├О╪┬Ф═┤Е┤╨Х╥╞И °О╪┴О╪⌡Х©■Е⌡·И─┴Д╦╜Г └Д╦▀Д╦─Ф═╪О╪▄Г▌╘Е╝╤Е┘ЁФ▌┴Ф║├Ф≈╤Е▐√Г╛╛Д╦─Д╦╙ */\nasync function mmChooseFirstStep(gp: IGameProcess, player: IPlayer, steps: number, firsts: string[]): Promise<string> {\n  const blocks: Record<string, string> = gp.customData.roadblocks ?? {};\n  const startAt = player.positionMapItemId;\n  const from = gp.getMapItemById(startAt), branch = MM_BRANCHES[startAt];\n  const options = firsts.map(first => {\n    const to = gp.getMapItemById(first);\n    const route = mmPlanRoute(gp, startAt, steps, first);\n    const hit = route.findIndex(id => blocks[id]);\n    const label = branch && from && to ? branch.label(to.x - from.x, to.y - from.y) : (to?.type.name ?? first);\n    return mmOption(first, label, hit >= 0 ? `П÷ ╖ Г╛╛ ${hit + 1} Ф╜╔Д╪ Х╒╚Х╥╞И °Ф▀╕Д╦▀` : \"Х©≥Ф²║Х╥╞Д╦┼Ф╡║Ф°┴Х╥╞И °\", hit >= 0 ? \"#E53935\" : \"#43A047\");\n  });\n  return (await mmChoose(gp, player, \"И─┴Ф▀╘Ф√╧Е░▒\", `Х©≥Ф╛║Х╣╟ ${steps} Ф╜╔Ц─┌`, options, \"И ▐Д╬©Х╣╟\", 1)) ?? firsts[0];\n}\n\n/** И■│Е╝ Д╦─Ф²║Х╥╞Г╨©О╪ Ф╡©И─■Ф╞▐Д╦─Ф═╪Е▐╙Ф■╬Х║▄Х╥╞Г╨©Д╦┼Г └Д╦▀Д╦─Ф╜╔О╪┬Е©┘Х╕│Ф≈╤Д╦╢Ф≈╤Ф┴⌠Е╪─Е▐█Е░▒Х╥╞Е╬└О╪┴Ц─┌Ф═╪Е╜░Ф°┴И┤█Е╓█Ф≈╤Х©■Е⌡· undefined */\nfunction mmPinRoute(gp: IGameProcess, startAt: string, route: string[]): { closed: string[]; opened: string[] } | undefined {\n  const nodes = [startAt, ...route.slice(0, -1)];\n  if (new Set(nodes).size !== nodes.length) return undefined;\n  const closed: string[] = [], opened: string[] = [];\n  for (let j = 0; j < route.length; j++) {\n    const paths = gp.mapData.mapPaths.filter(p => p.fromMapItemId === nodes[j]);\n    const target = paths.find(p => p.toMapItemId === route[j]);\n    if (!target) {\n      for (const id of closed) gp.setMapPathEnabled(id, true);\n      for (const id of opened) gp.setMapPathEnabled(id, false);\n      return undefined;\n    }\n    if (!gp.isMapPathEnabled(target.id)) { gp.setMapPathEnabled(target.id, true); opened.push(target.id); }\n    for (const p of paths) if (p !== target && gp.isMapPathEnabled(p.id)) { gp.setMapPathEnabled(p.id, false); closed.push(p.id); }\n  }\n  return { closed, opened };\n}\n\nasync function mmWalk(gp: IGameProcess, player: IPlayer, steps: number) {\n  mmReverseGuard(gp); // Ф°╗Е╜░Ф²▌Д╦⌠Г■╗Г └Е▐█Е░▒Х╥╞Е╬└Е╧ЁФ≈╤Д╦─Е╬▀Е┘ЁИ≈╜\n  const startAt = player.positionMapItemId;\n  const blocks: Record<string, string> = gp.customData.roadblocks ?? {};\n  // Х╥╞И °Е╟╠Е°╗Х└ Д╦▀О╪ Д╦─Е┤╨Е▐▒Е╟╠Х╒╚Ф▀╕Д╫▐О╪▄Е▌÷Е°╟Д╦█Е┼╗О╪▄Х©≥Д╦─Ф═╪Е├█Г╩⌠Г╝≈Д╦─Ф╛║О╪┬Е┬╟Х╬╬И≤╤Ф╝╣Г┘╖Е╦╦Е╓└Г░├О╪┴\n  if (blocks[startAt]) {\n    const setter = gp.players.get(blocks[startAt]);\n    delete blocks[startAt];\n    const where = mmPropertyAt(gp, startAt).prop?.name ?? gp.getMapItemById(startAt)?.type.name ?? \"Ф÷░Е╓└\";\n    mmAnnounce(gp, \"warning\", `${player.name} Х╒╚${setter ? ` ${setter.name} Г └` : \"\"}Х╥╞И °Ф▀╕Е°╗Е▌÷Е°╟Ц─▄${where}Ц─█О╪▄Х©≥Д╦─Ф═╪Е├█Г╩⌠Г╝≈Д╦─Ф╛║`,\n      `${mmPlayerLink(gp, player)} Х╒╚${setter ? ` ${mmPlayerLink(gp, setter)} Г └` : \"\"}П÷ ╖Х╥╞И °Ф▀╕Е°╗Е▌÷Е°╟Ц─▄${where}Ц─█О╪▄Х©≥Д╦─Ф═╪Е├█Г╩⌠Г╝≈Д╦─Ф╛║`);\n    await mmRolesAfterWalk(gp, player, []);\n    return;\n  }\n  const hasBlocks = Object.keys(blocks).length > 0;\n  let walkSteps = steps;\n  let firstPick: string | undefined;\n  let blockedAt: string | undefined;\n  const mutsumi = mmHasRole(player, \"mutsumi\") && !player.isBankrupted;\n  const incoming = mutsumi ? mmMutsumiState(gp, player)?.from : undefined;\n  const firsts = gp.mapData.mapPaths.filter(p => p.fromMapItemId === startAt && gp.isMapPathEnabled(p.id))\n    .map(p => p.toMapItemId).filter(t => t !== incoming);\n  // Е°╗Е╡■Х╥╞Е▐ёД╦┼Е┤╨Е▐▒О╪ Ф°╗Е╜░Ф²▌Ф─╩Ф≤╞Г■╠Ф┬▒Д╩╛Е╪╧Ф║├О╪┬Е╔╧Г └Х╥╞Г╨©Х╕│Ф▐░Е┴█Г╝≈Е╔╫О╪┴О╪⌡Е┘╤Д╩√Д╨╨Е▐╙Е°╗Ф°┴Х╥╞И °Ф≈╤Е╪╧Ф║├О╪▄Е░╕Е┬≥Д╨╓Г╩≥Е╪∙Ф⌠▌\n  if (firsts.length > 1 && (mutsumi || (hasBlocks && firsts.some(f => mmPlanRoute(gp, startAt, steps, f).some(id => blocks[id]))))) {\n    firstPick = await mmChooseFirstStep(gp, player, steps, firsts);\n  }\n  const pin = mutsumi ? mmMutsumiPlan(gp, player, steps, firstPick) : undefined;\n  if (pin) walkSteps = Math.min(walkSteps, pin.route.length);\n  if (hasBlocks) {\n    const route = pin ? pin.route : mmPlanRoute(gp, startAt, steps, firstPick);\n    const hit = route.slice(0, walkSteps).findIndex(id => blocks[id]);\n    if (hit >= 0) { walkSteps = hit + 1; blockedAt = route[hit]; }\n  }\n  let closed: string[] = [], opened: string[] = [];\n  const pinned = pin && walkSteps > 0 ? mmPinRoute(gp, startAt, pin.route.slice(0, walkSteps)) : undefined;\n  if (pinned) ({ closed, opened } = pinned);\n  else {\n    closed = mmRouteBranches(gp, player, steps);\n    if (firstPick) {\n      for (const p of gp.mapData.mapPaths) {\n        if (p.fromMapItemId === startAt && p.toMapItemId !== firstPick && gp.isMapPathEnabled(p.id)) { gp.setMapPathEnabled(p.id, false); closed.push(p.id); }\n      }\n    }\n  }\n  let res: { segments?: MapMovementSegment[] } | undefined;\n  try {\n    if (walkSteps > 0) res = await player.commandBus.execute({ type: \"player.walk\", payload: { steps: walkSteps } });\n  } finally {\n    for (const id of closed) gp.setMapPathEnabled(id, true);\n    for (const id of opened) gp.setMapPathEnabled(id, false);\n  }\n  const segments = res?.segments ?? [];\n  // Х╥╞И °О╪ Ф▀╕Д╦▀Е░▌Ф▀├Ф▌┴\n  if (blockedAt && player.positionMapItemId === blockedAt) {\n    const setter = gp.players.get(blocks[blockedAt]);\n    delete blocks[blockedAt];\n    const where = mmPropertyAt(gp, blockedAt).prop?.name ?? gp.getMapItemById(blockedAt)?.type.name ?? \"Ф÷░Е╓└\";\n    mmAnnounce(gp, \"warning\", `${player.name} Х╒╚${setter ? ` ${setter.name} Г └` : \"\"}Х╥╞И °Ф▀╕Е°╗Д╨├Ц─▄${where}Ц─█`,\n      `${mmPlayerLink(gp, player)} Х╒╚${setter ? ` ${mmPlayerLink(gp, setter)} Г └` : \"\"}П÷ ╖Х╥╞И °Ф▀╕Е°╗Д╨├Ц─▄${where}Ц─█О╪┬Ф°╛Х╞╔Х╣╟ ${steps} Ф╜╔О╪▄Х╣╟Д╨├ ${walkSteps} Ф╜╔О╪┴`);\n  }\n  // Х╝╟Е╫∙Е╡■Х╥╞О╪ Ф°╗Е╜░Ф²▌Ф■╧И│⌠Г └Е├≥Е╔╧Г └Г░├Г■╠О╪⌡Х╒╚Ф╜╔Ф∙╟Е┬├Ф╣│Г └Е├≥Х╖└Е┬≥О╪┬Х┤╙Г■╠И─┴Г └Д╦█Х╝╟О╪┴\n  for (const seg of segments) {\n    const note = pin?.notes[seg.fromMapItemId];\n    if (note) {\n      gp.msgNotifyBroadcast(\"info\", `${mmSkillTag(gp, player)}${player.name} Е°╗Х╥╞Е▐ёГ┼╧Х╠╚Д╨├Д╦─Д╦▀Б─╕Б─╕${note}`);\n      gp.gameLogBroadcast(`${mmPlayerLink(gp, player)} Е°╗Х╥╞Е▐ёГ┼╧Х╠╚Д╨├Д╦─Д╦▀Б─╕Б─╕${note}`);\n      continue;\n    }\n    const branch = MM_BRANCHES[seg.fromMapItemId];\n    const from = gp.getMapItemById(seg.fromMapItemId), to = gp.getMapItemById(seg.toMapItemId);\n    if (!branch || !from || !to || seg.fromMapItemId === startAt) continue;\n    gp.gameLogBroadcast(`${mmPlayerLink(gp, player)} Х╣╟Д╨├ ${steps} Ф╜╔О╪▄${branch.rule}О╪▄${branch.label(to.x - from.x, to.y - from.y)}`);\n  }\n  if (mutsumi) mmMutsumiRemember(gp, player, segments);\n  const visited = segments.map(s => s.toMapItemId);\n  // Г╖▒Е╜╕И≥╒Ц─│Г═■Г╘╤Ф┴─О╪ Е°╟Д╦╩Г╩▐Х©┤Ф┬√Е│°Д╦▀Е░└Е▐▒Д╦─Е╪═Е█║О╪┬Д╦╓Е╓└Д╨▓Г⌡╦Г▀╛Г╚▀О╪┴\n  for (const tile of MM_SCIENCE_TILES) {\n    if (!visited.includes(tile) || player.isBankrupted) continue;\n    const { prop } = mmPropertyAt(gp, tile);\n    if (prop?.owner?.id === player.id) await mmGiveRandomCard(gp, player, `Г╩▐Х©┤Х┤╙Е╥╠Г └${prop.name}О╪▄Г═■Г╘╤Ф┬░Ф·°Е┬╟Ф┴▀`);\n  }\n  await mmRolesAfterWalk(gp, player, visited);\n}\n\n/** Е┬╟Х╬╬Г╩⌠Г╝≈О╪▄Д╧▀Е░▌Е╓└Г░├Е┬╟Х╬╬Г╠╩Х╖▓Х┴╡Ф┼─Х┐╫О╪┬Ф°┬Е╓°Х╖│О╪┴ */\nasync function mmHandleArrival(gp: IGameProcess, player: IPlayer) {\n  await mmHandleArrivalCore(gp, player);\n  try {\n    await mmRolesAfterArrival(gp, player);\n  } catch (e) {\n    gp.msgNotifyBroadcast(\"error\", `Х╖▓Х┴╡Ф┼─Х┐╫Е┤╨И■≥О╪ ${e instanceof Error ? e.message : String(e)}`);\n  }\n}\n\n/** Е┬╟Х╬╬Г╩⌠Г╝≈О╪ Е°╟И⌡╥Ц─│Е∙├Е╨≈Х╣═Е█║Ц─│Д╨║Г│╣Ц─│И╒└Е╝ Ц─│Е▌÷Г┴┬Г╩⌠Г╝≈О╪┬Д╧╟Е°╟/Ф■╤Г╖÷/Ф═╪Е╜░Д╨▀Д╩╤О╪┴Ц─│Ф■╤Г╖÷Х╝╟Е╫∙Ц─│Е·└Ф√╜Д╦▌Х╫╕Г╚≥Е┼═Ф┬░ */\nasync function mmHandleArrivalCore(gp: IGameProcess, player: IPlayer) {\n  let handled = false;\n  try {\n    const here = player.positionMapItemId;\n\n    // Е°╟И⌡╥О╪ Г┌╦Х©⌡Е▄╩И≥╒О╪▄Е╧╤Г╚▀Е█ЁГ╩⌠Г╝≈Е▄╩И≥╒\n    const mines: Record<string, string> = gp.customData?.mines ?? {};\n    if (mines[here]) {\n      const planter = gp.players.get(mines[here]);\n      delete mines[here];\n      mmAnnounce(gp, \"warning\", `${player.name} Х╦╘Д╦╜Д╨├ ${planter?.name ?? \"Ф÷░Д╨╨\"} Е÷▀Г └Е°╟И⌡╥О╪▄Х╒╚Г┌╦Х©⌡Д╨├Е▄╩И≥╒О╪│`,\n        `${mmPlayerLink(gp, player)} Х╦╘Д╦╜Д╨├ ${planter ? mmPlayerLink(gp, planter) : \"Ф÷░Д╨╨\"} Е÷▀Г └Е°╟И⌡╥О╪▄Х╒╚Г┌╦Х©⌡Е▄╩И≥╒`);\n      await player.tpToMapItem(MM_IDS.hospital);\n      handled = true;\n      await gp.handleArriveEvent(player);\n      return;\n    }\n\n    // Е∙├Е╨≈О╪ Е│°Е°╗И≈╗Е▐ёИ─│Д╦─Е╪═Е█║О╪┬Х╥╞Х©┤Ф≈╤Г └Х╢╜Г┴╘Г■╠Е∙├Е╨≈Ф═╪Г └\"Г╩▐Х©┤Д╨▀Д╩╤\"Е╓└Г░├О╪▄Е│°Д╦▀Ф≈╤Д╧÷Д╪ Х╖╕Е▐▒О╪┴\n    if (here === MM_IDS.shop) await mmGiveRandomCard(gp, player, \"Е°╗Е∙├Е╨≈И≈╗Е▐ёЕ│°Д╦▀О╪▄Е╨≈Д╦╩И─│Д╨├Д╦─Е╪═Е█║\");\n\n    const { plot, prop } = mmPropertyAt(gp, here);\n\n    // Д╨║Г│╣О╪ Д╦█Д╩≤Е┬╚Д╨╨Г └Х©┤Х╥╞Х╢╧О╪▄Д╧÷Д╦█Х┐╫Д╧╟Ф≈═Д╦╩Г └Е°╟\n    if (prop && prop.owner?.id !== player.id && player.buffManager.hasBuffWithTag(\"undead\")) {\n      if (prop.owner) {\n        mmAnnounce(gp, \"info\", `Д╨║Г│╣ ${player.name} Иё≤Х©⌡Ц─▄${prop.name}Ц─█О╪▄Ф┼┼Ф■╤Г╖÷Г └ ${prop.owner.name} Е░⌠Х╥▒Д╨├`,\n          `Д╨║Г│╣ ${mmPlayerLink(gp, player)} Иё≤Х©⌡ ${mmPropLink(gp, prop)}О╪▄Ф┼┼Ф■╤Г╖÷Г └ ${mmPlayerLink(gp, prop.owner)} Е░⌠Х╥▒Д╨├О╪▄Е┘█Д╩≤Х©┤Х╥╞Х╢╧`);\n      } else {\n        gp.msgNotifyBroadcast(\"info\", `Д╨║Г│╣ ${player.name} Ф┐ЁД╧╟Ц─▄${prop.name}Ц─█О╪▄Д╫├И⌠╤Х║▄Д╦█Е▓▄Д╨║Г│╣Е│ Г■÷Ф└▐`);\n      }\n      return;\n    }\n\n    // И▓╔Е▄≥Е╟▐Е│╥О╪ Е┬╚Д╨╨И╒└Е╝ Г └Ф≈═Д╦╩Е°╟Г ╝Д╧╟Д╦█Д╨├О╪⌡И▓╔Е▄≥Е╟▐Е│╥Д╧╟Д╦█Х╣╥Ф≈╤Е▐╞Д╩╔И╒└Е╝ \n    if (plot && prop && !prop.owner && (await mmReserveOnArrival(gp, player, here, plot, prop))) { handled = true; return; }\n\n    const owner = prop?.owner;\n    const levelBefore = prop?.level ?? 0;\n    const moneyBefore = player.money;\n    handled = true;\n    await gp.handleArriveEvent(player);\n\n    // Х┌║Д╩╥Х│■Е┼╗О╪ Д╧╟Е°╟ / Г⌡√Ф┬©\n    if (plot && prop && prop.owner?.id === player.id) {\n      if (owner?.id !== player.id) mmStockOnProperty(gp, plot, \"buy\");\n      else if (prop.level > levelBefore) mmStockOnProperty(gp, plot, \"build\");\n    }\n\n    // Ф■╤Г╖÷О╪┬Е╪∙Ф⌠▌Х┤╙Е╥╠Д╪ Е├≥\"Ф■╞Д╩≤Д╨├Х©┤Х╥╞Х╢╧\"Г └Ф╦╦Ф┬▐Х╝╟Е╫∙О╪┴\n    if (!plot || !prop || !owner || owner.id === player.id) return;\n    const toll = moneyBefore - player.money;\n    if (toll > 0) gp.customData.lastTollRound = gp.currentRound; // Ф┴│Д╧┐О╪ Х©≥Д╦─Х╫╝Ф°┴Д╨╨Д╨╓Х©┤Х©┤Х╥╞Х╢╧\n    const lastToll0: Record<string, number> = gp.customData.lastToll0 ?? (gp.customData.lastToll0 = {});\n    if (toll > 0 && levelBefore === 0) lastToll0[here] = toll; // И▓╔Е▄≥Е╟▐Е│╥О╪ Г╘╨Е°╟Д╦┼Е┬ Д╨╓Г └Х©┤Х╥╞Х╢╧\n    if (toll > 0 && plot.type.id === MM_IDS.stationPlotType) mmValueMove(gp, \"rail\", 0.02);\n    if (player.isBankrupted || owner.isBankrupted) return;\n\n    // Х©┤Х╥╞Х╢╧Е┼═Ф┬░О╪ Х╫╕Г╚≥Ф▄┴Г╩▐Е┘╦Х╖└Е┬≥И ▐Ф▀╔Ф°┴Ф∙╟И┤▐Г©╩Е─█О╪┬1/2/3/4 Е╨╖ = 1/2/4/8 Е─█О╪┴О╪⌡Е┘╤Е╝┐Х┴╡Г╩└Е·└Ф√╜Е░▌О╪▄Г╘╨Е°╟О╪┬0 Г╨╖О╪┴Х©┤Х╥╞Х╢╧Г©╩Е─█О╪┬Ф▄┴Е°╟Е²≈Г╠╩Е·▀Е┬├Г╩└О╪┴\n    const group = gp.mapData.mapItems.filter(mi => mi.type.id === plot.type.id && mi.property).map(mi => mmFindProp(gp, mi.property!));\n    const owned = group.filter(p => p?.owner?.id === owner.id).length;\n    const base = prop.costList[prop.level] ?? 0;\n    let extra = 0;\n    let reason = \"\";\n    if (plot.type.id === MM_IDS.stationPlotType && owned > 1) {\n      extra = base * (2 ** (owned - 1) - 1);\n      reason = `Ф▀╔Ф°┴ ${owned} Д╦╙Х╫╕Г╚≥`;\n    } else if (plot.type.id !== MM_IDS.sciencePlotType && prop.level === 0 && group.length > 1 && owned === group.length) {\n      extra = base;\n      reason = \"Е·└Ф√╜Д╨├Ф∙╢Д╦╙Х┴╡Г╩└О╪┬Г╘╨Е°╟Х©┤Х╥╞Х╢╧Г©╩Е─█О╪┴\";\n    }\n    let extraPaid = 0;\n    if (extra > 0) {\n      const res = await player.cost(extra, \"property\");\n      await owner.gain(res.actualCost, \"property\");\n      extraPaid = res.actualCost;\n      if (levelBefore === 0) lastToll0[here] = toll + extraPaid;\n    mmAnnounce(gp, \"warning\", `${owner.name} ${reason}О╪▄${player.name} И╒²Е╓√Ф■╞Д╩≤Х©┤Х╥╞Х╢╧ ${res.actualCost}`,\n        `${mmPlayerLink(gp, owner)} ${reason}О╪▄${mmPlayerLink(gp, player)} И╒²Е╓√Ф■╞Д╩≤Х©┤Х╥╞Х╢╧ ${res.actualCost}О©╔`);\n    }\n    // Ф╩╗Ф╠÷Х╥╞б╥Ф╠÷Ф≥╞О╪ Е°╟Д╦╩Е░█Д╦▀Ф┴─Ф°┴Е°╟Г ╝Г └Х©┤Х╥╞Х╢╧Е┼═Ф┬░\n    const river = mmSpecialOwner(gp, \"river\");\n    if (toll > 0 && river && river.owner.id === owner.id && !player.isBankrupted) {\n      const rate = (mmOwnsAll(gp, owner, [\"dock\", \"river\"]) ? 0.15 : 0.1) * mmSpecialBoost(river.prop);\n      const bonus = Math.round((toll + extraPaid) * rate);\n      if (levelBefore === 0) lastToll0[here] = toll + extraPaid + Math.min(bonus, player.money);\n      if (bonus > 0) {\n        const res = await player.cost(bonus, \"property\");\n        await owner.gain(res.actualCost, \"property\");\n        gp.gameLogBroadcast(`П÷▄┼ ${mmPropLink(gp, river.prop)} Ф╠÷Ф≥╞Е┼═Ф┬░О╪ ${mmPlayerLink(gp, player)} И╒²Е╓√Ф■╞Д╩≤ ${res.actualCost}О©╔ Г╩≥ ${mmPlayerLink(gp, owner)}`);\n      }\n    }\n  } catch (e) {\n    // Х┤╙Е╝ Д╧┴И─╩Х╬▒Е┤╨И■≥Ф≈╤Ф┼╔Е┤╨И■≥Х╞╞О╪▄Е╧╤Д©²Х╞│Е▌÷Г┴┬Е┬╟Х╬╬Г╩⌠Г╝≈О╪┬Д╧╟Е°╟/Ф■╤Г╖÷О╪┴Д╩█Д╪ Ф┴╖Х║▄\n    gp.msgNotifyBroadcast(\"error\", `Е┬╟Х╬╬Г╩⌠Г╝≈Е┤╨И■≥О╪ ${e instanceof Error ? e.message : String(e)}`);\n    if (!handled) await gp.handleArriveEvent(player);\n  }\n}\n\n// ================= Х┌║Г╔╗ =================\n// 4 Е╝╤Д╦╩И╒≤Е┘╛Е▐╦Ц─┌Д╦╓Д╦╙И┤▐О╪ \n// - Е┘╛Е▐╦Д╩╥Е─╪О╪┬Д╦█Е┘╛Е╪─О╪▄Ф■╬Е°╗Е▐╙Е╜≤Е°╗Д╦╩Ф°╨Г╚╞Г └ customDataО╪┴О╪ Г■╠Е°╟Е⌡╬Д╦┼Е▐▒Г■÷Г └Д╨▀О╪┬Д╧╟Е°╟Г⌡√Ф┬©Ц─│Х╫╕Г╚≥Ф■╤Г╖÷Ц─│Д╫▐И≥╒Ц─│Ф┴⌠Е╥╔О╪┴\n//   Е▓▄И ▐Ф°╨Ф√╟И≈╩Ф▌╗Е┼╗О╪▄Ф╞▐Х╫╝Х©≤Ф°┴Г╪⌠Ф┘╒Ф╪┌Г╖╩Ц─┌\n// - Х┌║Д╩╥О╪┬Е┘╛Е╪─О╪▄Ф■╬Е°╗ exportData.stocksО╪▄Е░▄Ф╜╔Г╩≥Ф┴─Ф°┴Е╝╒Ф┬╥Г╚╞О╪┴О╪ Ф╞▐Х╫╝Е╪─Г⌡≤ = Е░▒Е┘╛Е▐╦Д╩╥Е─╪Е⌡·Е╫▓ + Ф┐╞Ф─╖О╪┬Д╦┼Х╫╝Ф╤╗Х╥▄Е╩╤Г╩╜О╪┴+ Е≥╙Её╟Ц─┌\n//   Ф┐┘Г╩╙Г╠╩Е█║Г┴▄О╪┬Ф╤╗Е│°/Х╥▄Е│°/Г┴⌡Е╦┌/Х┌║Г│╬О╪┴Е▐╙Ф▌╗Х┌║Д╩╥О╪▄Д╧▀Е░▌Д╪ Х╒╚Д╩╥Е─╪Ф┘╒Ф┘╒Ф▀┴Е⌡·Ц─┌\ntype MMStockId = \"realty\" | \"rail\" | \"factory\" | \"pharma\";\nconst MM_STOCKS: Record<MMStockId, { name: string; start: number; vol: number; valueVol: number; color: string }> = {\n  realty: { name: \"Е╦┌Д╦╜Е©┐Е°╟Д╨╖\", start: 100, vol: 0.10, valueVol: 0.03, color: \"#FFB300\" },\n  rail: { name: \"Г▌╞Е÷▌И⌠│Х╥╞\", start: 80, vol: 0.07, valueVol: 0.02, color: \"#546E7A\" },\n  factory: { name: \"OЕё╚Е╨╥И⌡├Е⌡╒\", start: 60, vol: 0.12, valueVol: 0.04, color: \"#78909C\" },\n  pharma: { name: \"Д╩│Е©┐Е▄╩Х█╞\", start: 50, vol: 0.14, valueVol: 0.05, color: \"#E53935\" },\n};\n// Ф╞▐Х╫╝Е╪─Г⌡≤Г └Д╩╥Ф═╪Ф╗║Е·▀О╪┬Е⌡·Е╫▓Ц─│Ф┐╞Ф─╖Ц─│Ф√╟И≈╩Ц─│Е≥╙Её╟О╪┴Е▐┼Е┘╤Е▐┌Ф∙╟Е°╗Ц─▄Х╫╝Ф╛║Е╪─Е╖▀Ц─█И≤╤Ф╝╣Д╩ёГ═│И┤▄\nconst MM_STOCK_IDS = Object.keys(MM_STOCKS) as MMStockId[];\nconst MM_STOCK_MIN_PRICE = 5;\ninterface MMStockState {\n  prices: Record<MMStockId, number>;\n  open: Record<MMStockId, number>; // Ф°╛Х╫╝Е╪─Г⌡≤Д╩╥О╪┬Г■╗Ф²╔Ф≤╬Г╓╨Ф°╛Х╫╝Ф╤╗Х╥▄О╪┴\n  holdings: Record<string, Partial<Record<MMStockId, number>>>;\n  insider: Partial<Record<MMStockId, number>>; // Е├┘Е╧∙Ф╤┬Ф│╞О╪ Д╦▀Д╦─Х╫╝Е╪─Г⌡≤И╒²Е╓√Ф╤╗Е╧┘\n  hist?: Record<MMStockId, number[]>; // Ф╞▐Х╫╝Ф■╤Г⌡≤Д╩╥О╪┬Ф┼≤Г╨©Е⌡╬Г■╗О╪┴\n  chart?: MMStockChart; // Е╥╕Д╦┼Х╖▓Х║▄Ф┐┘И²╒Ф²©Г⌡╢Ф▌╔Г╩▒Е╝ Г └Ф∙╟Ф█╝О╪┬UI Х║╗Х╬╬Е╪▐Д╦█Х┐╫Х╟┐Ф√╧ФЁ∙О╪▄Ф┴─Д╩╔Е°╗Д╦╩Ф°╨Г╚╞Г╝≈Е╔╫О╪┴\n}\ninterface MMStockChart {\n  round: number;\n  priceLevel: string; // Е╫⌠Е┴█Г┴╘Д╩╥Е─█Г▌┤О╪┬\"1.10\"О╪┴О╪▄Е╥╕Д╦┼Х╖▓И²╒Ф²©Ф≤╬Г╓╨Е°╗Х╫╝Ф╛║Ф≈│Х╬╧\n\n  top: number;\n  bottom: number;\n  lines: { id: MMStockId; name: string; color: string; d: string; price: number; pct: string; up: boolean }[];\n}\nconst MM_STOCK_HISTORY = 20; // Ф┼≤Г╨©Е⌡╬Д©²Г∙≥Г └Х╫╝Ф∙╟\n\n/** И┤█Ф√╟Х╝║Г╝≈Х║▄Ф┐┘И²╒Ф²©О╪ Ф┼≤Г╨©О╪┬SVG pathО╪▄viewBox 0 0 200 100О╪▄Ф┴─Ф°┴Х┌║Г╔╗Е┘╠Г■╗Г╨╣Х╫╢О╪┴+ Е⌡╬Д╬▀ */\nfunction mmStockChartRefresh(gp: IGameProcess) {\n  const s = mmStocks(gp);\n  const hist = (s.hist ??= {} as Record<MMStockId, number[]>);\n  const series = MM_STOCK_IDS.map(id => [...(hist[id] ?? []), s.prices[id]]);\n  const all = series.flat();\n  let lo = Math.min(...all), hi = Math.max(...all);\n  if (hi - lo < 20) { const mid = (hi + lo) / 2; lo = mid - 10; hi = mid + 10; }\n  lo = Math.max(0, Math.floor(lo * 0.95)); hi = Math.ceil(hi * 1.05);\n  const n = Math.max(2, ...series.map(pts => pts.length));\n  const x = (i: number) => (i / (n - 1)) * 200;\n  const y = (v: number) => 100 - ((v - lo) / (hi - lo)) * 100;\n  s.chart = {\n    round: gp.currentRound,\n    priceLevel: mmPriceLevel(gp).toFixed(2),\n    top: hi,\n    bottom: lo,\n    lines: MM_STOCK_IDS.map((id, k) => {\n      const pts = series[k].length > 1 ? series[k] : [series[k][0], series[k][0]];\n      const offset = n - pts.length; // Е╞╧И╫░Е▐ЁГ╚╞О╪┬Ф°─Ф√╟Д╩╥Е°╗Ф°─Е▐ЁО╪┴\n      const d = pts.map((v, i) => `${i === 0 ? \"M\" : \"L\"}${x(i + offset).toFixed(1)},${y(v).toFixed(1)}`).join(\" \");\n      const prev = mmPrevClose(gp, id); // Ф╤╗Х╥▄Е╧┘Г⌡╦Е╞╧Д╦┼Д╦─Х╫╝Ф■╤Г⌡≤О╪┬Г⌡╦Е╞╧Ф°╛Х╫╝Е╪─Г⌡≤Е┤═Д╧▌Ф╟╦Х©°Ф≤╞ +0%О╪┴\n      return { id, name: MM_STOCKS[id].name, color: MM_STOCKS[id].color, d, price: s.prices[id], pct: mmPct(s.prices[id], prev) || \"+0%\", up: s.prices[id] >= prev };\n    }),\n  };\n}\n\n/** Д╦█Е┘╛Е╪─Г └Е┘╛Е▐╦Д╩╥Е─╪Д╦▌Д╦┼Д╦─Х╫╝Ф╤╗Х╥▄О╪┬Е▐╙Е°╗Д╦╩Ф°╨Г╚╞О╪┴ */\nfunction mmStockCore(gp: IGameProcess): { value: Record<MMStockId, number>; ret: Partial<Record<MMStockId, number>> } {\n  const core = (gp.customData.stockCore ??= { value: {}, ret: {} });\n  for (const id of MM_STOCK_IDS) core.value[id] ??= mmStocks(gp).prices[id];\n  return core;\n}\n\nfunction mmStocks(gp: IGameProcess): MMStockState {\n  const ex = gp.exportData as unknown as Record<string, any>;\n  if (!ex.stocks) {\n    const prices = {} as Record<MMStockId, number>;\n    for (const id of MM_STOCK_IDS) prices[id] = MM_STOCKS[id].start;\n    ex.stocks = { prices, open: { ...prices }, holdings: {}, insider: {} } as MMStockState;\n  }\n  return ex.stocks as MMStockState;\n}\nconst mmHolding = (gp: IGameProcess, player: IPlayer, id: MMStockId) => mmStocks(gp).holdings[player.id]?.[id] ?? 0;\n/**\n * Ф╞▐Д╨╨Ф╞▐Е▐╙Х┌║Г╔╗Г └Ф▄│Д╩⌠Ф┬░Ф°╛О╪┬Ф─╩Х┼╠Х╢╧О╪┴Ц─┌Е▐╙Е°╗Д╦╩Ф°╨Г╚╞Ц─│Д╦█Е┘╛Е╪─Ц─┌\n * Ф▄┴Ф┬░Д╨╓Д╩╥Х╝║О╪▄Д╦█Е░╚Ф┴▀Г╩╜Х╢╧О╪⌡И─│Х┌║Ф▄┴Е╫⌠Ф≈╤Е╦┌Д╩╥Х╝║Е┘╔О╪⌡Е█√Е┤╨Ф≈╤Е²┤Д╩╥Д╦█Е▐≤Ц─│Ф┬░Ф°╛Ф▄┴Ф╞■Д╬▀Ф┴ёЕ┤▐Ц─┌\n */\nconst mmStockCost = (gp: IGameProcess, player: IPlayer): Partial<Record<MMStockId, number>> =>\n  ((gp.customData.stockCost ??= {})[player.id] ??= {});\n/** Ф■╧Ф▄│Х┌║Ф∙╟И┤▐О╪┬Ф┴─Ф°┴Д╧╟Е█√Ц─│И─│Х┌║Ц─│Е▐≤Е█√И┐╫Х╣╟Х©≥И┤▄О╪┴О╪▄И║╨Е╦╕Х╝╟Ф▄│Д╩⌠Ф┬░Ф°╛О╪ Е╒·Ф▄│Ф▄┴Е╫⌠Е┴█Х┌║Д╩╥Х╝║Е┘╔ */\nfunction mmSetHolding(gp: IGameProcess, player: IPlayer, id: MMStockId, qty: number) {\n  const s = mmStocks(gp);\n  const before = mmHolding(gp, player, id), after = Math.max(0, qty);\n  const cost = mmStockCost(gp, player);\n  if (after > before) cost[id] = (cost[id] ?? 0) + (after - before) * s.prices[id];\n  else if (after < before) cost[id] = after === 0 ? 0 : ((cost[id] ?? 0) * after) / before;\n  (s.holdings[player.id] ??= {})[id] = after;\n}\n/** Ф▄│Д╩⌠Х╞╢Ф≤▌О╪┬Е▐╙Г╩≥Ф°╛Д╨╨Г°▀О╪┴О╪ Ф▄│Х┌║Ф∙╟Ц─│Е²┤Д╩╥Ц─│Ф╣╝Г⌡┬ */\nfunction mmHoldingText(gp: IGameProcess, player: IPlayer, id: MMStockId): string {\n  const held = mmHolding(gp, player, id);\n  if (held <= 0) return \"Д╫═Х©≤Ф╡║Ф°┴Ф▄│Х┌║\";\n  const price = mmStocks(gp).prices[id];\n  const avg = (mmStockCost(gp, player)[id] ?? held * price) / held;\n  const pnl = Math.round((price - avg) * held);\n  const pct = avg > 0 ? `${pnl >= 0 ? \"+\" : \"\"}${Math.round((price / avg - 1) * 100)}%` : \"\";\n  return `Д╫═Ф▄│Ф°┴ ${held} Х┌║О╪▄Е²┤Д╩╥ ${Math.round(avg * 10) / 10}О©╔О╪▄${pnl >= 0 ? \"Ф╣╝Г⌡┬\" : \"Ф╣╝Д╨▐\"} ${pct}О╪┬${pnl >= 0 ? \"+\" : \"\"}${pnl}О©╔О╪┴`;\n}\nconst mmPortfolioValue = (gp: IGameProcess, player: IPlayer) =>\n  MM_STOCK_IDS.reduce((sum, id) => sum + mmHolding(gp, player, id) * mmStocks(gp).prices[id], 0);\n/** Д╦┼Д╦─Х╫╝Ф■╤Г⌡≤Д╩╥О╪┬Ф╞▐Х╫╝Е╪─Г⌡≤Е┴█Х╝╟Е┘╔Е▌├Е▐╡Г └Ф°─Е░▌Д╦─Д╦╙Е─╪О╪┴О╪⌡Х©≤Ф╡║Ф°┴Е▌├Е▐╡Ф≈╤Г■╗Ф°╛Х╫╝Е╪─Г⌡≤Д╩╥ */\nfunction mmPrevClose(gp: IGameProcess, id: MMStockId): number {\n  const s = mmStocks(gp);\n  const h = s.hist?.[id];\n  return h && h.length > 0 ? h[h.length - 1] : s.open[id];\n}\nconst mmPct = (now: number, before: number) =>\n  before > 0 ? `${now >= before ? \"+\" : \"\"}${Math.round((now / before - 1) * 100)}%` : \"\";\n\n/** Ф▌╗Е┼╗Е┘╛Е▐╦Д╩╥Е─╪О╪┬Е÷╨Ф°╛И²╒О╪▄pct = 0.05 Х║╗Г╓╨ +5%О╪┴О╪ Х┌║Д╩╥Д╦█Д╪ Г╚▀Е┬╩Е▐≤О╪▄Д╧▀Е░▌Е┤═Х╫╝И─░Ф╜╔Х©╫Д╦┼ */\nfunction mmValueMove(gp: IGameProcess, id: MMStockId, pct: number) {\n  const core = mmStockCore(gp);\n  core.value[id] = Math.max(MM_STOCK_MIN_PRICE, core.value[id] * (1 + pct));\n}\n\n/** Г╚▀Е█ЁФ▌╗Е┼╗Х┌║Д╩╥О╪┬Е╦┌Е°╨Ф┐┘Г╩╙О╪▄pct = 0.05 Х║╗Г╓╨Ф╤╗ 5%О╪┴О╪ Е┘╛Е▐╦Д╩╥Е─╪Д╦█Е▐≤О╪▄Д╧▀Е░▌Д╪ Х╒╚Ф┘╒Ф┘╒Ф▀┴Е⌡· */\nfunction mmStockMove(gp: IGameProcess, id: MMStockId, pct: number) {\n  const s = mmStocks(gp);\n  s.prices[id] = Math.max(MM_STOCK_MIN_PRICE, Math.round(s.prices[id] * (1 + pct)));\n  mmStockChartRefresh(gp);\n  gp.gameDataBroadcast();\n}\n\n/** Е°╟Д╨╖Х│■Е┼╗О╪┬Е÷╨Ф°╛И²╒О╪┴О╪ Д╧╟Е°╟ / Г⌡√Ф┬©Ф▌╗И╚≤Е°╟Д╨╖Е┘╛Е▐╦Д╩╥Е─╪О╪⌡Х╫╕Г╚≥Ф▌╗И╚≤И⌠│Х╥╞Е┘╛Е▐╦Д╩╥Е─╪ */\nfunction mmStockOnProperty(gp: IGameProcess, plot: MapItem, kind: \"buy\" | \"build\") {\n  if (plot.type.id === MM_IDS.stationPlotType) mmValueMove(gp, \"rail\", kind === \"buy\" ? 0.08 : 0.05);\n  else if (plot.type.id === MM_IDS.downtownPlotType) mmValueMove(gp, \"realty\", kind === \"buy\" ? 0.05 : 0.08);\n  else mmValueMove(gp, \"realty\", kind === \"buy\" ? 0.015 : 0.03);\n}\n\n/** И─┴Д╦─Е▐╙Х┌║Г╔╗О╪┬Е█║Г┴▄Г■╗О╪┴О╪⌡Е▐√Ф╤┬Х©■Е⌡· undefined */\nasync function mmChooseStock(gp: IGameProcess, player: IPlayer, title: string, content: string): Promise<MMStockId | undefined> {\n  const s = mmStocks(gp);\n  const options = MM_STOCK_IDS.map(id => mmOption(id, `${MM_STOCKS[id].name}Ц──${s.prices[id]}О©╔О╪┬Х╬┐Д╦┼Х╫╝ ${mmPct(s.prices[id], mmPrevClose(gp, id)) || \"+0%\"}О╪┴`,\n    mmHoldingText(gp, player, id), MM_STOCKS[id].color));\n  const pick = await mmChoose(gp, player, title, content, options, \"Е┘┬Д╦█Г■╗Д╨├\", 2);\n  return MM_STOCK_IDS.find(id => id === pick);\n}\n\n/** Д╦█Е┘╛Е╪─Х┌║Г╔╗Е░█Г └Д╨╓Ф≤⌠О╪┬Е├┘Е╧∙Ф╤┬Ф│╞Г■╗О╪┴О╪ Ф°╛Д╨╨Ф■╤Е┬╟Ф≤▌Г╩├О╪▄Е┘╤Д╩√Д╨╨Е▐╙Г÷╔И│⌠Е│ Д╨├Г╛■Д╨╓Ф≤⌠ */\nfunction mmSecretTrade(gp: IGameProcess, player: IPlayer, privateText: string) {\n  gp.messageNotify([player.id], { type: \"success\", content: privateText });\n  gp.gameLogBroadcast(`${mmPlayerLink(gp, player)} Ф┌└Ф┌└Е│ Д╨├Д╦─Г╛■Х┌║Г╔╗Д╨╓Ф≤⌠`);\n}\n\n/** Е█∙Е▐╙Х┌║Г╔╗Г └Д╦─Ф╛║Д╧╟Е█√О╪┬Д╨╓Ф≤⌠Ф┴─Е▓▄\"Е├┘Е╧∙Ф╤┬Ф│╞\"Е┘╠Г■╗О╪┴О╪⌡Х©■Е⌡·Ф≤╞Е░╕Ф┬░Д╨╓ */\nasync function mmTradeStock(gp: IGameProcess, player: IPlayer, id: MMStockId, cancelText: string, hint = \"\", secret = false): Promise<boolean> {\n  const price = mmStocks(gp).prices[id], held = mmHolding(gp, player, id);\n  const acts: { id: string; display: UISchema }[] = [];\n  const feeOf = (amount: number) => mmTradeFees(gp, player, amount).reduce((sum, f) => sum + f.fee, 0);\n  const feeText = (amount: number) => { const fee = feeOf(amount); return fee > 0 ? `О╪▄Ф┴▀Г╩╜Х╢╧ ${fee}О©╔` : \"\"; };\n  for (const n of [1, 5, 10, 20]) if (player.money > price * n + feeOf(price * n))\n    acts.push(mmOption(`buy:${n}`, `Д╧╟Е┘╔ ${n} Х┌║`, `Х┼╠Х╢╧ ${price * n}О©╔${feeText(price * n)}`, \"#43A047\"));\n  for (const n of [...new Set([1, 5, held])]) if (n > 0 && n <= held)\n    acts.push(mmOption(`sell:${n}`, n === held ? `Е┘╗И┐╗Е█√Е┤╨О╪┬${held} Х┌║О╪┴` : `Е█√Е┤╨ ${n} Х┌║`, `Ф■╤Е┘╔ ${price * n}О©╔${feeText(price * n)}`, \"#E53935\"));\n  if (acts.length === 0) {\n    gp.messageNotify([player.id], { type: \"info\", content: `Г▌╟И┤▒Д╦█Е╓÷Д╧╟Ц─▄${MM_STOCKS[id].name}Ц─█О╪▄Д╫═Д╧÷Ф╡║Ф°┴Е╝┐Г └Х┌║Г╔╗` });\n    return false;\n  }\n  const act = await mmChoose(gp, player, `${MM_STOCKS[id].name}Ц──${price}О©╔`,\n    `${hint}${mmHoldingText(gp, player, id)}Ц─┌Г▌╟И┤▒ ${player.money}О©╔Ц─┌О╪┬Д╧╟Е╝▄Г▌╟И┤▒Е©┘И║╩Х©≤Ф°┴Е┴╘Д╫≥О╪┴`, acts, cancelText, 3);\n  if (!act) return false;\n  const [kind, qtyText] = act.split(\":\");\n  const qty = Number(qtyText);\n  if (kind === \"buy\") {\n    const fees = mmTradeFees(gp, player, price * qty);\n    if (player.money <= price * qty + fees.reduce((sum, f) => sum + f.fee, 0)) return false;\n    await player.cost(price * qty, \"stock\");\n    mmSetHolding(gp, player, id, held + qty);\n    await mmPayTradeFees(gp, player, fees);\n    if (secret) mmSecretTrade(gp, player, `Д╫═Ф┌└Ф┌└Д╧╟Е┘╔Д╨├ ${qty} Х┌║Ц─▄${MM_STOCKS[id].name}Ц─█О╪┬${price}О©╔/Х┌║О╪┴`);\n    else mmAnnounce(gp, \"info\", `${player.name} Д╧╟Е┘╔ ${qty} Х┌║Ц─▄${MM_STOCKS[id].name}Ц─█О╪┬${price}О©╔/Х┌║О╪┴`,\n      `${mmPlayerLink(gp, player)} Д╧╟Е┘╔ ${qty} Х┌║ ${MM_STOCKS[id].name}О╪▄${price}О©╔/Х┌║`);\n  } else {\n    mmSetHolding(gp, player, id, held - qty);\n    await player.gain(price * qty, \"stock\");\n    await mmPayTradeFees(gp, player, mmTradeFees(gp, player, price * qty));\n    if (secret) mmSecretTrade(gp, player, `Д╫═Ф┌└Ф┌└Е█√Е┤╨Д╨├ ${qty} Х┌║Ц─▄${MM_STOCKS[id].name}Ц─█О╪┬${price}О©╔/Х┌║О╪┴`);\n    else mmAnnounce(gp, \"info\", `${player.name} Е█√Е┤╨ ${qty} Х┌║Ц─▄${MM_STOCKS[id].name}Ц─█О╪┬${price}О©╔/Х┌║О╪┴`,\n      `${mmPlayerLink(gp, player)} Е█√Е┤╨ ${qty} Х┌║ ${MM_STOCKS[id].name}О╪▄${price}О©╔/Х┌║`);\n  }\n  gp.gameDataBroadcast();\n  return true;\n}\n\n// ================= Г┴╧Ф╝┼Е°╟Е²≈ =================\n// Е█│Е╜≈Д╦┴Ф²║Х┤┌Д╦┼Г └Е°╟Г ╝Е╝╒Ф╣│Е▐╙Ф°┴Е╧ЁЕ²┤Г └ 1/5~1/3О╪▄Ф■╧Ф┬░Д╦█И²═Х©┤Х╥╞Х╢╧Ц─│И²═Х╒╚Е┼╗Х┐╫Е┼⌡Х╣ И▓╠О╪⌡\n// Е╦┌Д╦╜Е©┐Г └И┤▒Х·█Х║≈Ц─│Х╞│Е┬╦Е╓╖Е▌╕Ф≤╞Ф≥╝И─ Е°╟Г ╝О╪▄И╒²Е╓√Ф■╤Д╨╓Ф≤⌠Ф┴─Ф┴▀Г╩╜Х╢╧Ц─┌Х┐╫Е┼⌡И ▐Е°╟Г ╝Г╜┴Г╨╖Ф▐░Е█┤О╪ Ф╞▐Е█┤Д╦─Г╨╖Ф∙┬Ф·° +50%Ц─┌\nconst MM_SPECIAL_PLOTS = {\n  oldTown: \"mi-kw0hhn\", antique: \"mi-31vbp2\", // Х╔©Е▄╨б╥Х─│Е÷▌О╪ Х─│Е÷▌Е▄╨Ц─│Е▐╓Г▌╘Х║≈\n  tech: \"mi-fj25cp\", univ: \"mi-5bz7jg\", // Д╦°Е▄╨б╥Г╖▒Е┬⌡О╪ Г╖▒Ф┼─Е⌡╜Ц─│Е╓╖Е╜╕Е÷▌\n  dock: \"mi-3cgcqs\", river: \"mi-bmt9un\", // Е█≈Е▄╨б╥Ф╦╞Е▐ёО╪ Г═│Е╓╢Ц─│Ф╩╗Ф╠÷Х╥╞\n  finance: \"mi-e5sotc\", securities: \"mi-58mtl8\", plaza: \"mi-3sp7g9\", // Е╦┌Д╦╜Е©┐б╥И┤▒Х·█О╪ И┤▒Х·█Х║≈Ц─│Х╞│Е┬╦Е╓╖Е▌╕Ц─│Д╦╜Е╓╝Е╧©Е°╨\n};\ntype MMSpecialKey = keyof typeof MM_SPECIAL_PLOTS;\nfunction mmSpecialProp(gp: IGameProcess, key: MMSpecialKey): IProperty | undefined {\n  const mi = gp.getMapItemById(MM_SPECIAL_PLOTS[key]);\n  return mi?.property ? mmFindProp(gp, mi.property) : undefined;\n}\n/** Г┴╧Ф╝┼Е°╟Е²≈Е▓▄Е╝┐Г └Е°╗Д╦√Е°╟Д╦╩О╪⌡Ф╡║Д╨╨Д╧╟Ф┬√Е°╟Д╦╩Е╥╡Г═╢Д╨╖Ф≈╤Х©■Е⌡· undefined */\nfunction mmSpecialOwner(gp: IGameProcess, key: MMSpecialKey): { prop: IProperty; owner: IPlayer } | undefined {\n  const prop = mmSpecialProp(gp, key);\n  const owner = prop?.owner;\n  return prop && owner && !owner.isBankrupted ? { prop, owner } : undefined;\n}\nconst mmSpecialBoost = (prop: IProperty) => 1 + 0.5 * prop.level;\nconst mmOwnsAll = (gp: IGameProcess, owner: IPlayer, keys: MMSpecialKey[]) => keys.every(k => mmSpecialProp(gp, k)?.owner?.id === owner.id);\n\n/** Г═│Е╓╢б╥Х©⌡Е▐ёЕ┬├Ф┬░О╪ Е∙├Е╨≈Ф╞▐Е█√Е┤╨Д╦─Е╪═Е█║О╪▄И⌠╤Х║▄И╒²Е╓√Ф▀©Е┤╨Е■╝Д╩╥Г └ 20%О╪┬И⌡├И╫░Е█≈Е▄╨ 30%О╪┴Г╩≥Г═│Е╓╢Е°╟Д╦╩ */\nasync function mmDockShare(gp: IGameProcess, price: number) {\n  const dock = mmSpecialOwner(gp, \"dock\");\n  if (!dock) return;\n  const rate = (mmOwnsAll(gp, dock.owner, [\"dock\", \"river\"]) ? 0.3 : 0.2) * mmSpecialBoost(dock.prop);\n  const amount = Math.round(price * rate);\n  if (amount <= 0) return;\n  await dock.owner.gain(amount, \"property\");\n  gp.gameLogBroadcast(`П÷ ╒ ${mmPropLink(gp, dock.prop)} Д╩▌Е∙├Е╨≈Д╨╓Ф≤⌠Д╦╜Е┬├Е┬╟ ${amount}О©╔О╪┬Е°╟Д╦╩ ${mmPlayerLink(gp, dock.owner)}О╪┴`);\n}\n\n/** И┤▒Х·█Х║≈Ц─│Х╞│Е┬╦Е╓╖Е▌╕б╥Д╨╓Ф≤⌠Ф┴▀Г╩╜Х╢╧О╪ Д╨╓Ф≤⌠И╒²Г └ 1%О╪┬И⌡├И╫░Е╦┌Д╦╜Е©┐Д╦┴Е²≈ 2%О╪┴О╪▄Д╨╓Ф≤⌠Х─┘Х┤╙Е╥╠Ф≤╞Е°╟Д╦╩Ф≈╤Д╦█Ф■╤ */\nfunction mmTradeFees(gp: IGameProcess, trader: IPlayer, amount: number): { owner: IPlayer; prop: IProperty; fee: number }[] {\n  const fees: { owner: IPlayer; prop: IProperty; fee: number }[] = [];\n  for (const key of [\"finance\", \"securities\"] as MMSpecialKey[]) {\n    const s = mmSpecialOwner(gp, key);\n    if (!s || s.owner.id === trader.id) continue;\n    const rate = (mmOwnsAll(gp, s.owner, [\"finance\", \"securities\", \"plaza\"]) ? 0.02 : 0.01) * mmSpecialBoost(s.prop);\n    fees.push({ owner: s.owner, prop: s.prop, fee: Math.max(1, Math.round(amount * rate)) });\n  }\n  return fees;\n}\nasync function mmPayTradeFees(gp: IGameProcess, trader: IPlayer, fees: { owner: IPlayer; prop: IProperty; fee: number }[]) {\n  for (const f of fees) {\n    const res = await trader.cost(f.fee, \"stock\");\n    await f.owner.gain(res.actualCost, \"property\");\n    gp.gameLogBroadcast(`П÷▐╕ ${mmPlayerLink(gp, trader)} Д╨╓Ф≤⌠Х┌║Г╔╗О╪▄Д╩≤Г╩≥ ${mmPropLink(gp, f.prop)} Г └Е°╟Д╦╩ ${mmPlayerLink(gp, f.owner)} Ф┴▀Г╩╜Х╢╧ ${res.actualCost}О©╔`);\n  }\n}\n\n// Ф╞▐Х╫╝Г └Г┴╧Ф╝┼Е°╟Е²≈Ф■╤Г⌡┼О╪┬Х╔©Е▄╨Г┴╘Д╦ Х╢╧/Ф╥≤Е╝²Ц─│Е▐╓Г▌╘Х║≈И│≈Д╨╖Ф▀█Е█√Ц─│Д╦°Е▄╨Ф≥╨Ф┘╖Е█┤Г╨╖/Д╨╖Е╜╕Г═■О╪┴Е°╗Ц─▄Х╫╝Ф╛║Е╪─Е╖▀Ц─█И≤╤Ф╝╣Д╩ёГ═│И┤▄\n\n// ================= И─ Х╢╖Х├╗Х┐─ =================\n// Ф╞▐ MM_INFLATION_EVERY Х╫╝Г┴╘Д╩╥Д╦┼Ф╤╗Д╦─Ф╛║О╪┬Ф╤╗Е╧┘Г■╠Ф┬©И≈╢Х╝╬Г╫╝\"И─ Х╢╖Х├╗Х┐─\"Е├ЁЕ╝ О╪┴О╪▄Е┼═Е©╚Ф╦╦Ф┬▐Г╩⌠Ф²÷О╪ \n// Е╥╔Х╣└Ц─│Х©┤Х╥╞Х╢╧Ц─│Е°╟Д╩╥Ц─│Г⌡√Ф╔╪Х╢╧Ц─│Г╗▌Ц─│Д╨▀Д╩╤Е▓▄Е█║Г┴▄И┤▄Г └Е⌡╨Е╝ И┤▒И╒²И┐╫Ф▄┴\"Г┴╘Д╩╥Е─█Г▌┤\"Ф█╒Г╝≈О╪⌡\n// Е∙├Е╨≈Е█║Д╩╥Д╦█Ф╤╗О╪┬Е░▌Ф°÷Д╧╟Е█║Г⌡╦Е╞╧Ф⌡╢Д╬©Е╝°О╪┴О╪▄Х┌║Г╔╗Д╦█Х╥÷Ф╤╗О╪▄Ф▄┴Ф╞■Д╬▀Х╝║Г╝≈Г └И┤▒И╒²О╪┬Ф÷╔Г╗▌ 15% Г╜┴О╪┴Ф°╛Х╨╚Е╟╠Д╪ Х╥÷Г²─Е▐≤О╪▄Х┐°Е┬╘Г╨©Д©²Ф▄│Д╦█Е▐≤Ц─┌\nconst MM_INFLATION_EVERY = 5;\n\n/** Ф┬©И≈╢Х╝╬Г╫╝И┤▄Г └Ф╞▐Ф╛║Ф╤╗Е╧┘О╪┬0 = Е┘ЁИ≈╜О╪┴О╪▄Ф╡║Х╝╬Г╫╝Ф≈╤И╩≤Х╝╓ 5% */\nfunction mmInflationRate(gp: IGameProcess): number {\n  const raw = gp.gameSetting?.inflation?.value;\n  const v = Number(raw);\n  return raw === undefined || raw === \"\" || !Number.isFinite(v) ? 0.05 : v;\n}\n/** Е╫⌠Е┴█Г┴╘Д╩╥Е─█Г▌┤О╪┬Е╪─Е╠─ = 1О╪┴ */\nconst mmPriceLevel = (gp: IGameProcess): number => gp.customData.priceLevel ?? 1;\n/** Ф┼┼Е╪─Е╠─Ф≈╤Г └И┤▒И╒²Ф█╒Г╝≈Ф┬░Е╫⌠Е┴█Г┴╘Д╩╥ */\nconst mmInflate = (gp: IGameProcess, amount: number) => Math.round(amount * mmPriceLevel(gp));\n\n/** Ф╞▐Х╫╝Е╪─Е╖▀Ф≈╤Х╟┐Г■╗О╪ Е┬╟Г┌╧Е╟╠Ф╤╗Д╩╥О╪▄Е╧╤Ф▄┴Е╪─Е╠─Е▌÷Д╩╥ ц≈ Е─█Г▌┤И┤█Г╝≈Ф┴─Ф°┴Е°╟Г ╝Г └Ф∙╟Е─╪О╪┬И│©Е┘█Е▐█Е╓█Е▐√Ф∙╢Г └Х╞╞Е╥╝О╪┴ */\nasync function mmInflationRoundStart(gp: IGameProcess) {\n  const rate = mmInflationRate(gp);\n  const round = gp.currentRound;\n  if (rate <= 0 || round <= 0 || round % MM_INFLATION_EVERY !== 0 || gp.customData.inflatedRound === round) return;\n  gp.customData.inflatedRound = round;\n  const level = mmPriceLevel(gp) * (1 + rate);\n  gp.customData.priceLevel = level;\n  const base: Record<string, { costList: number[]; sellCost: number; buildCost: number }> =\n    gp.customData.basePrices ?? (gp.customData.basePrices = {});\n  for (const p of gp.properties.values()) {\n    const b = (base[p.id] ??= { costList: [...p.costList], sellCost: p.sellCost, buildCost: p.buildCost });\n    p.costList = b.costList.map(v => Math.round(v * level));\n    p.sellCost = Math.round(b.sellCost * level);\n    p.buildCost = Math.round(b.buildCost * level);\n  }\n  mmStockChartRefresh(gp); // Е╥╕Д╦┼Х╖▓И²╒Ф²©Г └\"Г┴╘Д╩╥ ц≈N\"Х╥÷Г²─Ф⌡╢Ф√╟О╪┬Х©≥Д╦─Х╫╝Г └Х║▄Ф┐┘Е°╗И─ Х┐─Г╩⌠Г╝≈Е┴█Е╟╠Е┬╥Ф√╟Х©┤Д╨├О╪┴\n  gp.gameDataBroadcast();\n  mmAnnounce(gp, \"warning\", `И─ Х╢╖Х├╗Х┐─О╪│Г┴╘Д╩╥Д╦┼Ф╤╗ ${Math.round(rate * 100)}%О╪┬Г╢╞Х╝║ ц≈${level.toFixed(2)}О╪┴`,\n    `П÷⌠┬ И─ Х╢╖Х├╗Х┐─О╪ Е╥╔Х╣└Ц─│Е°╟Д╩╥Ц─│Х©┤Х╥╞Х╢╧Ц─│Г⌡√Ф╔╪Х╢╧Е▓▄Г╗▌Х╢╧Д╦┼Ф╤╗ ${Math.round(rate * 100)}%О╪┬Г⌡╦Ф╞■Е╪─Е╠─Г╢╞Х╝║ ц≈${level.toFixed(2)}О╪┴`);\n}\n\n// ================= Х╖▓Х┴╡Ф┼─Х┐╫ =================\n// Ф┴─Ф°┴Х╖▓Х┴╡Г └ initCode И┐╫Е▐╙Х╟┐Г■╗ mmRoleInit(gameProcess, player)О╪⌡Ф┼─Х┐╫Ф▄┴ roleId Е┬├Ф╢╬Ц─┌\n// Ф▄┌Х╫╫Г┌╧О╪ \n// - Ф┴ёИ▓╠О╪┬Х√╞И╦║Е╜≤Е╟▐И┤▒Е╨⌠Ц─│Ф┴│Д╧┐Г═╢Д╨╖Е┴█Е▐≤Е█√О╪┴О╪ mmRoleInit И┤▄Е▄┘Хё┘Х╞╔Г▌╘Е╝╤Г └ player.cost\n// - Х╣╟Х╥╞О╪┬Ф°╗Е╜░Ф²▌И─┴Х╥╞Д╦▌И─├Х║▄Ц─│Е▄≈Ф╣╥Х╤┘Х╤┼Ц─│Е▄≈И╩▒Х©╫Г▄▌Х─┘И∙©И─■Ц─│Х√╞И╦║Е▐√И▓╠Ц─│И▓╔Е▄≥Е╟▐Е│╥И╒├Г╘╨Е°╟Г╖÷И┤▒Е▓▄И╒└Е╝ Е┬╟Ф°÷О╪┴О╪ mmWalk\n// - Ф┴⌠Е╥╔О╪┬Х√╞И╦║Е▌╩Д╬©Е┬╘Е╨≈О╪▄Е╥╔И▓╠Г©╩Е─█О╪┴О╪ Е├≥Е°╗ OЕё╚Е╨╥ Д╨▀Д╩╤Е▓▄Ф┼⌠Е▌╩Ф┴⌠Е╥╔Е█║И┤▄\n// - Е┬╟Х╬╬О╪┬И▓╔Е▄≥Е╟▐Е│╥И╒└Е╝ Ц─│Ф°┬Е╓°Х╖│Е┤▒Г┐╜И≈╧О╪⌡Х╝╟Е╫∙Г╘╨Е°╟Х©┤Х╥╞Х╢╧Ц─│Ф°┴Ф╡║Ф°┴Д╨╨Д╨╓Х©┤Х╥╞Х╢╧О╪┴О╪ mmHandleArrival\n// - Е┤╨Г┴▄О╪┬Е├╟ГЁ√И⌡╙Ф╒╗О╪┴О╪ Ц─▄Г▌╘Е╝╤Ф⌠█Д╫°Ц─█И≤╤Ф╝╣Ф■╧Д╦╨Х╟┐Г■╗ mmUseCard\n// - Ф╞▐Х╫╝Е╪─Е╖▀О╪┬Е├╟ГЁ√И⌡╙Ф╒╗Е╪─Е╠─Х┤╙Е╦╕Е█║О╪⌡Ф┴│Д╧┐О╪ Д╦┼Д╦─Х╫╝Ф╡║Д╨╨Д╨╓Х©┤Х╥╞Х╢╧О╪┴О╪ mmRolesRoundStartО╪▄Г■╠Ц─▄Х╫╝Ф╛║Е╪─Е╖▀Ц─█И≤╤Ф╝╣И┤▄Г └Г┴╧Ф╝┼Е°╟Е²≈Ф■╤Г⌡┼Х╟┐Г■╗\nconst MM_ROLE_IDS = {\n  kotone: \"role-kotone\", // Х√╞И╦║\n  misuzu: \"role-misuzu\", // И▓╔Е▄≥Е╟▐Е│╥\n  mutsumi: \"role-mutsumi\", // Ф°╗Е╜░Ф²▌\n  sheri: \"role-sheri\", // Е├╟ГЁ√И⌡╙Ф╒╗\n  teo: \"role-teo\", // Е▄≈Ф╣╥\n  yachiyo: \"role-yachiyo\", // Ф°┬Е╓°Х╖│\n  yoshino: \"role-yoshino\", // Ф┴│Д╧┐\n  diamond: \"role-diamond\", // Е┘┴И▓╩О╪┬Е▄≈И╩▒Х©╫Г▄▌Х─┘О╪┴\n};\ntype MMRoleKey = keyof typeof MM_ROLE_IDS;\n\n/** Ф┼─Х┐╫Ф∙╟Е─╪О╪▄Х╟┐Е╧ЁХ║║Ф■╧Х©≥И┤▄ */\nconst MM_ROLE_CFG = {\n  kotoneRate: 0.25, // Х√╞И╦║О╪ Х╒╚Е┼╗Е╓╠Е▌╩И┤▒И▓╠Е╜≤Е┘╔Е╟▐И┤▒Е╨⌠Г └Ф╞■Д╬▀\n  mutsumiChance: 0.5, // Ф°╗Е╜░Ф²▌О╪ Ф╞▐Д╦╙Х╥╞Е▐ёФ■╧Х╣╟\"Х░╫Х└ Ф═╪Е┬├Ф∙╟Ф°─Д╫▌\"О╪┬Е╟▒Д╨╓Х©┤Х╥╞Х╢╧Ц─│Е╓ Д╧╟Г╘╨Е°╟О╪┴Ф√╧Е░▒Г └Ф╕┌Г▌┤\n  sheriCopy: 0.5, // Е├╟ГЁ√И⌡╙Ф╒╗О╪ Х╒╚Ф■╩Е┤╩Е█║Ф▄┤Е╝ Ф≈╤Е╬≈Е┬╟Е░▄Ф═╥Д╦─Е╪═Е█║Г └Ф╕┌Г▌┤\n  sheriJoin: 0.25, // Е├╟ГЁ√И⌡╙Ф╒╗О╪ Е┬╚Д╨╨Д╧▀И≈╢Г └Ф■╩Е┤╩Е█║И║╨Е╦╕Д╧÷Ф┴⌠Е┬╟Е╔╧Г └Ф╕┌Г▌┤О╪┬Ф┴⌠Е┬╟Ф≈╤Д╦─Е╝ Е╬≈Е┬╟И┌ёЕ╪═Е█║О╪⌡Д╦─Е╪═Е█║Ф°─Е╓ И║╨Е╦╕Д╦─Д╦╙И⌡╙Ф╒╗О╪┴\n  teoChance: 0.75, // Е▄≈Ф╣╥О╪ Д╦─Ф╛║Г╖╩Е┼╗Д╦╜Х╤┘Х╤┼Д╨├Е┬╚Д╨╨Ф≈╤Е╬≈Е┬╟Ц─▄Е©╚И╘╛Е┼═И·╜Ц─█Г └Ф╕┌Г▌┤О╪┬Ф╞▐Ф╛║Г╖╩Е┼╗Ф°─Е╓ Д╦─Е╪═О╪┴\n  diamondMinSteps: 11, // Е▄≈И╩▒Х©╫Г▄▌Х─┘О╪ Д╦─Ф╛║Г╖╩Е┼╗Х┤ЁЕ╟▒Х╣╟Х©≥Д╧┬Е╓ Ф╜╔О╪┬\"Х╤┘Х©┤ 10\"О╪┴\n  diamondChance: 1, // Е▄≈И╩▒Х©╫Г▄▌Х─┘О╪ Х╬╬Ф═┤Е░▌Е╬≈Е┬╟Д╦─Е╪═Ф°╨Д╪ Е█║Г └Ф╕┌Г▌┤\n  yachiyoBonus: { 4: 60, 5: 35, 6: 25 } as Record<number, number>, // Ф°┬Е╓°Х╖│О╪ Е▐╕Е╓√Д╦╓Е░█Г▌╘Е╝╤Е░▄Ф═╪Г └Е╔√И┤▒О╪▄Ф▄┴Е╪─Е╠─Д╨╨Ф∙╟О╪┬Ф▄┴Г┴╘Д╩╥Ф█╒Г╝≈О╪┴\n  yoshinoBonus: { 4: 25, 5: 40, 6: 75 } as Record<number, number>, // Ф┴│Д╧┐О╪ Д╦┼Д╦─Х╫╝Ф╡║Д╨╨Д╨╓Х©┤Х╥╞Х╢╧Г └Е╔√И┤▒О╪▄Ф▄┴Е╪─Е╠─Д╨╨Ф∙╟О╪┬Ф▄┴Г┴╘Д╩╥Ф█╒Г╝≈О╪┴\n};\n/** Ф▄┴Е╪─Е╠─Д╨╨Ф∙╟Ф÷╔Х║╗О╪┬4 Д╨╨Д╩╔Д╦▀Ф▄┴ 4 Д╨╨О╪▄6 Д╨╨Д╩╔Д╦┼Ф▄┴ 6 Д╨╨О╪┴О╪▄Е├█Ф▄┴Г┴╘Д╩╥Ф█╒Г╝≈ */\nconst mmByPlayerCount = (gp: IGameProcess, table: Record<number, number>) =>\n  mmInflate(gp, table[Math.min(6, Math.max(4, gp.players.size))]);\n/** Х╒╚Е┼╗Ф┴ёИ▓╠Г └Ф═┤Г╜╬О╪ Х©┤Х╥╞Х╢╧Ц─│Г╗▌Ц─│Е▒╫Х©░Ц─│Е▄╩И≥╒О╪⌡Е█║Г┴▄Ф═┤Г╜╬Е▐╕Г╝≈О╪┬Д╦█Ф≤╞Х┤╙Е╥╠Е┤╨Г └Г┴▄Ф┴█Г╝≈Х╒╚Е┼╗О╪┴ */\nconst MM_PASSIVE_TAGS = [\"property\", \"tax\", \"fate\", \"hospital\"];\n/** Е├╟ГЁ√И⌡╙Ф╒╗Д╦█Д╪ \"Е┤▒Г┐╜И≈╧\"Г └Ф■╩Е┤╩Е█║О╪┬Е░▄Ф≈╤Е╞╧Д╦╓Д╦╙Д╨╨Г■÷Ф∙┬Х╞╢Д╦█И─ О╪┴ */\nconst MM_SHERI_NO_JOIN = [\"Д╧╬Е²╓Е╓╖Ф▄╙Г╖╩\"];\n/** Е├╟ГЁ√И⌡╙Ф╒╗Е╪─Е╠─Х┤╙Е╦╕Г └Е█║Д╩▌Х©≥И┤▄И ▐Ф°╨Ф┼╫Д╦─Е╪═О╪┬Е▓▄Ф┼─Х┐╫Е┬╓Е╝ Г■╗Г └\"Ф■╩Е┤╩Е█║\"Д╦█Ф≤╞Д╦─Е⌡·Д╨▀О╪▄Ф∙┘Ф└▐Д╦█Ф■╬Е²┤Е╞▄Е█║Ц─│Д╦╬Ф┼╔О╪┴ */\nconst MM_SHERI_START_POOL = [\"Ф÷╔Г╗▌\", \"Ф┴⌠Е┼╚\", \"Ф┼⌠Е▌╩Ф┴⌠Е╥╔\", \"Ф▀├Х©│И≤÷\", \"Х╥▄Е│°Е█║\"];\n\nconst mmRoleOf = (player: IPlayer): MMRoleKey | undefined =>\n  (Object.keys(MM_ROLE_IDS) as MMRoleKey[]).find(k => MM_ROLE_IDS[k] === player.roleId);\nconst mmHasRole = (player: IPlayer, role: MMRoleKey) => player.roleId === MM_ROLE_IDS[role];\nconst mmAlivePlayers = (gp: IGameProcess) => [...gp.players.values()].filter(p => !p.isBankrupted);\n/** Е²░Г┴╒Ц─│Ф┴⌠Е╥╔Ц─│Х╨╨Е°╗Е╒⌠Е°╟Г └Г▌╘Е╝╤Д╦█Е▐┌Д╦▌Д╫█Г╫╝Г╠╩Ф┼─Х┐╫ */\nconst mmIsHeld = (p: IPlayer) => [\"jail\", \"work\", \"dead\"].some(t => p.buffManager.hasBuffWithTag(t));\n/** Ф┼─Х┐╫Х╖╕Е▐▒Ф≈╤И─ Г÷╔Г └Е┴█Г╪─О╪▄Д╬▀Е╕┌ \"Б°╗Ц─░Ф°╗Е╜░Ф²▌Ц─▒\"О╪▄Х╝╘Г▌╘Е╝╤Д╦─Г°╪Г°▀Е┤╨Ф≤╞Х╖▓Х┴╡Ф┼─Х┐╫ */\nfunction mmSkillTag(gp: IGameProcess, player: IPlayer): string {\n  const roles = (gp.mapData as unknown as { roles?: { id: string; name: string }[] }).roles ?? [];\n  const info = roles.find(r => r.id === player.roleId);\n  return info ? `Б°╗Ц─░${info.name}Ц─▒` : \"Б°╗\";\n}\n\n/** Г▌╘Е╝╤Е█║Г┴┤Е▐ЁД╬╖Г └Г┼╤Ф─│Х║▄О╪┬Е╟▐И┤▒Е╨⌠Ц─│И╒└Е╝ Г╜┴О╪┴О╪▄Г╩▒Е╝  player.mmStatus */\nfunction mmSetStatus(gp: IGameProcess, player: IPlayer, text: string) {\n  (player as unknown as Record<string, unknown>).mmStatus = text;\n  gp.gameDataBroadcast();\n}\n\n/** Г▌╘Е╝╤Е█║Г┴┤О╪ Ф√┤Е╜≈Г■╗Г▌╘Е╝╤И╒°Х┴╡Е┼═Ф▐▐Х╬╧О╪▄Ф╣┘Х┴╡Г▌╘Е╝╤Ф■╧Г■╗Ф╥╠Х┴╡Ф▐▐Х╬╧О╪⌡Д╦▀И²╒Е╓ Д╦─Х║▄Ф┼─Х┐╫Г┼╤Ф─│ */\nfunction mmInfoDisplay(player: IPlayer): UISchema {\n  const color = player.getPlayerInfo().user.color || \"#000000\";\n  const hex = color.replace(\"#\", \"\");\n  const full = hex.length === 3 ? hex.split(\"\").map(c => c + c).join(\"\") : hex.slice(0, 6);\n  const [r, g, b] = [0, 2, 4].map(i => parseInt(full.slice(i, i + 2), 16) || 0);\n  const light = (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6;\n  const c = light ? \"rgba(0, 0, 0, 0.85)\" : \"#ffffff\";\n  const outline = `${c} -0.08em 0 0, ${c} 0.08em 0 0, ${c} 0 0.08em 0, ${c} 0 -0.08em 0, ${c} 0.06em 0.06em 0, ${c} -0.06em -0.06em 0, ${c} 0.06em -0.06em 0, ${c} -0.06em 0.06em 0`;\n  return {\n    id: `info-${player.id}`,\n    type: \"div\",\n    style: { flex: \"1\", display: \"flex\", flexDirection: \"column\", textAlign: \"center\", borderRadius: \"1.4em\", padding: \"0.3em 0.5em\", textShadow: outline, fontWeight: \"bold\" },\n    children: [\n      { id: \"username-text\", type: \"span\", textBinding: \"player.user.username\" },\n      {\n        id: \"money-container\",\n        type: \"div\",\n        children: [\n          { id: \"money-tag\", type: \"span\", content: \"О©╔\" },\n          { id: \"money-text\", type: \"span\", textBinding: \"player.money\" },\n        ],\n      },\n      { id: \"status-text\", type: \"span\", textBinding: \"player.mmStatus\", style: { fontSize: \"0.75em\" } },\n    ],\n  };\n}\n\n/** Х╖▓Х┴╡ initCode Х╟┐Г■╗О╪ Х╝╬Г╫╝Г▌╘Е╝╤Е█║Г┴┤О╪▄Е╧╤Г╩≥И°─Х╕│Г └Х╖▓Х┴╡Ф▄┌Д╦┼Ф┴ёИ▓╠И▓╘Е╜░ */\nfunction mmRoleInit(gp: IGameProcess, player: IPlayer) {\n  player.infoDisplay = mmInfoDisplay(player);\n  // Х╖▓Х┴╡Ф┼─Х┐╫Ф▄┌Ф┬░Е╦╦И╘╩ buffО╪▄Г▌╘Е╝╤Е█║Г┴┤Г └ buff Ф═▐И┤▄И ▐Ф≈╤Х┐╫Ф÷╔О╪⌡Ф▐▐Х©╟Г╛╛Д╦─Х║▄Ф≤╞Д╨╨Х╝╬Е▐╟Х╞█О╪▄Г■╗Ц─▄Ц─█Ф▀╛Х╣╥Ф²╔\n  const roles = (gp.mapData as unknown as { roles?: { id: string; name: string; description?: string }[] }).roles ?? [];\n  const info = roles.find(r => r.id === player.roleId);\n  if (info) {\n    const [flavor, ...rest] = (info.description ?? \"\").split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n    player.buffManager.addBuff({\n      id: `role-${player.id}`, name: `Х╖▓Х┴╡О╪ ${info.name}`, source: \"Х╖▓Х┴╡Ф┼─Х┐╫\", tags: [\"role\"],\n      description: rest.length > 0 ? `Ц─▄${flavor}Ц─█${rest.join(\" \")}` : (flavor ?? \"\"),\n    });\n  }\n  (player as unknown as Record<string, unknown>).mmStatus = \"\";\n  const role = mmRoleOf(player);\n  if (role !== \"kotone\" && role !== \"yoshino\") return;\n  const host = player as unknown as { cost: IPlayer[\"cost\"] };\n  const original = host.cost.bind(player);\n  host.cost = async (money, tag, target) => {\n    if (role === \"yoshino\" && !player.isBankrupted && money > 0 && player.money <= money) {\n      try { await mmYoshinoLiquidate(gp, player, money); } catch (e) { gp.msgNotifyBroadcast(\"error\", `Ф┴│Д╧┐Е▐≤Е█√Е┤╨И■≥О╪ ${e instanceof Error ? e.message : String(e)}`); }\n    }\n    const res = await original(money, tag, target);\n    if (role === \"kotone\" && !player.isBankrupted && (res?.actualCost ?? 0) > 0 && mmIsPassiveLoss(gp, player, tag)) {\n      mmKotoneDeposit(gp, player, res.actualCost);\n    }\n    return res;\n  };\n}\n\n// ---------- Х√╞И╦║О╪ Е╟▐И┤▒Е╨⌠ ----------\nfunction mmIsPassiveLoss(gp: IGameProcess, player: IPlayer, tag: unknown): boolean {\n  if (typeof tag !== \"string\") return false;\n  if (MM_PASSIVE_TAGS.includes(tag)) return true;\n  return tag === \"card\" && gp.customData.cardUser !== player.id; // Е┬╚Д╨╨Г └Е█║Х╝╘Д╫═Ф▌▐И▓╠Ф┴█Г╝≈О╪⌡Х┤╙Е╥╠Е┤╨Г┴▄Х┼╠Г └И▓╠О╪┬Е²┤Е╞▄Ц─│Е╪╨Е┬╤Ф■╤Х╢╜О╪┴Д╦█Г╝≈\n}\nconst mmVault = (gp: IGameProcess): Record<string, number> => gp.customData.kotoneVault ?? (gp.customData.kotoneVault = {});\nfunction mmKotoneDeposit(gp: IGameProcess, player: IPlayer, lost: number) {\n  const add = Math.round(lost * MM_ROLE_CFG.kotoneRate);\n  if (add <= 0) return;\n  const vault = mmVault(gp);\n  vault[player.id] = (vault[player.id] ?? 0) + add;\n  mmSetStatus(gp, player, `П÷▓╟ Е╟▐И┤▒Е╨⌠ О©╔${vault[player.id]}`);\n  gp.messageNotify([player.id], { type: \"success\", content: `${mmSkillTag(gp, player)}Х╒╚Ф┴ёГ └ ${lost}О©╔ И┤▄Ф°┴ ${add}О©╔ Е╜≤Х©⌡Д╨├Е╟▐И┤▒Е╨⌠О╪┬Е┘╠ ${vault[player.id]}О©╔О╪┴` });\n}\nasync function mmKotoneWithdraw(gp: IGameProcess, player: IPlayer) {\n  const vault = mmVault(gp);\n  const amount = vault[player.id] ?? 0;\n  if (amount <= 0) return;\n  vault[player.id] = 0;\n  await player.gain(amount, \"role\");\n  mmSetStatus(gp, player, \"\");\n  mmAnnounce(gp, \"success\", `${mmSkillTag(gp, player)}${player.name} Г╩▐Х©┤Х╣╥Г┌╧О╪▄Д╩▌Е╟▐И┤▒Е╨⌠И┤▄Е▐√Е┤╨Д╨├ ${amount}О©╔`,\n    `П÷▓╟ ${mmPlayerLink(gp, player)} Г╩▐Х©┤Х╣╥Г┌╧О╪▄Д╩▌Е╟▐И┤▒Е╨⌠И┤▄Е▐√Е┤╨Д╨├ ${amount}О©╔`);\n}\n\n// ---------- Ф┴│Д╧┐О╪ Г═╢Д╨╖Е┴█Х┤╙Е┼╗Е▐≤Е█√ ----------\nconst mmPropValue = (p: IProperty) => p.sellCost + p.level * p.buildCost;\nasync function mmYoshinoLiquidate(gp: IGameProcess, player: IPlayer, bill: number) {\n  const need = () => bill - player.money + 1; // Д╩≤Е╝▄Х┤ЁЕ╟▒Е┴╘ 1 Ф┴█Д╦█Г═╢Д╨╖\n  const mine = () => [...gp.properties.values()].filter(p => p.owner?.id === player.id);\n  // Е┘╗Е█√Д╨├Д╧÷Д╦█Е╓÷Е╟╠Д╦█Е█√О╪▄Г┘╖Е╦╦Г═╢Д╨╖\n  if (player.money + mmPortfolioValue(gp, player) + mine().reduce((s, p) => s + mmPropValue(p), 0) <= bill) return;\n  const sold: string[] = [];\n  const soldLog: string[] = [];\n  // Е┘┬Е█√Х┌║Г╔╗О╪┬Х╢╣Г └Е┘┬Е█√О╪▄Е▐╙Е█√Е╓÷Г■╗Г └Х┌║Ф∙╟О╪┴\n  const prices = mmStocks(gp).prices;\n  for (const id of [...MM_STOCK_IDS].sort((a, b) => prices[b] - prices[a])) {\n    if (need() <= 0) break;\n    const qty = mmHolding(gp, player, id);\n    if (qty <= 0) continue;\n    const n = Math.min(qty, Math.ceil(need() / prices[id]));\n    mmSetHolding(gp, player, id, qty - n);\n    await player.gain(n * prices[id], \"stock\");\n    sold.push(`${n} Х┌║${MM_STOCKS[id].name}`);\n    soldLog.push(`${n} Х┌║${MM_STOCKS[id].name}О╪┬${n * prices[id]}О©╔О╪┴`);\n  }\n  // Е├█Ф▄┴Е▌÷Д╩╥Ф┼┼Е°╟Г ╝Е█√Е⌡·И⌠╤Х║▄О╪ Ф°┴Д╦─Е²≈Е╟╠Е╓÷Г └Е█√Ф°─Д╬©Е╝°Г └И┌ёЕ²≈О╪▄Д╦█Е╓÷Е╟╠Е┘┬Е█√Ф°─Х╢╣Г └\n  while (need() > 0) {\n    const list = mine();\n    if (list.length === 0) break;\n    const enough = list.filter(p => mmPropValue(p) >= need()).sort((a, b) => mmPropValue(a) - mmPropValue(b));\n    const pick = enough[0] ?? list.sort((a, b) => mmPropValue(b) - mmPropValue(a))[0];\n    const value = mmPropValue(pick);\n    await pick.setLevel(0);\n    await pick.setOwner(undefined);\n    await player.gain(value, \"property\");\n    sold.push(`Ц─▄${pick.name}Ц─█`);\n    soldLog.push(`${mmPropLink(gp, pick)}О╪┬${value}О©╔О╪┴`);\n  }\n  if (sold.length === 0) return;\n  gp.gameDataBroadcast();\n  mmAnnounce(gp, \"warning\", `${mmSkillTag(gp, player)}${player.name} Х╕│Д╩≤ ${bill}О©╔О╪▄И▓╠Д╦█Е╓÷О╪▄Х┤╙Е┼╗Е▐≤Е█√Д╨├ ${sold.join(\"Ц─│\")}`,\n    `П÷╖╬ ${mmPlayerLink(gp, player)} Х╕│Д╩≤ ${bill}О©╔О╪▄И▓╠Д╦█Е╓÷О╪▄Х┤╙Е┼╗Е▐≤Е█√Д╨├ ${soldLog.join(\"Ц─│\")}`);\n}\n\nconst mmEnabledOuts = (gp: IGameProcess, node: string) =>\n  gp.mapData.mapPaths.filter(p => p.fromMapItemId === node && gp.isMapPathEnabled(p.id));\n/** Ф▄┴Е╡■Х╥╞Х╖└Е┬≥О╪▄Д╩▌ node Е┤╨Е▐▒Д╪ Х╣╟Г └Д╦▀Д╦─Ф═╪О╪┬Х╖└Е┬≥Е╞╧Д╦█Д╦┼Е°╟Е⌡╬Ф≈╤Х©■Е⌡· undefinedО╪┴ */\nfunction mmBranchDefault(gp: IGameProcess, node: string, ruleSteps: number): string | undefined {\n  const branch = MM_BRANCHES[node], from = gp.getMapItemById(node);\n  if (!branch || !from) return undefined;\n  const keep = mmEnabledOuts(gp, node).filter(p => {\n    const to = gp.getMapItemById(p.toMapItemId);\n    return !!to && branch.pick(ruleSteps, to.x - from.x, to.y - from.y);\n  });\n  return keep.length === 1 ? keep[0].toMapItemId : undefined;\n}\n\n// ---------- Ф°╗Е╜░Ф²▌О╪ Х╥╞Е▐ёФ°┴Ф╕┌Г▌┤Х╣╟\"Е╟▒Д╨╓Х©┤Х╥╞Х╢╧Ц─│Е╓ Д╧╟Г╘╨Е°╟\"Г └Ф√╧Е░▒О╪⌡Д╦°Г╚≥Ц─│Е█≈Г╚≥Е╞╧Е╔╧Д╧÷Ф≤╞Х╥╞Е▐ёО╪▄Е▐╞Д╩╔И─├Х║▄Х©⌡Е÷▌ ----------\n// Е°╟Е⌡╬Д╦┼Д╦°Х┤┌Ц─│Е█≈Х┤┌Е░└Ф°┴Д╦─Д╦╡Е▐█Е░▒Х╥╞Е╬└О╪┬Х╫╕Г╚≥ Б├▓ Е╦┌Д╦╜Е©┐О╪┴О╪▄Е╧ЁФ≈╤Е┘ЁИ≈╜О╪▄Е▐╙Е°╗Е╔╧Х©≥Ф╛║Г └Х╥╞Г╨©Г■╗Е┬╟Ф≈╤Д╦╢Ф≈╤Ф┴⌠Е╪─Ц─┌\n// Х╔©Х┤┌Ф╡║Ф°┴Е▐█Е░▒Х╥╞Е╬└О╪ Д╩▌Х╔©Г╚≥И─├Х║▄Х©⌡Е÷▌Е├█Е┤╨Ф²╔Е╟╠Ф┬░Д╨├Г╩∙Е╟▐Е°┬Ц─┌\nconst MM_PLAZA = \"mi-egk8e9\";\nconst MM_REVERSE_ARMS: string[][] = [\n  [\"mi-g06d7n\", \"mi-qoz0bq\", \"mi-lgu7ip\", \"mi-fodhrd\", \"mi-3u13y7\", MM_PLAZA], // Д╦°Г╚≥ Б├▓ Е╦┌Д╦╜Е©┐\n  [\"mi-urj3h0\", \"mi-qh8t31\", \"mi-xglgoi\", \"mi-rpqme6\", \"mi-f6xcah\", MM_PLAZA], // Е█≈Г╚≥ Б├▓ Е╦┌Д╦╜Е©┐\n];\n/** И─├Х║▄Ф≈╤Д╩▌ node Х╣╟Е┬╟Г └Д╦▀Д╦─Ф═╪ */\nfunction mmRevNext(node: string): string | undefined {\n  for (const arm of MM_REVERSE_ARMS) {\n    const i = arm.indexOf(node);\n    if (i >= 0 && i < arm.length - 1) return arm[i + 1];\n  }\n  return undefined;\n}\nconst mmIsJunction = (node: string) => MM_REVERSE_ARMS.some(arm => arm[0] === node);\n/** Е┘ЁИ≈╜Ф┴─Ф°┴Е▐█Е░▒Х╥╞Е╬└О╪┬Ф╞▐Ф╛║Х╣╟Х╥╞Е┴█Х╟┐Г■╗О╪⌡Е°╟Е⌡╬Е┬ Е┼═Х╫╫Ф≈╤Е╝┐Д╩╛И╩≤Х╝╓Ф≤╞Е╪─Г └О╪┴ */\nfunction mmReverseGuard(gp: IGameProcess) {\n  for (const p of gp.mapData.mapPaths) {\n    if (mmRevNext(p.fromMapItemId) === p.toMapItemId && gp.isMapPathEnabled(p.id)) gp.setMapPathEnabled(p.id, false);\n  }\n}\n\n/** Е│°Е°╗Ф÷░Ф═╪Ф≈╤Д╪ Д╨╓Г └Х©┤Х╥╞Х╢╧О╪┬Е░╚Х╫╕Г╚≥Г©╩Е─█Ц─│Е·└Ф√╜Г╘╨Е°╟Г©╩Е─█О╪⌡Д╦█Е░╚Ф╠÷Ф≥╞Е┼═Ф┬░О╪┴ */\nfunction mmTollEstimate(gp: IGameProcess, tile: string, payer: IPlayer): number {\n  const { plot, prop } = mmPropertyAt(gp, tile);\n  const owner = prop?.owner;\n  if (!plot || !prop || !owner || owner.id === payer.id || owner.isBankrupted) return 0;\n  const base = prop.costList[prop.level] ?? 0;\n  const group = gp.mapData.mapItems.filter(mi => mi.type.id === plot.type.id && mi.property).map(mi => mmFindProp(gp, mi.property!));\n  const owned = group.filter(p => p?.owner?.id === owner.id).length;\n  if (plot.type.id === MM_IDS.stationPlotType) return base * 2 ** (owned - 1);\n  if (plot.type.id !== MM_IDS.sciencePlotType && prop.level === 0 && group.length > 1 && owned === group.length) return base * 2;\n  return base;\n}\n\n/**\n * Ф°╗Е╜░Ф²▌Г╩≥Х░╫Х└ Ф═╪Ф┴⌠Е┬├О╪┬Х╤┼Д╫▌Х╤┼Ф┐ЁЕ▌╩О╪┴О╪ Е┬╚Д╨╨Г └Е°╟ = Х╕│Д╨╓Г └Х©┤Х╥╞Х╢╧О╪⌡Д╧╟Е╬≈Х╣╥Е▐┬Ф╡║Д╨╨И╒└Е╝ Г └Г╘╨Е°╟ = Х╢÷Г └Е█│Е┬├Д╧▀Д╦─Е°╟Д╩╥\n * О╪┬Х╤┼Х╢╣Х╤┼Ф┐ЁЕ▌╩О╪▄Ф╞■Е╕┌Е╦┌Д╦╜Е©┐О╪┴О╪⌡Е┘╤Д╩√Ф═╪Е╜░ = 0Ц─┌\n */\nfunction mmMutsumiScore(gp: IGameProcess, tile: string, player: IPlayer): number {\n  const prop = mmPropertyAt(gp, tile).prop;\n  if (prop && !prop.owner) {\n    const holder = mmReserves(gp)[tile];\n    return (!holder || holder === player.id) && player.money > prop.sellCost ? -prop.sellCost / 10 : 0;\n  }\n  return mmTollEstimate(gp, tile, player);\n}\n\n/** Ф°╗Е╜░Ф²▌Д╦┼Д╦─Ф╛║Х╣╟Е╝▄Е│°Е°╗Е⌠╙Ц─│Д╩▌Е⌠╙Ф═╪Ф²╔Ц─│Ф≤╞Е░╕Х©≤Е°╗И─├Х║▄О╪┬И─├Х║▄Е│°Е°╗Е█┼Х╥╞Ф≈╤О╪▄Д╦▀Ф╛║Ф▌╔Г²─Е╬─Е╦┌Д╦╜Е©┐Х╣╟О╪┴ */\nfunction mmMutsumiState(gp: IGameProcess, player: IPlayer): { from: string; rev: boolean } | undefined {\n  const s = (gp.customData.mutsumiPos ?? {})[player.id];\n  return s && s.at === player.positionMapItemId ? s : undefined;\n}\nfunction mmMutsumiRemember(gp: IGameProcess, player: IPlayer, segments: MapMovementSegment[]) {\n  const pos = (gp.customData.mutsumiPos ??= {});\n  const last = segments[segments.length - 1];\n  if (!last) return;\n  const rev = segments.some(s => mmRevNext(s.fromMapItemId) === s.toMapItemId) && mmRevNext(last.fromMapItemId) === last.toMapItemId && last.toMapItemId !== MM_PLAZA;\n  pos[player.id] = { at: last.toMapItemId, from: last.fromMapItemId, rev };\n}\n\n/**\n * Г╝≈Е╔╫Ф°╗Е╜░Ф²▌Х©≥Ф╛║Г └Ф∙╢Ф²║Х╥╞Г╨©Ц─┌Х╥╞Е▐ёО╪┬Е╓ Д╨▌Д╦─Д╦╙Е▌╩Е░▒Г └Ф═╪Е╜░О╪┴Д╦┼О╪ \n * - Ф▄┴Х╖└Е┬≥Ф°╛Ф²╔Г └Ф√╧Е░▒Д╦╨И╩≤Х╝╓О╪⌡\n * - Ф°┴ mutsumiChance Г └Ф╕┌Г▌┤Ф■╧Х╣╟Х░╫Х└ Ф═╪Е┬├Ф∙╟Ф°─Д╫▌Г └Ф√╧Е░▒О╪┬Е╟▒Д╨╓Х©┤Х╥╞Х╢╧Ц─│Е╓ Д╧╟Г╘╨Е°╟О╪▄Х╖│ mmMutsumiScoreО╪⌡Ф┴⌠Е╧ЁФ≈╤Д©²Ф▄│И╩≤Х╝╓О╪┴О╪▄Ф■╧Д╨├Е╟╠Х╝╟Д╦─Ф²║Г░├Г■╠Ц─┌\n * Е°╗Е╡■Х╥╞Е▐ёД╦┼Е┤╨Е▐▒Ф≈╤Г╛╛Д╦─Ф╜╔Г■╗ firstPickО╪┬Е╔╧Х┤╙Е╥╠И─┴Г └О╪┴Ц─┌\n */\nfunction mmMutsumiPlan(gp: IGameProcess, player: IPlayer, steps: number, firstPick?: string): { route: string[]; notes: Record<string, string> } {\n  const state = mmMutsumiState(gp, player);\n  const fwdOuts = (c: string) => mmEnabledOuts(gp, c).map(p => p.toMapItemId);\n  const cands = (c: string, prev: string | undefined, rev: boolean): string[] => {\n    const r = mmRevNext(c);\n    if (rev && r) return [r];\n    const list = fwdOuts(c);\n    if (mmIsJunction(c) && r) list.push(r);\n    return list.filter(t => t !== prev);\n  };\n  const nextRev = (c: string, t: string, rev: boolean) => (rev || mmIsJunction(c)) && mmRevNext(c) === t && t !== MM_PLAZA;\n  const dflt = (c: string, list: string[], i: number): string | undefined => {\n    if (list.length === 1) return list[0];\n    if (MM_BRANCHES[c]) {\n      if (i === 0) return firstPick && list.includes(firstPick) ? firstPick : undefined;\n      const d = mmBranchDefault(gp, c, steps);\n      return d && list.includes(d) ? d : undefined; // И╩≤Х╝╓Ф√╧Е░▒Ф≤╞Ф²╔Х╥╞О╪┬И─├Х║▄Х©⌡Г └Е╦┌Д╦╜Е©┐О╪┴Ф≈╤Ф╡║Ф°┴И╩≤Х╝╓\n    }\n    return fwdOuts(c).find(t => list.includes(t)); // Х╫╕Г╚≥Х╥╞Е▐ёИ╩≤Х╝╓Ф╡©Е╓√Е°┬\n  };\n  // Д╩▌ c И─┴ first Д╧▀Е░▌Ф▄┴И╩≤Х╝╓Х╣╟Е╝▄О╪▄Х©■Е⌡·Х░╫Х└ Ф═╪\n  const landing = (c: string, prev: string | undefined, rev: boolean, i: number, first: string): string => {\n    let cur = c, pr = prev, rv = rev, t = first;\n    for (let k = i; ; k++) {\n      rv = nextRev(cur, t, rv); pr = cur; cur = t;\n      if (k >= steps - 1) return cur;\n      const list = cands(cur, pr, rv);\n      const d = dflt(cur, list, k + 1) ?? list[0];\n      if (!d) return cur;\n      t = d;\n    }\n  };\n  const label = (c: string, t: string, score: number): string => {\n    const why = score < 0 ? \"И┌ёХ╬╧Ф°┴Г╘╨Е°╟Е▐╞Д╧╟\" : \"Х░╫Х└ Е╓└Х©┤Х╥╞Х╢╧Ф⌡╢Д╫▌\";\n    if (mmRevNext(c) === t && mmIsJunction(c)) return `И─├Х║▄Ф▀░Х©⌡Д╨├Е╦┌Д╦╜Е©┐О╪┬${why}О╪┴`;\n    const branch = MM_BRANCHES[c], from = gp.getMapItemById(c), to = gp.getMapItemById(t);\n    return `${branch && from && to ? branch.label(to.x - from.x, to.y - from.y) : \"Ф╡©Е╓√Е°┬Г╩╖Г╩╜Е┴█Х©⌡\"}О╪┬${why}О╪┴`;\n  };\n  const route: string[] = [];\n  const notes: Record<string, string> = {};\n  let cur = player.positionMapItemId, prev = state?.from, rev = state?.rev ?? false;\n  for (let i = 0; i < steps; i++) {\n    const list = cands(cur, prev, rev);\n    if (list.length === 0) break;\n    let next = dflt(cur, list, i);\n    const freePick = i === 0 && !!MM_BRANCHES[cur] && next !== undefined;\n    if (list.length > 1 && !freePick && (next === undefined || Math.random() < MM_ROLE_CFG.mutsumiChance)) {\n      const scored = list.map(t => ({ t, score: mmMutsumiScore(gp, landing(cur, prev, rev, i, t), player) }));\n      const best = Math.min(...scored.map(s => s.score));\n      const pick = next !== undefined && scored.find(s => s.t === next)?.score === best ? next : scored.find(s => s.score === best)!.t;\n      if (next !== undefined && pick !== next) notes[cur] = label(cur, pick, best);\n      next = pick;\n    }\n    if (!next) break;\n    rev = nextRev(cur, next, rev);\n    prev = cur;\n    cur = next;\n    route.push(next);\n  }\n  return { route, notes };\n}\n\n// ---------- Х╣╟Х╥╞Е░▌О╪ Е▄≈Ф╣╥Ц─│Е▄≈И╩▒Х©╫Г▄▌Х─┘Ц─│Х√╞И╦║Ц─│И▓╔Е▄≥Е╟▐Е│╥ ----------\nasync function mmRolesAfterWalk(gp: IGameProcess, player: IPlayer, visited: string[]) {\n  const walked = visited.length;\n  const lastMove: Record<string, number> = gp.customData.lastMove ?? (gp.customData.lastMove = {});\n  const passed = visited.slice(0, -1);\n  if (!player.isBankrupted && walked > 0) {\n    // Е▄≈Ф╣╥О╪ Х╤┘Х╤┼Д╨├Е┬╚Д╨╨О╪┬Х╣╟Х©┤Е╞╧Ф√╧Ф┴─Е°╗Ф═╪О╪▄Д╦■Х©≥Ф╛║Х╣╟Е╬≈Ф╞■Е╞╧Ф√╧Д╦┼Ф╛║Х©°О╪┴\n    if (mmHasRole(player, \"teo\")) {\n      const overtaken = mmAlivePlayers(gp).filter(o => o.id !== player.id && passed.includes(o.positionMapItemId) && walked > (lastMove[o.id] ?? 0));\n      if (overtaken.length > 0 && Math.random() < MM_ROLE_CFG.teoChance) {\n        await mmGiveNamedCard(gp, player, \"Е©╚И╘╛Е┼═И·╜\", `Х╤┘Х©┤Д╨├ ${overtaken.map(o => o.name).join(\"Ц─│\")}О╪▄Е┘┬Х║▄Д╦─Ф╜╔`, mmSkillTag(gp, player));\n      }\n    }\n    // Е▄≈И╩▒Х©╫Г▄▌Х─┘О╪ Д╦─Ф╛║Х╣╟Е╬≈Е╓÷Х©°\n    if (mmHasRole(player, \"diamond\") && walked >= MM_ROLE_CFG.diamondMinSteps && Math.random() < MM_ROLE_CFG.diamondChance) {\n      await mmGiveRandomCard(gp, player, `Д╦─Е▐ёФ╟■Х╥▒Д╨├ ${walked} Ф╜╔О╪▄Ф█║Е┬╟Д╦─Е╪═Ф°╨Д╪ Е█║`, mmSkillTag(gp, player));\n    }\n    // Х√╞И╦║О╪ Г╩▐Х©┤Х╣╥Г┌╧Е▐√Е┤╨Е╟▐И┤▒Е╨⌠\n    if (mmHasRole(player, \"kotone\") && visited.includes(MM_IDS.start)) await mmKotoneWithdraw(gp, player);\n  }\n  lastMove[player.id] = walked;\n  // И▓╔Е▄≥Е╟▐Е│╥О╪ Х╥╞Х©┤Е┬╚Д╨╨Г └ 0 Г╨╖Е°╟Г ╝О╪▄Д╩▌И⌠╤Х║▄И╒├Х╣╟И┌ёИ┤▄Е┬ Д╨╓Г └Х©┤Х╥╞Х╢╧О╪┬Ф╞▐Г╛■Е▐╙Х┐╫И╒├Д╦─Ф╛║О╪┴\n  if (mmHasRole(player, \"misuzu\") && !player.isBankrupted) {\n    const lastToll0: Record<string, number> = gp.customData.lastToll0 ?? {};\n    for (const tile of passed) {\n      const prop = mmPropertyAt(gp, tile).prop;\n      const amount = lastToll0[tile] ?? 0;\n      if (!prop || amount <= 0 || !prop.owner || prop.owner.id === player.id || prop.level !== 0) continue;\n      delete lastToll0[tile];\n      await player.gain(amount, \"role\");\n      mmAnnounce(gp, \"success\", `${mmSkillTag(gp, player)}${player.name} Ф╨°Х©⌡Г╘╨Е°╟Ц─▄${prop.name}Ц─█О╪▄Д╩▌И⌠╤Х║▄И╒├Х╣╟Д╨├Е┬ Д╨╓Г └Х©┤Х╥╞Х╢╧ ${amount}О©╔`,\n        `П÷■▒ ${mmPlayerLink(gp, player)} Ф╨°Х©⌡Г╘╨Е°╟ ${mmPropLink(gp, prop)}О╪▄Д╩▌И⌠╤Х║▄И╒├Х╣╟Д╨├Е┬ Д╨╓Г └Х©┤Х╥╞Х╢╧ ${amount}О©╔`);\n    }\n  }\n  // И▓╔Е▄≥Е╟▐Е│╥О╪ Х┤╙Е╥╠Х╥╞Х©┤О╪┬Ф┬√Е│°Е°╗О╪┴И╒└Е╝ Г └Е°╟Г ╝О╪▄И╒└Е╝ Е┬╟Ф°÷\n  const reserve = mmReserves(gp);\n  for (const [tile, pid] of Object.entries(reserve)) {\n    if (pid !== player.id || !visited.includes(tile)) continue;\n    delete reserve[tile];\n    mmSetStatus(gp, player, \"\");\n    const prop = mmPropertyAt(gp, tile).prop;\n    if (prop) gp.gameLogBroadcast(`П÷■▒ ${mmPlayerLink(gp, player)} Е⌡·Е┬╟Д╨├ ${mmPropLink(gp, prop)}О╪▄И╒└Е╝ Е┬╟Ф°÷`);\n  }\n}\n\n/** Ф▄┴Е█║Е░█Е▐▒Д╦─Е╪═Е█║О╪⌡Ф┴▀Г┴▄Ф╩║Д╨├Е╟╠Д╦█Г╩≥О╪┬Д╦█Е╪╧Д╦╒Г┴▄Ф║├О╪┴ */\nasync function mmGiveNamedCard(gp: IGameProcess, player: IPlayer, cardName: string, reason: string, tag = \"\"): Promise<boolean> {\n  const info = [...gp.chanceCardInfos.values()].find(i => i.name === cardName);\n  if (!info) return false;\n  if (player.chanceCards.length >= MM_MAX_HAND) {\n    gp.messageNotify([player.id], { type: \"info\", content: `${reason}О╪▄Д╫├Ф┴▀Г┴▄Ф╩║Д╨├О╪▄Ф╡║Ф▀©Е┬╟Ц─▄${cardName}Ц─█` });\n    return false;\n  }\n  await player.gainCard(gp.createNewChanceCard(info.id));\n  mmAnnounce(gp, \"success\", `${tag}${player.name} ${reason}О╪▄Е╬≈Е┬╟Ц─▄${cardName}Ц─█`, `${mmPlayerLink(gp, player)} ${reason}О╪▄Е╬≈Е┬╟ ${mmCardLink(gp, info.id)}`);\n  return true;\n}\n\n// ---------- И▓╔Е▄≥Е╟▐Е│╥О╪ Ф▄┌Г┴▄И╒└Е╝  ----------\n/** Х╥╞И²╒Ф═╪ ID Б├▓ И╒└Е╝ Х─┘ ID */\nconst mmReserves = (gp: IGameProcess): Record<string, string> => gp.customData.reserve ?? (gp.customData.reserve = {});\n/**\n * Е┬╟Х╬╬Ф≈═Д╦╩Е°╟Г ╝Ф≈╤Х╟┐Г■╗О╪┬Д╧╟Е°╟Д╧▀Е┴█О╪┴Ц─┌Х©■Е⌡· true Х║╗Г╓╨Е╥╡Г╩▐Е╓└Г░├Е╝▄О╪▄Д╦█Е├█Х╣╟Е╪∙Ф⌠▌Г └Д╧╟Е°╟Ф╣│Г╗▀О╪ \n * Е┬╚Д╨╨И╒└Е╝ Г └Е°╟Д╧╟Д╦█Д╨├О╪⌡И▓╔Е▄≥Е╟▐Е│╥Е│°Е°╗Ф≈═Д╦╩Е°╟Ф≈╤О╪▄\"Д╧╟Д╦▀ / Ф▄┌Г┴▄И╒└Е╝  / И┐╫Д╦█Х╕│\"Е░┬Ф┬░Д╦─Д╦╙И─┴Ф▀╘Ф║├О╪┬Д╩ёФ⌡©Е╪∙Ф⌠▌Г └Х╢╜Д╧╟Ф║├О╪┴Ц─┌\n */\nasync function mmReserveOnArrival(gp: IGameProcess, player: IPlayer, here: string, plot: MapItem, prop: IProperty): Promise<boolean> {\n  const reserve = mmReserves(gp);\n  const holder = reserve[here] ? gp.players.get(reserve[here]) : undefined;\n  if (reserve[here] && (!holder || holder.isBankrupted)) delete reserve[here];\n  else if (holder && holder.id !== player.id) {\n    mmAnnounce(gp, \"info\", `${mmSkillTag(gp, holder)}Ц─▄${prop.name}Ц─█Е╥╡Х╒╚ ${holder.name} Ф▄┌Г┴▄И╒└Е╝ О╪▄${player.name} Ф ┌Ф≈╤Д╧╟Д╦█Д╨├`,\n      `П÷■▒ ${mmPropLink(gp, prop)} Е╥╡Х╒╚ ${mmPlayerLink(gp, holder)} Ф▄┌Г┴▄И╒└Е╝ О╪▄${mmPlayerLink(gp, player)} Ф ┌Ф≈╤Д╧╟Д╦█Д╨├`);\n    return true;\n  }\n  if (!mmHasRole(player, \"misuzu\")) return false;\n  const old = Object.keys(reserve).find(t => reserve[t] === player.id && t !== here);\n  const oldName = old ? mmPropertyAt(gp, old).prop?.name : undefined;\n  const canBuy = player.money > prop.sellCost;\n  const options = [\n    ...(canBuy ? [mmOption(\"buy\", `Д╧╟Д╦▀Ц──${prop.sellCost}О©╔`, `Г▌╟И┤▒ ${player.money}О©╔`, \"#43A047\")] : []),\n    mmOption(\"reserve\", \"П÷■▒ Ф▄┌Г┴▄И╒└Е╝ \", `Д╦▀Ф╛║Х╥╞Х©┤Х©≥И┤▄Д╧▀Е┴█О╪▄Е┘╤Д╩√Д╨╨И┐╫Д╦█Х┐╫Д╧╟Е╝┐${oldName ? `О╪┬Д╪ Е▐√Ф╤┬Ц─▄${oldName}Ц─█Г └И╒└Е╝ О╪┴` : \"\"}`, \"#73677d\"),\n  ];\n  const pick = await mmChoose(gp, player, `Ц─▄${prop.name}Ц─█Ф╡║Ф°┴Д╦╩Д╨╨`,\n    `Е°╟Д╩╥ ${prop.sellCost}О©╔О╪▄Д╫═Г └Г▌╟И┤▒ ${player.money}О©╔Ц─┌${canBuy ? \"\" : \"Г▌╟Е°╗Д╧╟Д╦█Х╣╥Ц─┌\"}`, options, \"И┐╫Д╦█Х╕│\", 1);\n  if (pick === \"buy\") {\n    await gp.handlePlayerBuyProperty(player, prop);\n    if (prop.owner?.id === player.id) {\n      mmStockOnProperty(gp, plot, \"buy\");\n      if (reserve[here] === player.id) { delete reserve[here]; mmSetStatus(gp, player, \"\"); }\n    }\n    return true;\n  }\n  if (pick !== \"reserve\") return true;\n  if (old) delete reserve[old];\n  reserve[here] = player.id;\n  mmSetStatus(gp, player, `П÷■▒ И╒└Е╝ О╪ ${prop.name}`);\n  mmAnnounce(gp, \"info\", `${mmSkillTag(gp, player)}${player.name} Г╩≥Ц─▄${prop.name}Ц─█Ф▄┌Д╦┼Д╨├И╒└Е╝ Г┴▄`,\n    `П÷■▒ ${mmPlayerLink(gp, player)} Г╩≥ ${mmPropLink(gp, prop)} Ф▄┌Д╦┼Д╨├И╒└Е╝ Г┴▄О╪▄Д╦▀Ф╛║Х╥╞Х©┤Е┴█Е┬╚Д╨╨И┐╫Д╧╟Д╦█Д╨├`);\n  return true;\n}\n\n// ---------- Е┬╟Х╬╬Е░▌О╪ Ф°┬Е╓°Х╖│ ----------\nconst mmNeighbors = (gp: IGameProcess, id: string) => gp.mapData.mapPaths\n  .filter(p => p.fromMapItemId === id || p.toMapItemId === id)\n  .map(p => (p.fromMapItemId === id ? p.toMapItemId : p.fromMapItemId));\nasync function mmRolesAfterArrival(gp: IGameProcess, player: IPlayer) {\n  if (player.isBankrupted) return;\n  const yachiyos = mmAlivePlayers(gp).filter(p => p.id !== player.id && mmHasRole(p, \"yachiyo\"));\n  if (yachiyos.length === 0) return;\n  // Е│°Е°╗Ф°┬Е╓°Х╖│Ф≈│Х╬╧Д╦─Ф═╪О╪ Х╒╚Ф▀┴Е┬╟Е╔╧Х╨╚Х╬╧О╪┬Д╦█Х╖╕Е▐▒И┌ёД╦─Ф═╪Г └Ф∙┬Ф·°О╪┴\n  if (!mmIsHeld(player)) {\n    const y = yachiyos.find(y => !mmIsHeld(y) && y.positionMapItemId !== player.positionMapItemId\n      && mmNeighbors(gp, y.positionMapItemId).includes(player.positionMapItemId));\n    if (y) {\n      await player.tpToMapItem(y.positionMapItemId);\n      mmAnnounce(gp, \"info\", `${mmSkillTag(gp, y)}${y.name} Ф┼┼Х╥╞Х©┤Г └ ${player.name} Ф▀┴Е┬╟Х╨╚Х╬╧Е┤▒Г┐╜И≈╧`,\n        `П÷▐╝ ${mmPlayerLink(gp, y)} Ф┼┼Е│°Е°╗Ф≈│Х╬╧Г └ ${mmPlayerLink(gp, player)} Ф▀┴Е┬╟Д╨├Х┤╙Е╥╠Х╨╚Х╬╧`);\n    }\n  }\n  // Е▐╕Е╓√Д╦╓Е░█Г▌╘Е╝╤Е│°Е°╗Е░▄Д╦─Ф═╪О╪ Ф°┬Е╓°Х╖│Ф▀©Е╔√И┤▒\n  const here = player.positionMapItemId;\n  const mates = mmAlivePlayers(gp).filter(p => p.id !== player.id && p.positionMapItemId === here);\n  for (const y of yachiyos) {\n    const mate = mates.find(m => m.id !== y.id);\n    if (!mate) continue;\n    const bonus = mmByPlayerCount(gp, MM_ROLE_CFG.yachiyoBonus);\n    await y.gain(bonus, \"role\");\n    mmAnnounce(gp, \"success\", `${mmSkillTag(gp, y)}${player.name} Е▓▄ ${mate.name} Ф▄╓Е°╗Д╨├Е░▄Д╦─Ф═╪О╪▄${y.name} Г°▀Г┐╜И≈╧Ф▀©Е┬╟ ${bonus}О©╔`,\n      `П÷▐╝ ${mmPlayerLink(gp, player)} Е▓▄ ${mmPlayerLink(gp, mate)} Ф▄╓Е°╗Д╨├Е░▄Д╦─Ф═╪О╪▄${mmPlayerLink(gp, y)} Г°▀Г┐╜И≈╧Ф▀©Е┬╟ ${bonus}О©╔`);\n  }\n}\n\n// ---------- Е┤╨Г┴▄О╪ Е├╟ГЁ√И⌡╙Ф╒╗ ----------\n/** Ц─▄Г▌╘Е╝╤Ф⌠█Д╫°Ц─█И≤╤Ф╝╣Г■╗Е╝┐Д╩ёФ⌡© handleUseChanceCardО╪ Х╝╟Д╦▀Е┤╨Г┴▄Д╨╨О╪┬Х√╞И╦║Е┬╓Ф√╜Х╒╚Е┼╗Ф┴ёИ▓╠Г■╗О╪┴О╪▄Е┤╨Е╝▄Г┴▄Е╓└Г░├Е├╟ГЁ√И⌡╙Ф╒╗ */\nasync function mmUseCard(gp: IGameProcess, player: IPlayer, cardId: string, targetIdList: string[]): Promise<boolean> {\n  const card = player.getCardById(cardId);\n  const info = card ? { name: card.getName(), sourceId: card.getSourceId(), type: String(card.getType()) } : undefined;\n  gp.customData.cardUser = player.id;\n  let ok = false;\n  try {\n    ok = await gp.handleUseChanceCard(player, cardId, targetIdList);\n  } finally {\n    delete gp.customData.cardUser;\n  }\n  if (!ok || !info || (info.type !== \"ToOtherPlayer\" && info.type !== \"ToPlayer\")) return ok;\n  const target = gp.players.get(targetIdList[0]);\n  if (!target || target.id === player.id) return ok;\n  try {\n    await mmSheriAfterAttack(gp, player, target, info);\n  } catch (e) {\n    gp.msgNotifyBroadcast(\"error\", `Е├╟ГЁ√И⌡╙Ф╒╗Ф┼─Х┐╫Е┤╨И■≥О╪ ${e instanceof Error ? e.message : String(e)}`);\n  }\n  return ok;\n}\nasync function mmSheriAfterAttack(gp: IGameProcess, user: IPlayer, target: IPlayer, info: { name: string; sourceId: string }) {\n  if (mmHasRole(target, \"sheri\") && !target.isBankrupted) await mmSheriCopy(gp, target, info);\n  if (MM_SHERI_NO_JOIN.includes(info.name)) return;\n  // Ф╞▐Д╦╙Ф╡║Х╒╚Е█╥Е┘╔Г └И⌡╙Ф╒╗Е░└Х┤╙Е┬╓Е╝ О╪▄Д╫├Д╦─Е╪═Е█║Ф°─Е╓ И║╨Е╦╕Д╦─Д╦╙О╪┬Е╓ Д╦╙И⌡╙Ф╒╗Е░▄Е°╨Ф≈╤И≤╡Ф╜╒Е█║Г┴▄И⌡╙Е╢╘О╪┴\n  const joiners = mmAlivePlayers(gp).filter(p => mmHasRole(p, \"sheri\") && p.id !== user.id && p.id !== target.id && Math.random() < MM_ROLE_CFG.sheriJoin);\n  const s = joiners[Math.floor(Math.random() * joiners.length)];\n  if (s) {\n    mmAnnounce(gp, \"warning\", `${mmSkillTag(gp, s)}${s.name}О╪ Ц─▄Ф┬▒Д╧÷Х╕│Г▌╘О╪│Ц─█${user.name} Г └Ц─▄${info.name}Ц─█Д╧÷Ф┴⌠Е┬╟Д╨├ ${s.name} Х╨╚Д╦┼`,\n      `П÷█░ ${mmPlayerLink(gp, s)}О╪ Ц─▄Ф┬▒Д╧÷Х╕│Г▌╘О╪│Ц─█${mmPlayerLink(gp, user)} Г └ ${mmCardLink(gp, info.sourceId)} Д╧÷Ф┴⌠Е┬╟Д╨├ ${mmPlayerLink(gp, s)} Х╨╚Д╦┼`);\n    gp.customData.cardUser = user.id;\n    try {\n      await gp.createNewChanceCard(info.sourceId).use(user, s, gp);\n    } finally {\n      delete gp.customData.cardUser;\n    }\n    gp.gameDataBroadcast();\n    if (!s.isBankrupted) await mmSheriCopy(gp, s, info, 1);\n  }\n}\nasync function mmSheriCopy(gp: IGameProcess, sheri: IPlayer, info: { name: string; sourceId: string }, chance = MM_ROLE_CFG.sheriCopy) {\n  if (Math.random() >= chance) return;\n  if (sheri.chanceCards.length >= MM_MAX_HAND) {\n    gp.messageNotify([sheri.id], { type: \"info\", content: `Е╥╝Г┌╧Е╜╕Д╪ Д╨├Ц─▄${info.name}Ц─█О╪▄Е▐╞Ф┐°Ф┴▀Г┴▄Ф╩║Д╨├` });\n    return;\n  }\n  await sheri.gainCard(gp.createNewChanceCard(info.sourceId));\n  mmAnnounce(gp, \"success\", `${mmSkillTag(gp, sheri)}${sheri.name} Х╒╚Ц─▄${info.name}Ц─█Ф┴⌠Д╦╜О╪▄Д╧÷Е╜╕Д╪ Д╨├Х©≥Д╦─Ф▀⌡`,\n    `П÷█░ ${mmPlayerLink(gp, sheri)} Х╒╚ ${mmCardLink(gp, info.sourceId)} Ф┴⌠Д╦╜О╪▄Д╧÷Е╜╕Д╪ Д╨├Х©≥Д╦─Ф▀⌡О╪▄Е╬≈Е┬╟Д╦─Е╪═Е░▄Ф═╥Г └Е█║`);\n}\n\n// ---------- Ф╞▐Х╫╝Е╪─Е╖▀О╪ Е├╟ГЁ√И⌡╙Ф╒╗Е╪─Е╠─Х┤╙Е╦╕Е█║Ц─│Ф┴│Д╧┐ ----------\nasync function mmRolesRoundStart(gp: IGameProcess) {\n  // Е├╟ГЁ√И⌡╙Ф╒╗О╪ Г╛╛Д╦─Ф╛║Х╫╝Е┬╟\"Х╫╝Ф╛║Е╪─Е╖▀\"Ф≈╤Е▐▒Д╦─Е╪═Х┤╙Е╦╕Г └Е█║О╪┬Ф╞▐Д╨╨Е▐╙Е▐▒Д╦─Ф╛║О╪┴\n  const started: string[] = gp.customData.sheriStarted ?? (gp.customData.sheriStarted = []);\n  for (const p of mmAlivePlayers(gp).filter(p => mmHasRole(p, \"sheri\") && !started.includes(p.id))) {\n    started.push(p.id);\n    await mmGiveNamedCard(gp, p, MM_SHERI_START_POOL[Math.floor(Math.random() * MM_SHERI_START_POOL.length)], \"Е╦╕Г²─Г▌╘Е┘╥Д╦┼Е°╨\", mmSkillTag(gp, p));\n  }\n  const prev: number | undefined = gp.customData.rolePrevRound;\n  gp.customData.rolePrevRound = gp.currentRound;\n  if (prev === undefined || prev === gp.currentRound || gp.customData.lastTollRound === prev) return;\n  for (const p of mmAlivePlayers(gp).filter(p => mmHasRole(p, \"yoshino\"))) {\n    const bonus = mmByPlayerCount(gp, MM_ROLE_CFG.yoshinoBonus);\n    await p.gain(bonus, \"role\");\n    mmAnnounce(gp, \"success\", `${mmSkillTag(gp, p)}Д╦┼Д╦─Х╫╝Ф╡║Ф°┴Д╩╩Д╫∙Д╨╨Д╨╓Х©┤Х╥╞Х╢╧О╪▄${p.name} Ф▀©Е┬╟ ${bonus}О©╔`,\n      `П÷█┐ Д╦┼Д╦─Х╫╝Ф╡║Ф°┴Д╩╩Д╫∙Д╨╨Д╨╓Х©┤Х╥╞Х╢╧О╪▄${mmPlayerLink(gp, p)} Ф▀©Е┬╟ ${bonus}О©╔`);\n  }\n}\n\n// Ф▌╔ LLM Г └Е├┘Г╫╝ AI Х║╔Д╦│О╪┬Е▌╩Ф▌┴Е├≥Ф╜╩Г └Г▌╟И┤▒Е╝┴Е┘╗Г╨©Ц─│Х║╔Д╦┼Ф°╛Е°╟Е⌡╬Х╖└Е┬≥О╪┴Е°╗Ц─▄Ф╦╦Ф┬▐Е┬²Е╖▀Е▄√Г╩⌠Ф²÷Ц─█И≤╤Ф╝╣Д╩ёГ═│И┤▄\n","startMapItemId":"mi-pkctf6"}┴A
