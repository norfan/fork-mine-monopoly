","name":"Êà∑ÈÉ®ËµãÁ®é","type":"ArrivedEvent","description":"Áº¥Á∫≥Ë∫´Êà∑Á®éÔºàÁé∞ÈáëÁöÑ 10%Ôºå‰∏ç‰Ωé‰∫é 100Ôºâ„ÄÇ","effectCode":"((player: IPlayer, gameProcess: IGameProcess) => { const tax = Math.max(100, Math.floor(player.money * 0.1)); player.cost(tax, \"tang_tax\"); gameProcess.messageNotify([player.id], { type: \"warning\", content: `Áº¥Á∫≥Êà∑Á®é ${tax}` }); gameProcess.gameDataBroadcast(); });"},{"id":"evt-salary","name":"ÁöáÂüé‰ø∏Á¶Ñ","type":"PassedEvent","description":"ÁªèËøáÂ§ßÊòéÂÆ´È¢ÜÂèñ‰ø∏Á¶Ñ 1200„ÄÇ","effectCode":"((player: IPlayer, gameProcess: IGameProcess) => { player.gain(1200, \"tang_salary\"); gameProcess.messageNotify([player.id], { type: \"success\", content: \"Ë∑ØËøáÁöáÂüéÔºåÈ¢Ü‰ø∏Á¶Ñ 1200\" }); });"},{"id":"evt-exile","name":"Ë¥¨Ë∞™Â¥ñÂ∑û","type":"ArrivedEvent","description":"Ë¥¨Ë∞™Â¥ñÂ∑ûÔºåÊäºÂÖ•Â§ßÁêÜÂØ∫ÂÄôÂÆ°„ÄÇ","effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => { gameProcess.messageNotify([player.id], { type: \"warning\", content: \"Ë¥¨Ë∞™Â¥ñÂ∑ûÔºÅÊäºÂÖ•Â§ßÁêÜÂØ∫ÂÄôÂÆ°\" }); await player.tpToMapItem(\"item-10\"); });"}],"phases":{"gameOverRule":[{"id":"sys-phase-game-over-rule","name":"Ê∏∏ÊàèÁªìÊùüÂà§ÂÆöËßÑÂàô","description":"Ê∏∏ÊàèÁªìÊùüÂà§ÂÆöËßÑÂàô, ËøîÂõû false Ë°®Á§∫Ê∏∏ÊàèÁªßÁª≠","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => {\n\t// ËøîÂõû false Ë°®Á§∫Ê∏∏ÊàèÁªßÁª≠\n\t// ËøîÂõûÁé©ÂÆ∂IDÊï∞ÁªÑË°®Á§∫Ê∏∏ÊàèÁªìÊùüÔºåÊï∞ÁªÑÈ°∫Â∫èÂç≥‰∏∫ÊéíÂêçÔºàÁ¥¢Âºï0‰∏∫Á¨¨‰∏ÄÂêçÔºâ\n\t// Á§∫‰æã: return [winnerId, secondPlaceId, ...];\n\treturn false;\n});"}],"gameInited":[{"id":"sys-phase-game-inited","name":"Ê∏∏ÊàèÂàùÂßãÂåñÁªìÊùü","description":"Ê∏∏ÊàèÂàùÂßãÂåñÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;"}],"playerPreInit":[{"id":"sys-phase-player-pre-init","name":"Áé©ÂÆ∂È¢ÑÂàùÂßãÂåñ","description":"Áé©ÂÆ∂È¢ÑÂàùÂßãÂåñÈò∂ÊÆµÔºàÂú®Áé©ÂÆ∂ÂàùÂßãÂåñ‰πãÂâçËøêË°åÔºâ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}],"propertyPreInit":[{"id":"sys-phase-property-pre-init","name":"Âú∞ÁöÆÈ¢ÑÂàùÂßãÂåñ","description":"Âú∞ÁöÆÈ¢ÑÂàùÂßãÂåñÈò∂ÊÆµÔºàÂú®Âú∞ÁöÆÂàùÂßãÂåñ‰πãÂâçËøêË°åÔºâ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}],"gameRoundStart":[{"id":"sys-phase-game-round-start","name":"ËΩÆÊ¨°ÂºÄÂßã","description":"ËΩÆÊ¨°ÂºÄÂßãÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameRoundStartContext>;"}],"playerRound":[{"id":"sys-phase-player-round-start","name":"Áé©ÂÆ∂ÂõûÂêàÂºÄÂßã","description":"Áé©ÂÆ∂ÂõûÂêàÂºÄÂßãÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerRoundStart","initEventCode":"(async (context, gameProcess) => {\n\t//ÈÄöÁü•Áé©ÂÆ∂ÂõûÂêà\n\tgameProcess.roundTurnNotify(context.currentRoundPlayer.id);\n}) as GameEventFunction<PlayerRoundStartContext>;"},{"id":"sys-phase-roll-dice","name":"Áé©ÂÆ∂Êìç‰Ωú","description":"Áé©ÂÆ∂Êìç‰ΩúÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"RollDice","initEventCode":"(async (context, gameProcess) => {\n\tconst currentPlayer = context.currentRoundPlayer;\n\n\t// ‰ΩøÁî®Âæ™ÁéØÊù•Â§ÑÁêÜÂèØËÉΩÁöÑÂ§öÊ¨°Êìç‰ΩúÔºåÁõ¥Âà∞Áé©ÂÆ∂Êé∑È™∞Â≠êÊàñË∂ÖÊó∂\n\twhile (true) {\n\t\tgameProcess.setCurrentEventName(`Á≠âÂæÖ${currentPlayer.name}Êìç‰Ωú`);\n\n\t\tconst operation = await Promise.race([\n\t\t\tgameProcess.oncePlayerOperationAsync(currentPlayer.id, OperateType.RollDice)\n\t\t\t\t.then((res) => ({ type: OperateType.RollDice, res })),\n\t\t\tgameProcess.oncePlayerOperationAsync(currentPlayer.id, OperateType.UseChanceCard)\n\t\t\t\t.then((res) => ({ type: OperateType.UseChanceCard, res })),\n\t\t]);\n\n\t\tgameProcess.removePlayerAllOperationListener(currentPlayer.id, OperateType.RollDice);\n\t\tgameProcess.removePlayerAllOperationListener(currentPlayer.id, OperateType.UseChanceCard);\n\n\t\tif (operation.type === OperateType.RollDice) {\n\t\t\tbreak;\n\t\t}\n\n\t\tif (operation.res) {\n\t\t\tconst { chanceCardId, targetIdList } = operation.res;\n\t\t\tawait gameProcess.handleUseChanceCard(currentPlayer, chanceCardId, targetIdList);\n\t\t}\n\t}\n\n\t// Â∞ÜÈ™∞Â≠êÁªìÊûúÂÜôÂÖ•‰∏ä‰∏ãÊñáÔºåÂπ∂Â≠òÂÇ®Âà∞Áé©ÂÆ∂ÂØπË±°‰∏≠‰æõÂÖ∂‰ªñÊú∫Âà∂‰ΩøÁî®\n\tconst diceResult = await currentPlayer.rollDices();\n\tcontext.diceResult = diceResult;\n}) as GameEventFunction<RollDiceContext>;\n"},{"id":"sys-phase-player-move","name":"Áé©ÂÆ∂ÁßªÂä®","description":"Áé©ÂÆ∂ÁßªÂä®Èò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerMove","initEventCode":"(async (context, gameProcess) => {\n\t//Áé©ÂÆ∂ÁßªÂä®\n\tconst player = context.currentRoundPlayer;\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\n\tcontext.targetIndex = player.positionIndex;\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"sys-phase-arrived-event","name":"Âà∞Ëææ‰∫ã‰ª∂","description":"Âà∞Ëææ‰∫ã‰ª∂Èò∂ÊÆµ","from":"Á≥ªÁªü","mark":"ArrivedEvent","initEventCode":"(async (context, gameProcess) => {\n\tconst player = context.currentRoundPlayer;\n\tawait gameProcess.handleArriveEvent(player);\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"sys-phase-player-round-end","name":"Áé©ÂÆ∂ÂõûÂêàÁªìÊùü","description":"Áé©ÂÆ∂ÂõûÂêàÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\t\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"sys-phase-game-round-end","name":"ËΩÆÊ¨°ÁªìÊùü","description":"ËΩÆÊ¨°ÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\tgameProcess.currentRound += 1;\n}) as GameEventFunction<GameRoundEndContext>;"}],"postRestore":[{"id":"sys-phase-post-restore","name":"Â≠òÊ°£ÊÅ¢Â§çÂêé","description":"Â≠òÊ°£ÊÅ¢Â§çÂêéÈò∂ÊÆµ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}]},"buildingModelIdList":["house-guannei-0","house-guannei-1","house-guannei-2","house-guannei-3","house-guannei-4"],"uiTemplates":[],"modifierTemplates":[],"customUIs":[],"gameSettingForm":[{"id":"gs-init-money","key":"initMoney","type":"number-input","label":"ÂàùÂßãÂºÄÂÖÉÈÄöÂÆù","defaultValue":10000,"min":0,"max":1000000,"builtIn":true},{"id":"gs-turn-timeout","key":"turnTimeout","type":"number-input","label":"ÂõûÂêàÂÄíËÆ°Êó∂(Áßí)","defaultValue":15,"min":5,"max":120,"builtIn":true},{"id":"gs-chance-timeout","key":"chanceTimeout","type":"number-input","label":"Êú∫‰ºöÂç°ÈòÖËØªÊó∂Èôê(Áßí)","defaultValue":20,"min":5,"max":120}],"extraLibs":"// Áõõ‰∏ñÂ§ßÂîêÂú∞ÂõæÊïàÊûúÂáΩÊï∞Â∫ìÔºàÁî± GameProcessTypes + Êú¨Â∫ìÊãºÊé•ÂêéÁªè TS ÁºñËØëÊ≥®ÂÖ•Ôºâ\n// Ê®°ÂºèÂØπÈΩêÂÆòÊñπÂú∞Âõæ extraLibsÔºöÂú∞‰∫ßÂà∞ËææÔºàË¥≠ÁΩÆ/Âª∫ÈÄ†/Êî∂ÁßüÔºâ„ÄÅÊú∫‰ºöÂç°ÊäΩÂèñ„ÄÅÈÄöÁî®Êî∂‰ªòÊ¨æ\nfunction tangNumber(gp: IGameProcess, key: string, fallback: number): number {\n  const value = Number(gp.gameSetting[key]?.value);\n  return Number.isFinite(value) ? value : fallback;\n}\nasync function tangCash(gp: IGameProcess, player: IPlayer, base: number, title: string): Promise<void> {\n  if (player.isBankrupted) return;\n  const money = Math.max(0, Math.round(Math.abs(base)));\n  if (base >= 0) await player.gain(money, \"tang_card\");\n  else if (money > 0) await player.cost(money, \"tang_tax\");\n  gp.messageNotify([player.id], { type: base >= 0 ? \"success\" : \"warning\", content: `${title}Ôºö${base >= 0 ? \"Êî∂ÂÖ•\" : \"ÊîØÂá∫\"} ${money}ÔºåÁªì‰Ωô ${player.money}` });\n  gp.gameDataBroadcast();\n}\nasync function tangArrive(gp: IGameProcess, property: IProperty, player: IPlayer): Promise<void> {\n  if (player.isBankrupted) return;\n  const owner = property.owner;\n  const displayName = property.name.replace(/\\n/g, \"¬∑\");\n  if (!owner) {\n    const price = property.sellCost;\n    if (player.money <= price) {\n      gp.messageNotify([player.id], { type: \"warning\", content: `${displayName} ÂîÆ‰ª∑ ${price}ÔºåÁé∞Èáë‰∏çË∂≥ÔºåÊó†ÂäõË¥≠Âú∞„ÄÇ` });\n      return;\n    }\n    const result = await gp.showConfirmDialog(player.id, { title: `Ë¥≠ÁΩÆ ${displayName}`, content: `ÂîÆ‰ª∑ ${price}ÔºåÂΩìÂâçÁªì‰Ωô ${player.money}„ÄÇ`, confirmText: \"‰π∞‰∏ã\", cancelText: \"ÊîæÂºÉ\" }, { timeout: tangNumber(gp, \"turnTimeout\", 15) * 1000 });\n    if (result.confirm && !player.isBankrupted && player.money > price) await gp.handlePlayerBuyProperty(player, property);\n    return;\n  }\n  if (owner.id === player.id) {\n    if (property.level < property.maxLevel && player.money > property.buildCost) {\n      const result = await gp.showConfirmDialog(player.id, { title: `Êâ©Âª∫ ${displayName}`, content: `Âª∫ÈÄ†Ë¥π ${property.buildCost}ÔºåÂçáËá≥ ${property.level + 1} Á∫ß„ÄÇ`, confirmText: \"ÂºÄÂ∑•\", cancelText: \"ÊöÇ‰∏ç\" }, { timeout: tangNumber(gp, \"turnTimeout\", 15) * 1000 });\n      if (result.confirm && !player.isBankrupted) await gp.handlePlayerBuildUp(player, property);\n    }\n    return;\n  }\n  const rent = property.costList[property.level] || 0;\n  const paid = await player.cost(rent, \"tang_rent\", owner);\n  if (paid.actualCost > 0) await owner.gain(paid.actualCost, \"tang_rent\", player);\n  gp.msgNotifyBroadcast(\"info\", `${player.name} Âú® ${displayName} Áº¥Á∫≥ÁßüÈì∂ ${paid.actualCost} ‰∫à ${owner.name}`);\n  gp.gameDataBroadcast();\n}\nasync function tangDraw(gp: IGameProcess, player: IPlayer): Promise<void> {\n  const cards = Array.from(gp.chanceCardInfos.values());\n  if (!cards.length) return;\n  const info = cards[Math.floor(Math.random() * cards.length)];\n  await gp.showConfirmDialog(player.id, { title: `Êú∫‰ºöÂç° ¬∑ ${info.name}`, content: `${info.description}\\n\\nÁÇπÂáªÁ°ÆËÆ§ÂêéÊâßË°åÊïàÊûúÔºõÁ≠âÂæÖË∂ÖÊó∂Â∞ÜËá™Âä®ÊâßË°å„ÄÇ`, confirmText: \"Áü•ÊôìÂπ∂ÊâßË°å\", cancelText: \"Â∑≤ËØªÁªßÁª≠\" }, { timeout: tangNumber(gp, \"chanceTimeout\", 20) * 1000, defaultValue: { id: player.id, confirm: true } });\n  if (player.isBankrupted) return;\n  gp.msgNotifyBroadcast(\"info\", `${player.name} ÊäΩÂà∞„Äå${info.name}„Äç`);\n  await gp.createNewChanceCard(info.id).use(player, player, gp);\n  gp.gameDataBroadcast();\n}\n"}‚
