,{"id":"path-35","fromMapItemId":"item-35","toMapItemId":"item-36","initEnable":true,"name":"35 ‚Üí 36"},{"id":"path-36","fromMapItemId":"item-36","toMapItemId":"item-37","initEnable":true,"name":"36 ‚Üí 37"},{"id":"path-37","fromMapItemId":"item-37","toMapItemId":"item-38","initEnable":true,"name":"37 ‚Üí 38"},{"id":"path-38","fromMapItemId":"item-38","toMapItemId":"item-39","initEnable":true,"name":"38 ‚Üí 39"},{"id":"path-39","fromMapItemId":"item-39","toMapItemId":"item-0","initEnable":true,"name":"39 ‚Üí 0"}],"pathMapItemTypeIds":["t-act-siliao","t-act-jingbei","t-act-jingnan","t-act-huainan","t-act-jiangdong","t-act-hebei","t-act-xiliang","t-act-yizhou","t-chance","t-fate","t-tax","t-start","t-jail","t-free","t-goto"],"mapIndex":["item-0","item-1","item-2","item-3","item-4","item-5","item-6","item-7","item-8","item-9","item-10","item-11","item-12","item-13","item-14","item-15","item-16","item-17","item-18","item-19","item-20","item-21","item-22","item-23","item-24","item-25","item-26","item-27","item-28","item-29","item-30","item-31","item-32","item-33","item-34","item-35","item-36","item-37","item-38","item-39"],"roles":[{"id":"role-caocao","name":"ÊõπÊìç","description":"Ê≤ª‰∏ñ‰πãËÉΩËá£Ôºå‰π±‰∏ñ‰πãÂ•∏ÈõÑ„ÄÇ","color":"#5d7a9e","imageId":"image-role-caocao","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"},{"id":"role-liubei","name":"ÂàòÂ§á","description":"Ê±âÂÆ§ÂÆó‰∫≤ÔºåÂèåËÇ°ÂâëÔºå‰ªÅÂæ∑Â∏É‰∫éÂõõÊµ∑„ÄÇ","color":"#5d9e5d","imageId":"image-role-liubei","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"},{"id":"role-sunquan","name":"Â≠ôÊùÉ","description":"ÊâøÁà∂ÂÖÑÂü∫‰∏öÔºåÁ¥´È´ØÁ¢ßÁúºÔºåÊçÆÊúâÊ±ü‰∏ú„ÄÇ","color":"#b03a2e","imageId":"image-role-sunquan","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"},{"id":"role-zhugeliang","name":"ËØ∏Ëëõ‰∫Æ","description":"ÂçßÈæôÂÖàÁîüÔºåÁæΩÊâáÁ∫∂Â∑æÔºåÁÆóÊó†ÈÅóÁ≠ñ„ÄÇ","color":"#7f77dd","imageId":"image-role-zhugeliang","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"},{"id":"role-lvbu","name":"ÂêïÂ∏É","description":"È£ûÂ∞ÜÔºåÊñπÂ§©ÁîªÊàüÔºåËµ§ÂÖîÈ©¨ÔºåÂãáÂÜ†‰∏âÂÜõ„ÄÇ","color":"#c9761a","imageId":"image-role-lvbu","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"},{"id":"role-diaochan","name":"Ë≤ÇËùâ","description":"Âè∏ÂæíÂ∫úÊ≠åÂß¨Ôºå‰∏ÄÊõ≤ËøûÁéØÔºå‰π±‰∏ñ‰Ω≥‰∫∫„ÄÇ","color":"#d4537e","imageId":"image-role-diaochan","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {});"}],"inUse":false,"mapEvents":[{"id":"evt-chance","name":"Èî¶Âõä","type":"ArrivedEvent","description":"ÊäΩ‰∏ÄÂº†Êú∫‰ºöÂç°ÔºåÈòÖËØªÂêéÊâßË°å„ÄÇ","effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => { await clsDraw(gameProcess, player); });"},{"id":"evt-fate","name":"È£é‰∫ë","type":"ArrivedEvent","description":"‰π±‰∏ñÈ£é‰∫ëÔºöËé∑ÂæóÊé•Êµé / ÈÅ≠ÈÅá‰ºèÂáª / Ë¢´Ëø´‰ºëÊï¥","effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => { const r = Math.random(); if (r < 0.34) { await player.gain(1500, \"cls_fate\"); gameProcess.messageNotify([player.id], { type: \"success\", content: \"Êè¥ÂÜõ‰∏çÊó•ËÄåËá≥ÔºåËé∑ÂÜõÁ≤ÆÊé•Êµé 1500\" }); } else if (r < 0.67) { await player.cost(1000, \"cls_fate\"); gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ÈÅ≠ÈÅáÊïåÂÜõ‰ºèÂáªÔºåÊäòÊçü 1000\" }); } else { await player.setStop(1); gameProcess.messageNotify([player.id], { type: \"info\", content: \"Â§ßÈõ™Â∞ÅÂ±±ÔºåÊâéËê•‰ºëÊï¥‰∏ÄÂõûÂêà\" }); } gameProcess.gameDataBroadcast(); });"},{"id":"evt-tax","name":"Á®éÂÖ≥","type":"ArrivedEvent","description":"Áº¥Á∫≥ÂÜõÁ≤ÆÁ®éÔºàÁé∞ÈáëÁöÑ 10%Ôºå‰∏ç‰Ωé‰∫é 100Ôºâ„ÄÇ","effectCode":"((player: IPlayer, gameProcess: IGameProcess) => { const tax = Math.max(100, Math.floor(player.money * 0.1)); player.cost(tax, \"cls_tax\"); gameProcess.messageNotify([player.id], { type: \"warning\", content: `Áº¥Á∫≥ÂÜõÁ≤ÆÁ®é ${tax}` }); gameProcess.gameDataBroadcast(); });"},{"id":"evt-salary","name":"ÂÆ´Èó®ÁäíËµè","type":"PassedEvent","description":"ÁªèËøáËµ∑ÁÇπÈ¢ÜÂèñË¥Ø 1200„ÄÇ","effectCode":"((player: IPlayer, gameProcess: IGameProcess) => { player.gain(1200, \"cls_salary\"); gameProcess.messageNotify([player.id], { type: \"success\", content: \"Ë∑ØËøáÂÆ´Èó®ÔºåÈ¢ÜÂèñË¥Ø 1200\" }); });"},{"id":"evt-goto","name":"ÊäºÂÖ•Â§©Áâ¢","type":"ArrivedEvent","description":"Ëß¶ÁäØÁ¶Å‰æãÔºåÊäºÂÖ•Â§©Áâ¢ÂÄôÂÆ°„ÄÇ","effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => { gameProcess.messageNotify([player.id], { type: \"warning\", content: \"Ëß¶ÁäØÁ¶Å‰æãÔºÅÊäºÂÖ•Â§©Áâ¢\" }); await player.tpToMapItem(\"item-10\"); });"}],"phases":{"gameOverRule":[{"id":"sys-phase-game-over-rule","name":"Ê∏∏ÊàèÁªìÊùüÂà§ÂÆöËßÑÂàô","description":"Ê∏∏ÊàèÁªìÊùüÂà§ÂÆöËßÑÂàô, ËøîÂõû false Ë°®Á§∫Ê∏∏ÊàèÁªßÁª≠","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => {\n\t// ËøîÂõû false Ë°®Á§∫Ê∏∏ÊàèÁªßÁª≠\n\t// ËøîÂõûÁé©ÂÆ∂IDÊï∞ÁªÑË°®Á§∫Ê∏∏ÊàèÁªìÊùüÔºåÊï∞ÁªÑÈ°∫Â∫èÂç≥‰∏∫ÊéíÂêçÔºàÁ¥¢Âºï0‰∏∫Á¨¨‰∏ÄÂêçÔºâ\n\t// Á§∫‰æã: return [winnerId, secondPlaceId, ...];\n\treturn false;\n});"}],"gameInited":[{"id":"sys-phase-game-inited","name":"Ê∏∏ÊàèÂàùÂßãÂåñÁªìÊùü","description":"Ê∏∏ÊàèÂàùÂßãÂåñÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;"}],"playerPreInit":[{"id":"sys-phase-player-pre-init","name":"Áé©ÂÆ∂È¢ÑÂàùÂßãÂåñ","description":"Áé©ÂÆ∂È¢ÑÂàùÂßãÂåñÈò∂ÊÆµÔºàÂú®Áé©ÂÆ∂ÂàùÂßãÂåñ‰πãÂâçËøêË°åÔºâ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}],"propertyPreInit":[{"id":"sys-phase-property-pre-init","name":"Âú∞ÁöÆÈ¢ÑÂàùÂßãÂåñ","description":"Âú∞ÁöÆÈ¢ÑÂàùÂßãÂåñÈò∂ÊÆµÔºàÂú®Âú∞ÁöÆÂàùÂßãÂåñ‰πãÂâçËøêË°åÔºâ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}],"gameRoundStart":[{"id":"sys-phase-game-round-start","name":"ËΩÆÊ¨°ÂºÄÂßã","description":"ËΩÆÊ¨°ÂºÄÂßãÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundStart","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameRoundStartContext>;"}],"playerRound":[{"id":"sys-phase-player-round-start","name":"Áé©ÂÆ∂ÂõûÂêàÂºÄÂßã","description":"Áé©ÂÆ∂ÂõûÂêàÂºÄÂßãÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerRoundStart","initEventCode":"(async (context, gameProcess) => {\n\t//ÈÄöÁü•Áé©ÂÆ∂ÂõûÂêà\n\tgameProcess.roundTurnNotify(context.currentRoundPlayer.id);\n}) as GameEventFunction<PlayerRoundStartContext>;"},{"id":"sys-phase-roll-dice","name":"Áé©ÂÆ∂Êìç‰Ωú","description":"Áé©ÂÆ∂Êìç‰ΩúÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"RollDice","initEventCode":"(async (context, gameProcess) => {\n\tconst currentPlayer = context.currentRoundPlayer;\n\n\t// ‰ΩøÁî®Âæ™ÁéØÊù•Â§ÑÁêÜÂèØËÉΩÁöÑÂ§öÊ¨°Êìç‰ΩúÔºåÁõ¥Âà∞Áé©ÂÆ∂Êé∑È™∞Â≠êÊàñË∂ÖÊó∂\n\twhile (true) {\n\t\tgameProcess.setCurrentEventName(`Á≠âÂæÖ${currentPlayer.name}Êìç‰Ωú`);\n\n\t\tconst operation = await Promise.race([\n\t\t\tgameProcess.oncePlayerOperationAsync(currentPlayer.id, OperateType.RollDice)\n\t\t\t\t.then((res) => ({ type: OperateType.RollDice, res })),\n\t\t\tgameProcess.oncePlayerOperationAsync(currentPlayer.id, OperateType.UseChanceCard)\n\t\t\t\t.then((res) => ({ type: OperateType.UseChanceCard, res })),\n\t\t]);\n\n\t\tgameProcess.removePlayerAllOperationListener(currentPlayer.id, OperateType.RollDice);\n\t\tgameProcess.removePlayerAllOperationListener(currentPlayer.id, OperateType.UseChanceCard);\n\n\t\tif (operation.type === OperateType.RollDice) {\n\t\t\tbreak;\n\t\t}\n\n\t\tif (operation.res) {\n\t\t\tconst { chanceCardId, targetIdList } = operation.res;\n\t\t\tawait gameProcess.handleUseChanceCard(currentPlayer, chanceCardId, targetIdList);\n\t\t}\n\t}\n\n\t// Â∞ÜÈ™∞Â≠êÁªìÊûúÂÜôÂÖ•‰∏ä‰∏ãÊñáÔºåÂπ∂Â≠òÂÇ®Âà∞Áé©ÂÆ∂ÂØπË±°‰∏≠‰æõÂÖ∂‰ªñÊú∫Âà∂‰ΩøÁî®\n\tconst diceResult = await currentPlayer.rollDices();\n\tcontext.diceResult = diceResult;\n}) as GameEventFunction<RollDiceContext>;\n"},{"id":"sys-phase-player-move","name":"Áé©ÂÆ∂ÁßªÂä®","description":"Áé©ÂÆ∂ÁßªÂä®Èò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerMove","initEventCode":"(async (context, gameProcess) => {\n\t//Áé©ÂÆ∂ÁßªÂä®\n\tconst player = context.currentRoundPlayer;\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\n\tcontext.targetIndex = player.positionIndex;\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"sys-phase-arrived-event","name":"Âà∞Ëææ‰∫ã‰ª∂","description":"Âà∞Ëææ‰∫ã‰ª∂Èò∂ÊÆµ","from":"Á≥ªÁªü","mark":"ArrivedEvent","initEventCode":"(async (context, gameProcess) => {\n\tconst player = context.currentRoundPlayer;\n\tawait gameProcess.handleArriveEvent(player);\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"sys-phase-player-round-end","name":"Áé©ÂÆ∂ÂõûÂêàÁªìÊùü","description":"Áé©ÂÆ∂ÂõûÂêàÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"PlayerRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\t\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"sys-phase-game-round-end","name":"ËΩÆÊ¨°ÁªìÊùü","description":"ËΩÆÊ¨°ÁªìÊùüÈò∂ÊÆµ","from":"Á≥ªÁªü","mark":"GameRoundEnd","initEventCode":"(async (context, gameProcess) => {\n\tgameProcess.currentRound += 1;\n}) as GameEventFunction<GameRoundEndContext>;"}],"postRestore":[{"id":"sys-phase-post-restore","name":"Â≠òÊ°£ÊÅ¢Â§çÂêé","description":"Â≠òÊ°£ÊÅ¢Â§çÂêéÈò∂ÊÆµ","from":"Á≥ªÁªü","initEventCode":"(async (context, gameProcess) => {\n  \n}) as GameEventFunction<GameContext>;\n"}]},"buildingModelIdList":["house-siliao-0","house-siliao-1","house-siliao-2","house-siliao-3","house-siliao-4"],"uiTemplates":[],"modifierTemplates":[],"customUIs":[],"gameSettingForm":[{"id":"gs-init-money","key":"initMoney","type":"number-input","label":"ÂàùÂßãË¥Ø","defaultValue":12000,"min":0,"max":1000000,"builtIn":true},{"id":"gs-turn-timeout","key":"turnTimeout","type":"number-input","label":"ÂõûÂêàÂÄíËÆ°Êó∂(Áßí)","defaultValue":15,"min":5,"max":120,"builtIn":true},{"id":"gs-chance-timeout","key":"chanceTimeout","type":"number-input","label":"Êú∫‰ºöÂç°ÈòÖËØªÊó∂Èôê(Áßí)","defaultValue":20,"min":5,"max":120}],"extraLibs":"// ÁªèÂÖ∏Â§çÂàªÂú∞ÂõæÊïàÊûúÂáΩÊï∞Â∫ìÔºàÁ•ûÂ∑ûÂ§ßÂú∞/‰∏âÂõΩÈ£é‰∫ë/Ê±üÂçóÊ∞¥‰π° ÂÖ±Áî®Ôºâ\n// ‰∏é tang-extra-libs ÂêåÊûÑÔºöÂú∞‰∫ßÂà∞ËææÔºàË¥≠ÁΩÆ/Âª∫ÈÄ†/Êî∂ÁßüÔºâ„ÄÅÊú∫‰ºöÂç°ÊäΩÂèñ„ÄÅÈÄöÁî®Êî∂‰ªòÊ¨æ\nfunction clsNumber(gp: IGameProcess, key: string, fallback: number): number {\n  const value = Number(gp.gameSetting[key]?.value);\n  return Number.isFinite(value) ? value : fallback;\n}\nasync function clsCash(gp: IGameProcess, player: IPlayer, base: number, title: string): Promise<void> {\n  if (player.isBankrupted) return;\n  const money = Math.max(0, Math.round(Math.abs(base)));\n  if (base >= 0) await player.gain(money, \"cls_card\");\n  else if (money > 0) await player.cost(money, \"cls_tax\");\n  gp.messageNotify([player.id], { type: base >= 0 ? \"success\" : \"warning\", content: `${title}Ôºö${base >= 0 ? \"Êî∂ÂÖ•\" : \"ÊîØÂá∫\"} ${money}ÔºåÁªì‰Ωô ${player.money}` });\n  gp.gameDataBroadcast();\n}\nasync function clsArrive(gp: IGameProcess, property: IProperty, player: IPlayer): Promise<void> {\n  if (player.isBankrupted) return;\n  const owner = property.owner;\n  const displayName = property.name.replace(/\\n/g, \"¬∑\");\n  if (!owner) {\n    const price = property.sellCost;\n    if (player.money <= price) {\n      gp.messageNotify([player.id], { type: \"warning\", content: `${displayName} ÂîÆ‰ª∑ ${price}ÔºåÁé∞Èáë‰∏çË∂≥ÔºåÊó†ÂäõË¥≠ÁΩÆ„ÄÇ` });\n      return;\n    }\n    const result = await gp.showConfirmDialog(player.id, { title: `Ë¥≠ÁΩÆ ${displayName}`, content: `ÂîÆ‰ª∑ ${price}ÔºåÂΩìÂâçÁªì‰Ωô ${player.money}„ÄÇ`, confirmText: \"‰π∞‰∏ã\", cancelText: \"ÊîæÂºÉ\" }, { timeout: clsNumber(gp, \"turnTimeout\", 15) * 1000 });\n    if (result.confirm && !player.isBankrupted && player.money > price) await gp.handlePlayerBuyProperty(player, property);\n    return;\n  }\n  if (owner.id === player.id) {\n    if (property.level < property.maxLevel && player.money > property.buildCost) {\n      const result = await gp.showConfirmDialog(player.id, { title: `Êâ©Âª∫ ${displayName}`, content: `Âª∫ÈÄ†Ë¥π ${property.buildCost}ÔºåÂçáËá≥ ${property.level + 1} Á∫ß„ÄÇ`, confirmText: \"ÂºÄÂ∑•\", cancelText: \"ÊöÇ‰∏ç\" }, { timeout: clsNumber(gp, \"turnTimeout\", 15) * 1000 });\n      if (result.confirm && !player.isBankrupted) await gp.handlePlayerBuildUp(player, property);\n    }\n    return;\n  }\n  const rent = property.costList[property.level] || 0;\n  const paid = await player.cost(rent, \"cls_rent\", owner);\n  if (paid.actualCost > 0) await owner.gain(paid.actualCost, \"cls_rent\", player);\n  gp.msgNotifyBroadcast(\"info\", `${player.name} Âú® ${displayName} Áº¥Á∫≥ÁßüÈì∂ ${paid.actualCost} ‰∫à ${owner.name}`);\n  gp.gameDataBroadcast();\n}\nasync function clsDraw(gp: IGameProcess, player: IPlayer): Promise<void> {\n  const cards = Array.from(gp.chanceCardInfos.values());\n  if (!cards.length) return;\n  const info = cards[Math.floor(Math.random() * cards.length)];\n  await gp.showConfirmDialog(player.id, { title: `Êú∫‰ºöÂç° ¬∑ ${info.name}`, content: `${info.description}\\n\\nÁÇπÂáªÁ°ÆËÆ§ÂêéÊâßË°åÊïàÊûúÔºõÁ≠âÂæÖË∂ÖÊó∂Â∞ÜËá™Âä®ÊâßË°å„ÄÇ`, confirmText: \"Áü•ÊôìÂπ∂ÊâßË°å\", cancelText: \"Â∑≤ËØªÁªßÁª≠\" }, { timeout: clsNumber(gp, \"chanceTimeout\", 20) * 1000, defaultValue: { id: player.id, confirm: true } });\n  if (player.isBankrupted) return;\n  gp.msgNotifyBroadcast(\"info\", `${player.name} ÊäΩÂà∞„Äå${info.name}„Äç`);\n  await gp.createNewChanceCard(info.id).use(player, player, gp);\n  gp.gameDataBroadcast();\n}\n"}∫&
