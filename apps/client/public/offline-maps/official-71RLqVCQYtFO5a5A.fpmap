\n  }\n  // (2) æ‰‹ä¸­æœºä¼šå¡\n  let cardLines = [\"æ²¡æœ‰æ‰‹ç‰Œ\"];\n  const cards = target.chanceCards || [];\n  if (cards.length > 0) cardLines = cards.map((c) => (c.getName ? c.getName() : c.name) || \"æœºä¼šå¡\");\n  // (3) æŒæœ‰å½©ç¥¨å·ç \n  let lottoText = \"æš‚æ— æŒæœ‰å½©ç¥¨\";\n  const lm = gameProcess.lotteryManager;\n  if (lm && lm.playerStock) {\n    const ps = lm.playerStock.get(target.id);\n    if (ps && ps.stock && ps.stock.length > 0) lottoText = ps.stock.join(\"ã€\");\n  }\n  // (4) å‚ä¸æ‹¼æ‰‹æ°”çº¢åŒ…æ¡£ä½\n  const rp = gameProcess.__redpacket || { joined300: [], joined500: [] };\n  const tiers = [];\n  if (rp.joined300.includes(target.id)) tiers.push(\"1000 å…ƒæ¡£\");\n  if (rp.joined500.includes(target.id)) tiers.push(\"2500 å…ƒæ¡£\");\n  const rpText = tiers.length > 0 ? tiers.join(\"ã€\") : \"æœªå‚ä¸ä»»ä½•æ¡£ä½\";\n  // å››æ¨¡å—æŠ¥å‘Šï¼ˆdiv å—çº§ç‹¬å ä¸€è¡Œï¼Œå¼¹ç»™è°ƒæŸ¥è€…ï¼‰\n  const mod = (title, lines) => ({\n    id: \"det-\" + title,\n    type: \"div\",\n    style: { textAlign: \"left\", marginBottom: \"0.5rem\" },\n    children: [\n      { id: \"det-\" + title + \"-h\", type: \"div\", content: \"ã€\" + title + \"ã€‘\", style: { textAlign: \"left\", fontWeight: \"bold\", color: \"#5d4037\" } },\n      ...lines.map((l, i) => ({ id: \"det-\" + title + \"-\" + i, type: \"div\", content: \"Â· \" + l, style: { textAlign: \"left\" } })),\n    ],\n  });\n  const ui = {\n    id: \"det-report\",\n    type: \"div\",\n    style: { textAlign: \"left\" },\n    children: [\n      mod(\"æŒä»“è‚¡ç¥¨\", stockLines),\n      mod(\"æŒæœ‰æœºä¼šå¡\", cardLines),\n      mod(\"æŒæœ‰å½©ç¥¨\", [lottoText]),\n      mod(\"å‚ä¸æ‹¼æ‰‹æ°”çº¢åŒ…\", [rpText]),\n    ],\n  };\n  await gameProcess.showConfirmDialog(player.id, {\n    title: target.name + \" çš„è°ƒæŸ¥æŠ¥å‘Š\",\n    content: ui,\n    confirmText: \"çŸ¥é“äº†\",\n    closable: true,\n  });\n})"},{"id":"event-mod-enhance","type":"PassedEvent","name":"è§’è‰²å¼ºåŒ–è£…ç½®","iconId":"image-m