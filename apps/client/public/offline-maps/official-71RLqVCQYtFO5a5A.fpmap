(arrivedPlayer.id, {\n            data: undefined,\n            source: SocketMsgSource.Server,\n            type: SocketMsgType.MsgNotify,\n            msg: { type: \"error\", content: \"é“ä»”é“å¥³ï¼Œä½ çš„é’±ä¸å¤Ÿå“¦\" }\n          });\n        }\n      }\n    }\n    return payload;\n  });\n})","description":"å—è·¯å¤šåœ°é“ç«™ è‡ªå®šä¹‰æ•ˆæœ"},"exportData":{"name":"å—è·¯å¤šå…¬äº¤ç«™"},"customUI":"ui-template-rp12dz"}},{"id":"mi-mod-beach","x":8,"y":-12,"rotation":0,"type":{"id":"map-item-type-mod-beach","name":"å¸¦è–ªä¼‘å‡","modelId":"model-mod-beach","color":"#f7d794","size":1},"beLinked":"mi-dz-i03"},{"id":"mi-mod-chrono","x":13,"y":-7,"rotation":2,"type":{"id":"map-item-type-mod-chrono","name":"è¶…æ—¶ç©ºä¼ é€","modelId":"model-mod-chrono","color":"#4fc3f7","size":1},"beLinked":"mi-dz-b04"},{"id":"mi-mod-decor-rand","x":8,"y":-2,"rotation":1,"type":{"id":"map-item-type-zjojeh","name":"è£…é¥°åœ°å—-1","modelId":"model-fsp5fu","color":"#bb4473","size":1},"beLinked":"mi-dz-o35"},{"id":"mi-mod-factory","x":8,"y":-4,"rotation":2,"type":{"id":"map-item-type-mod-factory","name":"ä»¥å¡ä»£å·¥","modelId":"model-mod-factory","color":"#e0671c","size":1},"beLinked":"mi-dz-i15"},{"id":"mi-mod-lottery5","x":0,"y":-11,"rotation":1,"type":{"id":"map-item-type-ulzf20","name":"å½©ç¥¨","modelId":"model-y8kep0","color":"#eb1424","size":1},"beLinked":"mi-dz-o52"},{"id":"mi-mod-lottery6","x":13,"y":-16,"rotation":0,"type":{"id":"map-item-type-ulzf20","name":"å½©ç¥¨","modelId":"model-y8kep0","color":"#eb1424","size":1},"beLinked":"mi-dz-o12"},{"id":"mi-mod-sairport","x":16,"y":-11,"rotation":0,"type":{"id":"map-item-type-mod-airport","name":"æœºåœº","modelId":"model-mod-airport","color":"#f39c12","size":1},"beLinked":"mi-dz-o18"},{"id":"mi-mod-sbank","x":11,"y":0,"rotation":2,"type":{"id":"map-item-type-mod-bankloan","name":"é“¶è¡Œè´·æ¬¾","modelId":"model-mod-bankloan","color":"#2e7d32","size":1},"beLinked":"mi-dz-o32"},{"id":"mi-mod-shop5","x":4,"y":0,"rotation":2,"type":{"id