 [];\n      for (const pw of outsC.concat(insC)) {\n        if (gameProcess.isMapPathEnabled(pw.id)) {\n          gameProcess.setMapPathEnabled(pw.id, false);\n          gameProcess.stopcutDisabled.push(pw.id);\n        }\n      }\n      player.resetMapNavigation();\n      player.modifierManager.add($mod__stopcut_cleaner_walk);\n      player.modifierManager.add($mod__stopcut_cleaner);\n    }\n    gameProcess.gameDataBroadcast();\n    return;\n    }\n  }\n  gameProcess.gameDataBroadcast();\n})"},{"id":"event-mod-weather","type":"ArrivedEvent","name":"é—ªç”µé£æš´","iconId":"image-mod-weather","description":"èŠ±è´¹1500å…ƒå¬å”¤å¤§èŒƒå›´é—ªç”µæ‰“å‡»ï¼Œéšæœºä¸€åç©å®¶è¢«é—ªç”µåŠˆä¸­é€è¿›åŒ»é™¢ï¼Œå…¶ä½™ç©å®¶èº²é¿é—ªç”µè¢­å‡»åŸåœ°åœæ­¢è¡ŒåŠ¨ä¸€å›åˆã€‚è‡ªèº«ä¸å—é—ªç”µå½±å“ã€‚","effectCode":"(async (player, gameProcess) => {\n  if (player.money < 1500) {\n    await gameProcess.showMessageCard([player.id], { title: \"é—ªç”µé£æš´\", content: \"<color:#e74c3c>ç”µé‡ä¸è¶³ï¼ˆéœ€ ï¿¥1500ï¼‰ï¼Œæ— æ³•å¬å”¤é—ªç”µé£æš´ã€‚</color>\" });\n    return;\n  }\n  const res = await gameProcess.showConfirmDialog(player.id, {\n    title: \"é—ªç”µé£æš´\",\n    content: \"é›·äº‘å·²åœ¨å¤©é™…èšé›†ã€‚èŠ±è´¹ <color:primary>ï¿¥1500</color> å¬å”¤å¤§èŒƒå›´é—ªç”µæ‰“å‡»ï¼šéšæœºä¸€åå¯¹æ‰‹è¢«åŠˆè¿›å¤©é™æ¨ªç¥¸ï¼Œå…¶ä½™å¯¹æ‰‹åŸåœ°èº²é¿ 1 å›åˆã€‚<color:#7f8c8d>ä½ è‡ªå·±ä¸å—å½±å“ã€‚</color>\",\n    confirmText: \"å¬å”¤é£æš´ï¼ˆï¿¥1500ï¼‰\",\n    cancelText: \"æ”¾å¼ƒ\",\n  });\n  if (!res.confirm) return;\n  await player.cost(1500, \"system\");\n  // æ’é™¤å·²æ·˜æ±°ç©å®¶ï¼ˆisBankruptedï¼‰ï¼šè½¬ç›˜/é£æš´/ä¼ é€çš„æ•ˆæœå€™é€‰ä¸ç»“ç®—å‡ä¸å«æ·˜æ±°è€…\n  const all = Array.from(gameProcess.players?.values?.() || []).filter((p) => !p.isBankrupted);\n  const others = all.filter((p) => p.id !== player.id);\n  const results = [];\n  const hospitalTile = \"mi-dz-i12\"; // å¤©é™æ¨ªç¥¸åœ°å—\n  const strikeTarget = others.length > 0 ? others[Math.floor(Math.random() * others.length)] : null;\n  for (const p of others) {\n    if (strikeTarget && p.id === strikeTarget.id) continue;\n    await p.setStop((p.isStop || 0) + 1);\n    if (p.buffManager) {\n    p.buffManager.removeBuff(\"stop-buff-\" + p.id);\n    p.buffManager.addBuff({ id: \"stop-buff-\" + p.id, name: \"åœæ­¢è¡ŒåŠ¨\", triggerTiming: \"å›åˆå¼€å§‹æ—¶\", description: \"åœæ­¢è¡ŒåŠ¨ï¼š1 ä¸ªå›åˆè¢«è·³è¿‡\", source: \"é—ªç”µé£æš´\" });\n    p.modifierManager.add($mod__stop_buff_sync);\n    }\n    // ç«‹å³ç”Ÿæ•ˆï¼ˆä¸è½¬ç›˜ç¦è¶³åŒæ¬¾ï¼‰ï¼šå—å‡»è€…è‹¥æ­£å¤„è¡Œèµ°æµç¨‹åˆ™ç«‹å³æœ¬æ ¼æˆªæ–­å‰©ä½™æ­¥æ•°ã€‚\n    // é£æš´ä¸ºåˆ°è¾¾è§¦å‘ï¼ˆå¬å”¤è€…è¡Œèµ°å·²ç»“æŸï¼‰ï¼Œèº²é¿è€…å¸¸è§„ä¸‹ä¸åœ¨è¡Œèµ°ï¼Œæ­¤åˆ†æ”¯ä¸ºå¯¹ç§°é˜²å¾¡ï¼Œ\n    // é˜²å…¶ä»–æ•ˆæœé“¾åœ¨è¡Œèµ°ä¸­é€”è”åŠ¨è§¦å‘é£æš´æ—¶å‡ºç°å»¶è¿Ÿç”Ÿæ•ˆã€‚\n    if (p === player) {\n  {\n    const outsC = gameProcess.getAvailableMapPaths(p.positionMapItemId, \"forward\");\n    const insC = gameProcess.getAvailableMapPaths(p.positionMapItemId, \"reverse\");\n    gameProcess.stopcutDisabled = gameProcess.stopcutDisabled || [];\n    for (const pw of outsC.concat(insC)) {\n      if (gameProcess.isMapPathEnabled(pw.id)) {\n        gameProcess.setMapPathEnabled(pw.id, false);\n        gameProcess.stopcutDisabled.push(pw.id);\n      }\n    }\n    p.resetMapNavigation();\n    player.modifierManager.add($mod__stopcut_cleaner_walk);\n    player.modifierManager.add($mod__stopcut_cleaner);\n  }\n    }\n    results.push({ name: p.name, text: \"èº²é¿é—ªç”µï¼šåŸåœ°åœæ­¢è¡ŒåŠ¨ 1 å›åˆ\", bad: false });\n  }\n  if (strikeTarget) {\n    const shielded = (gameProcess.shields?.[strikeTarget.id] || 0) > 0;\n    try {\n      await strikeTarget.tpToMapItem(hospitalTile);\n      await gameProcess.handleArriveEvent(strikeTarget); // è§¦å‘å¤©é™æ¨ªç¥¸äº‹ä»¶ï¼ˆæŠ¤ç›¾åœ¨å…¶å†…éƒ¨åˆ¤å®šï¼‰\n      results.push({ name: strikeTarget.name, text: shielded ? \"è¢«é—ªç”µåŠˆä¸­ï¼ï¼ˆå…ç½šæŠ¤ç›¾æŒ¡ä¸‹æ¨ªç¥¸ï¼‰\" : \"è¢«é—ªç”µåŠˆä¸­ï¼ä¼ é€è‡³å¤©é™æ¨ªç¥¸\", bad: true });\n    } catch (e) {\n      results.push({ name: strikeTarget.name, text: \"è¢«é—ªç”µåŠˆä¸­ï¼ï¼ˆä¼ é€ç»“ç®—å‡ºç°å¼‚å¸¸ï¼‰\", bad: true }); // å®¹é”™ï¼šæ— è®ºä¼ é€ç»“ç®—æ˜¯å¦å¼‚å¸¸ï¼Œç»“ç®—é¡µé¢å¿…å®šæ¸²æŸ“\n    }\n  } else {\n    results.push({ name: \"æ— äºº\", text: \"é£æš´ç©ºæ”¾ï¼šåœºä¸Šæ²¡æœ‰å…¶ä»–ç©å®¶\", bad: true });\n  }\n  let rowSeq = 0;\n  const mkRow = (r, color, weight) => { rowSeq++; return { id: \"weather-row-\" + rowSeq, type: \"text\", content: r.name + \"ï¼š\" + r.text, style: { fontSize: \"0.9rem\", color: color, fontWeight: weight } }; };\n  await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n    title: \"é—ªç”µé£æš´\",\n    content: {\n      id: \"weather-report\",\n      type: \"div\",\n      style: { display: \"flex\", flexDirection: \"column\", gap: \"0.5rem\", maxWidth: \"22rem\", padding: \"0.5rem\" },\n      children: [\n        { id: \"weather-title\", type: \"text\", content: \"âš¡ é—ªç”µé£æš´ç»“ç®—\", style: { fontSize: \"1.25rem\", fontWeight: \"bold\", color: \"#2980b9\" } },\n        ...results.map((r) => mkRow(r, r.bad ? \"#ef4444\" : \"#f39c12\", r.bad ? \"bold\" : \"normal\"))\n      ]\n    },\n    duration: 4000\n  }); // ä¸é€šèƒ€å€ç‡æå‡é€šçŸ¥åŒæ¬¾é¡µé¢ + åŒæ¬¾ 4000ms æ—¶é•¿\n  gameProcess.gameDataBroadcast();\n});"},{"id":"event-mod-wheel","type":"PassedEvent","name":"æƒŠå–œè½¬ç›˜","iconId":"image-mod-wheel","description":"è½¬ç›˜éšæœºæŠ½ä¸€åç©å®¶åƒè´Ÿé¢æ•ˆæœï¼Œå…¶ä½™ç©å®¶å„éšæœºè·å¾—ä¸€ä¸ªæ­£é¢æ•ˆæœã€‚æ­£é¢/è´Ÿé¢å„ 5 ç§ï¼Œè¯¦è§æ•ˆæœè¡¨ã€‚","effectCode":"(async (player, gameProcess) => {\n  // æ’é™¤å·²æ·˜æ±°ç©å®¶ï¼ˆisBankruptedï¼‰ï¼šè½¬ç›˜/é£æš´/ä¼ é€çš„æ•ˆæœå€™é€‰ä¸ç»“ç®—å‡ä¸å«æ·˜æ±°è€…\n  const all = Array.from(gameProcess.players?.values?.() || []).filter((p) => !p.isBankrupted);\n  if (all.length === 0) return;\n  // ç¬¬ä¸€é‡ï¼šæ˜¯å¦è½¬åŠ¨ï¼ˆç©å®¶æ˜ç¡®é€‰æ‹©ï¼Œæ— è‡ªåŠ¨ç¡®è®¤ï¼‰ï¼›é€‰\"å¦\"ç›´æ¥æ”¾å¼ƒè§¦å‘\n  const askFirst = await gameProcess.showConfirmDialog(player.id, {\n    title: \"æƒŠå–œè½¬ç›˜\",\n    content: \"è·¯è¾¹å‘ç°ä¸€å°è£…é¥°åä¸½çš„æƒŠå–œè½¬ç›˜ï¼Œè¦è½¬åŠ¨å®ƒå—ï¼Ÿ\",\n    confirmText: \"è½¬åŠ¨è½¬ç›˜\",\n    cancelText: \"ä¸è½¬äº†\",\n  });\n  if (!askFirst.confirm) {\n    gameProcess.msgNotifyBroadcast(\"info\", player.name + \" è·¯è¿‡æƒŠå–œè½¬ç›˜ï¼Œæ²¡æœ‰è½¬åŠ¨ã€‚\");\n    return;\n  }\n  // ç¬¬äºŒé‡ï¼šé€‰æ‹©è½¬åŠ¨æ–¹å¼ã€‚ä½™é¢ä¸è¶³ 700 æ—¶ç¥ˆç¦é€‰é¡¹ä¸æ˜¾ç¤ºï¼›\"ä¸è½¬äº†\"= æ”¾å¼ƒè§¦å‘\n  const modeItems = [{ id: \"direct\", display: \"ç›´æ¥è½¬åŠ¨è½¬ç›˜\" }];\n  if ((player.money || 0) >= 700) modeItems.push({ id: \"pray\", display: \"èŠ±è´¹700å…ƒç¥ˆç¦ï¼Œè½¬åŠ¨è½¬ç›˜è‡ªå·±å¿…è·å¾—æ­£é¢æ•ˆæœ\" });\n  const modeRes = await gameProcess.showItemSelectDialog(player.id, {\n    title: \"æƒŠå–œè½¬ç›˜\",\n    content: \"è½¬åŠ¨æ–¹å¼ï¼šéšæœº 1 åç©å®¶æ‰¿å—è´Ÿé¢æ•ˆæœï¼Œå…¶ä½™ç©å®¶å„éšæœºè·å¾— 1 ä¸ªæ­£é¢æ•ˆæœã€‚<br><color:#27ae60>ã€æ­£é¢ã€‘æ¨ªè´¢åˆ°æ‰‹ +ï¿¥1500 ï¼ å¡ç‰Œè¡¥ç»™ éšæœºæœºä¼šå¡ ï¼ å…è´¹è‚¡ç¥¨ éšæœºè‚¡ç¥¨10è‚¡ ï¼ å…ç½šæŠ¤ç›¾ æŠµæ¶ˆä¸‹æ¬¡åç‰¢Â·åŒ»é™¢Â·ç›‘ç‹± ï¼ æˆ¿å±‹å‡çº§ æœ€ä½åœ°äº§å‡1çº§ï¼ˆæ— åœ°äº§è¡¥500ï¼‰</color><br><color:#e74c3c>ã€è´Ÿé¢ã€‘ç ´è´¢ -ï¿¥750 ï¼ é«˜é¢ç½šå• -ï¿¥1000 ï¼ åŸåœ°ç¦è¶³ 1 å›åˆ ï¼ ç¼´æ¢° éšæœºå¤±å»ä¸€å¼ æ‰‹å¡ ï¼ æ‹†è¿ä»¤ æœ€é«˜åœ°äº§é™1çº§ï¼ˆæ— åœ°äº§æˆ–å…¨0çº§ç½š500ï¼‰</color>\",\n    itemList: modeItems,\n    multiple: false,\n    cancelText: \"ä¸è½¬äº†\",\n  });\n  if (!modeRes.selected || modeRes.selected.length === 0) {\n    gameProcess.msgNotifyBroadcast(\"info\", player.name + \" æ”¾å¼ƒäº†è½¬åŠ¨è½¬ç›˜ã€‚\");\n    return;\n  }\n  const prayMode = modeRes.selected[0] === \"pray\";\n  if (prayMode) await player.cost(700, \"system\");\n  const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];\n  const results = [];\n  const nextOf = new Map(), prevOf = new Map();\n  for (const pp of gameProcess.mapData.mapPaths) {\n    if (!nextOf.has(pp.fromMapItemId)) nextOf.set(pp.fromMapItemId, pp.toMapItemId);\n    if (!prevOf.has(pp.toMapItemId)) prevOf.set(pp.toMapItemId, pp.fromMapItemId);\n  }\n  const isRev = (pid) => !!(gameProcess.reverseWalkers && gameProcess.reverseWalkers[pid]);\n  const moveRel = async (p, forward, steps) => {\n    const stepOf = forward ? (isRev(p.id) ? prevOf : nextOf) : (isRev(p.id) ? nextOf : prevOf);\n    let cur = p.positionMapItemId;\n    for (let i = 0; i < steps; i++) cur = stepOf.get(cur) || cur;\n    await p.tpToMapItem(cur);\n    await gameProcess.handleArriveEvent(p);\n  };\n  const doNeg = async (p, kind) => {\n    if (kind === \"broke750\") {\n      const r = await p.cost(750, \"system\");\n      results.push({ name: p.name, text: \"ç ´è´¢ï¼šæŸå¤± ï¿¥\" + r.actualCost, bad: true });\n    } else if (kind === \"fine1000\") {\n      const r = await p.cost(1000, \"system\");\n      results.push({ name: p.name, text: \"é«˜é¢ç½šå•ï¼šæŸå¤± ï¿¥\" + r.actualCost, bad: true });\n    } else if (kind === \"stop1\") {\n      await p.setStop((p.isStop || 0) + 1);\n  if (p.buffManager) {\n  p.buffManager.removeBuff(\"stop-buff-\" + p.id);\n  p.buffManager.addBuff({ id: \"stop-buff-\" + p.id, name: \"åœæ­¢è¡ŒåŠ¨\", triggerTiming: \"å›åˆå¼€å§‹æ—¶\", description: \"åœæ­¢è¡ŒåŠ¨ï¼š\" + 1 + \" ä¸ªå›åˆè¢«è·³è¿‡\", source: \"æƒŠå–œè½¬ç›˜\" });\n  p.modifierManager.add($mod__stop_buff_sync);\n  }\n      // ä»…å½“å—å‡»è€…=å½“å‰è¡Œèµ°è€…æ‰åšæœ¬æ ¼æˆªæ–­ï¼ˆç«‹å³ä¸­æ–­å…¶å‰©ä½™æ­¥æ•°ï¼‰ï¼›å—å‡»è€…ä¸ºä»–äººæ—¶çº¯è·³å›åˆç»ä¸ç¢°è·¯å¾„\n      if (p === player) {\n  {\n    const outsC = gameProcess.getAvailableMapPaths(p.positionMapItemId, \"forward\");\n    const insC = gameProcess.getAvailableMapPaths(p.positionMapItemId, \"reverse\");\n    gameProcess.stopcutDisabled = gameProcess.stopcutDisabled || [];\n    for (const pw of outsC.concat(insC)) {\n      if (gameProcess.isMapPathEnabled(pw.id)) {\n        gameProcess.setMapPathEnabled(pw.id, false);\n        gameProcess.stopcutDisabled.push(pw.id);\n      }\n    }\n    p.resetMapNavigation();\n    player.modifierManager.add($mod__stopcut_cleaner_walk);\n    player.modifierManager.add($mod__stopcut_cleaner);\n  }\n      }\n      results.push({ name: p.name, text: \"åŸåœ°ç¦è¶³ï¼šåœæ­¢è¡ŒåŠ¨ 1 å›åˆ\", bad: true });\n    } else if (kind === \"disarm\") {\n      const cards = p.chanceCards || [];\n      if (cards.length > 0) {\n        const card = cards[Math.floor(Math.random() * cards.length)];\n        const cid = card.getId ? card.getId() : card.id;\n        await p.loseCard(cid);\n        results.push({ name: p.name, text: \"ç¼´æ¢°ï¼šéšæœºå¤±å»ä¸€å¼ æ‰‹å¡\", bad: true });\n      } else {\n        const r = await p.cost(500, \"system\");\n        results.push({ name: p.name, text: \"ç¼´æ¢°ï¼ˆæ— å¡ï¼‰ï¼šæ”¹ç½š ï¿¥\" + r.actualCost, bad: true });\n      }\n    } else if (kind === \"demolish\") {\n      const owned = p.properties || [];\n      if (owned.length === 0) {\n        const r = await p.cost(500, \"system\");\n        results.push({ name: p.name, text: \"æ‹†è¿ä»¤ï¼ˆæ— åœ°äº§ï¼‰ï¼šç½šæ¬¾ ï¿¥\" + r.actualCost, bad: true });\n      } else {\n        const downgradable = owned.filter((pr) => pr.level > 0);\n        if (downgradable.length === 0) {\n          const r = await p.cost(500, \"system\");\n          results.push({ name: p.name, text: \"æ‹†è¿ä»¤ï¼ˆåœ°äº§å…¨ 0 çº§ï¼‰ï¼šç½šæ¬¾ ï¿¥\" + r.actualCost, bad: true });\n        } else {\n          const maxLv = Math.max(...downgradable.map((pr) => pr.level));\n          const cands = downgradable.filter((pr) => pr.level === maxLv);\n          const prop = cands[Math.floor(Math.random() * cands.length)];\n          await prop.levelDown();\n          results.push({ name: p.name, text: \"æ‹†è¿ä»¤ï¼š\" + prop.name + \" é™è‡³ \" + prop.level + \" çº§\", bad: true });\n        }\n      }\n    }\n  };\n  const doPos = async (p, kind) => {\n    if (kind === \"cash1500\") {\n      await p.gain(1500, \"system\");\n      results.push({ name: p.name, text: \"æ¨ªè´¢åˆ°æ‰‹ï¼š+ï¿¥1500\", bad: false });\n    } else if (kind === \"card\") {\n      const infos = Array.from(gameProcess.chanceCardInfos.values());\n      const info = pick(infos);\n      await p.gainCard(gameProcess.createNewChanceCard(info.id));\n      results.push({ name: p.name, text: \"å¡ç‰Œè¡¥ç»™ï¼šéšæœºæœºä¼šå¡ä¸€å¼ \", bad: false });\n    } else if (kind === \"freestock\") {\n      const sm = gameProcess.stockMarket;\n      if (!sm || !sm.data || !sm.data.isOpen || !sm.data.stocks || sm.data.stocks.length === 0) {\n        results.push({ name: p.name, text: \"å…è´¹è‚¡ç¥¨ï¼šè‚¡å¸‚ä¼‘å¸‚ï¼Œæœªèƒ½é¢†å–\", bad: false });\n      } else {\n        const stock = sm.data.stocks[Math.floor(Math.random() * sm.data.stocks.length)];\n        const receipt = sm.commitBuy(p.id, stock.id, 10);\n        if (!receipt) results.push({ name: p.name, text: \"å…è´¹è‚¡ç¥¨ï¼šäº¤æ˜“å¤±è´¥ï¼Œæœªèƒ½é¢†å–\", bad: false });\n        else results.push({ name: p.name, text: \"å…è´¹è‚¡ç¥¨ï¼š\" + stock.name + \" Ã—10 è‚¡ï¼ˆç°ä»· ï¿¥\" + stock.price.toFixed(1) + \"ï¼‰\", bad: false });\n      }\n    } else if (kind === \"shield\") {\n      gameProcess.shields = gameProcess.shields || {};\n      gameProcess.shields[p.id] = (gameProcess.shields[p.id] || 0) + 1;\n      const __sn = gameProcess.shields[p.id];\n          p.buffManager.removeBuff(\"shield-\" + p.id);\n      p.buffManager.addBuff({ id: \"shield-\" + p.id, name: \"å…ç½šæŠ¤ç›¾\", triggerTiming: \"åç‰¢/åŒ»é™¢/ç›‘ç‹±åˆ¤å®šæ—¶\", description: \"æŠµæ¶ˆä¸‹ä¸€æ¬¡åç‰¢/åŒ»é™¢/ç›‘ç‹±ï¼ˆå‰©ä½™ \" + __sn + \" ä¸ªï¼‰\", source: \"æƒŠå–œè½¬ç›˜\" });\n      results.push({ name: p.name, text: \"å…ç½šæŠ¤ç›¾ï¼šæŠµæ¶ˆä¸‹æ¬¡åç‰¢/åŒ»é™¢/ç›‘ç‹±\", bad: false });\n    } else if (kind === \"upgrade\") {\n      const owned = p.properties || [];\n      if (owned.length === 0) {\n        await p.gain(500, \"system\");\n        results.push({ name: p.name, text: \"æˆ¿å±‹å‡çº§ï¼ˆæ— åœ°äº§ï¼‰ï¼šè¡¥å¿ ï¿¥500\", bad: false });\n      } else {\n        const upgradable = owned.filter((pr) => pr.level < pr.maxLevel);\n        if (upgradable.length === 0) {\n          results.push({ name: p.name, text: \"æˆ¿å±‹å‡çº§ï¼šæ²¡æœ‰å¯å‡çº§çš„åœ°äº§\", bad: false });\n        } else {\n          const minLv = Math.min(...upgradable.map((pr) => pr.level));\n          const cands = upgradable.filter((pr) => pr.level === minLv);\n          const prop = cands[Math.floor(Math.random() * cands.length)];\n          await prop.levelUp();\n          results.push({ name: p.name, text: \"æˆ¿å±‹å‡çº§ï¼š\" + prop.name + \" å‡è‡³ \" + prop.level + \" çº§\", bad: false });\n        }\n      }\n    }\n  };\n  const NEG = [\"broke750\", \"fine1000\", \"stop1\", \"disarm\", \"demolish\"];\n  const POS = [\"cash1500\", \"card\", \"freestock\", \"shield\", \"upgrade\"];\n  if (prayMode) {\n    // ç¥ˆç¦æ¨¡å¼ï¼šè‡ªå·±å¿…å®šè·å¾—æ­£é¢æ•ˆæœï¼›è´Ÿé¢æ•ˆæœè½¬å«ç»™å…¶ä»–ç©å®¶ä¸­çš„éšæœºä¸€åï¼›å…¶ä½™ç©å®¶å„éšæœºæ­£é¢\n    const others = all.filter((p) => p.id !== player.id);\n    await doPos(player, pick(POS));\n    const negVictim = others.length > 0 ? others[Math.floor(Math.random() * others.length)] : null;\n    if (negVictim) await doNeg(negVictim, pick(NEG));\n    for (const p of others) {\n      if (negVictim && p.id === negVictim.id) continue;\n      await doPos(p, pick(POS));\n    }\n  } else {\n    const victim = all[Math.floor(Math.random() * all.length)];\n    const others = all.filter((p) => p.id !== victim.id);\n    await doNeg(victim, pick(NEG));\n    for (const p of others) await doPos(p, pick(POS));\n  }\n  const mkRow = (r, color, weight) => ({ id: \"wheel-row-\" + Math.random().toString(36).slice(2, 8), type: \"text\", content: r.name + \"ï¼š\" + r.text, style: { fontSize: \"0.9rem\", color: color, fontWeight: weight } });\n  await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n    title: \"æƒŠå–œè½¬ç›˜\",\n    content: {\n      id: \"wheel-report\",\n      type: \"div\",\n      style: { display: \"flex\", flexDirection: \"column\", gap: \"0.5rem\", maxWidth: \"22rem\", padding: \"0.5rem\" },\n      children: [\n        { id: \"wheel-title\", type: \"text\", content: \"ğŸ¡ è½¬ç›˜ç»“ç®—\", style: { fontSize: \"1.25rem\", fontWeight: \"bold\", color: \"#9b59b6\" } },\n        ...results.map((r) => mkRow(r, r.bad ? \"#ef4444\" : \"#16a34a\", r.bad ? \"bold\" : \"normal\"))\n      ]\n    },\n    duration: 4000\n  }); // ä¸é€šèƒ€å€ç‡æå‡é€šçŸ¥åŒæ¬¾é¡µé¢ï¼ˆç»“æ„åŒ– UISchemaï¼‰+ åŒæ¬¾ 4000ms æ—¶é•¿\n  gameProcess.gameDataBroadcast();\n});"},{"id":"event-mod-work4cards","type":"PassedEvent","name":"ä»¥å¡ä»£å·¥","iconId":"image-mod-factory","description":"å¯ä»¥é€‰æ‹©åŸåœ°æ‰“å·¥ï¼Œè·å¾—æœºä¼šå¡æŠ¥é…¬ã€‚","effectCode":"(async (player, gameProcess) => {\n  const PLANS = [\n    { id: \"work1\", stop: 1, cards: 1, display: \"åŸåœ°æ‰“å·¥ 1 å›åˆï¼ˆæŠ¥é…¬ï¼šæœºä¼šå¡ Ã—1ï¼‰\" },\n    { id: \"work2\", stop: 2, cards: 2, display: \"åŸåœ°æ‰“å·¥ 2 å›åˆï¼ˆæŠ¥é…¬ï¼šæœºä¼šå¡ Ã—2ï¼‰\" },\n  ];\n  const res = await gameProcess.showItemSelectDialog(player.id, {\n    title: \"ä»¥å¡ä»£å·¥å·¥å‚\",\n    content: \"æµæ°´çº¿æ‹›ä¸´æ—¶å·¥ï¼šæ‰“å¡ä¸Šç­ï¼Œå·¥é’±æŒ‰å¼ ç»“ç®—ã€‚\\n<color:#e74c3c>å¹²å¾—è¶Šä¹…ï¼Œå¡ç‰‡è¶Šå¤šï¼</color>\",\n    itemList: PLANS.map((p) => ({ id: p.id, display: p.display })),\n    multiple: false,\n    cancelText: \"ä¸æ‰“å·¥\",\n  });\n  if (!res.selected || res.selected.length === 0) {\n    gameProcess.msgNotifyBroadcast(\"info\", player.name + \" è·¯è¿‡ä»¥å¡ä»£å·¥ï¼Œæ²¡æœ‰å¼€å·¥ã€‚\");\n    return;\n  }\n  const plan = PLANS.find((p) => p.id === res.selected[0]) || PLANS[0];\n  await player.setStop((player.isStop || 0) + plan.stop); // å¼•æ“è·³å›åˆè¯» isStop\n  if (player.buffManager) {\n  player.buffManager.removeBuff(\"stop-buff-\" + player.id);\n  player.buffManager.addBuff({ id: \"stop-buff-\" + player.id, name: \"åœæ­¢è¡ŒåŠ¨\", triggerTiming: \"å›åˆå¼€å§‹æ—¶\", description: \"åœæ­¢è¡ŒåŠ¨ï¼š\" + plan.stop + \" ä¸ªå›åˆè¢«è·³è¿‡\", source: \"ä»¥å¡ä»£å·¥\" });\n  player.modifierManager.add($mod__stop_buff_sync);\n  }\n  // ç«‹å³ç”Ÿæ•ˆï¼šè·¯è¿‡å³é€‰å³åœâ€”â€”ä¸­æ–­å‰©ä½™æ­¥æ•°ï¼ŒçœŸæ­£\"åŸåœ°\"æ‰“å·¥ï¼ˆæˆªæ–­ä»…ä½œç”¨æœ¬äººï¼Œè¡Œèµ°ç»“æŸå³æ¢å¤è·¯å¾„ï¼‰\n  {\n    const outsC = gameProcess.getAvailableMapPaths(player.positionMapItemId, \"forward\");\n    const insC = gameProcess.getAvailableMapPaths(player.positionMapItemId, \"reverse\");\n    gameProcess.stopcutDisabled = gameProcess.stopcutDisabled || [];\n    for (const pw of outsC.concat(insC)) {\n      if (gameProcess.isMapPathEnabled(pw.id)) {\n        gameProcess.setMapPathEnabled(pw.id, false);\n        gameProcess.stopcutDisabled.push(pw.id);\n      }\n    }\n    player.resetMapNavigation();\n    player.modifierManager.add($mod__stopcut_cleaner_walk);\n    player.modifierManager.add($mod__stopcut_cleaner);\n  }\n  const infos = Array.from(gameProcess.chanceCardInfos.values());\n  for (let i = 0; i < plan.cards; i++) {\n    const info = infos[Math.floor(Math.random() * infos.length)];\n    await player.gainCard(gameProcess.createNewChanceCard(info.id));\n  }\n  gameProcess.msgNotifyBroadcast(\"success\", player.name + \" åŸåœ°æ‰“å·¥ \" + plan.stop + \" å›åˆï¼Œé¢†å–æœºä¼šå¡ Ã—\" + plan.cards + \"ï¼\");\n  await gameProcess.showMessageCard([player.id], { title: \"ä»¥å¡ä»£å·¥å·¥å‚\", content: \"å·¥ç‰Œä¸€åˆ·ï¼Œæµæ°´çº¿å¯åŠ¨â€¦â€¦\\n<color:primary>åœæ­¢è¡ŒåŠ¨ \" + plan.stop + \" å›åˆ</color>ï¼ŒæŠ¥é…¬ <color:primary>æœºä¼šå¡ Ã—\" + plan.cards + \"</color> å·²å…¥åŒ…ã€‚\" });\n  gameProcess.gameDataBroadcast();\n});"},{"id":"event-o5hqij","name":"ç›‘ç‹±","description":"è¸©ä¸­ç›‘ç‹±ï¼šåŸåœ°æ‹˜ç•™ï¼Œåœæ­¢è¡ŒåŠ¨ 1 å›åˆã€‚","type":"ArrivedEvent","iconId":"image-ijf8tf","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  if ((gameProcess.shields?.[player.id] || 0) > 0) {\n    gameProcess.shields[player.id]--;\n    const __sl = gameProcess.shields[player.id];\n    if (__sl > 0) { player.buffManager.updateBuff(\"shield-\" + player.id, { description: \"æŠµæ¶ˆä¸‹ä¸€æ¬¡åç‰¢/åŒ»é™¢/ç›‘ç‹±ï¼ˆå‰©ä½™ \" + __sl + \" ä¸ªï¼‰\" }); } else { player.buffManager.removeBuff(\"shield-\" + player.id); }\n    gameProcess.msgNotifyBroadcast(\"success\", \"å…ç½šæŠ¤ç›¾ç”Ÿæ•ˆï¼\" + player.name + \" å…é™¤äº†æœ¬æ¬¡ç›‘ç‹±ï¼\");\n    gameProcess.gameDataBroadcast();\n    return;\n  }\n  await player.setStop((player.isStop || 0) + 1);\n  gameProcess.msgNotifyBroadcast(\"warning\", player.name + \" è¸©ä¸­ç›‘ç‹±ï¼Œè¢«æ‹˜ç•™ä¸€å›åˆï¼Œåœæ­¢è¡ŒåŠ¨ï¼\");\n  gameProcess.gameLogBroadcast(player.name + \" åœæ­¢è¡ŒåŠ¨ 1 å›åˆï¼ˆç›‘ç‹±ï¼‰\");\n  gameProcess.gameDataBroadcast();\n})"},{"id":"event-uodz4z","name":"éšæœºäº‹ä»¶","description":"è§¦å‘éšæœºçš„äº‹ä»¶","type":"ArrivedEvent","iconId":"image-a63ig8","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  interface RandomEvent {\n    id: string;\n    name: string;\n    desc: string;\n    type: 'good' | 'bad' | 'neutral';\n    weight: number;\n    fn: () => Promise<void>;\n  }\n\n  const allPlayers: IPlayer[] = Array.from(gameProcess.players.values());\n  const mapSize = gameProcess.getPathMapItemIds().length;\n  const pathMapItemIds = gameProcess.getPathMapItemIds();\n\n  // ===== äº‹ä»¶æ± å®šä¹‰ =====\n  const events: RandomEvent[] = [\n    // --- æ­£é¢äº‹ä»¶ (æ€»æƒé‡ 45) ---\n    {\n      id: \"fortune-rain\",\n      name: \"å¤©é™æ¨ªè´¢\",\n      desc: \"è´¢ç¥çœ·é¡¾ï¼Œè·å¾— 1000~5000 å…ƒ\",\n      type: \"good\",\n      weight: 10,\n      fn: async () => {\n        const amount = Math.floor(Math.random() * 4000 + 1000);\n        await player.gain(amount);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} å¤©é™æ¨ªè´¢ï¼Œè·å¾— ${amount} å…ƒï¼`);\n      }\n    },\n    {\n      id: \"stock-tip\",\n      name: \"è‚¡å¸‚å†…å¹•\",\n      desc: \"è·å¾—ä¸€åªè‚¡ç¥¨çš„å†…å¹•æ¶ˆæ¯\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const result = await gameProcess.peekStockTrend(player.id, {\n          title: \"è‚¡å¸‚å†…å¹•\",\n          content: \"æœ‰äººå·å·å‘Šè¯‰ä½ ä¸‹å‘¨è‚¡å¸‚çš„é£å‘...\"\n        });\n        if (result) {\n          gameProcess.messageNotify([player.id], { type: \"info\", content: `å†…å¹•æ¶ˆæ¯ï¼š${result.stockName} è¢«è¯„çº§ä¸ºã€Œ${result.rating}ã€ï¼` });\n        }\n      }\n    },\n    {\n      id: \"free-card\",\n      name: \"æ„å¤–ä¹‹å–œ\",\n      desc: \"éšæœºè·å¾—ä¸€å¼ æœºä¼šå¡\",\n      type: \"good\",\n      weight: 8,\n      fn: async () => {\n        const cardIds = Array.from(gameProcess.chanceCardInfos.keys());\n        if (cardIds.length === 0) return;\n        const randomCardId = cardIds[Math.floor(Math.random() * cardIds.length)];\n        const newCard = gameProcess.createNewChanceCard(randomCardId);\n        await player.gainCard(newCard);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} æ¡åˆ°äº†ä¸€å¼ æœºä¼šå¡ï¼`);\n      }\n    },\n    {\n      id: \"building-gift\",\n      name: \"å»ºç­‘å‡çº§\",\n      desc: \"éšæœºä¸€æ ‹å»ºç­‘è‡ªåŠ¨å‡çº§\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const upgradeable = player.properties.filter(p => p.level < p.maxLevel);\n        if (upgradeable.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ æ²¡æœ‰å¯å‡çº§çš„å»ºç­‘ï¼\" });\n          return;\n        }\n        const randomProperty = upgradeable[Math.floor(Math.random() * upgradeable.length)];\n        await randomProperty.levelUp();\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} çš„ ${randomProperty.name} è‡ªåŠ¨å‡çº§ï¼`);\n      }\n    },\n    {\n      id: \"lottery-blessing\",\n      name: \"å½©ç¥¨ç¥ç¦\",\n      desc: \"è·å¾—ä¸€å¼ å…è´¹å½©ç¥¨\",\n      type: \"good\",\n      weight: 6,\n      fn: async () => {\n        const stock = gameProcess.lotteryManager.stock;\n        if (stock.length === 0) return;\n        const randomLottery = stock[Math.floor(Math.random() * stock.length)];\n        await gameProcess.handleBuyLottery(player, [randomLottery]);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} è·å¾—ä¸€å¼ å…è´¹å½©ç¥¨ï¼`);\n      }\n    },\n    {\n      id: \"wealth-share\",\n      name: \"å‡å¯Œæ•ˆåº”\",\n      desc: \"æ‰€æœ‰ç©å®¶ç»™ä½ æ¯äºº 200 å…ƒ\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) return;\n        let totalGain = 0;\n        for (const other of otherPlayers) {\n          if (other.money >= 200) {\n            await other.cost(200, \"event\", player);\n            await player.gain(200, \"event\", other);\n            totalGain += 200;\n          }\n        }\n        if (totalGain > 0) {\n          gameProcess.msgNotifyBroadcast(\"success\", `${player.name} è·å¾—å‡å¯Œæ•ˆåº”ï¼Œæ€»è®¡ ${totalGain} å…ƒï¼`);\n        }\n      }\n    },\n    // --- è´Ÿé¢äº‹ä»¶ (æ€»æƒé‡ 35) ---\n    {\n      id: \"sudden-loss\",\n      name: \"æ„å¤–æŸå¤±\",\n      desc: \"é­é‡æ„å¤–ï¼Œå¤±å» 1000~3000 å…ƒ\",\n      type: \"bad\",\n      weight: 10,\n      fn: async () => {\n        const amount = Math.floor(Math.random() * 2000 + 1000);\n        if (player.money < amount) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ é­é‡æ„å¤–ï¼Œä½†ä½ èº«æ— åˆ†æ–‡...\" });\n          return;\n        }\n        await player.cost(amount);\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} é­é‡æ„å¤–ï¼ŒæŸå¤± ${amount} å…ƒï¼`);\n      }\n    },\n    {\n      id: \"building-damage\",\n      name: \"å»ºç­‘æŸå\",\n      desc: \"éšæœºä¸€æ ‹å»ºç­‘ç­‰çº§ä¸‹é™\",\n      type: \"bad\",\n      weight: 7,\n      fn: async () => {\n        const damagable = player.properties.filter(p => p.level > 0);\n        if (damagable.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"å¹¸è¿çš„æ˜¯ï¼Œä½ æ²¡æœ‰å»ºç­‘å¯æŸåï¼\" });\n          return;\n        }\n        const randomProperty = damagable[Math.floor(Math.random() * damagable.length)];\n        await randomProperty.levelDown();\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} çš„ ${randomProperty.name} é­åˆ°æŸåï¼`);\n      }\n    },\n    {\n      id: \"forced-donation\",\n      name: \"å¼ºåˆ¶ææ¬¾\",\n      desc: \"è¢«è¿«æå‡ºç°é‡‘çš„ 10%\",\n      type: \"bad\",\n      weight: 6,\n      fn: async () => {\n        const donation = Math.floor(player.money * 0.1);\n        if (donation <= 0) return;\n        await player.cost(donation);\n        gameProcess.msgNotifyBroadcast(\"warning\", `${player.name} è¢«å¼ºåˆ¶ææ¬¾ ${donation} å…ƒï¼`);\n      }\n    },\n    // {\n    //   id: \"time-reversal\",\n    //   name: \"æ—¶ä¹‹é€†æµ\",\n    //   desc: \"è¢«æ—¶å…‰å€’æµï¼Œåé€€ 2-4 æ­¥\",\n    //   type: \"bad\",\n    //   weight: 7,\n    //   fn: async () => {\n    //     const steps = Math.floor(Math.random() * 3) + 2;\n    //     await player.tp(Math.max(0, player.positionIndex - steps));\n    //     gameProcess.msgNotifyBroadcast(\"warning\", `${player.name} è¢«æ—¶ä¹‹é€†æµå½±å“ï¼Œåé€€ ${steps} æ­¥ï¼`);\n    //   }\n    // },\n    {\n      id: \"card-loss\",\n      name: \"å¡ç‰‡é—å¤±\",\n      desc: \"éšæœºå¤±å»ä¸€å¼ æœºä¼šå¡\",\n      type: \"bad\",\n      weight: 5,\n      fn: async () => {\n        if (player.chanceCards.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ æ²¡æœ‰æœºä¼šå¡å¯ä¸¢å¤±ï¼\" });\n          return;\n        }\n        const randomCard = player.chanceCards[Math.floor(Math.random() * player.chanceCards.length)];\n        await player.loseCard(randomCard.getId());\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} é—å¤±äº†æœºä¼šå¡ ${randomCard.getName()}ï¼`);\n      }\n    },\n    // --- ä¸­æ€§/äº’åŠ¨äº‹ä»¶ (æ€»æƒé‡ 20) ---\n    {\n      id: \"random-tp\",\n      name: \"æ—¶ç©ºä¼ é€\",\n      desc: \"éšæœºä¼ é€åˆ°åœ°å›¾æŸå¤„\",\n      type: \"neutral\",\n      weight: 10,\n      fn: async () => {\n        if (mapSize <= 1) return;\n        let targetPos = pathMapItemIds[Math.floor(Math.random() * mapSize)];\n        while (targetPos === player.positionMapItemId) {\n          targetPos = pathMapItemIds[Math.floor(Math.random() * mapSize)];\n        }\n        await player.tpToMapItem(targetPos);\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} è¢«éšæœºä¼ é€åˆ°ä½ç½® ${targetPos}ï¼`);\n      }\n    },\n    {\n      id: \"card-steal\",\n      name: \"å€ŸèŠ±çŒ®ä½›\",\n      desc: \"ä»éšæœºç©å®¶å·ä¸€å¼ æœºä¼šå¡\",\n      type: \"neutral\",\n      weight: 5,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"æ²¡æœ‰å¯å·çš„ç›®æ ‡ï¼\" });\n          return;\n        }\n        const cardOwners = otherPlayers.filter(p => p.chanceCards.length > 0);\n        if (cardOwners.length === 0) {\n            gameProcess.messageNotify([player.id], { type: \"warning\", content: \"æ²¡æœ‰ç©å®¶æœ‰æœºä¼šå¡å¯å·ï¼\" });\n            return;\n        }\n        const target = cardOwners[Math.floor(Math.random() * cardOwners.length)];\n        const stolenCard = target.chanceCards[Math.floor(Math.random() * target.chanceCards.length)];\n        await target.loseCard(stolenCard.getId());\n        await player.gainCard(gameProcess.createNewChanceCard(stolenCard.getSourceId()));\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} ä» ${target.name} é‚£å·èµ°äº† ${stolenCard.getName()}ï¼`);\n      }\n    },\n    {\n      id: \"swap-fortune\",\n      name: \"è´¢å¯Œå¹³å‡\",\n      desc: \"ä¸éšæœºç©å®¶å¹³åˆ†ç°é‡‘\",\n      type: \"neutral\",\n      weight: 5,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) return;\n        const target = otherPlayers[Math.floor(Math.random() * otherPlayers.length)];\n        const playerMoney = player.money || 0;\n        const targetMoney = target.money || 0;\n        const avg = Math.floor((playerMoney + targetMoney) / 2);\n        const diff = playerMoney - avg;\n        if (diff > 0) {\n          await player.cost(diff, \"event\", target);\n          await target.gain(diff, \"event\", player);\n        } else if (diff < 0) {\n          await target.cost(-diff, \"event\", player);\n          await player.gain(-diff, \"event\", target);\n        }\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} ä¸ ${target.name} çš„ç°é‡‘è¢«å¹³å‡ä¸º ${avg} å…ƒï¼`);\n      }\n    }\n  ];\n\n  // ===== æŒ‰æƒé‡éšæœºé€‰æ‹©äº‹ä»¶ =====\n  const totalWeight = events.reduce((sum, e) => sum + e.weight, 0);\n  let random = Math.random() * totalWeight;\n  let selectedEvent = events[0];\n  for (const event of events) {\n    random -= event.weight;\n    if (random <= 0) {\n      selectedEvent = event;\n      break;\n    }\n  }\n\n  // ===== æ˜¾ç¤ºäº‹ä»¶åŠ¨ç”» =====\n  const typeEmoji = selectedEvent.type === 'good' ? 'star' : selectedEvent.type === 'bad' ? 'boom' : 'cycle';\n  const typeColor = selectedEvent.type === 'good' ? '#52c41a' : selectedEvent.type === 'bad' ? '#ff4d4f' : '#1890ff';\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: `${typeEmoji} éšæœºäº‹ä»¶è§¦å‘`,\n    content: {\n      id: \"random-event-display\",\n      type: \"div\",\n      style: {\n        display: \"flex\",\n        flexDirection: \"column\",\n        alignItems: \"center\",\n        gap: \"0.75rem\",\n        padding: \"1rem\"\n      },\n      children: [\n        {\n          id: \"event-name\",\n          type: \"text\",\n          content: selectedEvent.name,\n          style: {\n            fontSize: \"1.5rem\",\n            fontWeight: \"bold\",\n            color: typeColor\n          }\n        },\n        {\n          id: \"event-desc\",\n          type: \"text\",\n          content: selectedEvent.desc,\n          style: {\n            fontSize: \"1rem\",\n            color: \"#666\"\n          }\n        },\n        {\n          id: \"player-name\",\n          type: \"text\",\n          content: `â€” ${player.name} â€”`,\n          style: {\n            fontSize: \"1.125rem\",\n            fontWeight: \"600\",\n            color: \"#333\"\n          }\n        }\n      ]\n    },\n    duration: 3000\n  });\n\n  // ===== æ‰§è¡Œäº‹ä»¶æ•ˆæœ =====\n  await selectedEvent.fn();\n})"},{"id":"event-z25j74","name":"åç‰¢","description":"ä¼ é€åˆ°ç›‘ç‹±","type":"ArrivedEvent","iconId":"image-je466j","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  if ((gameProcess.shields?.[player.id] || 0) > 0) {\n    gameProcess.shields[player.id]--;\n    const __sl = gameProcess.shields[player.id];\n    if (__sl > 0) { player.buffManager.updateBuff(\"shield-\" + player.id, { description: \"æŠµæ¶ˆä¸‹ä¸€æ¬¡åç‰¢/åŒ»é™¢/ç›‘ç‹±ï¼ˆå‰©ä½™ \" + __sl + \" ä¸ªï¼‰\" }); } else { player.buffManager.removeBuff(\"shield-\" + player.id); }\n    gameProcess.msgNotifyBroadcast(\"success\", \"å…ç½šæŠ¤ç›¾ç”Ÿæ•ˆï¼\" + player.name + \" å…é™¤äº†æœ¬æ¬¡åç‰¢ä¼ é€ï¼\");\n    gameProcess.gameDataBroadcast();\n    return;\n  }\n  const prisonMapItemId = \"mi-dz-o14\";\n  if (!gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === prisonMapItemId)) {\n    throw new Error(\"ç›‘ç‹±ç›®æ ‡åœ°å›¾é¡¹ä¸å­˜åœ¨\");\n  }\n  if (!player.tpToMapItem) {\n    throw new Error(\"æ–°ç‰ˆ MapPath ä¼ é€ API ä¸å¯ç”¨\");\n  }\n  await player.tpToMapItem(prisonMapItemId);\n  player.setStop((player.isStop || 0) + 1);\n});"}],"phases":{"gameOverRule":[{"id":"phase-p0mtrp","name":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™","description":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™, è¿”å›ä¸€ä¸ªå¸ƒå°”å€¼, å½“è¿”å›å€¼ä¸ºtrueæ—¶æ¸¸æˆç»“æŸ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => {\n    const players = Array.from(gameProcess.players.values());\n    if (players.length <= 1) return false;\n    const activePlayers = players.filter(p => !p.isBankrupted);\n    if (activePlayers.length <= 1) {\n        const allPlayers = Array.from(gameProcess.players.values());\n        allPlayers.sort((a, b) => (b.money ?? 0) - (a.money ?? 0));\n        return allPlayers.map(p => p.id);\n    }\n    if (players.some(p => p.money >= gameProcess.gameSetting.targetMoney.value)) {\n        const allPlayers = Array.from(gameProcess.players.values());\n        allPlayers.sort((a, b) => (b.money ?? 0) - (a.money ?? 0));\n        return allPlayers.map(p => p.id);\n    }\n    return false;\n});"}],"gameInited":[{"id":"phase-2uwazh","name":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸ","description":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"((ctx: GameContext, gameProcess: IGameProcess) => {\n    gameProcess.players.forEach((player) => {\n        gameProcess.registerPlayerButton(player.id, \"æŸ¥çœ‹æŒè‚¡\", async () => {\n            const playerId = player.id;\n            const portfolios = gameProcess.exportData.stockMarket.portfolios[playerId] || {};\n            const stocks = gameProcess.exportData.stockMarket.stocks;\n\n            // é¢„å…ˆè®¡ç®—æŒä»“æ•°æ®\n            const holdings = [];\n            for (const stock of stocks) {\n                const holding = portfolios[stock.id] || 0;\n                if (holding > 0) {\n                    holdings.push({\n                        name: stock.name,\n                        color: stock.color,\n                        price: stock.price,\n                        priceText: stock.display.price,\n                        percent: stock.display.percent,\n                        percentColor: stock.display.color,\n                        linePath: stock.display.linePath,\n                        areaPath: stock.display.areaPath,\n                        holding: holding,\n                        marketValue: Math.round(holding * stock.price)\n                    });\n                }\n            }\n\n            await gameProcess.showConfirmDialog(playerId, {\n                title: `${player.name} çš„è‚¡ç¥¨æŒä»“`,\n                content: {\n                    id: \"stock-portfolio-wrapper\",\n                    type: \"div\",\n                    variable: {\n                        holdings: holdings,\n                        hasHolding: holdings.length > 0\n                    },\n                    children: [$ui__stock_portfolio]\n                },\n            });\n        });\n    });\n});"},{"id":"phase-mgdvg8","name":"è‚¡å¸‚ç³»ç»Ÿåˆå§‹åŒ–","description":"è‚¡å¸‚ç³»ç»Ÿåˆå§‹åŒ–ï¼šæ ¹æ®åœ°çš®å…¬å¸è‡ªåŠ¨åˆ›å»ºè‚¡ç¥¨ï¼Œæ³¨å†Œåœ°çš®-è‚¡ç¥¨è”åŠ¨ä¿®é¥°å™¨ï¼ˆæ”¶ç§Ÿ/å‡çº§/é™çº§/è´­ä¹°ï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    class StockMarketManager implements IStockMarketManager {\n        private _data: StockMarketData;\n        private historyLimit = 20;\n        private readonly BUY_FEE_RATE = 0.01;\n        private readonly SELL_FEE_RATE = 0.01;\n        private readonly UI_CONFIG = { width: 100, height: 30, padding: 4 };\n\n        constructor() {\n            this._data = {\n                isOpen: false,\n                stocks: [],\n                portfolios: {},\n                marketTrend: 0,\n                volatilityMultiplier: 1,\n                tick: 0\n            };\n        }\n\n        get data(): StockMarketData { return this._data; }\n\n        public init(configs: StockConfig[]): void {\n            if (this._data.stocks.length > 0) return;\n            this._data.stocks = configs.map(c => this.createStockInstance(c));\n            this._data.isOpen = true;\n        }\n\n        public addStock(config: StockConfig): Stock | null {\n            if (this.getStock(config.id)) return this.getStock(config.id)!;\n            const stock = this.createStockInstance(config);\n            this._data.stocks.push(stock);\n            return stock;\n        }\n\n        private createStockInstance(config: StockConfig): Stock {\n            const price = config.price ?? 100;\n            const stock: Stock = {\n                id: config.id,\n                name: config.name,\n                color: config.color || '#fff',\n                price,\n                basePrice: config.basePrice ?? price,\n                changeRate: 0,\n                history: [price],\n                trend: config.initialTrend ?? 0,\n                volatility: config.volatility ?? 0.02,\n                trendSpeed: config.trendSpeed ?? 0.01,\n                liquidity: config.liquidity ?? 1,\n                heat: 0,\n                display: {\n                    color: '#999999',\n                    linePath: '',\n                    areaPath: '',\n                    price: '',\n                    percent: ''\n                }\n            };\n            this.refreshDisplay(stock);\n            return stock;\n        }\n\n        public tick(): void {\n            this._data.tick++;\n            for (const stock of this._data.stocks) {\n                stock.trend += (Math.random() - 0.5) * stock.trendSpeed;\n                stock.trend += this._data.marketTrend * 0.1;\n                stock.trend = this.clamp(stock.trend, -1, 1);\n                stock.heat *= 0.9;\n                let rate = stock.trend * 0.02\n                    + (Math.random() - 0.5) * stock.volatility * this._data.volatilityMultiplier;\n                rate *= (1 + stock.heat);\n                this.applyPriceChange(stock, rate);\n            }\n        }\n\n        public setMarketTrend(value: number): void {\n            this._data.marketTrend = this.clamp(value, -1, 1);\n        }\n\n        public setHistoryLimit(limit: number): void {\n            if (limit > 0) {\n                this.historyLimit = limit;\n                for (const s of this._data.stocks) {\n                    while (s.history.length > this.historyLimit) s.history.shift();\n                }\n            }\n        }\n\n        public getTaxRate(isBuy: boolean): number {\n            return isBuy ? this.BUY_FEE_RATE : this.SELL_FEE_RATE;\n        }\n\n        public getStock(stockId: string): Stock | undefined {\n            return this._data.stocks.find(s => s.id === stockId);\n        }\n\n        public getHolding(playerId: string, stockId: string): number {\n            return this._data.portfolios[playerId]?.[stockId] || 0;\n        }\n\n        public getPlayerHoldingStock(playerId: string): { stock: Stock; holding: number }[] {\n            const h = this._data.portfolios[playerId];\n            if (!h) return [];\n            return Object.keys(h)\n                .filter(id => h[id] > 0)\n                .map(id => ({ stock: this.getStock(id)!, holding: h[id] }));\n        }\n\n        public getTransactionCost(stockId: string, amount: number): number {\n            const s = this.getStock(stockId);\n            if (!s) return 0;\n            return Math.round(s.price * amount * (1 + this.getTaxRate(true)));\n        }\n\n        public getSellRevenue(stockId: string, amount: number): number {\n            const s = this.getStock(stockId);\n            if (!s) return 0;\n            return Math.round(s.price * amount * (1 - this.getTaxRate(false)));\n        }\n\n        public canTrade(playerId: string, stockId: string, amount: number, isBuy: boolean): TradeCheckResult {\n            if (!this._data.isOpen) return { ok: false, msg: 'ä¼‘å¸‚' };\n            const s = this.getStock(stockId);\n            if (!s) return { ok: false };\n            if (amount <= 0) return { ok: false };\n            if (!isBuy && this.getHolding(playerId, stockId) < amount) {\n                return { ok: false, msg: 'æŒæœ‰çš„è‚¡ç¥¨æ•°ä¸å¤Ÿ' };\n            }\n            return { ok: true };\n        }\n\n        public commitBuy(playerId: string, stockId: string, amount: number): TradeReceipt | null {\n            const check = this.canTrade(playerId, stockId, amount, true);\n            if (!check.ok) return null;\n            const s = this.getStock(stockId)!;\n            if (!this._data.portfolios[playerId]) this._data.portfolios[playerId] = {};\n            this._data.portfolios[playerId][stockId] = (this._data.portfolios[playerId][stockId] || 0) + amount;\n            this.applyTradeImpact(s, amount, s.price, true);\n            const feeRate = this.getTaxRate(true);\n            return { stockName: s.name, price: s.price, amount, totalCost: Math.round(s.price * amount * (1 + feeRate)) };\n        }\n\n        public commitSell(playerId: string, stockId: string, amount: number): TradeReceipt | null {\n            const check = this.canTrade(playerId, stockId, amount, false);\n            if (!check.ok) return null;\n            const s = this.getStock(stockId)!;\n            const port = this._data.portfolios[playerId];\n            if (!port) return null;\n            port[stockId] -= amount;\n            if (port[stockId] <= 0) delete port[stockId];\n            this.applyTradeImpact(s, amount, s.price, false);\n            const feeRate = this.getTaxRate(false);\n            return { stockName: s.name, price: s.price, amount, totalCost: Math.round(s.price * amount * (1 - feeRate)) };\n        }\n\n        private applyTradeImpact(stock: Stock, amount: number, price: number, isBuy: boolean) {\n            const tradeValue = amount * price;\n            let impact = Math.log10(tradeValue + 1) * 0.001 * (1 / stock.liquidity);\n            impact *= Math.sqrt(Math.log10(tradeValue + 1));\n            if (!isBuy) impact *= -1;\n            stock.heat += Math.log10(tradeValue + 1) * 0.01;\n            this.applyPriceChange(stock, impact);\n        }\n\n        public triggerEvent(stockId: string, type: 'RENT' | 'BUILD' | 'RANDOM', intensity: number = 1): void {\n            const s = this.getStock(stockId);\n            if (!s) return;\n            let rate = 0;\n            if (type === 'RENT') {\n                rate = 0.01 * intensity;\n                s.trend += 0.1;\n            } else if (type === 'BUILD') {\n                rate = 0.05 * intensity;\n                s.heat += 0.2;\n            } else {\n                rate = (Math.random() - 0.5) * 0.05;\n            }\n            this.applyPriceChange(s, rate);\n        }\n\n        private applyPriceChange(stock: Stock, rate: number) {\n            const old = stock.price;\n            let newPrice = stock.price * (1 + rate);\n            newPrice = this.clamp(newPrice, 5, 100000);\n            stock.price = Number(newPrice.toFixed(2));\n            stock.changeRate = (stock.price - old) / old;\n            stock.history.push(stock.price);\n            if (stock.history.length > this.historyLimit) stock.history.shift();\n        }\n\n        public getExportData(): StockMarketData {\n            this._data.stocks.forEach(s => this.refreshDisplay(s));\n            return this._data;\n        }\n\n        private refreshDisplay(stock: Stock): void {\n            stock.display.color = stock.changeRate >= 0 ? '#ef4444' : '#22c55e';\n            stock.display.price = stock.price.toFixed(1);\n            const percent = (stock.changeRate * 100).toFixed(1);\n            stock.display.percent = (stock.changeRate > 0 ? '+' : '') + percent + '%';\n            const history = stock.history;\n            if (history.length < 2) {\n                const midY = this.UI_CONFIG.height / 2;\n                const line = \"M0,\" + midY + \" L\" + this.UI_CONFIG.width + \",\" + midY;\n                stock.display.linePath = line;\n                stock.display.areaPath = line + \" L\" + this.UI_CONFIG.width + \",\" + this.UI_CONFIG.height + \" L0,\" + this.UI_CONFIG.height + \" Z\";\n                return;\n            }\n            const min = Math.min.apply(null, history);\n            const max = Math.max.apply(null, history);\n            const range = max - min || 1;\n            const drawHeight = this.UI_CONFIG.height - this.UI_CONFIG.padding * 2;\n            const stepX = this.UI_CONFIG.width / (history.length - 1);\n            const points: string[] = [];\n            for (let i = 0; i < history.length; i++) {\n                const x = (i * stepX).toFixed(1);\n                const ratio = (history[i] - min) / range;\n                const y = (this.UI_CONFIG.height - this.UI_CONFIG.padding - (ratio * drawHeight)).toFixed(1);\n                points.push(x + \",\" + y);\n            }\n            const line = \"M\" + points.join(\" L\");\n            stock.display.linePath = line;\n            stock.display.areaPath = line + \" L\" + this.UI_CONFIG.width + \",\" + this.UI_CONFIG.height + \" L0,\" + this.UI_CONFIG.height + \" Z\";\n        }\n\n        private clamp(v: number, min: number, max: number): number {\n            return Math.max(min, Math.min(max, v));\n        }\n    }\n\n    const stockMarket = new StockMarketManager();\n\n    // ========== æ ¹æ®åœ°çš®å…¬å¸åˆ›å»ºè‚¡ç¥¨ ==========\n    const companyColors: Record<string, string> = {\n        'å†…å·çŸ¿ä¸š': '#8B6914',\n        'èººå¹³åœ°äº§': '#2D8B57',\n        'éŸ­èœå•†è¡Œ': '#C8A415',\n        'æ‘¸é±¼ç§‘æŠ€': '#4682B4',\n        'æ¢­å“ˆèµ„æœ¬': '#C0392B',\n        'ç§ƒå¤´ä¿é™©': '#8E44AD',\n        'é¸½é¸½èˆªç©º': '#16A085',\n        'æ©˜çŒ«é£Ÿå ‚': '#D35400'\n    };\n\n    const companyMap: Record<string, IProperty[]> = {};\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        if (!companyMap[company]) companyMap[company] = [];\n        companyMap[company].push(prop);\n    });\n\n    const stockConfigs: StockConfig[] = [];\n    const companyKeys = Object.keys(companyMap);\n    for (let i = 0; i < companyKeys.length; i++) {\n        const company = companyKeys[i];\n        const props = companyMap[company];\n        let totalSellCost = 0;\n        for (let j = 0; j < props.length; j++) totalSellCost += props[j].sellCost;\n        const avgPrice = Math.round(totalSellCost / props.length / 10);\n        stockConfigs.push({\n            id: 'stock_' + company,\n            name: company,\n            price: avgPrice,\n            color: companyColors[company] || '#ffffff',\n            volatility: 0.03,\n            liquidity: props.length * 0.5\n        });\n    }\n\n    stockMarket.init(stockConfigs);\n    gameProcess.stockMarket = stockMarket;\n\n    // ========== åœ°çš®-è‚¡ç¥¨è”åŠ¨ä¿®é¥°å™¨ ==========\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        prop.modifierManager.add($mod__stock_rent_link);\n        prop.modifierManager.add($mod__stock_build_link);\n        prop.modifierManager.add($mod__stock_buy_link);\n        prop.modifierManager.add($mod__stock_downgrade_link);\n    });\n}) as GameEventFunction<GameContext>;"},{"id":"phase-a0gp5z","name":"å½©ç¥¨ç³»ç»Ÿåˆå§‹åŒ–","description":"å½©ç¥¨ç³»ç»Ÿåˆå§‹åŒ–","initEventCode":"(async (context, gameProcess) => {\n    class LotteryManager implements ILotteryManager {\n        stock: number[];\n        stockSize: number;\n        price: number;\n        jackpot: number;\n        currentJackpot: number;\n        playerStock: Map<string, { player: IPlayer; stock: number[]; }>;\n\n        constructor(stockNum: number, price: number, jackpot: number = 0) {\n            this.price = price;\n            this.jackpot = jackpot;\n            this.currentJackpot = jackpot;\n            this.playerStock = new Map<string, { player: IPlayer; stock: number[]; }>();\n            for (const player of gameProcess.players.values()) {\n                this.playerStock.set(player.id, { player, stock: [] })\n            }\n            this.resetStock(stockNum);\n        }\n\n        async buyLottery(player: IPlayer, lottery: number[]) {\n            const lotterySet = new Set(lottery);\n            if (lotterySet.size !== lottery.length) {\n                throw new Error(\"å½©ç¥¨å·ç é‡å¤\");\n            }\n\n            const stockSet = new Set(this.stock);\n            for (const num of lottery) {\n                if (!stockSet.has(num)) {\n                    throw new Error(`å½©ç¥¨å·ç  ${num} ä¸åœ¨åº“å­˜ä¸­`);\n                }\n            }\n\n            this.stock = this.stock.filter(s => !lotterySet.has(s));\n\n            const playerStock = this.playerStock.get(player.id);\n            if (!playerStock) {\n                throw new Error(\"ç©å®¶ä¸å­˜åœ¨\");\n            }\n            playerStock.stock.push(...lottery);\n        }\n\n        resetStock(stockSize: number): void {                                                                            // é‡ç½®åº“å­˜\n            this.stock = Array.from({ length: stockSize }, (_, index) => index + 1); this.stockSize = stockSize;\n            this.currentJackpot = this.jackpot;\n\n            // é‡ç½®æ‰€æœ‰ç©å®¶çš„å½©ç¥¨åº“å­˜\n            for (const playerStock of this.playerStock.values()) {\n                playerStock.stock = [];\n            }\n        }\n\n        draw(count: number = 1): JackpotResult {\n            // è¾¹ç•Œæ£€æŸ¥\n            if (this.stockSize === 0) {\n                return { lottery: [], jackpotPlayers: [], currentJackpot: 0 };\n            }\n\n            // 1. ç”Ÿæˆå¯ç”¨å·ç æ± ï¼ˆ1 åˆ° stockSizeï¼‰\n            const availableNumbers = Array.from(\n                { length: this.stockSize },\n                (_, i) => i + 1\n            );\n\n            // 2. éšæœºæŠ½å– count ä¸ªä¸­å¥–å·ç ï¼ˆFisher-Yates éƒ¨åˆ†æ´—ç‰Œï¼šæ¯ä¸ªå·ç ä¸¥æ ¼ç­‰æ¦‚ç‡ï¼Œæ— é‡è¯•ï¼‰\n            const shuffledPool = availableNumbers.slice();\n            const drawCount = Math.min(count, shuffledPool.length);\n            for (let i = 0; i < drawCount; i++) {\n                const j = i + Math.floor(Math.random() * (shuffledPool.length - i));\n                const tmpNum = shuffledPool[i]; shuffledPool[i] = shuffledPool[j]; shuffledPool[j] = tmpNum;\n            }\n            const winningNumbers = shuffledPool.slice(0, drawCount);\n            const winningSet = new Set<number>(winningNumbers);\n\n            // 3. æ£€æŸ¥å“ªäº›ç©å®¶æœ‰è¿™äº›å·ç \n            const jackpotPlayers: { player: IPlayer; jackpot: number[]; }[] = [];\n\n            for (const { player, stock } of this.playerStock.values()) {\n                const matched = stock.filter(num => winningSet.has(num));\n                if (matched.length > 0) {\n                    jackpotPlayers.push({ player, jackpot: matched });\n                }\n            }\n\n            const res = { lottery: winningNumbers, jackpotPlayers, currentJackpot: this.currentJackpot }\n\n            // æ¯å‘¨ä¸€å¼€å¥–ç»“ç®—ï¼šå¥–æ± åœ¨åŸå…ˆåŸºç¡€ä¸Šå¢åŠ  1000 å…ƒï¼ˆç´¯è¿›ï¼‰ï¼Œéšååº“å­˜/æŒç¥¨ç»Ÿä¸€é‡ç½®\n            this.jackpot += 1000;\n            this.resetStock(this.stockSize);\n\n            return res;\n        }\n    }\n    gameProcess.lotteryManager = new LotteryManager(30, 150, 4500);\n// æ“ä½œé¢æ¿\"æŸ¥çœ‹å½©ç¥¨\"æŒ‰é’®ï¼šç‚¹å‡»åæŸ¥çœ‹è‡ªå·±æŒæœ‰çš„å½©ç¥¨å·ç \n        for (const player of gameProcess.players.values()) {\n            gameProcess.registerPlayerButton(player.id, \"æŸ¥çœ‹å½©ç¥¨\", async () => {\n                const lm = gameProcess.lotteryManager;\n                const ps = lm.playerStock.get(player.id);\n                const nums = ps && ps.stock.length > 0 ? ps.stock.join(\"ã€\") : \"æš‚æ— æŒæœ‰å½©ç¥¨\";\n                await gameProcess.showConfirmDialog(player.id, {\n                    title: \"æˆ‘çš„å½©ç¥¨\",\n                    content: \"æŒæœ‰çš„å½©ç¥¨å·ç ï¼š\" + String.fromCharCode(10) + \"<color:primary>\" + nums + \"</color>\",\n                    confirmText: \"å…³é—­\",\n                    closable: true,\n                });\n            });\n        }\n}) as GameEventFunction<GameContext>;"},{"id":"phase-3ndlon","name":"æ—¥æœŸç³»ç»Ÿåˆå§‹åŒ–","description":"æ—¥æœŸç³»ç»Ÿåˆå§‹åŒ–","initEventCode":"(async (context, gameProcess) => {\n    enum WeekDay {\n        Sunday = 0,\n        Monday = 1,\n        Tuesday = 2,\n        Wednesday = 3,\n        Thursday = 4,\n        Friday = 5,\n        Saturday = 6\n    }\n\n    class DateManager implements IDateManager {\n        currentTurn: number;\n        readonly startDay: WeekDay = WeekDay.Monday;\n\n        // é»˜è®¤æ ¼å¼æ¨¡æ¿\n        private static readonly DEFAULT_TEMPLATE = \"{day}\";\n\n        constructor() {\n            this.currentTurn = 0;\n        }\n\n        getCurrentDay(): WeekDay {\n            return this.getDayByTurn(this.currentTurn);\n        }\n\n        getCurrentDayName(): string {\n            const dayNames = [\"æ˜ŸæœŸæ—¥\", \"æ˜ŸæœŸä¸€\", \"æ˜ŸæœŸäºŒ\", \"æ˜ŸæœŸä¸‰\", \"æ˜ŸæœŸå››\", \"æ˜ŸæœŸäº”\", \"æ˜ŸæœŸå…­\"];\n            return dayNames[this.getCurrentDay()];\n        }\n\n        getDayByTurn(turn: number): WeekDay {\n            const dayOffset = turn % 7;\n            const result = (this.startDay + dayOffset) % 7;\n            return result as WeekDay;\n        }\n\n        getDayNumber(): number {\n            return this.currentTurn + 1;\n        }\n\n        getWeekNumber(): number {\n            return Math.floor(this.currentTurn / 7) + 1;\n        }\n\n        advanceTurn(count: number = 1): void {\n            if (count < 0) {\n                throw new Error(\"å›åˆæ•°ä¸èƒ½ä¸ºè´Ÿæ•°\");\n            }\n            this.currentTurn += count;\n        }\n\n        resetTurn(): void {\n            this.currentTurn = 0;\n        }\n\n        format(template: string = DateManager.DEFAULT_TEMPLATE): string {\n            return template\n                .replace(\"{day}\", this.getCurrentDayName())\n                .replace(\"{dayNum}\", this.getDayNumber().toString())\n                .replace(\"{week}\", this.getWeekNumber().toString());\n        }\n    }\n    gameProcess.dateManager = new DateManager();\n}) as GameEventFunction<GameContext>;"},{"id":"phase-xmteor","name":"æŒ‚è½½ç³»ç»Ÿå‡½æ•°","description":"æŒ‚è½½ç³»ç»Ÿå‡½æ•°","initEventCode":"(async (context, gameProcess) => {\n    gameProcess.handleBuyLottery = async function (player, lottery) {\n        if (lottery.length > 3) {\n            return;\n        }\n\n        const cost = gameProcess.lotteryManager.price * lottery.length;\n        if (player.money < cost) {\n            return;\n        }\n\n        await player.cost(cost);\n        await gameProcess.lotteryManager.buyLottery(player, lottery);\n    };\n\n    gameProcess.peekStockTrend = async function (playerId, options) {\n        const sm = gameProcess.stockMarket;\n        if (!sm || !sm.data.isOpen) return null;\n\n        function getRating(trend: number, heat: number): string {\n            const score = trend * 0.7 + heat * 0.3;\n            if (score > 0.5) return \"å¤¯çˆ†äº†\";\n            if (score > 0.3) return \"é¡¶çº§\";\n            if (score > 0.1) return \"äººä¸Šäºº\";\n            if (score > -0.2) return \"NPC\";\n            return \"æ‹‰å®Œäº†\";\n        }\n\n        const items = sm.data.stocks.map(function (stock) {\n            return {\n                id: stock.id,\n                display: {\n                    id: \"stock-peek-\" + stock.id,\n                    type: \"div\",\n                    style: { background: '#ffffff', borderRadius: '1rem' },\n                    variable: {\n                        stockName: stock.name,\n                        stockColor: stock.color,\n                        areaColor: stock.display.color,\n                        areaPath: stock.display.areaPath,\n                        linePath: stock.display.linePath,\n                        price: stock.display.price,\n                        percent: stock.display.percent,\n                    },\n                    children: [\n                        $ui__stock_preview\n                    ]\n                }\n            };\n        });\n\n        var dialogOptions: any = {\n            title: (options && options.title) || 'é€‰æ‹©è¦æŸ¥çœ‹çš„è‚¡ç¥¨',\n            itemList: items,\n            cancelText: (options && options.cancelText) || 'å–æ¶ˆ'\n        };\n        if (options && options.content) dialogOptions.content = options.content;\n        if (options && options.column) dialogOptions.column = options.column;\n\n        var result = await gameProcess.showItemSelectDialog(playerId, dialogOptions);\n        if (!result.selected.length) return null;\n\n        var stock = sm.getStock(result.selected[0]);\n        if (!stock) return null;\n\n        return {\n            stockId: stock.id,\n            stockName: stock.name,\n            price: stock.price,\n            changeRate: stock.changeRate,\n            trendValue: stock.trend,\n            heatValue: stock.heat,\n            rating: getRating(stock.trend, stock.heat)\n        };\n    };\n}) as GameEventFunction<GameContext>;"},{"id":"phase-inflation-init","name":"é€šèƒ€ç³»ç»Ÿåˆå§‹åŒ–","description":"åˆå§‹åŒ–é€šèƒ€çŠ¶æ€ï¼ˆå€ç‡1.0ï¼‰ï¼Œä¿å­˜æ¯å—åœ°çš®çš„åŸå§‹ costList åˆ° exportData.baseCostListï¼Œç”¨äºåç»­æŒ‰å€ç‡é‡ç®—","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n  gameProcess.inflationRate = 1.0;\n  gameProcess.inflationHistory = [];\n\n  gameProcess.properties.forEach(function (prop) {\n    const company = prop.company;\n    if (!company) return;\n    prop.baseCostList = [...prop.costList];\n  });\n\n  const dm = gameProcess.dateManager;\n  const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n  let inflationWeek = Math.ceil(2 / cycle) * cycle;\n  const nextInflationDays = (inflationWeek - 1) * 7;\n\n  // Initialize exportData after all systems are ready\n  gameProcess.exportData = {\n    stockMarket: gameProcess.stockMarket.getExportData(),\n    date: dm.format(),\n    inflation: {\n      rate: gameProcess.inflationRate,\n      week: dm.getWeekNumber(),\n      nextInflationDays: nextInflationDays\n    }\n  };\n\n  // Broadcast to clients\n  gameProcess.gameDataBroadcast();\n}) as GameEventFunction<GameContext>;"}],"playerPreInit":[{"id":"phase-xuncvq","name":"ç©å®¶é¢„åˆå§‹åŒ–","description":"ç©å®¶é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨ç©å®¶åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<GameContext>;\r\n"}],"propertyPreInit":[{"id":"phase-5kermw","name":"åœ°çš®é¢„åˆå§‹åŒ–","description":"åœ°çš®é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨åœ°çš®åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<GameContext>;\r\n"}],"gameRoundStart":[{"id":"phase-mrppqo","name":"è½®æ¬¡å¼€å§‹","description":"è½®æ¬¡å¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context, gameProcess) => {\r\n    // gameProcess.players.forEach(p => {\r\n    //     p.gainCard(gameProcess.createNewChanceCard(\r\n    //         \"card-y472rl\"))\r\n    // })\r\n    // gameProcess.gameDataBroadcast();\r\n}) as GameEventFunction<GameRoundStartContext>;"},{"id":"phase-fnkiz2","name":"ç‰¹æ®Šæ—¥æœŸäº‹ä»¶","description":"ç‰¹æ®Šæ—¥æœŸäº‹ä»¶","initEventCode":"(async (ctx: GameContext, gameProcess: IGameProcess) => {\n    //å½©ç¥¨äº‹ä»¶: ç¬¬äºŒä¸ªæ˜ŸæœŸå¼€å§‹æ¯å‘¨ä¸€éƒ½ä¼šå¼€å¥–\n    if (gameProcess.dateManager.currentTurn > 6 && gameProcess.dateManager.getCurrentDay() === WeekDay.Monday) {\n        // åˆ®åˆ®ä¹å¥–é‡‘é¢åº¦æ¯å‘¨ä¸€é€’å¢ï¼šé•+250 / å®çŸ³+500 / æ˜Ÿæ˜Ÿ+750\n        const spW = gameProcess.__scratchPrize || (gameProcess.__scratchPrize = { pickaxe: 750, gem: 1000, star: 1750 });\n        spW.pickaxe += 250; spW.gem += 500; spW.star += 750;\n        const result = gameProcess.lotteryManager.draw();\n        //æœ‰äººä¸­å¥–\n        if (result.jackpotPlayers.length > 0) {\n            // å…ˆæ˜¾ç¤ºå¼€å¥–ç»“æœ\n            await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n                title: \"å¼€å¥–å•¦\",\n                content: {\n                    id: \"lottery-result-container\",\n                    type: \"div\",\n                    style: {\n                        display: \"flex\",\n                        flexDirection: \"column\",\n                        gap: \"0.75rem\",\n                        maxWidth: \"25rem\"\n                    },\n                    children: [\n                        {\n                            id: \"lottery-numbers\",\n                            type: \"text\",\n                            content: `å¼€å¥–å·ç : ${result.lottery.join('ã€')}`,\n                            style: {\n                                fontSize: \"1.125rem\",\n                                fontWeight: \"bold\",\n                                color: \"#333333\"\n                            }\n                        },\n                        {\n                            id: \"winning-player-container\",\n                            type: \"div\",\n                            style: {\n                                fontSize: \"0.875rem\",\n                            },\n                            children: result.jackpotPlayers.map((jackpot, index) => ({\n                                id: `winning-player-${index}`,\n                                type: 'text',\n                                content: jackpot.player.name,\n                                style: {\n                                    color: jackpot.player.getUser().color\n                                }\n                            }))\n                        },\n                        {\n                            id: \"prize-amount\",\n                            type: \"text\",\n                            content: `ä¸­å¥–å¥–é‡‘: Â¥${result.currentJackpot}`,\n                            style: {\n                                fontSize: \"1rem\",\n                                fontWeight: \"600\",\n                                color: \"#ff5722\"\n                            }\n                        }\n                    ]\n                },\n                duration: 4000,\n            })\n            // ç­‰å¾…UIæ˜¾ç¤ºåå†å‘æ”¾å¥–é‡‘\n            const totalWinningNumbers = result.jackpotPlayers.reduce((sum, p) => sum + p.jackpot.length, 0);\n            for (const jackpotPlayer of result.jackpotPlayers) {\n                const share = Math.round(result.currentJackpot * (jackpotPlayer.jackpot.length / totalWinningNumbers));\n                if (share > 0) {\n                    await jackpotPlayer.player.gain(share, \"system\");\n                }\n            }\n        } else {\n            //æ²¡äººä¸­å¥–\n            await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n                title: \"å¼€å¥–å•¦\",\n                content: {\n                    id: \"lottery-result-container\",\n                    type: \"div\",\n                    style: {\n                        display: \"flex\",\n                        flexDirection: \"column\",\n                        gap: \"0.75rem\",\n                        maxWidth: \"25rem\"\n                    },\n                    children: [\n                        {\n                            id: \"lottery-numbers\",\n                            type: \"text\",\n                            content: `å¼€å¥–å·ç : ${result.lottery.join('ã€')}`,\n                            style: {\n                                fontSize: \"1.125rem\",\n                                fontWeight: \"bold\",\n                                color: \"#333333\"\n                            }\n                        },\n                        {\n                            id: \"winning-player\",\n                            type: \"text\",\n                            content: `æ²¡æœ‰äººä¸­å¥–`,\n                            style: {\n                                fontSize: \"0.875rem\",\n                                color: \"#666666\"\n                            }\n                        },\n                        {\n                            id: \"prize-amount\",\n                            type: \"text\",\n                            content: `å½“å‰å¥–æ± : Â¥${result.currentJackpot}`,\n                            style: {\n                                fontSize: \"1rem\",\n                                fontWeight: \"600\",\n                                color: \"#ff5722\"\n                            }\n                        }\n                    ]\n                },\n                duration: 4000,\n            })\n        }\n\n    }\n// ===== æ‹¼æ‰‹æ°”çº¢åŒ…ç»“ç®—ï¼ˆæ¯å‘¨å››ï¼‰ =====\n    if (gameProcess.dateManager.currentTurn > 6 && gameProcess.dateManager.getCurrentDay() === WeekDay.Thursday) {\n        const rp = gameProcess.__redpacket || { joined300: [], joined500: [] };\n        const tiers = [\n            { key: \"joined300\", total: 1000, min: 150, max: 500, label: \"1000 å…ƒæ¡£\" },\n            { key: \"joined500\", total: 2500, min: 300, max: 1200, label: \"2500 å…ƒæ¡£\" },\n        ];\n        const splitPool = (total, n, min, max) => {\n            // å…¨å‘˜æœ€é«˜å¯è¡Œï¼ˆnÃ—max â‰¤ å¥–æ± ï¼‰â†’ äººäººéƒ½æ‹¿æœ€é«˜\n            if (n * max <= total) { const arr = Array(n).fill(max); return arr; }\n            // è¶…æ± ï¼šæ¯äººåœ¨å¯è¡ŒåŒºé—´å†…å‡åŒ€éšæœºå–å€¼ï¼Œæ€»å’Œæ°ä¸ºå¥–æ± ï¼ˆé¡ºåºè´ªå¿ƒä¿ç•Œ + æ´—ç‰Œæ¶ˆåï¼‰\n            const arr = [];\n            let left = total;\n            for (let i = 0; i < n; i++) {\n                const rest = n - i - 1;\n                const lo = Math.max(min, left - rest * max);\n                const hi = Math.min(max, left - rest * min);\n                let v;\n                if (rest === 0) { v = left; }\n                else { v = lo + Math.floor(Math.random() * ((hi - lo) / 10 + 1)) * 10; v = Math.max(lo, Math.min(hi, v)); }\n                arr.push(v); left -= v;\n            }\n            for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = arr[i]; arr[i] = arr[j]; arr[j] = t; }\n            return arr;\n        };\n        for (const tier of tiers) {\n            const joined = rp[tier.key] || [];\n            const players = joined.map((pid) => gameProcess.players.get(pid)).filter(Boolean);\n            if (players.length === 0) continue;\n            const amounts = splitPool(tier.total, players.length, tier.min, tier.max);\n            const maxAmt = Math.max.apply(null, amounts);\n            for (let i = 0; i < players.length; i++) {\n                if (amounts[i] > 0) await players[i].gain(amounts[i], \"system\");\n            }\n            const order = players.map((p, i) => ({ p: p, amt: amounts[i] })).sort((a, b) => b.amt - a.amt);\n            const rows = order.map((o) => ({\n                id: \"rp-\" + o.p.id,\n                type: \"text\",\n                content: o.p.name + \"ï¼šï¿¥\" + o.amt,\n                style: { fontSize: \"1.05rem\", fontWeight: \"bold\", color: o.amt === maxAmt ? \"#FFD700\" : \"#e67e22\" },\n            }));\n            await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n                title: \"ğŸ§§ æ‹¼æ‰‹æ°”çº¢åŒ…ç»“ç®—ï¼ˆ\" + tier.label + \"ï¼‰\",\n                content: { id: \"rp-container\", type: \"div\", style: { display: \"flex\", flexDirection: \"column\", gap: \"0.5rem\" }, children: rows },\n                duration: 5000,\n            });\n        }\n        gameProcess.__redpacket = { joined300: [], joined500: [] };\n    }\n})"},{"id":"phase-inflation-weekly","name":"é€šèƒ€ç‡å‘¨è°ƒæ•´","description":"æ¯å‘¨ä¸€ï¼ˆç¬¬2å‘¨èµ·ï¼‰æ£€æµ‹äººå‡ç°é‡‘ï¼Œæ ¹æ®ç°é‡‘æ°´å¹³è°ƒæ•´é€šèƒ€æ­¥é•¿ï¼ˆ5%~25%ï¼‰ï¼Œç›´æ¥ä¿®æ”¹æ‰€æœ‰åœ°çš® costList = baseCostList Ã— rateï¼Œé€šçŸ¥ç©å®¶","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    const dm = gameProcess.dateManager;\n    if (dm.currentTurn <= 6) return;\n    if (dm.getCurrentDay() !== WeekDay.Monday) return;\n\n    const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n    if (dm.getWeekNumber() % cycle !== 0) return;\n\n    const week = dm.getWeekNumber();\n\n    let totalCash = 0;\n    let activePlayers = 0;\n    gameProcess.players.forEach(function(p) {\n        totalCash += p.money;\n        activePlayers++;\n    });\n    if (activePlayers === 0) return;\n    const avgCash = Math.round(totalCash / activePlayers);\n\n    let step: number;\n    if (avgCash < 2000) {\n        step = 0.05;\n    } else if (avgCash < 5000) {\n        step = 0.10;\n    } else if (avgCash < 10000) {\n        step = 0.15;\n    } else {\n        step = 0.25;\n    }\n\n    step *= (1 + (Math.random() - 0.5) * 0.06);\n\n    const oldRate = gameProcess.inflationRate;\n    const newRate = Math.round((oldRate + step) * 100) / 100;\n    gameProcess.inflationRate = newRate;\n\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        const base = prop.baseCostList;\n        if (!base) return;\n        prop.costList = base.map(function(v) { return Math.max(1, Math.round(v * newRate)); });\n    });\n\n    const pctChange = ((newRate - oldRate) * 100).toFixed(1);\n\n    await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n        title: 'å¸‚åœºå…¬æŠ¥',\n        content: {\n            id: 'inflation-report',\n            type: 'div',\n            style: {\n                display: 'flex',\n                flexDirection: 'column',\n                gap: '0.5rem',\n                maxWidth: '22rem',\n                padding: '0.5rem'\n            },\n            children: [\n                {\n                    id: 'inflation-title',\n                    type: 'text',\n                    content: 'ç‰©ä»·ä¸Šæ¶¨',\n                    style: {\n                        fontSize: '1.25rem',\n                        fontWeight: 'bold',\n                        color: '#ef4444'\n                    }\n                },\n                {\n                    id: 'inflation-rate',\n                    type: 'text',\n                    content: 'è¿‡è·¯è´¹å€ç‡: ' + oldRate.toFixed(2) + 'x â†’ ' + newRate.toFixed(2) + 'x (+' + pctChange + '%)',\n                    style: {\n                        fontSize: '1rem',\n                        color: '#333333'\n                    }\n                },\n                {\n                    id: 'inflation-cash',\n                    type: 'text',\n                    content: 'äººå‡èµ„é‡‘: Â¥' + avgCash,\n                    style: {\n                        fontSize: '0.875rem',\n                        color: '#666666'\n                    }\n                },\n                {\n                    id: 'inflation-week',\n                    type: 'text',\n                    content: 'ç¬¬' + week + 'å‘¨',\n                    style: {\n                        fontSize: '0.8rem',\n                        color: '#999999'\n                    }\n                }\n            ]\n        },\n        duration: 4000\n    });\n\n    gameProcess.inflationHistory.push({ week: week, rate: newRate, avg: avgCash });\n    gameProcess.gameDataBroadcast();\n}) as GameEventFunction<GameRoundStartContext>;"}],"playerRound":[{"id":"phase-k54cn2","name":"ç©å®¶å›åˆå¼€å§‹","description":"ç©å®¶å›åˆå¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":1,"initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<PlayerRoundStartContext>;"},{"id":"phase-g01fxb","name":"ç©å®¶æ“ä½œ","description":"ç©å®¶æ“ä½œé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":2,"initEventCode":"(async (ctx, gameProcess) => {\n    const currentPlayer = ctx.currentRoundPlayer;\n    const currentPlayerId = currentPlayer.id;\n\n    // ä½¿ç”¨å¾ªç¯æ¥å¤„ç†å¯èƒ½çš„å¤šæ¬¡æ“ä½œï¼Œç›´åˆ°ç©å®¶æ·éª°å­æˆ–è¶…æ—¶\n    while (true) {\n        gameProcess.setCurrentEventName(`ç­‰å¾…${currentPlayer.name}æ“ä½œ`);\n\n        // åŒæ—¶ç›‘å¬æ·éª°å­ï¼ˆå¸¦è¶…æ—¶ï¼‰å’Œä½¿ç”¨æœºä¼šå¡\n        const operation = await Promise.race([\n            gameProcess.oncePlayerOperationAsync(currentPlayerId, OperateType.RollDice)\n                .then(res => ({ type: OperateType.RollDice, res })),\n            gameProcess.oncePlayerOperationAsync(currentPlayerId, OperateType.UseChanceCard)\n                .then(res => ({ type: OperateType.UseChanceCard, res }))\n        ]);\n\n        gameProcess.removePlayerAllOperationListener(currentPlayerId, OperateType.RollDice);\n        gameProcess.removePlayerAllOperationListener(currentPlayerId, OperateType.UseChanceCard);\n\n        if (operation.type === OperateType.RollDice) {\n            break;\n        } else if (operation.type === OperateType.UseChanceCard) {\n            if (operation.res) {\n                const { chanceCardId, targetIdList } = operation.res;\n                await gameProcess.handleUseChanceCard(currentPlayer, chanceCardId, targetIdList);\n            }\n        }\n    }\n\n    // å°†éª°å­ç»“æœå†™å…¥ä¸Šä¸‹æ–‡ï¼Œå¹¶å­˜å‚¨åˆ°ç©å®¶å¯¹è±¡ä¸­ä¾›å…¶ä»–æœºåˆ¶ä½¿ç”¨\n    // æ¸©æ³‰ç¥è¡Œæ ‡è®°ï¼šä»…è¡Œèµ°æµç¨‹çš„æ·éª°å…è®¸æ¸©æ³‰æ•ˆæœç”Ÿæ•ˆ/æ¶ˆè€—æ¬¡æ•°ï¼ˆéª°å­è€è™æœºç­‰æœºä¼šå¡æ·éª°ä¸è§¦å‘ï¼‰\n    gameProcess.__walkingRoll = true;\n    let diceResult;\n    try {\n        diceResult = await currentPlayer.rollDices();\n    } finally {\n        gameProcess.__walkingRoll = false;\n    }\n    ctx.diceResult = diceResult;\n    currentPlayer.lastDiceRollResults = diceResult;\n}) as GameEventFunction<RollDiceContext>"},{"id":"phase-q3ztq7","name":"ç©å®¶ç§»åŠ¨","description":"ç©å®¶ç§»åŠ¨é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":3,"initEventCode":"(async (context, gameProcess) => {\r\n\t//ç©å®¶ç§»åŠ¨\r\n\tconst player = context.currentRoundPlayer;\r\n    player.lastPositionId = player.positionMapItemId;\r\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\r\n\tcontext.targetIndex = player.positionIndex;\r\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"phase-aku4r0","name":"åˆ°è¾¾äº‹ä»¶","description":"åˆ°è¾¾äº‹ä»¶é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":4,"initEventCode":"(async (context, gameProcess) => {\r\n\tconst player = context.currentRoundPlayer;\r\n\tawait gameProcess.handleArriveEvent(player);\r\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"phase-462sxl","name":"ç©å®¶å›åˆç»“æŸ","description":"ç©å®¶å›åˆç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":5,"initEventCode":"(async (context, gameProcess) => {\r\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"phase-fji36p","name":"è½®æ¬¡ç»“æŸ","description":"è½®æ¬¡ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":6,"initEventCode":"(async (context, gameProcess) => {\n    gameProcess.currentRound += 1;\n\n    gameProcess.dateManager.advanceTurn(1);\n\n    const stockMarket = gameProcess.stockMarket;\n\n    stockMarket.tick();\n\n    stockMarket.data.stocks.forEach(stock => {\n        const intensity = 1 + (gameProcess.currentRound * 0.1);\n        stockMarket.triggerEvent(stock.id, 'RANDOM', intensity);\n    });\n\n    const dm = gameProcess.dateManager;\n    const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n    let nextInflationDays: number;\n    const currentWeek = dm.getWeekNumber();\n    const isMonday = dm.currentTurn % 7 === 0;\n    if (dm.currentTurn > 6 && isMonday && currentWeek % cycle === 0) {\n        nextInflationDays = 0;\n    } else {\n        let nextMondayTurn = isMonday ? dm.currentTurn + 7 : Math.ceil((dm.currentTurn + 1) / 7) * 7;\n        if (nextMondayTurn < 7) nextMondayTurn = 7;\n        let nextMondayWeek = Math.floor(nextMondayTurn / 7) + 1;\n        let inflationWeek = Math.ceil(nextMondayWeek / cycle) * cycle;\n        if (inflationWeek < 2) inflationWeek = Math.ceil(2 / cycle) * cycle;\n        nextInflationDays = (inflationWeek - 1) * 7 - dm.currentTurn;\n    }\n\n    gameProcess.exportData = {\n        stockMarket: stockMarket.getExportData(),\n        date: dm.format(),\n        inflation: {\n            rate: gameProcess.inflationRate,\n            week: currentWeek,\n            nextInflationDays: nextInflationDays\n        }\n    };\n\n    gameProcess.gameDataBroadcast();\n\n    gameProcess.customData.stockMarketData = stockMarket.data;\n    gameProcess.customData.lotteryData = {\n        stock: gameProcess.lotteryManager.stock,\n        currentJackpot: gameProcess.lotteryManager.currentJackpot,\n        playerStock: {}\n    };\n    gameProcess.lotteryManager.playerStock.forEach((value, key) => {\n        gameProcess.customData.lotteryData.playerStock[key] = value.stock;\n    });\n    gameProcess.customData.dateData = {\n        currentTurn: dm.currentTurn\n    };\n    gameProcess.customData.inflationData = {\n        rate: gameProcess.inflationRate,\n        history: [...gameProcess.inflationHistory]\n    };\n})"}],"postRestore":[{"id":"phase-9k4e5y","name":"å­˜æ¡£æ¢å¤å","description":"å­˜æ¡£æ¢å¤åé˜¶æ®µï¼ˆåœ¨ restoreFromSnapshot ä¹‹åã€GameInit å¹¿æ’­ä¹‹å‰è¿è¡Œï¼Œä»…åœ¨æœ‰å­˜æ¡£æ•°æ®æ—¶æ‰§è¡Œä¸€æ¬¡ï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    const sm = gameProcess.stockMarket;\n    const lm = gameProcess.lotteryManager;\n    const dm = gameProcess.dateManager;\n\n    if (gameProcess.customData.stockMarketData) {\n        const saved = gameProcess.customData.stockMarketData;\n        sm.data.isOpen = saved.isOpen;\n        sm.data.stocks = saved.stocks;\n        sm.data.portfolios = saved.portfolios;\n        sm.data.marketTrend = saved.marketTrend;\n        sm.data.volatilityMultiplier = saved.volatilityMultiplier;\n        sm.data.tick = saved.tick;\n    }\n\n    if (gameProcess.customData.lotteryData) {\n        const saved = gameProcess.customData.lotteryData;\n        lm.stock = saved.stock;\n        lm.currentJackpot = saved.currentJackpot;\n        for (const playerId in saved.playerStock) {\n            const playerStock = lm.playerStock.get(playerId);\n            if (playerStock) {\n                playerStock.stock = saved.playerStock[playerId];\n            }\n        }\n    }\n\n    if (gameProcess.customData.dateData) {\n        dm.currentTurn = gameProcess.customData.dateData.currentTurn;\n    }\n\n    const savedInflation = gameProcess.customData.inflationData;\n    const restoredRate = savedInflation?.rate ?? gameProcess.exportData?.inflation?.rate ?? 1;\n    gameProcess.inflationRate = restoredRate;\n    gameProcess.inflationHistory = Array.isArray(savedInflation?.history) ? savedInflation.history : [];\n\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        const base = prop.baseCostList;\n        if (!base) return;\n        prop.costList = base.map(function(v) { return Math.max(1, Math.round(v * restoredRate)); });\n    });\n}) as GameEventFunction<GameContext>;"}]},"buildingModelIdList":["model-3c7a8fbb-eccc-405e-8c3e-f11909aebae9","model-61dab177-1a23-45f7-be12-3af7b9336ae5","model-cf31d466-ede0-4455-8f0d-fd83564edc21"],"uiTemplates":[{"id":"tmpl-inpqnc","name":"æˆ‘çš„è‚¡ç¥¨æŒä»“","slug":"stock_portfolio","template":{"id":"stock-portfolio-root","type":"div","style":{"padding":"0.625rem 0.8rem","height":"100%"},"children":[{"id":"header","type":"div","style":{"display":"flex","justifyContent":"center","alignItems":"center","padding":"0.25rem 0.375rem","marginBottom":"0.5rem"},"children":[{"id":"title","type":"text","content":"æˆ‘çš„è‚¡ç¥¨æŒä»“","style":{"fontSize":"1rem","fontWeight":"800","letterSpacing":"1px","color":"var(--fp-color-text-secondary)"}}]},{"id":"empty-state","type":"div","style":{"display":"flex","justifyContent":"center","alignItems":"center","padding":"2rem","color":"var(--fp-color-text-secondary)"},"children":[{"id":"empty-text","type":"text","content":"æš‚æ— æŒä»“"}],"vShow":"!hasHolding"},{"id":"stock-list","type":"div","style":{"overflowY":"scroll","display":"flex","flexDirection":"column","gap":"1rem","padding":"0.5rem 1rem","flex":"1","max-height":"20rem","width":"40rem","flex-wrap":"wrap"},"vFor":"","children":[{"id":"stock-card","type":"div","style":{"display":"flex","flexDirection":"column","gap":"0.375rem","borderRadius":"0.375rem","padding":"1rem","background-color":"#ffffff","box-shadow":"var(--fp-shadow-card)"},"props":{"class":"felt-card-no-stitched"},"children":[{"id":"stock-info-row","type":"div","style":{"display":"flex","alignItems":"center","gap":"0.5rem"},"children":[{"id":"stock-name","type":"text","textBinding":"item.name","styleBinding":{"color":"item.color"},"style":{"fontSize":"0.875rem","whiteSpace":"nowrap","overflow":"hidden","textOverflow":"ellipsis","maxWidth":"5rem"}},{"id":"stock-price","type":"text","textBinding":"item.priceText","styleBinding":{"color":"item.percentColor"},"style":{"fontSize":"0.8rem","marginLeft":"auto"}},{"id":"stock-percent","type":"text","textBinding":"item.percent","styleBinding":{"color":"item.percentColor"},"style":{"fontSize":"0.7rem","opacity":0.8}}]},{"id":"stock-chart-row","type":"div","style":{"display":"flex","alignItems":"center","height":"2rem","marginTop":"0.25rem"},"children":[{"id":"stock-chart","type":"svg","style":{"width":"100%","height":"100%","overflow":"visible"},"props":{"viewBox":"0 0 100 30","preserveAspectRatio":"none"},"children":[{"id":"chart-area","type":"path","style":{"stroke":"none","opacity":0.2,"transition":"d 0.3s ease"},"styleBinding":{"fill":"item.percentColor"},"propsBinding":{"d":"item.areaPath"}},{"id":"chart-line","type":"path","style":{"fill":"none","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","vectorEffect":"non-scaling-stroke","transition":"d 0.3s ease"},"styleBinding":{"stroke":"item.percentColor"},"propsBinding":{"d":"item.linePath"}}]}]},{"id":"holding-i