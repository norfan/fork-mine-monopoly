ˆå¼€å§‹æ—¶"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<ICommandMap, \"player.round.start\">, ctx: ICommandContext<ICommandMap, \"player.round.start\">) => {\n    const result = await gameProcess.peekStockTrend(player.id, {\n        title: 'å†…å¹•æ¶ˆæ¯ - é€‰æ‹©è¦æŸ¥çœ‹çš„è‚¡ç¥¨',\n        cancelText: 'ä¸æŸ¥çœ‹',\n        column: 3\n    });\n    if (!result) {\n        ctx.skip();\n        return;\n    }\n    gameProcess.messageNotify([player.id], {\n        type: 'info',\n        content: 'ã€å†…å¹•æ¶ˆæ¯ã€‘' + result.stockName + ' æœºå¯†è¯„çº§ï¼š' + result.rating\n    });\n});"},{"id":"mod-wxmbrr","name":"ã€è§’è‰²æŠ€èƒ½ã€‘æ‹†è¿","slug":"demolition","descriptor":{"autoConsume":false,"commandType":"property.arrived","meta":{"description":"ä»˜è¿‡è·¯è´¹æ—¶ï¼Œå¯é€‰æ‹©æ”¯ä»˜åŒå€è´¹ç”¨ä½¿è¯¥åœ°äº§é™ 1 çº§","name":"æ‹†è¿","source":"è§’è‰²æŠ€èƒ½","tags":["property"],"triggerTiming":"åˆ°è¾¾åœ°äº§å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n  const arrived = cmd.payload.arrivedPlayer;\n  const owner = property.owner;\n  const toll = cmd.payload.toll;\n\n  // åŸºæœ¬æ£€æŸ¥\n  if (!owner || arrived.id === owner.id || !toll || toll <= 0) {\n    ctx.skip();\n    return;\n  }\n\n  const player = gameProcess.players.get(arrived.id);\n  if (!player) {\n    ctx.skip();\n    return;\n  }\n\n  // ã€ç©å®¶é™åˆ¶ã€‘åªæœ‰ç‰¹å®šçš„ä¿®ç‹—ç©å®¶æ‰èƒ½è§¦å‘ï¼ˆé¿å…å¤šä¸ªä¿®ç‹—ç©å®¶å†²çªï¼‰\n  if (ctx.modifierData?.playerId !== arrived.id) {\n    ctx.skip();\n    return;\n  }\n\n  // ã€ç©å®¶é€‰æ‹©ã€‘è¯¢é—®æ˜¯å¦å‘åŠ¨æŠ€èƒ½\n  const confirmResult = await gameProcess.showConfirmDialog(player.id, {\n    title: \"ä¿®ç‹—æŠ€èƒ½ - æ‹†è¿\",\n    content: `è¦æ”¯ä»˜åŒå€è¿‡è·¯è´¹ï¼ˆï¿¥${toll * 2}ï¼‰ä½¿ ${property.name} é™ä¸€çº§å—ï¼Ÿ`,\n  });\n\n  if (!confirmResult.confirm) {\n    ctx.skip();\n    return;\n  }\n\n  // æ‰§è¡Œæ‹†è¿é€»è¾‘\n  const doubleToll = toll * 2;\n  const costRes = await player.cost(doubleToll, MoneyTag.PLAYER, owner);\n  if (costRes.actualCost >= doubleToll) {\n    await property.levelDown();\n    gameProcess.msgNotifyBroadcast(\"info\",\n      `${player.name} å‘åŠ¨æ‹†è¿ï¼é¢å¤–æ”¯ä»˜ ï¿¥${costRes.actualCost}ï¼Œ${property.name} é™ä¸º Lv.${property.level}`\n    );\n  }\n});"},{"id":"mod-y45l0f","name":"ã€æœºä¼šå¡ã€‘éª°å­ç¨","slug":"dice_tax","descriptor":{"autoConsume":true,"meta":{"description":"éª°å­ç¨ï¼šä¸‹ä¸€æ¬¡æ·éª°åï¼ŒæŒ‰æ€»ç‚¹æ•° Ã—200 ç¼´çº³ç½šé‡‘","name":"éª°å­ç¨","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.dice.roll","remainingTriggers":1,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const diceResults = ctx.result && (ctx.result as any).diceResult;\n    if (Array.isArray(diceResults)) {\n        const total = diceResults.reduce((sum: number, d: any) => sum + d.result, 0);\n        const rate = 200;\n        const tax = total * rate;\n        const sourcePlayer = gameProcess.players.get(player.diceTaxSource || '');\n        const costRes = await player.cost(tax, 'CARD', sourcePlayer);\n        if (sourcePlayer) await sourcePlayer.gain(costRes.actualCost, 'CARD', player);\n        gameProcess.msgNotifyBroadcast('warning', `${player.name} è¢«å¾æ”¶éª°å­ç¨ ${costRes.actualCost} å—é’±ï¼ˆ${total}ç‚¹x${rate}ï¼‰ï¼`);\n    }\n});"},{"id":"mod-y9h3d8","name":"ã€æœºä¼šå¡ã€‘æ³¡æ²«ç»æµ","slug":"foam_economy","descriptor":{"autoConsume":true,"commandType":"player.round.end","meta":{"description":"æ³¡æ²«ç»æµï¼šè‡ªå·±çš„åœ°äº§è¿‡è·¯è´¹ç¿»å€æ”¶å–ï¼ŒæŒç»­ 3 å›åˆï¼Œåˆ°æœŸæ—¶æœ€é«˜åœ°äº§é™ 1 çº§","name":"æ³¡æ²«ç»æµ","source":"æœºä¼šå¡","tags":["property","buff"]},"priority":0,"remainingTriggers":3,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n  // å›åˆè®¡æ•° +1\n  player.foamEconomyRound = (player.foamEconomyRound || 0) + 1;\n\n  // æ£€æŸ¥æ˜¯å¦è¾¾åˆ°3å›åˆ\n  if (player.foamEconomyRound >= 3) {\n    // æ¸…é™¤æ³¡æ²«ç»æµçŠ¶æ€\n    delete player.foamEconomyRound;\n\n    // æ¸…ç†æ‰€æœ‰åœ°çš®ä¸Šçš„ç¿»å€ä¿®é¥°å™¨ï¼ˆéå†å…¨éƒ¨åœ°çš®ï¼Œå› ä¸ºå¯èƒ½å·²å–æ‰éƒ¨åˆ†ï¼‰\n    for (const prop of gameProcess.properties.values()) {\n      prop.modifierManager.removeById($mod__foam_economy_double.id);\n    }\n\n    // æ‰€æœ‰å»ºç­‘é™1çº§\n    for (const prop of gameProcess.properties.values()) {\n      if (prop.owner && prop.owner.id === player.id && prop.level > 0) {\n        await prop.levelDown();\n      }\n    }\n\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n      title: 'æ³¡æ²«ç ´è£‚',\n      content: `<b><color:primary>${player.name}</color></b> çš„æ³¡æ²«ç»æµç ´è£‚ï¼Œæ‰€æœ‰å»ºç­‘é™äº†1çº§ï¼`,\n      duration: 3000\n    });\n  }\n})"},{"id":"mod-zcpvhq","name":"ã€æœºä¼šå¡ã€‘éª°å­å°å°","slug":"dice_seal","descriptor":{"autoConsume":true,"meta":{"description":"éª°å­å°å°ï¼šæ¥ä¸‹æ¥ 3 å›åˆæ¯æ¬¡åªèƒ½æ· 1 é¢—éª°å­ï¼Œåˆ°æœŸå½’è¿˜","name":"éª°å­å°å°","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.round.end","remainingTriggers":3,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n\n});"},{"id":"mod-zunfox","name":"ã€è§’è‰²æŠ€èƒ½ã€‘å‘½è¿æ“æ§","slug":"fate_controller","descriptor":{"autoConsume":false,"commandType":"player.dice.roll","meta":{"description":"æ¯æ¬¡æ·éª°å 50% æ¦‚ç‡è§¦å‘ï¼šå¯é€‰æ‹©ä¸€é¢—éª°å­é‡æ·å¹¶ç›´æ¥ä½¿ç”¨æ–°ç»“æœ","name":"å‘½è¿æ“æ§","source":"è§’è‰²æŠ€èƒ½","tags":["dice"],"triggerTiming":"æ·éª°å­å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const diceResult = (ctx.result as any)?.diceResult;\n    if (!diceResult || diceResult.length === 0) {\n        ctx.skip();\n        return;\n    }\n    if (Math.random() >= 0.5) {\n        ctx.skip();\n        return;\n    }\n    gameProcess.setCurrentEventName(`${player.name} æ­£åœ¨ä½¿ç”¨ â€œå‘½è¿æ“æ§â€`)\n    const items = diceResult.map((r: any, i: number) => ({\n        id: String(i),\n        display: {\n            id: \"dice-card-\" + i,\n            type: \"div\" as const,\n            variable: { diceIndex: i + 1, diceValue: r.result },\n            children: [$ui__dice_select_card]\n        }\n    }));\n    const { selected } = await gameProcess.showItemSelectDialog(player.id, {\n        title: \"å‘½è¿æ“æ§ - é€‰æ‹©è¦é‡æ·çš„éª°å­\",\n        itemList: items,\n        cancelText: \"ä¸ä½¿ç”¨\"\n    });\n    if (selected.length === 0) {\n        ctx.skip();\n        return;\n    }\n    const idx = Number(selected[0]);\n    const oldResult = diceResult[idx].result;\n    const newResult = (cmd.payload as any).dices[idx].roll();\n    const modified = diceResult.slice();\n    modified[idx] = newResult;\n\n    gameProcess.setCurrentEventName(`${player.name} æ­£åœ¨é‡æ·éª°å­`);\n    gameProcess.gameBroadcast({\n        type: SocketMsgType.RollDiceResult,\n        source: SocketMsgSource.Server,\n        data: {\n            rollDiceResult: [newResult],\n            rollDicePlayerId: player.id\n        },\n        msg: {\n            type: \"info\",\n            content: `${player.name} å‘åŠ¨å‘½è¿æ“æ§ï¼é‡æ·éª°å­${idx + 1}`\n        }\n    });\n    await new Promise((resolve) => setTimeout(resolve, 3000));\n\n    ctx.setResult({ diceResult: modified });\n    gameProcess.msgNotifyBroadcast('warning',\n        `${player.name} å‘åŠ¨å‘½è¿æ“æ§ï¼éª°å­${idx + 1}: ${oldResult} â†’ ${newResult.result}`);\n});"}],"customUIs":[{"id":"custom-ui-4h7odi","name":"è‚¡å¸‚ä¿¡æ¯å±•ç¤ºUI","layout":{"x":0,"y":1,"width":8,"height":6},"uiSchema":"ui-template-vojbrs"},{"id":"custom-ui-a1il6i","name":"æ—¥æœŸ","layout":{"x":0,"y":0,"width":8,"height":1},"uiSchema":"ui-template-azqfcc"}],"gameSettingForm":[{"id":"form-field-p5wzoc","key":"targetMoney","type":"number-input","label":"èƒœåˆ©åˆ¤å®šé‡‘é’±","defaultValue":50000,"min":0},{"id":"gs-1u11w0","key":"inflationCycle","type":"number-input","label":"é€šè´§è†¨èƒ€å‘¨æœŸï¼ˆå‘¨ï¼‰","defaultValue":"1","min":1,"max":52},{"id":"gs-ocbji9","key":"turnTimeout","type":"number-input","label":"å›åˆå€’è®¡æ—¶(ç§’)","defaultValue":30,"min":5,"max":120,"builtIn":true},{"id":"initMoney","key":"initMoney","type":"number-input","label":"åˆå§‹é‡‘é’±","defaultValue":15000,"min":0,"builtIn":true}],"extraLibs":"/** \n * ç©å®¶å‘½ä»¤å†…å®¹æ‹“å±•\n */\ninterface PlayerCommandMap {\n    \n}\n\n/** \n * IPlayer(ç©å®¶) è‡ªå®šä¹‰å†…å®¹æ‹“å±•\n */\ninterface IPlayer {\n    // è¡ŒåŠ¨åŠ›\n    ap: number;\n    totalAp: number;\n\n    // è“„æ°”æŠ€èƒ½è®¡æ•°\n    pufferTollCount?: number;\n\n    // æ³¡æ²«ç»æµå›åˆè®¡æ•°\n    foamEconomyRound?: number;\n\n    // å‘½è¿éª°å’’æ•°æ®\n    diceCurse?: { rolls: number[], resolved: boolean };\n\n    // éª°å­ç¨æ¥æºç©å®¶ID\n    diceTaxSource?: string;\n\n    // æ—¶é—´å€’æµä¿å­˜çš„ä½ç½®\n    timeReversalPosition?: number;\n\n    // éª°å­å°å°æ•°æ®\n    diceSeal?: { remainingRounds: number, removedDices: IDice[] };\n\n    // è”ç›ŸçŠ¶æ€ï¼ˆç®€åŒ–ç‰ˆï¼Œç›´æ¥ç»‘å®šåœ¨ç©å®¶èº«ä¸Šï¼‰\n    allianceWith?: {\n        allyId: string;          // ç›Ÿå‹çš„ç©å®¶ID\n        remainingTimes: number; // å‰©ä½™å…å•æ¬¡æ•°\n    };\n\n    /**\n     * æœ¬å›åˆæ·éª°ç»“æœ\n     * ç”¨äºèµ·ç‚¹å¥–é‡‘ç­‰éœ€è¦è®¿é—®éª°å­ç»“æœçš„æœºåˆ¶\n     */\n    lastDiceRollResults?: DiceResult[];\n\n    // ç§»åŠ¨å‰ä¸Šä¸€æ¬¡çš„mapItemId\n    lastPositionId: string;\n}\n\n/** \n * IProperty(åœ°äº§) è‡ªå®šä¹‰å†…å®¹æ‹“å±•\n */\ninterface IProperty {\n    // åœ°é“ç«™\n    busCost: number;\n\n    //å…¬å¸\n    company: string;\n\n    // åœ°é“ç«™åç§°\n    name: string;\n\n    // åŸå§‹è¿‡è·¯è´¹åˆ—è¡¨ï¼ˆç”¨äºé€šèƒ€ç³»ç»Ÿï¼‰\n    baseCostList?: number[];\n\n    // è”ç›ŸçŠ¶æ€ï¼ˆæ—§ç‰ˆï¼Œç”¨äºå‘åå…¼å®¹ï¼‰\n    allianceState?: AllianceState;\n}\n\n/**\n * è”ç›ŸçŠ¶æ€æ¥å£ï¼ˆæ—§ç‰ˆï¼Œç”¨äºå‘åå…¼å®¹ï¼‰\n */\ninterface AllianceState {\n    srcId: string;\n    tgtId: string;\n    srcToTarget: number;\n    targetToSrc: number;\n    srcBuffId: string;\n    tgtBuffId: string;\n}\n\n/** \n * IGameProcess(æ¸¸æˆè¿›ç¨‹) è‡ªå®šä¹‰å†…å®¹æ‹“å±•\n */\ninterface IGameProcessCustomFields {\n    stockMarket: IStockMarketManager;\n    lotteryManager: ILotteryManager;\n    dateManager: IDateManager;\n\n    handleBuyLottery: (player: IPlayer, lottery: number[]) => Promise<void>;\n\n    /**\n     * çª¥æ¢è‚¡ç¥¨è¶‹åŠ¿ï¼ˆå‚è€ƒ\"å†…å¹•äº¤æ˜“\"æœºä¼šå¡ï¼‰\n     * ä½¿ç”¨ $ui__stock_preview å¯ŒUIå±•ç¤ºè‚¡ç¥¨èµ°åŠ¿å›¾ + æœºå¯†è¯„çº§\n     * @param playerId ç©å®¶ID\n     * @param options.title å¯¹è¯æ¡†æ ‡é¢˜\n     * @param options.content å¯¹è¯æ¡†æè¿°\n     * @param options.cancelText å–æ¶ˆæŒ‰é’®æ–‡æœ¬\n     * @param options.column åˆ—æ•°\n     * @returns é€‰ä¸­è‚¡ç¥¨çš„è¶‹åŠ¿ä¿¡æ¯ï¼Œä¼‘å¸‚æˆ–å–æ¶ˆæ—¶è¿”å›null\n     */\n    peekStockTrend: (playerId: string, options?: {\n        title?: string;\n        content?: string;\n        cancelText?: string;\n        column?: number;\n    }) => Promise<StockTrendPeekResult | null>;\n\n    inflationRate: number;\n    inflationHistory: Array<{ week: number, rate: number, avg: number }>;\n\n    /**\n     * é€†è¡Œè€…çŠ¶æ€è®°å½•\n     * hasCompletedFirstLap: æ˜¯å¦å·²å®Œæˆç¬¬ä¸€åœˆï¼ˆç¬¬ä¸€åœˆä¸é¢†å·¥èµ„ï¼‰\n     * lap2: æ˜¯å¦å·²è¿›å…¥ç¬¬äºŒåœˆï¼ˆç¬¬äºŒåœˆè·å¾—2500è¡¥å¿ï¼‰\n     * lap3: æ˜¯å¦å·²è¿›å…¥ç¬¬ä¸‰åœˆï¼ˆç¬¬ä¸‰åœˆåŠä»¥åè·å¾—3000è¡¥å¿ï¼‰\n     */\n    reverseWalkers: Record<string, { \n        hasCompletedFirstLap: boolean; \n        lap2?: boolean;\n        lap3?: boolean;\n    }>;\n\n    /** ä¼ é€’ç»™å®¢æˆ·ç«¯çš„å¯¼å‡ºæ•°æ® */\n    exportData: IGameProcessExportData;\n}\n\n/** \n * IGameProcess(æ¸¸æˆè¿›ç¨‹) ä¼ é€’ç»™å®¢æˆ·ç«¯çš„æ•°æ®æ‹“å±•\n */\ninterface IGameProcessExportData {\n    stockMarket: StockMarketData;\n    date: string;\n    inflation: {\n        rate: number;\n        week: number;\n        nextInflationDays: number;\n    };\n}\n\n/**\n * è‚¡ç¥¨è¶‹åŠ¿çª¥æ¢ç»“æœ\n */\ninterface StockTrendPeekResult {\n    stockId: string;\n    stockName: string;\n    price: number;\n    changeRate: number;\n    trendValue: number;\n    heatValue: number;\n    /** æœºå¯†è¯„çº§ï¼šå¤¯çˆ†äº†/é¡¶çº§/äººä¸Šäºº/NPC/æ‹‰å®Œäº† */\n    rating: string;\n}\n\n// ========================\n// è‚¡å¸‚ç³»ç»Ÿ\n// ========================\n\n/**\n * è‚¡ç¥¨é…ç½®æ¥å£\n */\ninterface StockConfig {\n    id: string;\n    name: string;\n    price?: number;\n    color?: string;\n    basePrice?: number;\n    volatility?: number;\n    trendSpeed?: number;\n    initialTrend?: number;\n    liquidity?: number;\n}\n\ninterface StockDisplay {\n    color: string;\n    linePath: string;\n    areaPath: string;\n    price: string;\n    percent: string;\n}\n\ninterface Stock {\n    id: string;\n    name: string;\n    color: string;\n    price: number;\n    basePrice: number;\n    changeRate: number;\n    history: number[];\n    trend: number;\n    volatility: number;\n    trendSpeed: number;\n    liquidity: number;\n    heat: number;\n    display: StockDisplay;\n}\n\ninterface TradeCheckResult {\n    ok: boolean;\n    msg?: string;\n}\n\ninterface TradeReceipt {\n    stockName: string;\n    price: number;\n    amount: number;\n    totalCost: number;\n}\n\ninterface StockMarketData {\n    isOpen: boolean;\n    stocks: Stock[];\n    portfolios: Record<string, Record<string, number>>;\n    marketTrend: number;\n    volatilityMultiplier: number;\n    tick: number;\n}\n\ninterface IStockMarketManager {\n    readonly data: StockMarketData;\n    getExportData(): StockMarketData;\n    init(configs: StockConfig[]): void;\n    addStock(config: StockConfig): Stock | null;\n    getTaxRate(isBuy: boolean): number;\n    getStock(stockId: string): Stock | undefined;\n    getHolding(playerId: string, stockId: string): number;\n    getPlayerHoldingStock(playerId: string): { stock: Stock, holding: number }[];\n    getTransactionCost(stockId: string, amount: number): number;\n    canTrade(playerId: string, stockId: string, amount: number, isBuy: boolean): TradeCheckResult;\n    commitBuy(playerId: string, stockId: string, amount: number): TradeReceipt | null;\n    commitSell(playerId: string, stockId: string, amount: number): TradeReceipt | null;\n    triggerEvent(stockId: string, type: 'RENT' | 'BUILD' | 'RANDOM', intensity?: number): void;\n    tick(): void;\n    setMarketTrend(value: number): void;\n}\n\n// ========================\n// å½©ç¥¨ç³»ç»Ÿ\n// ========================\n\ninterface ILotteryManager {\n    stock: number[];\n    playerStock: Map<string, { player: IPlayer, stock: number[] }>\n    price: number;\n    jackpot: number;\n    currentJackpot: number;\n    resetStock(stockSize: number): void;\n    buyLottery(player: IPlayer, lottery: number[]): Promise<void>;\n    draw(): JackpotResult;\n}\n\ninterface JackpotResult {\n    lottery: number[];\n    jackpotPlayers: { player: IPlayer; jackpot: number[]; }[];\n    currentJackpot: number;\n}\n\n// ========================\n// æ—¥æœŸç³»ç»Ÿ\n// ========================\n\nenum WeekDay {\n    Sunday = 0,\n    Monday = 1,\n    Tuesday = 2,\n    Wednesday = 3,\n    Thursday = 4,\n    Friday = 5,\n    Saturday = 6\n}\n\ninterface IDateManager {\n    currentTurn: number;\n    readonly startDay: WeekDay;\n    getCurrentDay(): WeekDay;\n    getCurrentDayName(): string;\n    getDayByTurn(turn: number): WeekDay;\n    getDayNumber(): number;\n    getWeekNumber(): number;\n    advanceTurn(count?: number): void;\n    resetTurn(): void;\n    format(template?: string): string;\n}","startMapItemId":"mi-dz-o00"}É¨
