ourcePlayer.modifierManager.add($mod__compound_interest_boost);\n    sourcePlayer.modifierManager.add($mod__compound_interest_cleanup, async () => {\n        sourcePlayer.modifierManager.removeById(modId);\n        gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} çš„å¤åˆ©æ•ˆåº”å·²ç»“æŸï¼`);\n    });\n})"},{"id":"card-e360xf","name":"ç´§æ€¥æŠ›å”®","type":"ToSelf","description":"é€‰æ‹©ä¸€å¼ è‚¡ç¥¨ï¼Œå°†è‡ªå·±çš„ä»½é¢å…¨éƒ¨å–å‡º","color":"#d4b440","iconId":"image-tdfah0","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const holdings = gameProcess.stockMarket.getPlayerHoldingStock(sourcePlayer.id);\n    const active = holdings.filter(h => h.holding > 0); if (active.length === 0) {\n        throw new Error(\"æ²¡æœ‰ä»»ä½•æŒä»“ï¼Œæ— æ³•æ‰§è¡Œç´§æ€¥æŠ›å”®\");\n    }\n    const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"ç´§æ€¥æŠ›å”®\",\n        content: \"é€‰æ‹©è¦æ¸…ä»“çš„è‚¡ç¥¨ï¼ˆä»¥å½“å‰å¸‚ä»·å–å‡ºï¼Œæ‰£é™¤1%æ‰‹ç»­è´¹ï¼‰\",\n        itemList: active.map(h => ({\n            id: h.stock.id,\n            display: `${h.stock.name}  æŒä»“:${h.holding}è‚¡  ç°ä»·:ï¿¥${h.stock.price.toFixed(1)}`\n        }))\n    });\n    if (!result.selected.length) return;\n    const stockId = result.selected[0];\n    const amount = gameProcess.stockMarket.getHolding(sourcePlayer.id, stockId);\n    const receipt = gameProcess.stockMarket.commitSell(sourcePlayer.id, stockId, amount);\n    if (!receipt) return;\n    await sourcePlayer.gain(receipt.totalCost, 'stock_sell');\n    gameProcess.msgNotifyBroadcast(\"warning\", `${sourcePlayer.name} ç´§æ€¥æŠ›å”®äº† ${receipt.amount}è‚¡\n  ${receipt.stockName}ï¼Œå›æ”¶ ï¿¥${receipt.totalCost.toFixed(0)}`);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"ç´§æ€¥æŠ›å”®\",\n        content: `<color:primary>${sourcePlayer.name}</color> ç´§æ€¥æ¸…ä»“<br><b>${receipt.stockName}</b>\n  ${receipt.amount}è‚¡ Ã— ï¿¥${receipt.price.toFixed(1)}<br>æ‰‹ç»­è´¹æ‰£é™¤ååˆ°è´¦\n  <color:gold><b>ï¿¥${receipt.totalCost.toFixed(0)}</b></color>`,\n        duration: 3000\n    });\n})"},{"id":"card-ebstji","name":"é­”æ³•éª°å­","color":"#bd14a7","description":"ä½ å¯ä»¥å†³å®šç›®æ ‡ç©å®¶æ‰€æœ‰éª°å­ä¸‹ä¸€æ¬¡æ·å‡ºçš„ç‚¹æ•°","type":"ToPlayer","iconId":"image-gvgzzn","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    for (let i = 0; i < target.dices.length; i++) {\n        const dice = target.dices[i];\n        const res = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n            title: `çŒé“…éª°å­: é€‰æ‹©ç¬¬ ${i + 1} ä¸ªéª°å­`,\n            content: ``,\n            itemList: dice.diceValues.map(v => ({\n                id: `${v}`,\n                display: `${v}`,\n            }))\n        })\n        dice.setProphecy(Number(res.selected[0]));\n    }\n});"},{"id":"card-efdbcc64-fd07-4cff-b93e-6dc8e03a5a33","name":"éª°å­ç¨","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶ä¸‹æ¬¡æ·éª°éœ€æ”¯ä»˜ç‚¹æ•°x200çš„ç¨","color":"#ff5722","iconId":"image-smf2t5","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    target.diceTaxSource = sourcePlayer.id;\n    target.modifierManager.add($mod__dice_tax);\n})"},{"id":"card-f30c6c03-c51f-4173-a650-1e7c967b5632","name":"ä¸¤æåè½¬","type":"ToSelf","description":"æ‰€æœ‰å…¶ä»–ç©å®¶ä¸‹ä¸€å›åˆå€’ç€èµ°è·¯","color":"#e91e63","iconId":"image-wnq9gi","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const targets = Array.from(gameProcess.players.values()).filter(p => p.id !== sourcePlayer.id);\n    for (const t of targets) {\n        t.modifierManager.add($mod__reverse_walk);\n    }\n    const playerIds = Array.from(gameProcess.players.keys());\n    await gameProcess.showMessageCard(playerIds, {\n        title: 'åå‘è¡Œèµ°',\n        content: targets.map(function (t) { return '<b>' + t.name + '</b>è¢«æ–½åŠ äº†<color:red><b>åå‘è¡Œèµ°</b></color>ï¼<br>ä¸‹ä¸€å›åˆå°†å€’ç€èµ°è·¯'; }).join('<br>'),\n        duration: 3000\n    });\n})"},{"id":"card-f447e767-551f-4ca8-a082-6351c2b4603d","name":"åŠ«å¯Œæµè´«","type":"ToSelf","description":"ä»é‡‘é’±æœ€å¤šçš„ç©å®¶æ‰‹ä¸­å¤ºå– 10% ç°é‡‘ï¼Œåˆ†ç»™é‡‘é’±æœ€å°‘çš„ç©å®¶","color":"#e86d26","iconId":"image-l9mbc1","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const allPlayers = Array.from(gameProcess.players.values()).filter(p => !p.isBankrupted);\n    allPlayers.sort((a, b) => a.money - b.money);\n    const poorest = allPlayers[0];\n    const richest = allPlayers[allPlayers.length - 1];\n    if (poorest === richest) return;\n    const stealAmount = Math.floor(richest.money * 0.1);\n    if (stealAmount <= 0) return;\n    const costRes = await richest.cost(stealAmount, MoneyTag.CARD, poorest);\n    await poorest.gain(costRes.actualCost, MoneyTag.CARD, richest);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: 'åŠ«å¯Œæµè´«',\n        content: `ä»<color:gold><b>${richest.name}</b></color>å¤„å¤ºå–äº†<color:red><b>${costRes.actualCost}</b></color>ï¿¥\\n  <br>èµ äºˆ<color:green><b>${poorest.name}</b></color>`,\n        duration: 3000\n    });\n})"},{"id":"card-fbj2cq","name":"å†…å¹•äº¤æ˜“","type":"ToSelf","description":"çª¥æ¢æ‰€æœ‰è‚¡ç¥¨çš„å†…éƒ¨è¶‹åŠ¿ï¼Œç„¶åé€‰æ‹©ä¸€æ”¯ç§˜å¯†è´­ä¹° 10 è‚¡","color":"#11a5d5","iconId":"image-5w3awq","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const buyAmount = 10;\n    const peekResult = await gameProcess.peekStockTrend(sourcePlayer.id, {\n        title: \"æœºå¯†æƒ…æŠ¥\",\n        content: \"ä½ é€šè¿‡ç‰¹æ®Šæ¸ é“è·å–äº†è‚¡å¸‚å†…å¹•ï¼Œé€‰æ‹©ä¸€åªè‚¡ç¥¨ç§˜å¯†ä¹°å…¥<b>10è‚¡</b>\",\n        cancelText: \"å–æ¶ˆ\",\n        column: 3\n    });\n    if (!peekResult) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"å†…å¹•äº¤æ˜“\",\n            content: \"è‚¡å¸‚ä¼‘å¸‚ä¸­ï¼Œæƒ…æŠ¥é€šé“æš‚æ—¶å…³é—­â€¦â€¦\",\n            duration: 3000\n        });\n        return;\n    }\n\n    const sm = gameProcess.stockMarket;\n    const totalCost = sm.getTransactionCost(peekResult.stockId, buyAmount);\n    const check = sm.canTrade(sourcePlayer.id, peekResult.stockId, buyAmount, true);\n    if (!check.ok) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"äº¤æ˜“å¤±è´¥\",\n            content: check.msg || \"å½“å‰æ— æ³•äº¤æ˜“\",\n            duration: 3000\n        });\n        return;\n    }\n\n    if (sourcePlayer.money < totalCost) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"èµ„é‡‘ä¸è¶³\",\n            content: \"ä¹°å…¥\" + peekResult.stockName + \"éœ€èŠ±è´¹ <color:red>$\" + totalCost + \"</color>ï¼Œä½ çš„ä½™é¢ä¸è¶³ã€‚\",\n            duration: 3000\n        });\n        return;\n    }\n\n    await sourcePlayer.cost(totalCost, MoneyTag.CARD);\n    const receipt = sm.commitBuy(sourcePlayer.id, peekResult.stockId, buyAmount);\n    if (receipt) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"äº¤æ˜“å®Œæˆ\",\n            content: \"æˆåŠŸä¹°å…¥ <color:primary>\" + receipt.stockName + \"</color> Ã—\" + receipt.amount +\n                \"<br>æˆäº¤ä»·ï¼š$\" + receipt.price + \"/è‚¡<br>æ€»èŠ±è´¹ï¼š<color:red>$\" + receipt.totalCost + \"</color>\",\n            duration: 3000\n        });\n    }\n\n    gameProcess.msgNotifyBroadcast(\"info\", \"æœ‰ç¥ç§˜èµ„é‡‘æ‚„æ‚„å…¥åœºâ€¦â€¦\");\n})"},{"id":"card-fmcip7","name":"éšæœºä¼ é€","type":"ToOtherPlayer","description":"æ‰€æœ‰ç©å®¶è¢«éšæœºä¼ é€åˆ°åœ°å›¾ä¸Šçš„ä¸åŒä½ç½®","color":"#8B008B","iconId":"image-paifbh","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const allPlayers = Array.from(gameProcess.players.values()).filter((player) => !player.isBankrupted);\n  const pathMapItemIds = [...gameProcess.getPathMapItemIds()];\n\n  if (allPlayers.length < 2) {\n    throw new Error(\"åœºä¸Šç©å®¶ä¸è¶³\");\n  }\n  if (pathMapItemIds.length < allPlayers.length) {\n    throw new Error(\"åœ°å›¾è·¯å¾„èŠ‚ç‚¹ä¸è¶³ï¼Œæ— æ³•ä¸ºæ‰€æœ‰ç©å®¶åˆ†é…ä¸åŒä½ç½®\");\n  }\n\n  for (let cursor = pathMapItemIds.length - 1; cursor > 0; cursor -= 1) {\n    const swapCursor = Math.floor(Math.random() * (cursor + 1));\n    [pathMapItemIds[cursor], pathMapItemIds[swapCursor]] = [pathMapItemIds[swapCursor], pathMapItemIds[cursor]];\n  }\n\n  const destinationMapItemIds = pathMapItemIds.slice(0, allPlayers.length);\n  const fixedSlots = destinationMapItemIds\n    .map((mapItemId, slot) => mapItemId === allPlayers[slot].positionMapItemId ? slot : -1)\n    .filter((slot) => slot >= 0);\n\n  if (fixedSlots.length === 1) {\n    const fixedSlot = fixedSlots[0];\n    const swapSlot = fixedSlot === 0 ? 1 : 0;\n    [destinationMapItemIds[fixedSlot], destinationMapItemIds[swapSlot]] = [destinationMapItemIds[swapSlot], destinationMapItemIds[fixedSlot]];\n  } else if (fixedSlots.length > 1) {\n    const lastMapItemId = destinationMapItemIds[fixedSlots[fixedSlots.length - 1]];\n    for (let cursor = fixedSlots.length - 1; cursor > 0; cursor -= 1) {\n      destinationMapItemIds[fixedSlots[cursor]] = destinationMapItemIds[fixedSlots[cursor - 1]];\n    }\n    destinationMapItemIds[fixedSlots[0]] = lastMapItemId;\n  }\n\n  const details: string[] = [];\n  for (let slot = 0; slot < allPlayers.length; slot += 1) {\n    const player = allPlayers[slot];\n    const destinationMapItemId = destinationMapItemIds[slot];\n    await player.tpToMapItem(destinationMapItemId);\n    details.push(`${player.name}: ${destinationMapItemId}`);\n  }\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"éšæœºä¼ é€\",\n    content: `<b>éšæœºä¼ é€</b> å¯åŠ¨ï¼æ‰€æœ‰ç©å®¶è¢«ä¼ é€åˆ°éšæœºä½ç½®ï¼`,\n    duration: 5000\n  });\n});"},{"id":"card-fqxyvw","name":"å½©ç¥¨å¤§æ´¾é€","type":"ToSelf","description":"å…è´¹è·å¾— 3 å¼ å½©ç¥¨ï¼Œä¸èŠ±é’±ç›´æ¥å½•å…¥","color":"#f44336","iconId":"image-vw02qh","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const lm = gameProcess.lotteryManager;\n    if (lm.stock.length === 0) {\n        throw Error(\"å½©ç¥¨å·²å”®ç½„ï¼Œæ— æ³•é¢†å–\");\n    }\n    const count = Math.min(3, lm.stock.length);\n    const picked: number[] = [];\n    const stockCopy = [...lm.stock];\n    for (let i = 0; i < count; i++) {\n        const idx = Math.floor(Math.random() * stockCopy.length);\n        picked.push(stockCopy[idx]);\n        stockCopy.splice(idx, 1);\n    }\n    await lm.buyLottery(sourcePlayer, picked);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"å½©ç¥¨å¤§æ´¾é€\",\n        content: `${sourcePlayer.name} å…è´¹è·å¾—äº† <b>${count}</b> å¼ å½©ç¥¨ï¼<br><color:primary>${picked.join(\"ã€\")}</color>`,\n        duration: 3000\n    });\n})"},{"id":"card-ghue5b","name":"æ¶¨åœæ¿","type":"ToSelf","description":"æŒ‡å®šä¸€æ”¯è‚¡ç¥¨ç¬é—´æš´æ¶¨è‡³æ¶¨åœä»·ï¼Œå¤¯çˆ†äº†","color":"#ba182a","iconId":"image-ryox2u","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const stockMarket = gameProcess.stockMarket;\n\n  // æ„å»ºè‚¡ç¥¨é€‰æ‹©åˆ—è¡¨\n  const items = stockMarket.data.stocks.map((stock) => ({\n    id: stock.id,\n    display: {\n      id: \"stock-\" + stock.id,\n      type: \"div\" as const,\n      style: { background: '#ffffff', borderRadius: '1rem' },\n      variable: {\n        stockName: stock.name,\n        stockColor: stock.color,\n        areaColor: stock.display.color,\n        areaPath: stock.display.areaPath,\n        linePath: stock.display.linePath,\n        price: stock.display.price,\n        percent: stock.display.percent,\n      },\n      children: [\n        $ui__stock_preview\n      ]\n    }\n  }));\n\n  // å¼¹å‡ºé€‰æ‹©å¯¹è¯æ¡†\n  const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n    title: \"é€‰æ‹©æ¶¨åœç›®æ ‡\",\n    content: \"é€‰æ‹©ä¸€æ”¯è‚¡ç¥¨ä½¿å…¶æ¶¨åœï¼\",\n    itemList: items\n  });\n\n  if (!result.selected.length) return;\n\n  const stockId = result.selected[0];\n  const stock = stockMarket.getStock(stockId);\n  if (!stock) return;\n\n  // æ¶¨åœæ•ˆæœï¼šæ‹‰æ»¡çƒ­åº¦ + å¼ºè¶‹åŠ¿ + BUILDäº‹ä»¶å†²å‡»\n  stock.heat = 5;\n  stock.trend = 0.95;\n  stockMarket.triggerEvent(stockId, \"BUILD\", 3);\n\n  // å…¨å±€å¹¿æ’­\n  gameProcess.msgNotifyBroadcast(\"success\", `${sourcePlayer.name} å¼•çˆ†äº† ${stock.name}ï¼Œç›´æ¥æ¶¨åœï¼`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"æ¶¨åœæ¿\",\n    content: `<b><color:red>${stock.name}</color></b> è¢«æ‹‰å‡è‡³æ¶¨åœï¼<br>å½“å‰ä»·æ ¼ï¼š<b>Â¥${stock.price.toFixed(1)\n      }</b><br><color:primary>å¸‚åœºçƒ­åº¦é£™å‡ï¼Œåç»­æ³¢åŠ¨å°†åŠ å‰§</color>`,\n    duration: 3000\n  });\n})"},{"id":"card-jn5s7n","name":"å‘½è¿éª°å’’","color":"#9c27b0","description":"è®°å½•ç›®æ ‡ç©å®¶æ¥ä¸‹æ¥3æ¬¡æ·éª°çš„æ€»ç‚¹æ•°ï¼Œ3æ¬¡åæŒ‰æ€»ç‚¹æ•°*10æ‰£é™¤é‡‘é’±","type":"ToOtherPlayer","iconId":"image-s6gxv7","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const targetPlayer = target;\n  targetPlayer.diceCurse = { rolls: [], resolved: false };\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å¯¹ ${targetPlayer.name} æ–½æ”¾äº†å‘½è¿éª°å’’ï¼è®°å½•æ¥ä¸‹æ¥ 3 æ¬¡æ·éª°...`);\n  targetPlayer.modifierManager.add($mod__dice_curse);\n})"},{"id":"card-kfyl5m","name":"æ—¶é—´å€’æµ","type":"ToSelf","description":"å›åˆç»“æŸæ—¶è¿”å›åˆ°å½“å‰ä½ç½®ï¼ˆè§¦å‘åˆ°è¾¾æ•ˆæœï¼‰","color":"#5a79d8","iconId":"image-yl0121","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const sourcePlayerState = sourcePlayer as IPlayer & { timeReversalMapItemId?: string };\n  const currentMapItemId = sourcePlayer.positionMapItemId;\n  if (!currentMapItemId || !gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === currentMapItemId)) {\n    throw new Error(\"æ— æ³•ä¿å­˜å½“å‰ MapPath åœ°å›¾é¡¹ä½ç½®\");\n  }\n  sourcePlayerState.timeReversalMapItemId = currentMapItemId;\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å‘åŠ¨äº†æ—¶é—´å€’æµï¼`);\n  sourcePlayer.modifierManager.add($mod__time_reversal);\n})"},{"id":"card-mod-coma","name":"å¤§ç¡ä¸€è§‰","type":"ToOtherPlayer","description":"é€‰æ‹©ä¸€åç©å®¶åŸåœ°ä¼‘æ•´ï¼Œåœæ­¢è¡ŒåŠ¨ 2 å›åˆã€‚","color":"#8E44AD","iconId":"image-mod-coma","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  await target.setStop(target.stop + 2);\n  gameProcess.msgNotifyBroadcast(\"info\", target.name + \" è¢« \" + sourcePlayer.name + \" å‚¬çœ äº†ï¼Œä¸€è§‰ç¡è¿‡å¤´ï¼Œåœæ­¢è¡ŒåŠ¨ 2 å›åˆï¼\");\n  gameProcess.gameLogBroadcast(target.name + \" åœæ­¢è¡ŒåŠ¨ 2 å›åˆï¼ˆå¤§ç¡ä¸€è§‰ï¼‰\");\n})"},{"id":"card-mod-nap","name":"å°ç¡ä¸€ä¸‹","type":"ToOtherPlayer","description":"é€‰æ‹©ä¸€åç©å®¶åŸåœ°ä¼‘æ•´ï¼Œåœæ­¢è¡ŒåŠ¨ 1 å›åˆã€‚","color":"#5B8DEF","iconId":"image-mod-nap","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  await target.setStop(target.stop + 1);\n  gameProcess.msgNotifyBroadcast(\"info\", target.name + \" è¢« \" + sourcePlayer.name + \" å“„ç¡ç€äº†ï¼ŒåŸåœ°ä¼‘æ•´ 1 å›åˆï½\");\n  gameProcess.gameLogBroadcast(target.name + \" åœæ­¢è¡ŒåŠ¨ 1 å›åˆï¼ˆå°ç¡ä¸€ä¸‹ï¼‰\");\n})"},{"id":"card-mod-wizard","name":"é­”æ³•å¸ˆ","type":"ToOtherPlayer","description":"å¬å”¤ä¸€é“é—ªç”µå‡»ä¸­ç›®æ ‡ç©å®¶ï¼Œå°†å…¶ä¼ é€è‡³åŒ»é™¢åœ°å—ï¼Œå¹¶è§¦å‘åŒ»é™¢åœ°å—çš„ç‰¹æ®Šæ•ˆæœã€‚","color":"#F1C40F","iconId":"image-mod-wizard","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const hospital = gameProcess.mapData.mapItems.find((i: any) => i.mapEventId === \"event-mod-hospital\");\n  if (!hospital) throw Error(\"æ‰¾ä¸åˆ°åŒ»é™¢åœ°å—\");\n  gameProcess.msgNotifyBroadcast(\"warning\", sourcePlayer.name + \" å¬å”¤ä¸€é“é—ªç”µåŠˆä¸­äº† \" + target.name + \"ï¼\");\n  await target.tpToMapItem(hospital.id);\n  await gameProcess.handleArriveEvent(target); // è§¦å‘åŒ»é™¢åœ°å—ç‰¹æ®Šæ•ˆæœï¼ˆå¤©é™æ¨ªç¥¸ï¼šä½é™¢+ä½é™¢è´¹ï¼‰\n  gameProcess.gameDataBroadcast();\n})"},{"id":"card-mwzb3g","name":"æŠ¢åœ°","color":"#7a5549","description":"é€‰æ‹©ä¸€åç©å®¶è¿›è¡Œéª°å­å†³æ–—ï¼Œå½“ä½ è·èƒœåå¯ä»¥éšæœºè·å¾—å¯¹æ–¹çš„ä¸€å—åœ°çš®","type":"ToOtherPlayer","iconId":"image-jtebwk","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  function colorfulName(p: IPlayer) {\n    return `<color:${p.getUser().color}>${p.name}</color>`;\n  }\n\n  const targetPlayer = target;\n  if (targetPlayer.properties.length === 0) {\n    throw Error(\"ç›®æ ‡æ²¡æœ‰åœ°çš®ï¼Œæ”¾è¿‡TAå§\");\n  }\n\n  const srcRoll = await sourcePlayer.rollDices();\n  const tgtRoll = await targetPlayer.rollDices();\n  const srcTotal = srcRoll.reduce((sum: number, r: DiceResult) => sum + r.result, 0);\n  const tgtTotal = tgtRoll.reduce((sum: number, r: DiceResult) => sum + r.result, 0);\n\n  const srcWon = srcTotal > tgtTotal;\n  const winner = srcWon ? sourcePlayer : targetPlayer;\n  const stolenProp = targetPlayer.properties[Math.floor(Math.random() * targetPlayer.properties.length)];\n\n  const content =\n    `${colorfulName(sourcePlayer)} æ·å‡ºäº†ï¼š<color:second>${srcRoll.map((r: DiceResult) => r.result).join(' + ')}</color> ä¸€å…±<color:primary>${srcTotal}</color> ç‚¹<br>`\n    + `${colorfulName(targetPlayer)} æ·å‡ºäº†ï¼š<color:second>${tgtRoll.map((r: DiceResult) => r.result).join(' + ')}</color> ä¸€å…±<color:primary>${tgtTotal}</color> ç‚¹<br>`\n    + `${colorfulName(winner)} è·èƒœï¼Œ`\n    + (srcWon\n      ? `${colorfulName(sourcePlayer)} è·å¾— ${colorfulName(targetPlayer)} çš„åœ°çš®ï¼š${stolenProp.name}`\n      : `${colorfulName(targetPlayer)} è·å¾—æŒ‘æˆ˜è€… ${sourcePlayer.name} çš„ ï¿¥2000 èµ”å¿`);\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"æŠ¢åœ°ï¼šéª°å­å†³æ–—ç»“æœ\",\n    content,\n    duration: 5000\n  });\n\n  if (srcWon) {\n    await stolenProp.setOwner(sourcePlayer);\n  } else {\n    if (sourcePlayer.money >= 2000) {\n      const costRes = await sourcePlayer.cost(2000, MoneyTag.PLAYER, targetPlayer);\n      await targetPlayer.gain(costRes.actualCost, MoneyTag.PLAYER, sourcePlayer);\n    } else {\n      const costRes = await sourcePlayer.cost(sourcePlayer.money, MoneyTag.PLAYER, targetPlayer);\n      await targetPlayer.gain(costRes.actualCost, MoneyTag.PLAYER, sourcePlayer);\n    }\n  }\n})"},{"id":"card-pmhu37","name":"è‚¡æ¯åˆ†çº¢","type":"ToSelf","description":"æ ¹æ®ä½ çš„æ€»æŒä»“è‚¡æ•°ï¼Œæ¯è‚¡å‘æ”¾ ï¿¥50 ç°é‡‘åˆ†çº¢ï¼ŒæŒä»“è¶Šå¤šæ”¶ç›Šè¶Šå¤§","color":"#e3b33b","iconId":"image-zce1w9","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const sm = gameProcess.stockMarket;\n  if (!sm.data.isOpen) {\n    throw new Error(\"è‚¡å¸‚ä¼‘å¸‚ä¸­ï¼Œæ— æ³•é¢†å–è‚¡æ¯åˆ†çº¢\");\n  }\n  const holdings = sm.getPlayerHoldingStock(sourcePlayer.id);\n  const active = holdings.filter(h => h.holding > 0);\n  if (active.length === 0) {\n    throw new Error(\"æ²¡æœ‰ä»»ä½•æŒä»“ï¼Œæ— æ³•é¢†å–è‚¡æ¯åˆ†çº¢\");\n  }\n  const totalShares = active.reduce((sum, h) => sum + h.holding, 0);\n  const dividend = totalShares * 50;\n  await sourcePlayer.gain(dividend, MoneyTag.CARD);\n  const details = active.map(h => h.stock.name + \" \" + h.holding + \"è‚¡\").join(\"ã€\");\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"è‚¡æ¯åˆ†çº¢\",\n    content: \"<color:primary>\" + sourcePlayer.name + \"</color> é¢†å–äº†è‚¡æ¯åˆ†çº¢<br>æŒä»“ï¼š\" + details + \"<br>å…± <b>\" + totalShares + \"</b> è‚¡ Ã— ï¿¥50 = <color:primary><b>ï¿¥\" + dividend + \"</b></color>\",\n    duration: 3000\n  });\n})"},{"id":"card-s19prt","name":"æ³¡æ²«ç»æµ","color":"#ff9800","description":"ä½ çš„å½“å‰åœ°äº§è¿‡è·¯è´¹ç¿»å€ï¼ŒæŒç»­3å›åˆã€‚ä½†åˆ°æœŸåè¿‡è·¯è´¹ç¿»å€çš„å»ºç­‘é™1çº§","type":"ToPlayer","iconId":"image-mjecmu","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  // é˜²æ­¢å åŠ æ•ˆæœ\n  if (sourcePlayer.modifierManager.hasBuffWithTag('foam-economy')) {\n    throw new Error(`${sourcePlayer.name} çš„æ³¡æ²«ç»æµæ•ˆæœæ­£åœ¨è¿›è¡Œä¸­ï¼Œæ— æ³•å åŠ ï¼`);\n  }\n\n  // åˆå§‹åŒ–å›åˆè®¡æ•°å™¨\n  sourcePlayer.foamEconomyRound = 0;\n\n  // æ·»åŠ ç©å®¶ä¿®é¥°å™¨ï¼šå›åˆè®¡æ•°+é™çº§\n  sourcePlayer.modifierManager.add($mod__foam_economy);\n\n  // ç»™ç©å®¶æ‰€æœ‰åœ°äº§æ·»åŠ ç¿»å€ä¿®é¥°å™¨\n  for (const prop of sourcePlayer.properties) {\n    prop.modifierManager.add($mod__foam_economy_double);\n  }\n})"},{"id":"card-vjm864","name":"ç»æµå¯’å†¬","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶3å›åˆå†…è·å¾—çš„é’±æ•°å‡å°‘20%","color":"#d93f3f","iconId":"image-dv5377","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const modId = target.modifierManager.add($mod__economic_winter_debuff);\n    target.modifierManager.add($mod__economic_winter_cleanup, async () => {\n        target.modifierManager.removeById(modId);\n        gameProcess.msgNotifyBroadcast('info', `${target.name} çš„ç»æµå¯’å†¬å·²ç»“æŸï¼`);\n    });\n    gameProcess.msgNotifyBroadcast(`warning`, `${sourcePlayer.name} å¯¹ ${target.name} æ–½åŠ äº†ç»æµå¯’å†¬ï¼æ”¶å…¥å‡å°‘20%ï¼ŒæŒç»­3å›åˆã€‚`);\n})"},{"id":"card-y472rl","name":"éª°å­è€è™æœº","color":"#d19c29","description":"æ·ä¸€æ¬¡éª°å­ï¼Œè·å¾— æ€»ç‚¹æ•° * 200 å—é’±ï¼Œå¦‚æœç‚¹æ•°ç›¸åŒåˆ™ç¿»å€","type":"ToSelf","iconId":"image-avnok7","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const rollRes = await sourcePlayer.rollDices();\n    let rollCount = rollRes.map(r => r.result).reduce((p, c) => p + c);\n    if (rollRes.every(v => v.result === rollRes[0].result)) {\n        rollCount *= 2;\n    }\n    await sourcePlayer.gain(rollCount * 200, MoneyTag.CARD);\n});"},{"id":"card-zmo535","name":"è·Œåœæ¿","type":"ToSelf","description":"æŒ‡å®šä¸€æ”¯è‚¡ç¥¨ç¬é—´æš´è·Œè‡³è·Œåœä»·ï¼Œæ‹‰å®Œäº†","color":"#24a11b","iconId":"image-iegie9","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const stockMarket = gameProcess.stockMarket;\n    const items = stockMarket.data.stocks.map((s: any) => ({\n        id: s.id,\n        display: {\n            id: \"stock-\" + s.id,\n            type: \"div\" as const,\n            style: { background: '#ffffff', borderRadius: '1rem' },\n            variable: {\n                stockName: s.name,\n                stockColor: s.color,\n                areaColor: s.display.color,\n                areaPath: s.display.areaPath,\n                linePath: s.display.linePath,\n                price: s.display.price,\n                percent: s.display.percent,\n            },\n            children: [\n                $ui__stock_preview\n            ]\n        }\n    }));\n\n    const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"é€‰æ‹©ç ¸ç›˜ç›®æ ‡\",\n        content: \"é€‰æ‹©ä¸€æ”¯è‚¡ç¥¨ä½¿å…¶è·Œåœï¼\",\n        itemList: items\n    });\n\n    if (!result.selected.length) return;\n\n    const stockId = result.selected[0];\n    const stock = stockMarket.getStock(stockId);\n    if (!stock) return;\n\n    const oldPrice = stock.price;\n    stock.heat = 0;\n    stock.trend = -0.95;\n    stock.price = Math.max(5, oldPrice * 0.9);\n    stock.changeRate = (stock.price - oldPrice) / oldPrice;\n    stock.history.push(stock.price);\n    if (stock.history.length > 20) stock.history.shift();\n\n    gameProcess.msgNotifyBroadcast(\"error\", sourcePlayer.name + \" ç ¸ç›˜äº† \" + stock.name + \"ï¼Œç›´æ¥è·Œåœï¼\");\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"è·Œåœæ¿\",\n        content: \"<b><color:green>\" + stock.name + \"</color></b> è¢«ç ¸è‡³è·Œåœï¼<br>å½“å‰ä»·æ ¼ï¼š<b>Â¥\" +\n            stock.price.toFixed(1) + \"</b><br><color:red>å¸‚åœºä¸€ç‰‡å“€åšï¼Œææ…Œæƒ…ç»ªè”“å»¶</color>\",\n        duration: 3000\n    });\n})"}],"mapItemTypes":[{"id":"map-item-type-41gi4c","name":"å…¬äº¤ç«™","modelId":"model-bbec2d5e-01aa-4fe5-9e30-261849d96f9d","color":"#c64239","size":1},{"id":"map-item-type-8ty8pf","name":"è¯åˆ¸ä¸­å¿ƒ","modelId":"model-44d53d3d-b3a5-4196-98b7-1563111460e1","color":"#90886f","size":1},{"id":"map-item-type-90ca6p","name":"æºœç¼åœ°å—","modelId":"model-0f838b1d-ddfe-48c6-a6bc-37e860fe3452","color":"#676f98","size":1},{"id":"map-item-type-cjscr2","name":"è·¯1","modelId":"model-59a48297-1b26-488e-a211-1d73d5a7ba25","color":"#9f6068","size":1},{"id":"map-item-type-dh0oy5","name":"å»ç›‘ç‹±è£…é¥°","modelId":"model-3fyfqc","color":"#629d7a","size":1},{"id":"map-item-type-eon1jp","name":"æ¡Œå­","modelId":"model-ae76c5ff-7850-4281-8bd5-08ffdd884387","color":"#b826d9","size":1},{"id":"map-item-type-grooot","name":"ç›‘ç‹±","modelId":"model-9a732baf-6c9c-440c-a6d8-a66d526c1540","color":"#798486","size":1},{"id":"map-item-type-hn3zik","name":"è£…é¥°åœ°å—-2","modelId":"model-g9shr4","color":"#53ac83","size":1},{"id":"map-item-type-i17qnr","name":"èµ·ç‚¹è£…é¥°","modelId":"model-f0u7du","color":"#27d8c2","size":1},{"id":"map-item-type-mod-airport","name":"æœºåœº","color":"#f39c12","modelId":"model-mod-airport","size":1},{"id":"map-item-type-mod-bankloan","name":"é“¶è¡Œè´·æ¬¾","modelId":"model-mod-bankloan","color":"#2e7d32","size":1},{"id":"map-item-type-mod-chrono","name":"è¶…æ—¶ç©ºä¼ é€","modelId":"model-mod-chrono","color":"#4fc3f7","size":1},{"id":"map-item-type-mod-detective","name":"ä¾¦æ¢äº‹åŠ¡æ‰€","color":"#5d4037","modelId":"model-mod-detective","size":1},{"id":"map-item-type-mod-enhance","name":"è§’è‰²å¼ºåŒ–è£…ç½®","color":"#455a64","modelId":"model-mod-enhance","size":1},{"id":"map-item-type-mo