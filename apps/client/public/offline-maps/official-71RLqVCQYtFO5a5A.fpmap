I":"ui-template-rp12dz"}},{"id":"mi-zgb7v6","x":15,"y":-16,"rotation":3,"type":{"id":"map-item-type-grooot","name":"ç›‘ç‹±","modelId":"model-9a732baf-6c9c-440c-a6d8-a66d526c1540","color":"#798486","size":1},"beLinked":"mi-dz-o14"}],"chanceCards":[{"id":"card-3t5n8x","name":"å…è´¹å‡çº§","type":"ToProperty","description":"é€‰æ‹©ä¸€å—åœ°äº§ç›´æ¥å…è´¹å‡çº§ä¸€çº§","color":"#2E8B57","iconId":"image-sujs1i","effectCode":"(async (sourcePlayer: IPlayer, target: IProperty, gameProcess: IGameProcess) => {\n    if (target.level >= target.maxLevel) {\n        throw Error(\"è¯¥åœ°äº§å·²æ»¡çº§ï¼Œæ— æ³•å‡çº§\");\n    }\n    const oldLevel = target.level;\n    await target.levelUp();\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"å…è´¹å‡çº§\",\n        content: `${sourcePlayer.name} å¯¹ <b>${target.name}</b> ä½¿ç”¨äº†å…è´¹å‡çº§ï¼<br>å»ºç­‘ç­‰çº§ ${oldLevel} â†’ ${target.level}`,\n        duration: 3000\n    });\n});"},{"id":"card-62fb69d0-4849-4b77-b9b0-97964fba6de4","name":"éª°å­å°å°","type":"ToPlayer","description":"è®©ç›®æ ‡ç©å®¶ 3 ä¸ªå›åˆå†…åªèƒ½ä½¿ç”¨ä¸€ä¸ªéª°å­","color":"#d93636","iconId":"image-nze37u","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const extraDiceIds = target.dices.slice(1).map(function (d) { return d.id; });\n    console.log(extraDiceIds);\n    const removedDices: IDice[] = [];\n    for (let i = 0; i < extraDiceIds.length; i++) {\n        const removedDice = await target.removeDice(extraDiceIds[i]);\n        if (removedDice) removedDices.push(removedDice);\n    }\n    console.log(removedDices);\n    target.diceSeal = { removedDices, remainingRounds: 3 };\n    target.modifierManager.add($mod__dice_seal, async () => {\n        removedDices.forEach(d => target.addDice(d.diceValues));\n        await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n            title: 'éª°å­å°å°',\n            content: `<b>${target.name}</b> çš„<color:red><b>éª°å­å°å°</b></color> ç»“æŸäº†`,\n            duration: 2000\n        });\n    });\n    gameProcess.gameDataBroadcast()\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: 'éª°å­å°å°',\n        content: `<b>${target.name}</b> è¢«æ–½åŠ äº†<color:red><b>éª°å­å°å°</b></color>ï¼åªèƒ½æ·1é¢—éª°å­ï¼ŒæŒç»­3å›åˆ`,\n        duration: 2000\n    });\n})"},{"id":"card-6yly84","name":"é¥æ§å™¨","color":"#ea3e3e","description":"å¯ä»¥è®©ç›®æ ‡å‘å‰èµ°1-6æ­¥ï¼Œå¹¶è§¦å‘ç›¸åº”äº‹ä»¶","type":"ToPlayer","iconId":"image-h61pvw","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const res = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"é€‰æ‹©æ­¥æ•°\",\n        content: \"è®©ç›®æ ‡å‘å‰èµ°æŒ‡å®šæ­¥æ•°\",\n        itemList: [1, 2, 3, 4, 5, 6].map((n => ({ id: `${n}`, display: `${n}æ­¥` })))\n    })\n    await target.walk(Number(res.selected[0]));\n    await gameProcess.handleArriveEvent(target);\n});"},{"id":"card-7bz7m0","name":"ä¸€åœºè±ªèµŒ","color":"#2941a3","description":"èŠ±è´¹ï¿¥2000è½¬åŠ¨å‘½è¿è½®ç›˜ï¼Œéšæœºè§¦å‘ä¸€ç§æ•ˆæœ","type":"ToSelf","iconId":"image-ipf5ch","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const betAmount = 2000;\n    const allPlayerIds = gameProcess.getAllPlayersId();\n\n    if (sourcePlayer.money < betAmount) {\n        throw Error(\"èµ„é‡‘ä¸è¶³ï¼Œè‡³å°‘éœ€è¦ ï¿¥\" + betAmount + \" æ‰èƒ½å‚ä¸èµŒå±€\");\n    }\n\n    await sourcePlayer.cost(betAmount, MoneyTag.CARD);\n    gameProcess.msgNotifyBroadcast(\"info\", sourcePlayer.name + \" èŠ±äº† ï¿¥\" + betAmount + \" è½¬åŠ¨å‘½è¿è½®ç›˜...\");\n\n    const events = [\n        // 1. è´¢ç¥é©¾åˆ° â€” è·å¾—ï¿¥5000\n        async () => {\n            await sourcePlayer.gain(5000, MoneyTag.CARD);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è´¢ç¥é©¾åˆ°\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> èµŒæ³¨ç¿»äº†2.5å€ï¼\\n<color:green>ï¿¥${betAmount}</color> â†’ <b><color:green>ï¿¥5000</color></b>`,\n                duration: 3000\n            });\n        },\n        // 2. åŸºå»ºç‹‚é­” â€” éšæœºä¸€å¤„å·±æ–¹åœ°äº§å…è´¹å‡çº§\n        async () => {\n            const upgradable = sourcePlayer.properties.filter(p => p.level < p.maxLevel);\n            if (upgradable.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"åŸºå»ºç‹‚é­”\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³æåŸºå»ºï¼Œä½†æ²¡æœ‰å¯å‡çº§çš„åœ°äº§`,\n                    duration: 3000\n                });\n                return;\n            }\n            const prop = upgradable[Math.floor(Math.random() * upgradable.length)];\n            const oldLevel = prop.level;\n            await prop.levelUp();\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"åŸºå»ºç‹‚é­”\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> è·å¾—å…è´¹å‡çº§ï¼\\n<b>${prop.name}</b> ${oldLevel}çº§ â†’ <b>${prop.level}çº§</b>`,\n                duration: 3000\n            });\n        },\n        // 3. è‚¡å¸‚èµ ç¤¼ â€” è·å¾—20è‚¡éšæœºè‚¡ç¥¨\n        async () => {\n            const sm = gameProcess.stockMarket;\n            if (!sm || !sm.data.isOpen || sm.data.stocks.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"è‚¡å¸‚èµ ç¤¼\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³ç‚’è‚¡ï¼Œä½†è‚¡å¸‚ä¼‘å¸‚ä¸­`,\n                    duration: 3000\n                });\n                return;\n            }\n            const stock = sm.data.stocks[Math.floor(Math.random() * sm.data.stocks.length)];\n            const receipt = sm.commitBuy(sourcePlayer.id, stock.id, 20);\n            if (!receipt) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"è‚¡å¸‚èµ ç¤¼\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> äº¤æ˜“å¤±è´¥ï¼Œæ— æ³•é¢†å–èµ è‚¡`,\n                    duration: 3000\n                });\n                return;\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è‚¡å¸‚èµ ç¤¼\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> è·å¾— <b>${stock.name}</b> èµ è‚¡ Ã—20ï¼\\nå½“å‰è‚¡ä»·ï¼šï¿¥${stock.price.toFixed(1)}`,\n                duration: 3000\n            });\n        },\n        // 4. å½©ç¥¨è¾¾äºº â€” 3å¼ å…è´¹å½©ç¥¨\n        async () => {\n            const lm = gameProcess.lotteryManager;\n            if (lm.stock.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å½©ç¥¨è¾¾äºº\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³ä¹°å½©ç¥¨ï¼Œä½†å·²å”®ç½„`,\n                    duration: 3000\n                });\n                return;\n            }\n            const count = Math.min(3, lm.stock.length);\n            const picked: number[] = [];\n            const stockCopy = [...lm.stock];\n            for (let i = 0; i < count; i++) {\n                const idx = Math.floor(Math.random() * stockCopy.length);\n                picked.push(stockCopy[idx]);\n                stockCopy.splice(idx, 1);\n            }\n            await lm.buyLottery(sourcePlayer, picked);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"å½©ç¥¨è¾¾äºº\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> å…è´¹è·å¾— <b>${count}</b> å¼ å½©ç¥¨ï¼\\n<color:primary>${picked.join(\"ã€\")}</color>`,\n                duration: 3000\n            });\n        },\n        // 5. é¡ºæ‰‹ç‰µç¾Š â€” å·å–å¯¹æ‰‹ä¸€å¼ æœºä¼šå¡\n        async () => {\n            const opponents = Array.from(gameProcess.players.values()).filter(\n                p => p.id !== sourcePlayer.id && !p.isBankrupted && p.chanceCards.length > 0\n            );\n            if (opponents.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"é¡ºæ‰‹ç‰µç¾Š\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³å·å¡ï¼Œä½†æ²¡äººæœ‰å¡å¯å·`,\n                    duration: 3000\n                });\n                return;\n            }\n            const victim = opponents[Math.floor(Math.random() * opponents.length)];\n            const stolenCard = victim.chanceCards[Math.floor(Math.random() * victim.chanceCards.length)];\n            const newCard = gameProcess.createNewChanceCard(stolenCard.getSourceId());\n            await victim.loseCard(stolenCard.getId());\n            await sourcePlayer.gainCard(newCard);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"é¡ºæ‰‹ç‰µç¾Š\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> ä» <b>${victim.name}</b> å¤„å·èµ°äº†ä¸€å¼ æœºä¼šå¡ï¼\\n<color:primary>${stolenCard.getName()}</color>`,\n                duration: 3000\n            });\n        },\n        // 6. å‘½è¿é¦ˆèµ  â€” 2å¼ éšæœºæœºä¼šå¡\n        async () => {\n            const allTemplates = Array.from(gameProcess.chanceCardInfos.values());\n            if (allTemplates.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å‘½è¿é¦ˆèµ \",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³è¦æœºä¼šå¡ï¼Œä½†å¡æ± ä¸ºç©º`,\n                    duration: 3000\n                });\n                return;\n            }\n            const count = Math.min(2, 4 - sourcePlayer.chanceCards.length);\n            if (count <= 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å‘½è¿é¦ˆèµ \",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æ‰‹ç‰Œå·²æ»¡ï¼Œæ— æ³•è·å¾—æ›´å¤š`,\n                    duration: 3000\n                });\n                return;\n            }\n            const names: string[] = [];\n            for (let i = 0; i < count; i++) {\n                const tpl = allTemplates[Math.floor(Math.random() * allTemplates.length)];\n                const card = gameProcess.createNewChanceCard(tpl.id);\n                await sourcePlayer.gainCard(card);\n                names.push(tpl.name);\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"å‘½è¿é¦ˆèµ \",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> å°†èµŒæ³¨æ¢æˆäº† <b>${count}</b> å¼ æœºä¼šå¡ï¼\\n<color:primary>${names.join(\"ã€\")}</color>`,\n                duration: 3000\n            });\n        },\n        // 7. è¡€æœ¬æ— å½’ â€” å•¥ä¹Ÿæ²¡æœ‰\n        async () => {\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è¡€æœ¬æ— å½’\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> çš„ ï¿¥${betAmount} æ‰“äº†æ°´æ¼‚...\\nå‘½è¿ä»€ä¹ˆä¹Ÿæ²¡ç»™`,\n                duration: 3000\n            });\n        },\n        // 8. æ‹†è¿é€šçŸ¥ â€” æ‰€æœ‰å»ºç­‘é™1çº§\n        async () => {\n            const leveled = sourcePlayer.properties.filter(p => p.level > 0);\n            if (leveled.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"æ‹†è¿é€šçŸ¥\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æ”¶åˆ°æ‹†è¿é€šçŸ¥ï¼Œä½†æ²¡æœ‰å»ºç­‘å¯æ‹†`,\n                    duration: 3000\n                });\n                return;\n            }\n            for (const prop of leveled) {\n                await prop.levelDown();\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"æ‹†è¿é€šçŸ¥\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> æ”¶åˆ°æ‹†è¿é€šçŸ¥ï¼\\n${leveled.map(p => p.name).join(\"ã€\")} å…¨éƒ¨é™äº†1çº§`,\n                duration: 3000\n            });\n        }\n    ];\n\n    await events[Math.floor(Math.random() * events.length)]();\n})"},{"id":"card-7epkfv","name":"ä¸åŠ¨äº§ç¨","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶æŒ‰æŒæœ‰åœ°äº§æ•°é‡ç¼´ç¨ï¼Œæ¯å¤„åœ°äº§ç¼´çº³\\n( 300 Ã— å½“å‰é€šèƒ€å€ç‡ )ï¿¥","color":"#8B0000","iconId":"image-vzskja","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  if (target.properties.length === 0) {\n    throw new Error(\"ç›®æ ‡ç©å®¶æ²¡æœ‰æŒæœ‰åœ°äº§\");\n  }\n  const taxPerProperty = Math.round(300 * gameProcess.inflationRate);\n  const count = target.properties.length;\n  const tax = count * taxPerProperty;\n  await target.cost(tax);\n  await sourcePlayer.gain(tax, MoneyTag.CARD);\n  gameProcess.msgNotifyBroadcast(\"warning\", `${target.name} å› æŒæœ‰${count}å¤„åœ°äº§ï¼Œè¢«å¼ºåˆ¶å¾æ”¶ ï¿¥${tax} ä¸åŠ¨äº§ç¨ï¼å½“å‰ä½™é¢ ï¿¥${target.money}`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"ä¸åŠ¨äº§ç¨\",\n    content: `<b>${sourcePlayer.name}</b> å¯¹ <b>${target.name}</b> å¾æ”¶ä¸åŠ¨äº§ç¨ï¼ï¼ˆï¿¥${taxPerProperty}/å¤„ Ã— ${gameProcess.inflationRate.toFixed(2)}å€é€šèƒ€ï¼‰<br><br>${count}å¤„åœ°äº§ï¼Œå¼ºåˆ¶å¾æ”¶ ï¿¥${tax}<br>${target.name} å½“å‰ä½™é¢ï¼š<color:red>ï¿¥${target.money}</color>`,\n    duration: 4000\n  });\n})"},{"id":"card-9wrxjv","name":"ç»“ç›Ÿ","color":"#47c256","description":"é€‰æ‹©ä¸€ä½ç©å®¶ç»“ç›Ÿï¼Œå„è‡ªå…é™¤å¯¹æ–¹3æ¬¡çš„è¿‡è·¯è´¹","type":"ToOtherPlayer","iconId":"image-ixz4g4","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const targetPlayer = target as IPlayer;\n\n  function cleanupAlliance(player: IPlayer) {\n    player.modifierManager.removeByTag('alliance');\n    delete player.allianceWith;\n  }\n\n  const oldSourceAllyId = sourcePlayer.allianceWith?.allyId;\n  if (oldSourceAllyId) {\n    const oldSourceAlly = gameProcess.players.get(oldSourceAllyId);\n    if (oldSourceAlly) {\n      cleanupAlliance(oldSourceAlly);\n    }\n  }\n\n  const oldTargetAllyId = targetPlayer.allianceWith?.allyId;\n  if (oldTargetAllyId) {\n    const oldTargetAlly = gameProcess.players.get(oldTargetAllyId);\n    if (oldTargetAlly) {\n      cleanupAlliance(oldTargetAlly);\n    }\n  }\n\n  cleanupAlliance(sourcePlayer);\n  cleanupAlliance(targetPlayer);\n\n  sourcePlayer.allianceWith = { allyId: targetPlayer.id, remainingTimes: 3 };\n  targetPlayer.allianceWith = { allyId: sourcePlayer.id, remainingTimes: 3 };\n\n  sourcePlayer.modifierManager.add($mod__alliance_toll_free_player);\n  targetPlayer.modifierManager.add($mod__alliance_toll_free_player);\n\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å’Œ ${targetPlayer.name} ç»“æˆè”ç›Ÿï¼å„è‡ªå…é™¤å¯¹æ–¹ 3 æ¬¡è¿‡è·¯è´¹ï¼`);\n});"},{"id":"card-a06g8w","name":"æ‹†è¿ä»¤","type":"ToProperty","description":"é€‰æ‹©ä¸€å—åœ°äº§æ‹†é™¤ä¸€å±‚å»ºç­‘ï¼Œä¸šä¸»è·å¾—ä¸€åŠå»ºé€ è´¹çš„è¡¥å¿","color":"#8B4513","iconId":"image-9ogdah","effectCode":"(async (sourcePlayer: IPlayer, target: IProperty, gameProcess: IGameProcess) => {\n    if (target.level <= 0) {\n        throw Error(\"è¯¥åœ°äº§æ²¡æœ‰å»ºç­‘å¯ä»¥æ‹†é™¤\");\n    }\n    const owner = target.owner;\n    const propertyName = target.name;\n    const oldLevel = target.level;\n    const compensation = Math.floor(target.buildCost / 2);\n    await target.levelDown();\n    if (owner) {\n        await owner.gain(compensation, MoneyTag.CARD);\n    }\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"æ‹†è¿ä»¤\",\n        content: `${sourcePlayer.name} å¯¹ <b>${propertyName}</b> å‘åŠ¨äº†æ‹†è¿ä»¤ï¼<br>å»ºç­‘ç­‰çº§ ${oldLevel} â†’ ${oldLevel - 1}<br>${owner ? `ä