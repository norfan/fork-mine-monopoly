–°ä¸€è½®\n  gameProcess.__mqUsed = gameProcess.__mqUsed || [];\n  const MQ_TOTAL = 3; // æ¯æ¬¡è§¦å‘å¯è¿ç»­ç­” 3 é“é¢˜\n  for (let mqRound = 0; mqRound < MQ_TOTAL; mqRound++) {\n  let mqPool = QUESTIONS.map((x, i) => i).filter((i) => gameProcess.__mqUsed.indexOf(i) === -1);\n  if (mqPool.length === 0) { gameProcess.__mqUsed.length = 0; mqPool = QUESTIONS.map((x, i) => i); }\n  const mqIdx = mqPool[Math.floor(Math.random() * mqPool.length)];\n  gameProcess.__mqUsed.push(mqIdx);\n  const item = QUESTIONS[mqIdx];\n  const res = await gameProcess.showItemSelectDialog(player.id, {\n        title: \"ç¥ç§˜é—®ç­”\", cancelText: mqRound < MQ_TOTAL - 1 ? \"ä¸ä¼šåšï¼Œä¸‹ä¸€é¢˜\" : \"ç¦»å¼€\", column: 1,\n    content: { id: \"mq-qb\", type: \"div\", children: [\n      { id: \"mq-cat\", type: \"div\", content: \"é¢˜ç›®ç±»å‹ï¼š\" + (item.cat || \"ç»¼åˆ\"), style: { textAlign: \"center\", color: \"#888888\", fontSize: \"0.9rem\", marginBottom: \"0.4rem\" } },\n      { id: \"mq-qt\", type: \"div\", content: item.q },\n      { id: \"mq-left\", type: \"div\", content: \"å‰©ä½™\" + (MQ_TOTAL - mqRound) + \"é¢˜\", style: { textAlign: \"center\", color: \"#888888\", fontSize: \"0.9rem\", marginTop: \"0.4rem\" } },\n    ] },\n    itemList: item.opts.map((o, i) => ({ id: String(i), display: o })),\n  });\n  if (!res.selected || res.selected.length === 0) {\n    if (mqRound < MQ_TOTAL - 1) {\n      gameProcess.msgNotifyBroadcast(\"info\", player.name + \" ç‚¹äº†ã€Œä¸ä¼šåšï¼Œä¸‹ä¸€é¢˜ã€ï¼Œè·³è¿‡è¿™é“é¢˜ã€‚\");\n      continue;\n    }\n    gameProcess.msgNotifyBroadcast(\"info\", player.name + \" è·¯è¿‡ç¥ç§˜é—®ç­”ï¼Œæ²¡æ•¢ä½œç­”ã€‚\");\n    return;\n  }\n  const correct = res.selected[0] === String(item.a);\n  const others = Array.from(gameProcess.players.values()).filter((p) => p.id !== player.id && !p.isBankrupted);\n  const richest = others.slice().sort((a, b) => (Number(b.money) || 0) - (Number(a.money) || 0))[0];\n  const myProps = player.properties || [];\n  const upgradable = myProps.filter((pr) => pr.level < pr.maxLevel);\n  const downgradable = myProps.filter((pr) => pr.level > 0);\n  const headBlocks = [\n    { id: \"mq-t\", type: \"div\", content: \"ã€é¢˜ç›®ã€‘\" + item.q, style: { textAlign: \"left\", color: \"#5d4037\" } },\n    { id: \"mq-a\", type: \"div\", content: \"ã€æ­£ç¡®ç­”æ¡ˆã€‘\" + item.opts[item.a], style: { textAlign: \"left\", color: correct ? \"#2e7d32\" : \"#c62828\" } },\n    { id: \"mq-p\", type: \"div\", content: \"ã€è§£æã€‘\" + item.tip, style: { textAlign: \"left\", color: \"#455a64\" } },\n  ];\n  if (correct) {\n    const RW = [\n      { id: \"r1\", text: \"è·å¾—1500å…ƒ\", ok: true, run: async () => { await player.gain(1500, MoneyTag.PLAYER); return \"è·å¾—å¥–åŠ± ï¿¥1500\"; } },\n      { id: \"r2\", text: \"ä»æœ€å¯Œçš„ç©å®¶æ‰‹ä¸­å¤ºå–1000å…ƒ\", ok: !!(richest && (Number(richest.money) || 0) >= 1000), run: async () => { const pay = await richest.cost(1000, MoneyTag.PLAYER); await player.gain(pay.actualCost, MoneyTag.PLAYER); return \"ä» \" + richest.name + \" æ‰‹ä¸­å¤ºå– ï¿¥\" + pay.actualCost; } },\n      { id: \"r3\", text: \"è·å¾—éšæœºä¸€å¼ æœºä¼šå¡\", ok: (player.chanceCards || []).length < 4, run: async () => { const infos = Array.from(gameProcess.chanceCardInfos.values()); const info = infos[Math.floor(Math.random() * infos.length)]; await player.gainCard(gameProcess.createNewChanceCard(info.id)); return \"è·å¾—æœºä¼šå¡ã€Œ\" + (info.name || info.id) + \"ã€\"; } },\n      { id: \"r4\", text: \"è‡ªå·±çš„éšæœºä¸€å¤„å¯å‡çº§çš„æˆ¿äº§å‡1çº§\", ok: upgradable.length > 0, run: async () => { const pr = upgradable[Math.floor(Math.random() * upgradable.length)]; await pr.levelUp(); return \"æˆ¿äº§ã€Œ\" + pr.name + \"ã€å‡è‡³ \" + pr.level + \" çº§\"; } },\n    ];\n    const res2 = await gameProcess.showItemSelectDialog(player.id, {\n      title: \"ç¥ç§˜é—®ç­” Â· ç­”å¯¹äº†ï¼é€‰æ‹©ä½ çš„å¥–åŠ±\",\n      content: { id: \"mq-rw\", type: \"div\", style: { textAlign: \"left\" }, children: headBlocks.concat([{ id: \"mq-rw-tip\", type: \"div\", content: \"ã€å¥–åŠ±ã€‘è¯·é€‰æ‹©å…¶ä¸­ä¸€ä¸ªå¥–åŠ±ï¼Œç°åŒ–æŒ‰é’®ä¸å¯é€‰ã€‚\", style: { textAlign: \"left\", color: \"#2e7d32\" } }], RW.map((r, i) => ({ id: \"mq-rw-\" + i, type: \"div\", content: (i + 1) + \". \" + r.text, style: { textAlign: \"left\" } }))) },\n      itemList: RW.map((r, i) => ({ id: r.id, display: r.ok ? ((i + 1) + \".\") : { id: \"gray-\" + r.id, type: \"span\", style: { color: \"#999999\" }, children: [{ type: \"text\", content: (i + 1) + \".\" }] } })),\n      column: 4, cancelText: \"ç¦»å¼€\", closable: true,\n    });\n    const pick = RW.find((r) => r.id === (res2.selected || [])[0]);\n    const chosen = pick && pick.ok ? pick : RW[0];\n    const detail = await chosen.run();\n    gameProcess.msgNotifyBroadcast(\"success\", player.name + \" ç­”å¯¹ç¥ç§˜é—®ç­”ï¼Œ\" + detail + \"ï¼\");\n  } else {\n    const PN = [\n      { id: \"p1\", text: \"å¤±å»750å…ƒ\", ok: true, run: async () => { const pay = await player.cost(750, MoneyTag.PLAYER); return pay.actualCost < 750 ? \"ä½™é¢ä¸è¶³ï¼Œæ‰£è‡³ 0ï¼ˆå®é™…æ‰£é™¤ ï¿¥\" + pay.actualCost + \"ï¼‰\" : \"å¤±å» ï¿¥750\"; } },\n      { id: \"p2\", text: \"åŸåœ°åœæ­¢è¡ŒåŠ¨ä¸€å›åˆ\", ok: true, run: async () => {\n        await player.setStop((player.isStop || 0) + 1);\n        if (player.buffManager) {\n          player.buffManager.removeBuff(\"stop-buff-\" + player.id);\n          player.buffManager.addBuff({ id: \"stop-buff-\" + player.id, name: \"åœæ­¢è¡ŒåŠ¨\", triggerTiming: \"å›åˆå¼€å§‹æ—¶\", description: \"åœæ­¢è¡ŒåŠ¨ï¼š1 ä¸ªå›åˆè¢«è·³è¿‡\", source: \"ç¥ç§˜é—®ç­”\" });\n          player.modifierManager.add($mod__stop_buff_sync);\n        }\n        const outsC = gameProcess.getAvailableMapPaths(player.positionMapItemId, \"forward\");\n        const insC = gameProcess.getAvailableMapPaths(player.positionMapItemId, \"reverse\");\n        gameProcess.stopcutDisabled = gameProcess.stopcutDisabled || [];\n        for (const pw of outsC.concat(insC)) {\n          if (gameProcess.isMapPathEnabled(pw.id)) {\n            gameProcess.setMapPathEnabled(pw.id, false);\n            gameProcess.stopcutDisabled.push(pw.id);\n          }\n        }\n        player.resetMapNavigation();\n        player.modifierManager.add($mod__stopcut_cleaner_walk);\n        player.modifierManager.add($mod__stopcut_cleaner);\n        return \"åŸåœ°åœæ­¢è¡ŒåŠ¨ 1 å›åˆ\";\n      } },\n      { id: \"p3\", text: \"å¤±å»æ‰‹ä¸­éšæœºä¸€å¼ æœºä¼šå¡\", ok: (player.chanceCards || []).length > 0, run: async () => { const cs = player.chanceCards; const c = cs[Math.floor(Math.random() * cs.length)]; await player.loseCard(c.getId()); return \"å¤±å»æœºä¼šå¡ã€Œ\" + (c.getName ? c.getName() : \"æœºä¼šå¡\") + \"ã€\"; } },\n      { id: \"p4\", text: \"è‡ªå·±çš„éšæœºä¸€å¤„å¯é™çº§çš„æˆ¿äº§é™1çº§\", ok: downgradable.length > 0, run: async () => { const pr = downgradable[Math.floor(Math.random() * downgradable.length)]; await pr.levelDown(); return \"æˆ¿äº§ã€Œ\" + pr.name + \"ã€é™è‡³ \" + pr.level + \" çº§\"; } },\n    ];\n    const res2 = await gameProcess.showItemSelectDialog(player.id, {\n      title: \"ç¥ç§˜é—®ç­” Â· ç­”é”™äº†â€¦é€‰æ‹©ä½ çš„æƒ©ç½š\",\n      content: { id: \"mq-pn\", type: \"div\", style: { textAlign: \"left\" }, children: headBlocks.concat([{ id: \"mq-pn-tip\", type: \"div\", content: \"ã€æƒ©ç½šã€‘è¯·é€‰æ‹©å…¶ä¸­ä¸€ä¸ªæƒ©ç½šï¼Œç°åŒ–æŒ‰é’®ä¸å¯é€‰ã€‚\", style: { textAlign: \"left\", color: \"#c62828\" } }], PN.map((p, i) => ({ id: \"mq-pn-\" + i, type: \"div\", content: (i + 1) + \". \" + p.text, style: { textAlign: \"left\" } }))) },\n      itemList: PN.map((p, i) => ({ id: p.id, display: p.ok ? ((i + 1) + \".\") : { id: \"gray-\" + p.id, type: \"span\", style: { color: \"#999999\" }, children: [{ type: \"text\", content: (i + 1) + \".\" }] } })),\n      column: 4, cancelText: \"ç¦»å¼€\", closable: true,\n    });\n    const pick = PN.find((p) => p.id === (res2.selected || [])[0]);\n    const chosen = pick && pick.ok ? pick : PN[0];\n    const detail = await chosen.run();\n    gameProcess.msgNotifyBroadcast(\"warning\", player.name + \" ç­”é”™ç¥ç§˜é—®ç­”ï¼Œ\" + detail + \"ã€‚\");\n  }\n    gameProcess.gameDataBroadcast();\n  }\n})"},{"id":"event-mod-pawnshop","type":"PassedEvent","name":"å½“é“º","description":"å¯ä»¥æŠŠæœºä¼šå¡å½“æ‰æ¢é’±ã€‚","iconId":"image-mod-pawnshop","effectCode":"(async (player, gameProcess) => {\n  if (player.chanceCards.length === 0) {\ngameProcess.msgNotifyBroadcast(\"info\", player.name + \" è·¯è¿‡å½“é“ºï¼Œèº«ä¸Šæ²¡æœ‰æœºä¼šå¡ã€‚\");\n    return;\n  }\n  const items = player.chanceCards.map(function (c) {\n    const money = 500; // æ‰€æœ‰æœºä¼šå¡ç»Ÿä¸€ä½œä»· ï¿¥500\n    let nm = \"æœºä¼šå¡\";\n    try { const info = gameProcess.chanceCardInfos.get(c.getSourceId()); if (info && info.name) nm = info.name; else nm = c.getName(); } catch (e) { nm = c.getName(); }\n    return { id: c.getId(), display: nm + \"ï¼ˆä½œä»· ï¿¥\" + money + \"ï¼‰\", money };\n  });\n  const res = await gameProcess.showItemSelectDialog(player.id, {\n    title: \"è€æ¿çš„å½“é“º\",\n    content: \"å½“æ‰æœºä¼šå¡æ¢é’±ï¼Œæ‰€æœ‰æœºä¼šå¡ç»Ÿä¸€ä½œä»· <color:primary>ï¿¥500</color>ã€‚\\n<color:#e74c3c>å½“ç¥¨è¿‡æœŸä¸èµï¼Œæ¦‚ä¸è´Ÿè´£ï¼</color>\",\n    itemList: items,\n    multiple: true,\n    cancelText: \"ä¸å–\",\n  });\n  if (!res.selected || res.selected.length === 0) {\ngameProcess.msgNotifyBroadcast(\"info\", player.name + \" è·¯è¿‡å½“é“ºï¼Œæ²¡æœ‰å½“å¡ã€‚\");\n    return;\n  }\n  let total = 0;\n  for (const sel of res.selected) {\n    const item = items.find(function (i) { return i.id === sel; });\n    if (!item) continue;\n    await player.loseCard(item.id);\n    await player.gain(item.money, \"system\");\n    total += item.money;\n    gameProcess.msgNotifyBroadcast(\"info\", player.name + \" æŠŠæœºä¼šå¡å½“ç»™äº†å½“é“ºï¼Œæ¢åˆ° ï¿¥\" + item.money);\n  }\n  if (total > 0) {\n    await gameProcess.showMessageCard([player.id], { title: \"è€æ¿çš„å½“é“º\", conte