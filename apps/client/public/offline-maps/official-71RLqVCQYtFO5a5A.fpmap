ss":"felt-card"}}],"props":{},"style":{"padding":"0.625rem 0.8rem"}},"slug":"stock_show_component"}],"modifierTemplates":[{"id":"mod-0tqmqj","name":"ã€è§’è‰²æŠ€èƒ½ã€‘è“„æ°”","slug":"puffer_toll","descriptor":{"autoConsume":false,"commandType":"property.arrived","meta":{"description":"æ¯ä»˜3æ¬¡è¿‡è·¯è´¹å“ˆæ°”å…å•","name":"è“„æ°”","source":"è§’è‰²æŠ€èƒ½","tags":["property"]},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n    const arrived = cmd.payload.arrivedPlayer;\n    const owner = property.owner;\n    const toll = cmd.payload.toll;\n\n    if (!owner || arrived.id === owner.id || !toll || toll <= 0) {\n        ctx.skip();\n        return;\n    }\n\n    // åªå¯¹æ²³è±šæœ¬äººç”Ÿæ•ˆ\n    if (ctx.modifierData?.ownerPlayerId !== arrived.id) {\n        ctx.skip();\n        return;\n    }\n\n    const player = gameProcess.players.get(arrived.id);\n    if (!player) {\n        ctx.skip();\n        return;\n    }\n\n    player.pufferTollCount = (player.pufferTollCount || 0) + 1;\n    player.buffManager.updateBuff('puffer-toll-display-' + player.id, {\n        description: 'æ¯ä»˜3æ¬¡è¿‡è·¯è´¹å“ˆæ°”å…å• Â· è¿›åº¦ ' + (player.pufferTollCount % 3) + '/3'\n    });\n\n    const enhancedPuffer = (gameProcess.__enhanced || {})[arrived.id] === \"role-yce1tw\";\n    if (enhancedPuffer) {\n        if (player.pufferFreeNext) {\n            player.pufferFreeNext = false;\n            cmd.payload.toll = 0;\n            gameProcess.msgNotifyBroadcast(\"info\", arrived.name + \" å“ˆæ°”äº†ï¼å¼ºåŒ–æ²³è±šå…å•ç”Ÿæ•ˆï¼Œæœ¬æ¬¡è¿‡è·¯è´¹å…¨å…ï¼\");\n        } else {\n            player.pufferFreeNext = true;\n            gameProcess.msgNotifyBroadcast(\"info\", arrived.name + \" è¢«æ”¶äº†è¿‡è·¯è´¹ï¼Œå¼ºåŒ–æ²³è±šè“„åŠ›ï¼šä¸‹ä¸€æ¬¡è¿‡è·¯è´¹å°†å…¨å…ï¼\");\n        }\n        return;\n    }\n    if (player.pufferTollCount % 3 === 0) {\n        cmd.payload.toll = 0;\n        gameProcess.msgNotifyBroadcast('info',\n            arrived.name + ' å“ˆæ°”äº†ï¼ç¬¬' + player.pufferTollCount + 'æ¬¡è¿‡è·¯è´¹å…å•ï¼');\n    }\n});"},{"id":"mod-14idg0","name":"ã€è§’è‰²æŠ€èƒ½ã€‘é€†è¡Œ","slug":"reverse_walker","descriptor":{"autoConsume":false,"commandType":"player.walk","meta":{"description":"æ°¸ä¹…åå‘è¡Œèµ°ï¼šæ¯ä¸€æ­¥éƒ½æœç›¸åæ–¹å‘èµ°ï¼ˆç¬¬ä¸€åœˆç»è¿‡èµ·ç‚¹ä¸é¢†å·¥èµ„ï¼Œä¹‹åæ¯åœˆé€’å¢è¡¥å¿ï¼‰","name":"é€†è¡Œ","source":"è§’è‰²æŠ€èƒ½","tags":["movement"],"triggerTiming":"ç§»åŠ¨å‰"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<ICommandMap, \"player.walk\">, ctx: ICommandContext<ICommandMap, \"player.walk\">) => {\n    cmd.payload.steps = -cmd.payload.steps;\n});"},{"id":"mod-1c2mq0","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·å‡çº§è”åŠ¨","slug":"stock_build_link","descriptor":{"autoConsume":false,"meta":{"description":"è‡ªå·±çš„åœ°äº§å‡çº§æ—¶ï¼Œå¯¹åº”å…¬å¸çš„è‚¡ä»·ä¼šéšä¹‹ä¸Šæ¶¨","name":"è‚¡ä»·å‡çº§è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"å‡çº§å"},"priority":0,"commandType":"property.level.up","remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.level.up\">, ctx: ICommandContext<PropertyCommandMap, \"property.level.up\">) => {\n    const company = property.company;\n    if (!company) { ctx.skip(); return; }\n    const stockId = 'stock_' + company;\n    gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', 1);\n});"},{"id":"mod-4n070f","name":"ã€æœºä¼šå¡ã€‘å¤åˆ©æ•ˆåº”","slug":"compound_interest_boost","descriptor":{"autoConsume":false,"meta":{"description":"å¤åˆ©åŠ æŒï¼šè·å¾—é‡‘é’±æ—¶é‡‘é¢å¢åŠ  20%ï¼ŒæŒç»­ 3 å›åˆåå¤±æ•ˆ","name":"å¤åˆ©æ•ˆåº”","source":"æœºä¼šå¡","tags":["money","buff","compound_interest_boost"],"triggerTiming":"è·å¾—é‡‘é’±æ—¶"},"priority":0,"commandType":"player.money.gain","remainingTriggers":-1,"timing":"before"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.gain\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.gain\">) => {\n    // èµ„äº§å˜ç°å›æµï¼ˆè‚¡ç¥¨å–å‡ºå›æ¬¾ï¼‰ä¸ç®—æ”¶ç›Šï¼Œä¸äº«å—å¤åˆ©åŠ æˆ\n    if (cmd.payload.tag === 'stock_sell') return;\n    cmd.payload.money = Math.ceil(cmd.payload.money * 1.2);\n});"},{"id":"mod-6t40wl","name":"ã€æœºä¼šå¡ã€‘æ—¶é—´å€’æµ","slug":"time_reversal","descriptor":{"autoConsume":true,"meta":{"description":"æœ¬å›åˆç»“æŸæ—¶ï¼Œä½ å°†è¢«ä¼ é€å›æœ¬å›åˆçš„å‡ºå‘ä½ç½®","name":"æ—¶é—´å€’æµ","source":"æœºä¼šå¡","tags":["movement","debuff"],"triggerTiming":"å›åˆç»“æŸ"},"priority":0,"commandType":"player.round.end","remainingTriggers":1,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n  const playerState = player as IPlayer & { timeReversalMapItemId?: string };\n  const savedMapItemId = playerState.timeReversalMapItemId;\n  if (!savedMapItemId) return;\n  if (!gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === savedMapItemId)) {\n    delete playerState.timeReversalMapItemId;\n    gameProcess.msgNotifyBroadcast('warning', `${player.name} çš„æ—¶é—´å€’æµç›®æ ‡å·²ä¸å­˜åœ¨ï¼Œæ•ˆæœå–æ¶ˆã€‚`);\n    return;\n  }\n  if (!player.tpToMapItem) {\n    throw new Error(\"æ–°ç‰ˆ MapPath ä¼ é€ API ä¸å¯ç”¨\");\n  }\n  await player.tpToMapItem(savedMapItemId);\n  delete playerState.timeReversalMapItemId;\n  await gameProcess.handleArriveEvent(player);\n  gameProcess.msgNotifyBroadcast('info', `${player.name} æ—¶å…‰å€’æµï¼Œå›åˆ°äº†å‡ºå‘ä½ç½®ï¼`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: 'æ—¶é—´å€’æµ',\n    content: `<b>${player.name}</b> æ—¶å…‰å€’æµå›åˆ°äº†å‡ºå‘ä½ç½®ï¼`,\n    duration: 3000\n  });\n});"},{"id":"mod-92tduf","name":"ã€æœºä¼šå¡ã€‘åå‘è¡Œèµ°","slug":"reverse_walk","descriptor":{"autoConsume":true,"meta":{"description":"ä¸‹ä¸€æ¬¡è¡Œèµ°åå‘ç§»åŠ¨ï¼šæœç›¸åæ–¹å‘å‰è¿›åŒæ ·çš„æ­¥æ•°","name":"åå‘è¡Œèµ°","source":"æœºä¼šå¡","tags":["movement","debuff"],"triggerTiming":"è¡Œèµ°å‰"},"priority":0,"commandType":"player.walk","remainingTriggers":1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.walk\">, ctx: ICommandContext<PlayerCommandMap, \"player.walk\">) => {\n    cmd.payload.steps = -cmd.payload.steps;\n    await gameProcess.msgNotifyBroadcast('warning', `${player.name} è¢«æ–½åŠ äº†åå‘è¡Œèµ°ï¼ä¸‹ä¸€å›åˆå°†å€’ç€èµ°è·¯`);\n});"},{"id":"mod-98v0co","name":"ã€æœºä¼šå¡ã€‘è”ç›Ÿå…å•","slug":"alliance_toll_free_player","descriptor":{"autoConsume":false,"commandType":"player.money.lose","meta":{"description":"åŒç›Ÿè±å…ï¼šä¸ç»“ç›Ÿç©å®¶ä¹‹é—´äº’ä»˜è¿‡è·¯è´¹æ—¶å…¨é¢å…é™¤","name":"è”ç›Ÿå…å•","source":"æœºä¼šå¡","tags":["alliance"]},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.lose\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.lose\">) => {\n  if (cmd.payload.tag !== MoneyTag.PROPOERTY) {\n    return;\n  }\n\n  const alliance = player.allianceWith;\n  const target = cmd.payload.target;\n  if (!alliance || !target || target.id !== alliance.allyId) {\n    return;\n  }\n\n  if (alliance.remainingTimes <= 0) {\n    delete player.allianceWith;\n    if (ctx.modifierId) {\n      player.modifierManager.removeById(ctx.modifierId);\n    }\n    return;\n  }\n\n  alliance.remainingTimes--;\n  cmd.payload.money = 0;\n\n  gameProcess.msgNotifyBroadcast(\n    'info',\n    `${player.name} è”ç›Ÿå…å•ï¼${target.name} çš„åœ°çš®è¿‡è·¯è´¹å…é™¤ï¼ˆå‰©ä½™ ${alliance.remainingTimes} æ¬¡ï¼‰`\n  );\n\n  if (alliance.remainingTimes <= 0) {\n    delete player.allianceWith;\n    if (ctx.modifierId) {\n      player.modifierManager.removeById(ctx.modifierId);\n    }\n  }\n});"},{"id":"mod-9ivu3z","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·è´­ä¹°è”åŠ¨","slug":"stock_buy_link","descriptor":{"autoConsume":false,"meta":{"description":"è‡ªå·±çš„åœ°äº§è¢«ä»–äººè´­ä¹°æ—¶ï¼Œå¯¹åº”å…¬å¸çš„è‚¡ä»·ä¼šéšä¹‹ä¸Šæ¶¨","name":"è‚¡ä»·è´­ä¹°è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"æ˜“ä¸»å"},"priority":0,"commandType":"property.owner.change","remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.owner.change\">, ctx: ICommandContext<PropertyCommandMap, \"property.owner.change\">) => {\n  const result = ctx.result;\n  if (!result || !result.newOwner) { ctx.skip(); return; }\n  const company = property.company;\n  if (!company) { ctx.skip(); return; }\n  const stockId = 'stock_' + company;\n  const sellCost = property.sellCost;\n  const intensity = Math.min(sellCost / 1000, 2);\n  gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', intensity);\n});"},{"id":"mod-9wr1vl","name":"ã€æœºä¼šå¡ã€‘æ³¡æ²«ç»æµç¿»å€","slug":"foam_economy_double","descriptor":{"autoConsume":false,"commandType":"property.arrived","meta":{"description":"æ³¡æ²«ç»æµï¼šç©å®¶è¿›å…¥ä½ çš„åœ°äº§æ—¶ï¼Œè¿‡è·¯è´¹ç¿»å€æ”¶å–","name":"æ³¡æ²«ç»æµç¿»å€","source":"æœºä¼šå¡","tags":["property","buff"]},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n  // æ£€æŸ¥æ˜¯å¦æœ‰ä¸šä¸»\n  const owner = cmd.payload.owner;\n  if (!owner) {\n    ctx.skip();\n    return;\n  }\n\n  // æ£€æŸ¥ä¸šä¸»æ˜¯å¦åœ¨æ³¡æ²«ç»æµä¸­\n  if (!owner.foamEconomyRound) {\n    ctx.skip();\n    return;\n  }\n\n  // ç¿»å€è¿‡è·¯è´¹ï¼ˆå¦‚æœå­˜åœ¨ï¼‰\n  if (cmd.payload.toll) {\n    cmd.payload.toll *= 2;\n  }\n});"},{"id":"mod-enh-demolition","name":"ã€å¼ºåŒ–ã€‘å¼ºåŒ–æ‹†è¿","slug":"demolition_plus","descriptor":{"autoConsume":false,"commandType":"property.arrived","timing":"after","remainingTriggers":-1,"priority":0,"meta":{"name":"å¼ºåŒ–æ‹†è¿","description":"ä¿®ç‹—æ¯æ¬¡ä»˜è¿‡è·¯è´¹æ—¶ï¼Œç›´æ¥ä½¿å¯¹æ–¹åœ°äº§é™ä¸€çº§ï¼ˆæ— éœ€é¢å¤–è´¹ç”¨ï¼‰","source":"è§’è‰²å¼ºåŒ–","tags":["property"]}},"effectCode":"(async (property, gameProcess, cmd, ctx) => {\n    const arrived = cmd.payload.arrivedPlayer;\n    const owner = property.owner;\n    const toll = cmd.payload.toll;\n    if (!owner || arrived.id === owner.id || !toll || toll <= 0) { ctx.skip(); return; }\n    if (ctx.modifierData?.playerId !== arrived.id) { ctx.skip(); return; }\n    if (!((gameProcess.__enhanced || {})[arrived.id] === \"role-6nd6bp\")) { ctx.skip(); return; }\n    if (property.level > 0) {\n        await property.levelDown();\n        gameProcess.msgNotifyBroadcast(\"info\", arrived.name + \" çš„å¼ºåŒ–ä¿®ç‹—è£…ç½®ç”Ÿæ•ˆï¼\" + property.name + \" ç›´æ¥é™ä¸º Lv.\" + property.level);\n    }\n});"},{"id":"mod-enh-fate-plus","name":"ã€å¼ºåŒ–ã€‘å‘½è¿æ“æ§","slug":"fate_controller_plus","descriptor":{"autoConsume":false,"commandType":"player.dice.roll","timing":"after","remainingTriggers":-1,"priority":0,"meta":{"name":"å‘½è¿æ“æ§Â·å¼ºåŒ–","description":"æ¯æ¬¡æ·éª°å100%è§¦å‘ï¼šå¯é€‰æ‹©é‡æ·ä¸€é¢—æˆ–ä¸¤é¢—éª°å­ï¼ˆä¹Ÿå¯ä»¥ä¸é‡æ·ï¼‰ï¼Œç›´æ¥ä½¿ç”¨æ–°ç»“æœ","source":"è§’è‰²å¼ºåŒ–","tags":["dice"]}},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n    const diceResult = (ctx.result as any)?.diceResult;\n    if (!diceResult || diceResult.length === 0) { ctx.skip(); return; }\n    gameProcess.setCurrentEventName(player.name + \" å‘½è¿æ“æ§Â·å¼ºåŒ–\");\n    const items = diceResult.map((r: any, i: number) => ({ id: String(i), display: { id: \"dice-card-\" + i, type: \"div\", variable: { diceIndex: i + 1, diceValue: r.result }, children: [$ui__dice_select_card] } }));\n    const sel = await gameProcess.showItemSelectDialog(player.id, { title: \"å‘½è¿æ“æ§Â·å¼ºåŒ– - é€‰æ‹©è¦é‡æ·çš„éª°å­\", itemList: items, multiple: 2, cancelText: \"ä¸é‡æ·\" });\n    const idxs = (sel.selected || []).map(Number).slice(0, 2);\n    if (idxs.length === 0) { ctx.skip(); return; }\n    const modified = diceResult.slice();\n    const olds = [], news = [];\n    for (const idx of idxs) {\n        const oldResult = diceResult[idx].result;\n        const newResult = (cmd.payload as any).dices[idx].roll();\n        modified[idx] = newResult;\n        olds.push(oldResult); news.push(newResult);\n    }\n    gameProcess.gameBroadcast({ type: SocketMsgType.RollDiceResult, source: SocketMsgSource.Server, data: { rollDiceResult: news, rollDicePlayerId: player.id }, msg: { type: \"info\", content: player.name + \" å‘åŠ¨å¼ºåŒ–å‘½è¿æ“æ§ï¼é‡æ· \" + idxs.length + \" é¢—\" } });\n    await new Promise((resolve) => setTimeout(resolve, 2000));\n    ctx.setResult({ diceResult: modified });\n    gameProcess.msgNotifyBroadcast(\"warning\", player.name + \" å¼ºåŒ–å‘½è¿æ“æ§ï¼\" + idxs.map((idx, k) => \"éª°å­\" + (idx + 1) + \": \" + olds[k].result + \" â†’ \" + news[k].result).join(\"ï¼Œ\"));\n});"},{"id":"mod-enh-shrimp-dice","name":"ã€å¼ºåŒ–ã€‘çè™¾ä¸‰éª°","slug":"shrimp_dice_plus","descriptor":{"autoConsume":false,"commandType":"player.round.start","timing":"after","remainingTriggers":-1,"priority":0,"meta":{"name":"ä¸‰éª°æˆæƒ","description":"çè™¾å›åˆå¼€å§‹æ—¶éª°å­è¡¥é½è‡³ä¸‰æšï¼ˆæ°¸ä¹…ä¸‰æšéª°å­ä½¿ç”¨æƒï¼‰","source":"è§’è‰²å¼ºåŒ–","tags":["dice"]}},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n    if (!((gameProcess.__enhanced || {})[player.id] === \"role-updhap\")) return;\n    let guard = 0;\n    while ((player.dices || []).length < 3 && guard++ < 5) { await player.addDice(); }\n    if (guard > 0) gameProcess.msgNotifyBroadcast(\"info\", player.name + \" çš„å¼ºåŒ–çè™¾è£…ç½®è¡¥é½äº†éª°å­ï¼ˆå…± 3 æšï¼‰ï¼\");\n});"},{"id":"mod-enh-stock-all","name":"ã€å¼ºåŒ–ã€‘è‚¡è‚¡å…¨å‘˜å†…å¹•","slug":"stock_expert_all","descriptor":{"autoConsume":false,"commandType":"player.round.start","timing":"after","remainingTriggers":-1,"priority":0,"meta":{"name":"å…¨å‘˜å†…å¹•","description":"å›åˆå¼€å§‹æ—¶ç›´æ¥è·å¾—æ‰€æœ‰è‚¡ç¥¨çš„æœºå¯†è¯„çº§","source":"è§’è‰²å¼ºåŒ–","tags":["stock"]}},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n    const sm = gameProcess.stockMarket;\n    if (!sm || !sm.data.isOpen) return;\n    function getRating(trend, heat) { const score = trend * 0.7 + heat * 0.3; if (score > 0.5) return \"å¤¯çˆ†äº†\"; if (score > 0.3) return \"é¡¶çº§\"; if (score > 0.1) return \"äººä¸Šäºº\"; if (score > -0.2) return \"NPC\"; return \"æ‹‰å®Œäº†\"; }\n    const lines = (sm.data.stocks || []).map((stock) => stock.name + \"ï¼šæœºå¯†è¯„çº§ã€Œ\" + getRating(stock.trend || 0, stock.heat || 0) + \"ã€\");\n    if (lines.length === 0) return;\n    await gameProcess.showConfirmDialog(player.id, {\n      title: \"è‚¡è‚¡å˜å˜ - å…¨å‘˜å†…å¹•\",\n      content: \"æœ¬å‘¨è‚¡å¸‚æœºå¯†è¯„çº§ï¼š\\n\" + lines.join(\"\\n\"),\n      confirmText: \"çŸ¥é“äº†\",\n      closable: true,\n    });\n});"},{"id":"mod-f4jozz","name":"ã€è§’è‰²æŠ€èƒ½ã€‘åŠæ­¥","slug":"half_walker","descriptor":{"autoConsume":false,"commandType":"player.walk","meta":{"description":"ä½¿ç”¨ç‚¹æ•°ä¸º [2,4,5,6,7,9] çš„å¤§éª°å­ï¼Œä½†æ¯æ­¥è¡Œç¨‹å‡åŠï¼ˆå‘ä¸Šå–æ•´ï¼‰","name":"åŠæ­¥","source":"è§’è‰²æŠ€èƒ½","tags":["movement"],"triggerTiming":"è¡Œèµ°å‰"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.walk\">, ctx: ICommandContext<PlayerCommandMap, \"player.walk\">) => {\n    cmd.payload.steps = Math.ceil(cmd.payload.steps / 2);\n});"},{"id":"mod-gh4oyb","name":"ã€æœºä¼šå¡ã€‘ç»æµå¯’å†¬","slug":"economic_winter_debuff","descriptor":{"autoConsume":false,"commandType":"player.money.gain","meta":{"description":"ç»æµå¯’å†¬ï¼šè·å¾—é‡‘é’±æ—¶é‡‘é¢å‡å°‘ 20%ï¼ŒæŒç»­ 3 å›åˆåå¤±æ•ˆ","name":"ç»æµå¯’å†¬","source":"æœºä¼šå¡","tags":["money","debuff"],"triggerTiming":"è·å¾—é‡‘é’±æ—¶"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.gain\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.gain\">) => {\n    cmd.payload.money = Math.floor(cmd.payload.money * 0.8);\n});"},{"id":"mod-is33dj","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·æ”¶ç§Ÿè”åŠ¨","slug":"stock_rent_link","descriptor":{"autoConsume":false,"meta":{"description":"è‡ªå·±æ”¶å–åœ°äº§è¿‡è·¯è´¹æ—¶ï¼Œå¯¹åº”å…¬å¸çš„è‚¡ä»·ä¼šéšä¹‹ä¸Šæ¶¨","name":"è‚¡ä»·æ”¶ç§Ÿè”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"æ”¶ç§Ÿå"},"priority":0,"commandType":"property.arrived","remainingTriggers":-1,"timing":"after"},"effectCode":"(async ( property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n    const result = ctx.result;\n    if (!result || !result.toll || result.toll <= 0) { ctx.skip(); return; }\n    const company = property.company;\n    if (!company) { ctx.skip(); return; }\n    const stockId = 'stock_' + company;\n    const intensity = Math.min(result.toll / 500, 3);\n    gameProcess.stockMarket.triggerEvent(stockId, 'RENT', intensity);\n});"},{"id":"mod-j5d4t4","name":"ã€æœºä¼šå¡ã€‘å¤åˆ©æ•ˆåº”æ¸…ç†","slug":"compound_interest_cleanup","descriptor":{"autoConsume":true,"meta":{"description":"ï¼ˆç³»ç»Ÿï¼‰å¤åˆ©æ•ˆåº”è¿˜å‰© 3 ä¸ªå›åˆï¼Œåˆ°æœŸè‡ªåŠ¨ç§»é™¤","name":"å¤åˆ©æ•ˆåº”","source":"æœºä¼šå¡","tags":["money","buff"],"triggerTiming":"å›åˆç»“æŸæ—¶"},"priority":0,"commandType":"player.round.end","remainingTriggers":3,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n    \n});"},{"id":"mod-k1ohbh","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·é™çº§è”åŠ¨","slug":"stock_downgrade_link","descriptor":{"autoConsume":false,"commandType":"property.level.down","meta":{"description":"è‡ªå·±çš„åœ°äº§é™çº§æ—¶ï¼Œå¯¹åº”å…¬å¸çš„è‚¡ä»·ä¼šéšä¹‹ä¸‹è·Œ","name":"è‚¡ä»·é™çº§è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"é™çº§å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.level.down\">, ctx: ICommandContext<PropertyCommandMap, \"property.level.down\">) => {\n  const company = property.company;\n  if (!company) { ctx.skip(); return; }\n  const stockId = 'stock_' + company;\n  gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', -1);\n});"},{"id":"mod-kstz78","name":"ã€æœºä¼šå¡ã€‘å‘½è¿éª°å’’","slug":"dice_curse","descriptor":{"autoConsume":false,"meta":{"description":"å‘½è¿éª°å’’ï¼šè®°å½•æ¥ä¸‹æ¥ 3 æ¬¡æ·éª°çš„ç‚¹æ•°ï¼Œç¬¬ 3 æ¬¡ç»“ç®—ç´¯è®¡ç‚¹æ•° Ã—10 çš„ä¼¤å®³","name":"å‘½è¿éª°å’’","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.dice.roll","remainingTriggers":3,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const data = player.diceCurse;\n    if (!data || data.resolved) return;\n    if (!ctx.result) return;\n    const rollTotal = (ctx.result as any).diceResult.reduce((sum: number, dr: any) => sum + dr.result, 0);\n    data.rolls.push(rollTotal);\n    const count = data.rolls.length;\n    gameProcess.msgNotifyBroadcast('info', `${player.name} å‘½è¿éª°å’’è®°å½• ${count}/3ï¼šæœ¬æ¬¡ ${rollTotal} ç‚¹`);\n    if (count >= 3) {\n        data.resolved = true;\n        if (player.isBankrupted) {\n            gameProcess.msgNotifyBroadcast('warning', `${player.name} å·²ç ´äº§ï¼Œå‘½è¿éª°å’’ä½œåºŸï¼`);\n        } else {\n            const total = data.rolls.reduce((a: number, b: number) => a + b, 0);\n            const damage = total * 10;\n            await player.cost(damage, 'CARD');\n            gameProcess.msgNotifyBroadcast('warning', `${player.name} å‘½è¿éª°å’’ç»“ç®—ï¼3æ¬¡æ·éª°å…± ${total} ç‚¹ï¼Œå—åˆ° ${damage} ç‚¹ä¼¤å®³ï¼`);\n        }\n    }\n});"},{"id":"mod-mod-bankloan-repay","name":"ã€ç‰¹æ®Šåœ°ç‚¹ã€‘é“¶è¡Œè´·æ¬¾è¿˜æ¬¾å™¨","slug":"bankloan_repay","descriptor":{"autoConsume":true,"commandType":"player.round.end","meta":{"description":"é“¶è¡Œè´·æ¬¾ï¼šæœªè¿˜æ¸…è´·æ¬¾æ—¶ä¸èƒ½å†æ¬¡è´·æ¬¾ï¼›æ¯æ¬¡ç»è¿‡èµ·ç‚¹è‡ªåŠ¨å¿è¿˜ 1 æœŸï¼Œç¦»å¼€èµ·ç‚¹åçš„é¦–ä¸ªå›åˆç»“æŸç‚¹æ‰£æ¬¾","name":"é“¶è¡Œè´·æ¬¾è¿˜æ¬¾","source":"ç‰¹æ®Šåœ°ç‚¹","tags":["bankloan"]},"priority":0,"remainingTriggers":999,"timing":"after"},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n  const loan = (gameProcess.bankloanDebts || {})[player.id];\n  if (!loan || !(loan.left > 0)) {\n    player.modifierManager.removeByTag(\"bankloan\");\n    ctx.skip();\n    return;\n  }\n  if (!loan.due || player.positionMapItemId === loan.startId) {\n    ctx.skip(); // æœªæŒ‚è´¦ï¼Œæˆ–äººè¿˜ç«™åœ¨èµ·ç‚¹ä¸Šï¼šä¸æ‰£æ¬¾ä¹Ÿä¸æ¶ˆè€—æ¬¡æ•°\n    return;\n  }\n  loan.due = false;\n  await player.cost(loan.per, \"system\");\n  loan.left--;\n  if (loan.left > 0) {\n    gameProcess.msgNotifyBroadcast('warning', player.name + ' å¿è¿˜é“¶è¡Œè´·æ¬¾ ï¿¥' + loan.per + 'ï¼Œå‰©ä½™ ' + loan.left + ' æœŸ');\n  } else {\n    delete gameProcess.bankloanDebts[player.id];\n    player.modifierManager.removeByTag(\"bankloan\");\n    gameProcess.msgNotifyBroadcast('success', player.name + ' çš„é“¶è¡Œè´·æ¬¾å·²å…¨éƒ¨è¿˜æ¸…ï¼');\n  }\n  gameProcess.gameDataBroadcast();\n});"},{"id":"mod-mod-hot-spring","name":"ã€ç‰¹æ®Šåœ°ç‚¹ã€‘æ¸©æ³‰ç¥è¡Œ","slug":"hot_spring_lucky","descriptor":{"autoConsume":true,"commandType":"player.dice.roll","meta":{"description":"æ¸©æ³‰ç¥è¡Œï¼šæ¥ä¸‹æ¥ 3 æ¬¡æ·éª°çš„æ¯æšéª°å­å¿…å®šä¸º 5 æˆ– 6ï¼ˆèµ°å¾—åˆå¿«åˆè¿œï¼‰","name":"æ¸©æ³‰ç¥è¡Œ","source":"ç‰¹æ®Šåœ°ç‚¹","tags":["dice"],"triggerTiming":"æ·éª°å­æ—¶"},"priority":0,"remainingTriggers":3,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n  // æ¸©æ³‰æ•ˆæœä»…ä½œç”¨äºè¡Œèµ°ç”¨éª°ï¼šæ¶ˆè´¹å›åˆæ·éª° phase åœ¨æ‰§è¡Œæ·éª°å‘½ä»¤å‰ç½® __walkingRoll æ ‡è®°ã€‚\n  // éè¡Œèµ°æ·éª°ï¼ˆéª°å­è€è™æœºç­‰æœºä¼šå¡æŒ‰ç‚¹æ•°æ¢é’±ï¼‰æ— æ ‡è®° â†’ ä¸è®¾é¢„è¨€ã€ä¸æ¶ˆè€—æ¬¡æ•°ã€‚\n  const walking = gameProcess.__walkingRoll === true;\n  if (!walking) { ctx.skip(); return; }\n  const realDices = (cmd.payload as any).dices;\n  if (!realDices || realDices.length === 0) { ctx.skip(); return; }\n  const force = (player as any).hotSpringForce || 0; // 9=çŒªçŒªå¿…9ï¼›0=æ™®é€šå¿…5æˆ–6\n  // æ·å‰é€æšè®¾ç½®é¢„è¨€ï¼šroll() æœ¬èº«å³å‡º 5/6ï¼ˆçŒªçŒª 9ï¼‰ï¼Œæ·éª°åŠ¨ç”»ç›´æ¥æ˜¾ç¤ºé¢„è¨€ç‚¹æ•°ï¼Œæ— äº‹åæ”¹ç‚¹ã€‚\n  // prophecy åœ¨ roll() å†…å•æ¬¡æ¶ˆè´¹è‡ªæ¸…ï¼Œæ— éœ€äº‹åæ¸…ç†ã€‚\n  for (let i = 0; i < realDices.length; i++) {\n    const faces = (realDices[i] as any).diceValues as number[] | undefined;\n    // å·²å¿… 5/6 çš„éª°ï¼ˆå¦‚èƒ½é‡é¥®æ–™ 6 ç‚¹éª°ï¼‰ä¸å†è¦†å†™ï¼Œä¿ç•™å…¶åŸä¿è¯ï¼›çŒªçŒª(9)ä»å…¨è¦†å†™ï¼ˆä¸åŸè¡Œä¸ºä¸€è‡´ï¼‰\n    if (force !== 9 && Array.isArray(faces) && faces.length > 0 && faces.every((f) => f === 5 || f === 6)) continue;\n    realDices[i].setProphecy(force === 9 ? 9 : (Math.random() < 0.5 ? 5 : 6)); // æ¯æšéª°å­ç‹¬ç«‹éšæœº\n  }\n  gameProcess.msgNotifyBroadcast(\"info\", force === 9\n    ? player.name + \" çŒªçŒªæ¸©æ³‰è¶…è½½ç”Ÿæ•ˆï¼æœ¬æ¬¡æ¯æšéª°å­å¿…å®šæ˜¯ 9\"\n    : player.name + \" æ¸©æ³‰ç¥è¡Œç”Ÿæ•ˆï¼æœ¬æ¬¡æ¯æšéª°å­å¿…å®šæ˜¯ 5 æˆ– 6\");\n})"},{"id":"mod-mod-rideshare","name":"ã€ç‰¹æ®Šåœ°ç‚¹ã€‘é¡ºé£è½¦è·Ÿéš","slug":"rideshare","descriptor":{"autoConsume":true,"commandType":"player.walk","meta":{"description":"é¡ºé£è½¦è·Ÿéšï¼šæœ¬æ¬¡è¡Œèµ°ç»“æŸåï¼Œæ­è½¦çš„ç©å®¶å°†æŒ‰è‡ªå·±çš„æ–¹å‘å…è´¹è·Ÿèµ°ç›¸åŒæ­¥æ•°","name":"é¡ºé£è½¦è·Ÿéš","source":"ç‰¹æ®Šåœ°ç‚¹","tags":["rideshare"]},"priority":0,"remainingTriggers":1,"timing":"after"},"effectCode":"(async (walker, gameProcess, cmd, ctx) => {\n  const riderId = ctx.modifierData && ctx.modifierData.riderId;\n  if (!riderId) { ctx.skip(); return; }\n  const rider = gameProcess.players.get(riderId);\n  if (!rider || rider.isBankrupted) { ctx.skip(); return; }\n  if ((rider.isStop || 0) > 0) { ctx.skip(); return; }\n  const rawSteps = cmd.payload && cmd.payload.steps;\n  if (!rawSteps || Math.abs(rawSteps) <= 0) { ctx.skip(); return; }\n  const steps = Math.abs(rawSteps); // è·Ÿèµ°æ–¹å‘æŒ‰æ­è½¦è€…è‡ªå·±çš„è¡Œèµ°æ–¹å‘ï¼ˆæ­£å‘ï¼‰ï¼Œåªå¤åˆ¶æ­¥æ•°\n  rider.buffManager.removeBuff(\"rideshare-wait-\" + rider.id);\n  await rider.commandBus.execute({ type: \"player.walk\", payload: { steps: steps } });\n  await gameProcess.handleArriveEvent(rider);\n  gameProcess.msgNotifyBroadcast(\"warning\", rider.name + \" æ­äº† \" + walker.name + \" çš„é¡ºé£è½¦ï¼Œå…è´¹è·Ÿèµ° \" + Math.abs(steps) + \" æ ¼ï¼\");\n  gameProcess.gameDataBroadcast();\n})"},{"id":"mod-mod-skill-cat","name":"ã€æŠ€èƒ½è®­ç»ƒè¥ã€‘é­”æ³•çŒ«å’ªä¹‹åŠ›","slug":"skill_cat","descriptor":{"autoConsume":true,"commandType":"player.dice.roll","priority":0,"remainingTriggers":3,"timing":"after"},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n  if (gameProcess.__walkingRoll !== true) { ctx.skip(); return; } // éè¡Œèµ°æ·éª°ï¼ˆè€è™æœº/å†³æ–—ç­‰ï¼‰ä¸è§¦å‘é‡æ·ï¼Œä¸æ¶ˆè€—æ¬¡æ•°\n  const diceResult = ctx.result && ctx.result.diceResult;\n  if (!diceResult || diceResult.length === 0) { ctx.skip(); return; }\n  const items = diceResult.map((r, i) => ({ id: String(i), display: \"éª°å­\" + (i + 1) + \"ï¼š\" + r.result + \" ç‚¹\" }));\n  const res = await gameProcess.showItemSelectDialog(player.id, { title: \"é­”æ³•çŒ«å’ªä¹‹åŠ› - é€‰æ‹©è¦é‡æ·çš„éª°å­\", itemList: items, cancelText: \"ä¸é‡æ·\" });\n  if (!res.selected || res.selected.length === 0) { ctx.skip(); return; }\n  const idx = Number(res.selected[0]);\n  if (isNaN(idx) || !diceResult[idx]) { ctx.skip(); return; }\n  const oldResult = diceResult[idx].result;\n  const newResult = cmd.payload.dices[idx].roll();\n  const modified = diceResult.slice();\n  modified[idx] = newResult;\n  gameProcess.gameBroadcast({ type: SocketMsgType.RollDiceResult, source: SocketMsgSource.Server, data: { rollDiceResult: [newResult], rollDicePlayerId: player.id }, msg: { type: \"info\", content: player.name + \" å‘åŠ¨é­”æ³•çŒ«å’ªä¹‹åŠ›ï¼é‡æ·éª°å­\" + (idx + 1) } });\n  ctx.setResult({ diceResult: modified });\n  const csC = gameProcess.campSkill = gameProcess.campSkill || {};\n  csC[player.id + \"cat\"] = Math.max(0, (csC[player.id + \"cat\"] || 0) - 1);\n  if (csC[player.id + \"cat\"] > 0) player.buffManager.updateBuff(\"skill-cat-\" + player.id, { triggerTimes: csC[player.id + \"cat\"] });\n  else player.buffManager.removeBuff(\"skill-cat-\" + player.id);\n  gameProcess.msgNotifyBroadcast(\"warning\", player.name + \" å‘åŠ¨é­”æ³•çŒ«å’ªä¹‹åŠ›ï¼éª°å­\" + (idx + 1) + \": \" + oldResult + \" â†’ \" + newResult.result);\n  await new Promise((r) => setTimeout(r, 3000)); // ç­‰é‡æ·éª°å­åŠ¨ç”»æ’­å®Œï¼ˆæŠ›æ·+æ’åˆ—å…±3sï¼‰è§’è‰²å†å¼€å§‹è¡Œèµ°\n})"},{"id":"mod-mod-skill-demolition","name":"ã€æŠ€èƒ½è®­ç»ƒè¥ã€‘ä¿®ç‹—ä¹‹åŠ›","slug":"skill_demolition","descriptor":{"autoConsume":true,"commandType":"property.arrived","meta":{"description":"ä¸‹ä¸€æ¬¡ä»˜è¿‡è·¯è´¹æ—¶å¯æ”¯ä»˜1.5å€è´¹ç”¨ä½¿å¯¹æ–¹åœ°äº§é™ä¸€çº§","name":"ä¿®ç‹—ä¹‹åŠ›","source":"æŠ€èƒ½è®­ç»ƒè¥","tags":["camp"]},"priority":0,"remainingTriggers":1,"timing":"after"},"effectCode":"(async (property, gameProcess, cmd, ctx) => {\n  const arrived = cmd.payload.arrivedPlayer;\n  const owner = property.owner;\n  const toll = cmd.payload.toll;\n  if (!owner || arrived.id === owner.id || !toll || toll <= 0) { ctx.skip(); return; }\n  if (ctx.modifierData?.playerId !== arrived.id) { ctx.skip(); return; }\n  const csD = gameProcess.campSkill = gameProcess.campSkill || {};\n  if (!(csD[arrived.id + \"dog\"] > 0)) { ctx.skip(); return; }\n  csD[arrived.id + \"dog\"] = 0;\n  if (owner.buffManager) owner.buffManager.removeBuff(\"skill-dog-\" + owner.id);\n  const confirmResult = await gameProcess.showConfirmDialog(arrived.id, { title: \"ä¿®ç‹—ä¹‹åŠ›\", content: \"è¦æ”¯ä»˜ 1.5 å€è¿‡è·¯è´¹ï¼ˆï¿¥\" + Math.ceil(toll * 1.5) + \"ï¼‰ä½¿ \" + property.name + \" é™ä¸€çº§å—ï¼Ÿ\" });\n  if (!confirmResult.confirm) { ctx.skip(); return; }\n  const doubleToll = Math.ceil(toll * 1.5);\n  const costRes = await arrived.cost(doubleToll, MoneyTag.PLAYER, owner);\n  if (costRes.actualCost >= doubleToll) {\n    await property.levelDown();\n    gameProcess.msgNotifyBroadcast(\"warning\", arrived.name + \" å‘åŠ¨ä¿®ç‹—ä¹‹åŠ›ï¼æ”¯ä»˜ ï¿¥\" + costRes.actualCost + \"ï¼Œ\" + property.name + \" é™ä¸º Lv.\" + property.level);\n  }\n})"},{"id":"mod-mod-skill-stock","name":"ã€æŠ€èƒ½è®­ç»ƒè¥ã€‘è‚¡è‚¡å˜å˜ä¹‹åŠ›","slug":"skill_stock","descriptor":{"autoConsume":true,"commandType":"player.round.start","priority":0,"remainingTriggers":3,"timing":"after"},"effectCode":"(async (player, gameProcess, cmd, ctx) => {\n  const result = await gameProcess.peekStockTrend(player.id, { title: \"å†…å¹•æ¶ˆæ¯ - é€‰æ‹©è¦æŸ¥çœ‹çš„è‚¡ç¥¨\", cancelText: \"ä¸æŸ¥çœ‹\", column: 3 });\n  if (!result) { ctx.skip(); return; }\n  const cs = gameProcess.campSkill = gameProcess.campSkill || {};\n  cs[player.id + \"stock\"] = Math.max(0, (cs[player.id + \"stock\"] || 0) - 1);\n  if (cs[player.id + \"stock\"] > 0) player.buffManager.updateBuff(\"skill-stock-\" + player.id, { triggerTimes: cs[player.id + \"stock\"] });\n  else player.buffManager.removeBuff(\"skill-stock-\" + player.id);\n  gameProcess.messageNotify([player.id], { type: \"info\",