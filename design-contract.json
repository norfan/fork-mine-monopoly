{
  "schema_version": "6.0",
  "task": {
    "title": "MineMonopoly 离线桌游模式改造 PRD",
    "source_text": "我要改造这个项目，不需要在线联机游玩，就离线游玩，仅用一台手机软件当主控器，多个玩家围绕手机进行操作（最多支持8个人一起游玩），同时需要准备实体道具，有没有什么方案？哪些需要作为实体道具？实体清单能不能简单一点，如果只有钞票，其他都在手机上可以么？",
    "readiness_target": "draft",
    "flags": {
      "capacity": true,
      "handoff": true,
      "html": false,
      "lifecycle": true,
      "numbers": true,
      "persistence": false,
      "probability": false,
      "production": true,
      "resources": false,
      "scope_constraints": true
    }
  },
  "authority": {
    "allowed_changes": [
      {
        "id": "ALLOW-OFFLINE",
        "category": "rule",
        "description": "改造为离线单机游玩，主控器不依赖在线联机",
        "source_quote": "不需要在线联机游玩，就离线游玩",
        "fields": ["network.online_requirement"]
      },
      {
        "id": "ALLOW-HOST-PHONE",
        "category": "rule",
        "description": "仅用一台手机软件当主控器",
        "source_quote": "仅用一台手机软件当主控器",
        "fields": ["host.device"]
      },
      {
        "id": "ALLOW-8P",
        "category": "parameter",
        "description": "最多支持8个人一起游玩",
        "source_quote": "最多支持8个人一起游玩",
        "fields": ["player.max_count"]
      },
      {
        "id": "ALLOW-PHYSICAL",
        "category": "content",
        "description": "准备实体道具配合游玩",
        "source_quote": "需要准备实体道具",
        "fields": ["physical.props"]
      },
      {
        "id": "ALLOW-MINIMAL-PROPS",
        "category": "rule",
        "description": "实体清单可简化：仅保留钞票，棋盘/棋子/卡牌等数字化到手机",
        "source_quote": "实体清单能不能简单一点，如果只有钞票，其他都在手机上可以么",
        "fields": ["physical.props.mode"]
      }
    ],
    "forbidden_changes": [
      {
        "id": "BAN-PLAYER-DEVICES",
        "category": "rule",
        "description": "不新增玩家自有设备接入，游玩围绕唯一主控手机进行",
        "source_quote": "仅用一台手机软件当主控器，多个玩家围绕手机进行操作",
        "fields": ["player.devices"]
      },
      {
        "id": "BAN-REALTIME-SYNC",
        "category": "rule",
        "description": "不引入玩家间实时同步通道，改造后主流程离线可玩",
        "source_quote": "不需要在线联机游玩",
        "fields": ["network.realtime_sync"]
      }
    ],
    "proposed_changes": [
      {
        "id": "CHG-OFFLINE-MODE",
        "category": "rule",
        "description": "主流程去除在线依赖：游戏逻辑单机运行，手机作为主控器执行规则与记账",
        "problem": "现有架构依赖中央服务器认证与玩家间同步，离线场景无法启动",
        "scope_effect": "modify",
        "responsibilities": ["program", "config", "qa"],
        "tradeoff": "",
        "authority_ids": ["ALLOW-OFFLINE"],
        "fields": ["network.online_requirement"],
        "priority": "P0"
      },
      {
        "id": "CHG-HOST-ROLE",
        "category": "rule",
        "description": "手机角色从对等客户端变为主控器：驱动回合、裁决规则、权威记账",
        "problem": "多人围绕单台手机操作需要统一的操作入口与权威状态",
        "scope_effect": "modify",
        "responsibilities": ["program", "ui", "qa"],
        "tradeoff": "",
        "authority_ids": ["ALLOW-HOST-PHONE"],
        "fields": ["host.device"],
        "priority": "P0"
      },
      {
        "id": "CHG-8P",
        "category": "parameter",
        "description": "玩家席位上限设为 8 人",
        "problem": "聚会场景需要明确的座位与人数容量",
        "scope_effect": "modify",
        "responsibilities": ["program", "config", "qa"],
        "tradeoff": "",
        "authority_ids": ["ALLOW-8P"],
        "fields": ["player.max_count"],
        "priority": "P0"
      },
      {
        "id": "CHG-DUAL-MODE",
        "category": "rule",
        "description": "实体道具双档：极简档（仅钞票，数字棋盘）与桌游档（钞票+实体棋盘），开局设置选择",
        "problem": "实体清单需可简化：只有钞票时手机必须渲染棋盘，其他状态数字化",
        "scope_effect": "add",
        "responsibilities": ["program", "ui", "content", "qa"],
        "tradeoff": "桌游档的实体棋盘/卡牌为可选增强，不强制准备；两档共享同一规则与记账",
        "authority_ids": ["ALLOW-MINIMAL-PROPS", "ALLOW-PHYSICAL", "ALLOW-HOST-PHONE"],
        "fields": ["physical.props.mode"],
        "priority": "P0"
      }
    ]
  },
  "assumptions": [
    {
      "id": "ASM-PHONE-OS",
      "statement": "主控器手机以 Android 为主（现有 Capacitor 管线），iOS 作为后续适配目标",
      "impact": "high",
      "status": "test_value",
      "validation": "由项目当前构建管线与目标设备确认"
    },
    {
      "id": "ASM-KEEP-EDITOR",
      "statement": "地图编辑器保留，用于导出可打印棋盘（桌游档）与地图数据",
      "impact": "high",
      "status": "confirmed",
      "validation": "项目现状：map-editor 已有地图构建与导出能力"
    },
    {
      "id": "ASM-RENDER-REUSE",
      "statement": "极简档数字棋盘复用客户端 Three.js/PixiJS 渲染能力",
      "impact": "high",
      "status": "test_value",
      "validation": "由客户端现有渲染管线确认"
    }
  ],
  "rules": [
    {
      "id": "RULE-ROUND",
      "title": "回合主控规则",
      "definition": "手机主控器按座位顺序驱动回合；当前回合玩家操作手机完成掷骰与结算，其余玩家观察公共状态。",
      "priority": "P0",
      "parameter_ids": ["PAR-MAX-PLAYERS"],
      "state_machine_ids": ["SM-GAME"],
      "authority_ids": ["ALLOW-HOST-PHONE", "ALLOW-8P"],
      "fields": ["host.device", "player.max_count"]
    },
    {
      "id": "RULE-MONEY",
      "title": "资产记账规则",
      "definition": "手机主控器为资产权威记账端；玩家可选择实体钞票双轨（实体为演示、手机为权威）或纯手机记账，由开局设置开关决定。",
      "priority": "P0",
      "parameter_ids": ["PAR-START-MONEY"],
      "authority_ids": ["ALLOW-PHYSICAL"],
      "fields": ["physical.props"]
    },
    {
      "id": "RULE-DICE",
      "title": "骰子输入规则",
      "definition": "默认手机内掷骰（防作弊、免道具）；可选实体骰子 + 手机确认结果，由开局设置开关决定。",
      "priority": "P0",
      "authority_ids": ["ALLOW-HOST-PHONE"],
      "fields": ["host.device"]
    },
    {
      "id": "RULE-MODE",
      "title": "实体档位规则",
      "definition": "开局设置二选一：极简档（仅钞票，手机渲染数字棋盘）或桌游档（钞票+实体棋盘）；两档共享同一规则、同一记账、同一回合交接，游戏中不可切换。",
      "priority": "P0",
      "parameter_ids": ["PAR-MODE-DEFAULT"],
      "authority_ids": ["ALLOW-MINIMAL-PROPS", "ALLOW-PHYSICAL"],
      "fields": ["physical.props.mode"]
    },
    {
      "id": "RULE-REALITY",
      "title": "实体一致性规则",
      "definition": "桌游档：移动棋子、交付钞票、抽卡由当前回合玩家执行，手机提示并记录；极简档：仅钞票交付需人工，棋子与抽卡在手机上自动完成；不一致时以手机为权威并提示纠正。",
      "priority": "P0",
      "authority_ids": ["ALLOW-MINIMAL-PROPS", "ALLOW-PHYSICAL"],
      "fields": ["physical.props.mode"]
    }
  ],
  "parameters": [
    {
