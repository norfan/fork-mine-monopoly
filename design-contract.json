  "numeric_requirements": [
    {
      "id": "NUMREQ-TURN-BUDGET",
      "statement": "8 人局单轮总时长控制在聚会可接受范围（≤10 分钟）",
      "source": "design_goal",
      "assertion_ids": ["ASSERT-FULL-ROUND", "ASSERT-FULL-ROUND-MIN"]
    },
    {
      "id": "NUMREQ-PRINT-SIZE",
      "statement": "地图导出分辨率满足实体棋盘打印清晰度",
      "source": "design_goal",
      "assertion_ids": ["ASSERT-PRINT-RES"]
    }
  ],
  "numerical_assertions": [
    {
      "id": "ASSERT-FULL-ROUND",
      "scenario": "normal",
      "expression": "max_players * turn_seconds",
      "inputs": {"max_players": "PAR-MAX-PLAYERS", "turn_seconds": "PAR-TURN-SECONDS"},
      "declared_value": 480,
      "unit": "秒",
      "tolerance": 0,
      "acceptance": {"operator": "<=", "value": 600}
    },
    {
      "id": "ASSERT-FULL-ROUND-MIN",
      "scenario": "boundary",
      "expression": "min(2, max_players) * min(30, turn_seconds)",
      "inputs": {"max_players": "PAR-MAX-PLAYERS", "turn_seconds": "PAR-TURN-SECONDS"},
      "declared_value": 60,
      "unit": "秒",
      "tolerance": 0,
      "acceptance": {"operator": ">=", "value": 60}
    },
    {
      "id": "ASSERT-PRINT-RES",
      "scenario": "normal",
      "expression": "map_print_dpi",
      "inputs": {"map_print_dpi": "PAR-MAP-PRINT-DPI"},
      "declared_value": 300,
      "unit": "dpi",
      "tolerance": 0,
      "acceptance": {"operator": ">=", "value": 150}
    }
  ],
  "state_machines": [
    {
      "id": "SM-GAME",
      "initial_state": "SETUP",
      "states": [
        {"id": "SETUP", "entry": "选择地图、玩家人数与模式开关（档位/骰子/钞票）", "exit": "开始游戏"},
        {"id": "PLAYER_TURN", "entry": "当前玩家接管手机", "exit": "掷骰完成"},
        {"id": "RESOLVE", "entry": "按格位结算", "exit": "结算完成"},
        {"id": "BANKRUPT_CHECK", "entry": "检查破产", "exit": "玩家数>=2 或终局"},
        {"id": "GAME_OVER", "entry": "终局条件达成", "exit": "结算展示"}
      ],
      "event_order": ["setup_done", "dice_rolled", "resolved", "turn_end", "bankrupt", "game_end"],
      "transitions": [
        {
          "id": "TR-START",
          "from": "SETUP",
          "event": "setup_done",
          "to": "PLAYER_TURN",
          "effect": "进入座位 1 玩家回合",
          "repeat_policy": "每局一次",
          "cleanup": "锁定设置项并记录开局快照"
        },
        {
          "id": "TR-DICE",
          "from": "PLAYER_TURN",
          "event": "dice_rolled",
          "to": "RESOLVE",
          "effect": "移动棋子并结算格位",
          "repeat_policy": "每回合一次，连双再掷由规则控制",
          "cleanup": "清空掷骰态并释放当前玩家控制权"
        },
        {
          "id": "TR-NEXT",
          "from": "RESOLVE",
          "event": "turn_end",
          "to": "PLAYER_TURN",
          "effect": "座位+1 进入下一玩家回合",
          "repeat_policy": "按座位循环",
          "cleanup": "移交控制权给下一座位玩家"
        },
        {
          "id": "TR-BANKRUPT",
          "from": "RESOLVE",
          "event": "bankrupt",
          "to": "BANKRUPT_CHECK",
          "effect": "判定剩余玩家数量",
          "repeat_policy": "每次破产结算一次",
          "cleanup": "该玩家资产归零并从座位循环移除"
        },
        {
          "id": "TR-END",
          "from": "BANKRUPT_CHECK",
          "event": "game_end",
          "to": "GAME_OVER",
          "effect": "展示排名与统计",
          "repeat_policy": "终局一次",
          "cleanup": "冻结资产并展示结算"
        }
      ]
    }
  ],
